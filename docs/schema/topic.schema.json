{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floriankappert/bhote/blob/main/docs/schema/topic.schema.json",
  "title": "bhote topic",
  "description": "One topic as printed by `bhote show --json`, `bhote list --json` (array items) and every changing command with --json. A value that is not set is null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "n",
    "title",
    "description",
    "status",
    "waiting_for",
    "waiting_since",
    "agent",
    "slack",
    "project",
    "review",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Stable id, <created epoch>-<random>. Never changes, also not across machines."
    },
    "n": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Position in `bhote list --all` at the moment of the call. Usable as <ref> right away; changes when topics change."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 140
    },
    "status": {
      "enum": [
        "now",
        "testing",
        "next",
        "waiting",
        "review",
        "later",
        "done"
      ]
    },
    "waiting_for": {
      "type": [
        "string",
        "null"
      ],
      "description": "Who the topic waits for; only set while status is waiting."
    },
    "waiting_since": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Unix time (seconds) since when it waits; only set while status is waiting."
    },
    "agent": {
      "description": "The herdr agent the topic belongs to (handed over with s, or the agent that last changed it), or null.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "machine",
            "pane",
            "session",
            "branch"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "The agent's workspace name."
            },
            "machine": {
              "type": [
                "string",
                "null"
              ],
              "description": "Machine label (HOST_LABEL or a saved herdr machine)."
            },
            "pane": {
              "type": [
                "string",
                "null"
              ],
              "description": "herdr pane id, e.g. w3:p2."
            },
            "session": {
              "type": [
                "string",
                "null"
              ],
              "description": "The agent's session id (herdr agent_session, = CLAUDE_CODE_SESSION_ID). Stable across herdr restarts."
            },
            "branch": {
              "type": [
                "string",
                "null"
              ],
              "description": "The git branch the agent works on (\"@1234abc\" when detached), read by the machine it runs on (GITHUB_BRANCHES)."
            }
          }
        }
      ]
    },
    "slack": {
      "description": "A pinned Slack channel, DM or thread: watched while the topic waits (SLACK_WATCH); a message from someone else sets it to review. null: none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "thread",
            "label",
            "message"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "pattern": "^[A-Z0-9]+$",
              "description": "Channel id (C…, G…, D…) or a user id for the DM"
            },
            "thread": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+\\.[0-9]+$",
              "description": "Thread ts, when a thread is watched"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "description": "#channel, @person, channel, DM or thread"
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "description": "The last message from someone else (who: text), while in review"
            }
          }
        }
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ],
      "description": "The project's name (the topic's own, set by bhote add --project, an agent's repository or the panel's tab); null: none."
    },
    "review": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "The card an agent put under a review topic: what it did and what is open, and the jump button *Review ansehen* (`bhote review <ref> --summary … --look`). Null when the topic is not in review or has no card.",
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "reply",
              "jump"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 24,
                "description": "The button's label, e.g. \"Commit?\"."
              },
              "reply": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 400,
                "description": "The text the agent gets when the button is pressed (default: the label without the question mark, in lower case). Null for the jump button."
              },
              "jump": {
                "type": "boolean",
                "description": "True for the generic button \"Review ansehen\" (--look): it focuses the agent and sends nothing; the topic stays in review."
              }
            }
          }
        }
      }
    },
    "created": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Unix time (seconds)."
    },
    "updated": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Unix time (seconds) of the last change; the newer one wins when replicas are merged."
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only in `bhote current --json`, never in the other commands: what runs for the agent that asks. `tests`: the suites running in its worktree (live status files, three at most); `deploy`: the deployment its topic waits for, or null.",
      "required": [
        "tests",
        "deploy"
      ],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "suite",
              "done",
              "total"
            ],
            "properties": {
              "suite": {
                "type": "string"
              },
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        },
        "deploy": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "project",
            "label",
            "state",
            "done",
            "total",
            "url"
          ],
          "properties": {
            "project": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "state": {
              "enum": [
                "running",
                "queued",
                "approval",
                "ok",
                "failed",
                "canceled"
              ]
            },
            "done": {
              "type": [
                "integer",
                "null"
              ]
            },
            "total": {
              "type": [
                "integer",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only in `bhote current --json --full`: the pull request of the agent's branch and the other open topics of the same project (the Claude Code mod's pane shows them).",
      "required": [
        "pr",
        "siblings"
      ],
      "properties": {
        "pr": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "number",
            "title",
            "state",
            "draft",
            "url",
            "checks"
          ],
          "properties": {
            "number": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "state": {
              "enum": [
                "open",
                "closed",
                "merged"
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "success",
                "failed",
                "pending"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "success": {
                  "type": "integer"
                },
                "failed": {
                  "type": "integer"
                },
                "pending": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "siblings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "title",
              "status"
            ],
            "properties": {
              "n": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "lists": {
          "type": "object",
          "additionalProperties": false,
          "description": "The cards of the panel: the other topics of each status, newest first (at most 8 in review, 5 finished, 6 of the others), with the total of that status. deploying is a topic that waits for a deployment; next, waiting, later, done and the archived ones are not part of it.",
          "properties": {
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "items"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "updated",
                      "n",
                      "title",
                      "agent",
                      "code"
                    ],
                    "properties": {
                      "updated": {
                        "type": "integer"
                      },
                      "n": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string",
                        "description": "The agent's code on its machine (MAC4, OMR3), empty without one."
                      }
                    }
                  }
                }
              }
            },
            "now": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "items"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "updated",
                      "n",
                      "title",
                      "agent",
                      "code"
                    ],
                    "properties": {
                      "updated": {
                        "type": "integer"
                      },
                      "n": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string",
                        "description": "The agent's code on its machine (MAC4, OMR3), empty without one."
                      }
                    }
                  }
                }
              }
            },
            "testing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "items"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "updated",
                      "n",
                      "title",
                      "agent",
                      "code"
                    ],
                    "properties": {
                      "updated": {
                        "type": "integer"
                      },
                      "n": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string",
                        "description": "The agent's code on its machine (MAC4, OMR3), empty without one."
                      }
                    }
                  }
                }
              }
            },
            "deploying": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "items"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "updated",
                      "n",
                      "title",
                      "agent",
                      "code"
                    ],
                    "properties": {
                      "updated": {
                        "type": "integer"
                      },
                      "n": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string",
                        "description": "The agent's code on its machine (MAC4, OMR3), empty without one."
                      }
                    }
                  }
                }
              }
            },
            "finished": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "items"
              ],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "updated",
                      "n",
                      "title",
                      "agent",
                      "code"
                    ],
                    "properties": {
                      "updated": {
                        "type": "integer"
                      },
                      "n": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string",
                        "description": "The agent's code on its machine (MAC4, OMR3), empty without one."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

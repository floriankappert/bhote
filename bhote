topic_id() { local _b=${1##*/}; printf '%s' "${_b%.topic}"; }   # the id IS the file name (checked: [A-Za-z0-9_-]); never trust an id= line
topic_get() {  # topic_get <file> <key> [default]
    local line v=""
    [ -f "$1" ] || { printf '%s' "$3"; return; }
    while IFS= read -r line; do [ "${line%%=*}" = "$2" ] && { v=${line#*=}; break; }; done < "$1"
    case "$v" in *[[:cntrl:]]*) v=${v//[[:cntrl:]]/} ;; esac      # a topic may come from another machine: never print its escape codes
    printf '%s' "${v:-$3}"
}
REVIEW_NOTE_MAX=240                                                    # the summary under a review topic (a few lines in the card)
DESC_MAX=140                                                          # a description is a short note, not a document
# One writer per topic at a time (the panel, the collector, `bhote event`, an agent's CLI call): a read-modify-write without
# it loses the other writer's key. A folder, because mkdir is atomic; not a pid, because the collector shares the panel's $$.
topic_lock() {  # topic_lock <file>: 0 when the lock is ours; after about 5 s the lock counts as left by a killed writer
    local _i
    for (( _i = 0; _i < 100; _i++ )); do mkdir "$1.lock" 2>/dev/null && return 0; sleep 0.05; done

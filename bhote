    if [ -n "${KW_READ:-}" ]; then
        kharka_follow_stop
        if [ $(( SECONDS - ${KW_AT:-0} )) -lt 60 ]; then KW_WAIT=$(( ${KW_WAIT:-0} > 0 ? KW_WAIT * 2 : 5 )); [ "$KW_WAIT" -gt 60 ] && KW_WAIT=60
        else KW_WAIT=0; fi
        KW_NEXT=$(( SECONDS + KW_WAIT ))
    fi
    [ "$SECONDS" -ge "${KW_NEXT:-0}" ] || return 0

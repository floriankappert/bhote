#!/usr/bin/env bash
# bhote — start screen: a framed welcome like Claude Code's (name and version in the top edge), a compass over a
# gradient wordmark, then a few lines about where it runs. Truecolor; NO_COLOR=1 prints it plain. Bash 3.2 compatible.
# Palette = the Catppuccin values of the herdr sidebar (teal, blue, mauve, pink, peach); the dog has its own.
# UTF-8 is needed (the frame, the dog, ${#var} counting characters). Only when the current locale is not UTF-8, switch to one
# that is installed (forcing a missing one would drop to the C locale and garble every multibyte character).
case "$(locale charmap 2>/dev/null)" in
    UTF-8|utf8|utf-8) ;;
    *) for _l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
           if locale -a 2>/dev/null | grep -qx "$_l"; then export LC_ALL=$_l; break; fi
       done ;;
esac
umask 077                                                             # everything bhote writes is for this user only
RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bhote.XXXXXX") || exit 1         # private (0700) scratch dir: nothing predictable in /tmp
trap 'rm -rf "$RUN_DIR"' EXIT
# What all panels of this machine share (the agent lists, "a change is waiting", which panel collects): a private folder that
# must belong to this user; if it does not (or cannot be made), every panel keeps to its own scratch dir.
SHARED_DIR=${BHOTE_SHARED:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/bhote-$UID}
{ mkdir -p "$SHARED_DIR" && chmod 700 "$SHARED_DIR"; } 2>/dev/null
{ [ -d "$SHARED_DIR" ] && [ -O "$SHARED_DIR" ] && [ ! -L "$SHARED_DIR" ]; } || SHARED_DIR=$RUN_DIR
SPLASH_W=${BHOTE_WIDTH:-42}       # the start screen's least width; it grows with the pane (see splash_geometry)
WIDTH=$SPLASH_W
VERSION=${BHOTE_VERSION:-0.1.0}

# ── settings: ~/.config/bhote/config, plain KEY=value lines (never sourced). Everything that reaches beyond this machine
# is OFF until the user switches it on in the settings screen (","): bhote must not open SSH connections unasked.
#   REMOTE_AGENTS=on|off   ask the saved herdr machines for their agents, in the background (default off)
#   MACHINES_OFF=a,b       saved machines that stay out even when REMOTE_AGENTS is on
#   REMOTE_EVERY=10        seconds between two remote queries      LOCAL_EVERY=3   seconds between two local ones
#   TESTS_BUSY=on|off      an agent whose workspace is running tests counts as busy, not free (default off)
#   HOST_LABEL=Name        how this machine is called in the agent lists (default: Mac on macOS, else the host name)
#   NAME_COLORS=a=teal,b=mauve   colour agents by a part of their name (case-insensitive); colours: red teal peach mauve blue green yellow
#   ANIMATION=on|off       the dog blinks and pants (default on)
#   SPLASH_AUTOCLOSE=on|off   the welcome screen closes by itself after SPLASH_SECONDS (default on, 15)
#   AUTOSTART=on|off       the herdr plugin opens the panel next to the agents when herdr starts (default on)
CONFIG_FILE=${BHOTE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bhote/config}
cfg_var() {  # cfg_var <var> <key> <default>: no subshell, no awk (the screen asks a dozen times)
    local _cl _cv=""   # odd names: the caller's target variable must never be shadowed
    if [ -r "$CONFIG_FILE" ]; then while IFS= read -r _cl; do [ "${_cl%%=*}" = "$2" ] && _cv=${_cl#*=}; done < "$CONFIG_FILE"; fi
    printf -v "$1" '%s' "${_cv:-$3}"
}
cfg_get() { cfg_var _CFG "$1" "$2"; printf '%s' "$_CFG"; }
num_or() { case "$1" in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac; }   # num_or <value> <default>: digits only
num_set() { case "$2" in ''|*[!0-9]*) printf -v "$1" '%s' "$3" ;; *) printf -v "$1" '%s' "$2" ;; esac; }   # the same into a variable (no subshell)
# Every value that ends up in $(( )) must be plain digits first: bash expands a[$(cmd)] inside arithmetic and would RUN cmd.
cfg_set() {  # cfg_set KEY value [KEY value ...]: one rewrite, one mv (a value never contains a control character: it could add a line)
    local tmp="$CONFIG_FILE.tmp.$$" line k keep a
    mkdir -p "$(dirname "$CONFIG_FILE")"
    { if [ -r "$CONFIG_FILE" ]; then while IFS= read -r line; do
          k=${line%%=*}; keep=1
          for (( a = 1; a <= $#; a += 2 )); do [ "$k" = "${!a}" ] && keep=0; done
          [ "$keep" = 1 ] && printf '%s\n' "$line"
      done < "$CONFIG_FILE"; fi
      while [ $# -ge 2 ]; do printf '%s=%s\n' "$1" "${2//[[:cntrl:]]/}"; shift 2; done
    } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
}
machine_wanted() {  # machine_wanted <label>: remote queries on, and this machine not switched off
    [ "$(cfg_get REMOTE_AGENTS off)" = on ] || return 1
    case ",$(cfg_get MACHINES_OFF ''),"  in *",$1,"*) return 1 ;; esac
    return 0
}

# ── topics: one small KEY=value file per topic (id, title, status now|waiting|later|done, waiting_for, waiting_since,
# created, updated, deleted). The LOCAL copy is always the working copy: it is read and written, also when the chosen data
# location is a saved machine (STORE=remote, STORE_MACHINE=<label>). That machine holds a replica which is merged in the
# background whenever it can be reached; while it cannot, bhote simply keeps working locally ("offline") and the changes
# wait. Merging is per topic, the newer `updated` wins (a deleted topic stays as a tombstone with deleted=1 so that the
# deletion travels, too). BHOTE_SSH replaces ssh (the tests use a fake one); BHOTE_REMOTE_DIR the folder on the machine.
DATA_DIR=${BHOTE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/bhote}
TOPIC_DIR=$DATA_DIR/topics
REMOTE_TOPIC_DIR=${BHOTE_REMOTE_DIR:-.local/share/bhote/topics}      # relative to the remote home
STORE_STATUS="$DATA_DIR/store.status"                                 # state=ok|offline, ok_at=<epoch>; shared by all panels
STORE_DIRTY="$SHARED_DIR/dirty"                          # touched by every local change: sync at once
store_ssh() { local host=$1; shift; case "$host" in ''|-*|*[!A-Za-z0-9._@:%-]*) return 1 ;; esac   # never an option, never odd characters
    "${BHOTE_SSH:-ssh}" -o BatchMode=yes -o ConnectTimeout=4 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$host" "$@"; }
# The remote LOGIN shell may be zsh or fish: an empty glob aborts a zsh command line. So every remote script goes to
# `sh -c` as one safely quoted word, and does not depend on what the login shell would make of it.
store_sh() { local host=$1 script=$2; store_ssh "$host" "sh -c $(printf '%q' "$script")"; }
store_host() {  # store_host <saved machine label> -> its ssh target
    herdr machine list 2>/dev/null | awk -F'\t' -v l="$1" '$2 == l { print $3; exit }'
}
store_note() {  # store_note ok|offline
    local ok_at; ok_at=$(awk -F= '$1 == "ok_at" { print $2 }' "$STORE_STATUS" 2>/dev/null)
    [ "$1" = ok ] && ok_at=$(date +%s)
    printf 'state=%s\nok_at=%s\n' "$1" "${ok_at:-0}" > "$STORE_STATUS"
}
topic_get() {  # topic_get <file> <key> [default]
    local line v=""
    [ -f "$1" ] || { printf '%s' "$3"; return; }
    while IFS= read -r line; do [ "${line%%=*}" = "$2" ] && { v=${line#*=}; break; }; done < "$1"
    case "$v" in *[[:cntrl:]]*) v=${v//[[:cntrl:]]/} ;; esac      # a topic may come from another machine: never print its escape codes
    printf '%s' "${v:-$3}"
}
DESC_MAX=140                                                          # a description is a short note, not a document
topic_set() {  # topic_set <file> <key> <value>: also stamps `updated`
    local f=$1 now old v=${3//[[:cntrl:]]/}; now=$(date +%s)      # no control character in a value: a newline would add keys
    [ "$2" = description ] && v=${v:0:$DESC_MAX}
    old=$(num_or "$(topic_get "$f" updated 0)" 0); [ "$now" -le "$old" ] && now=$(( old + 1 ))   # a change always counts as newer
    { grep -v -e "^$2=" -e '^updated=' "$f"; printf '%s=%s\nupdated=%s\n' "$2" "$v" "$now"; } > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"
    : > "$STORE_DIRTY"
}
topic_new() {  # topic_new <title> [waiting for] [description]
    mkdir -p "$TOPIC_DIR"
    local now id title status=now since=""; now=$(date +%s); id="$now-$RANDOM"
    title=${1//[[:cntrl:]]/}; title=$(printf '%s' "$title" | sed 's/^ *//; s/ *$//'); set -- "$title" "${2//[[:cntrl:]]/}" "${3//[[:cntrl:]]/}"
    set -- "$1" "$2" "${3:0:$DESC_MAX}"
    [ -n "$title" ] || return 1
    [ -n "$2" ] && { status=waiting; since=$now; }
    printf 'id=%s\ntitle=%s\nstatus=%s\nwaiting_for=%s\nwaiting_since=%s\ncreated=%s\nupdated=%s\ndeleted=0\ndescription=%s\n' \
        "$id" "$title" "$status" "$2" "$since" "$now" "$now" "${3:-}" > "$TOPIC_DIR/$id.topic"
    NEW_TOPIC_ID=$id
    : > "$STORE_DIRTY"
}
store_tag() { STORE_TAG_OUT=""; [ "${U_STORE:-}" = remote ] && [ "${U_STORE_STATE:-}" = offline ] && STORE_TAG_OUT=" · offline"; printf '%s' "$STORE_TAG_OUT"; }
# All topics are read ONCE per screen into arrays (pure bash, no subshell per topic: a draw used to start a few awk per topic
# and grew with the square of the count). Order: now, waiting, later, done; inside a group by file name = by creation.
topics_load() {
    local f line k v id title st wf ws up del desc ag am ap seen n=0 s i m=0 a_file a_id a_title a_st a_wf a_ws a_up a_desc a_ag a_am a_ap
    for f in "$TOPIC_DIR"/*.topic; do
        [ -f "$f" ] || continue
        title=""; st=now; wf=""; ws=""; up=0; del=0; desc=""; ag=""; am=""; ap=""; seen=" "
        while IFS= read -r line; do
            k=${line%%=*}; v=${line#*=}
            case "$seen" in *" $k "*) continue ;; esac; seen="$seen$k "     # the FIRST value counts, everywhere (topic_get does the same)
            case "$k" in title) title=$v ;; status) st=$v ;; waiting_for) wf=$v ;; waiting_since) ws=$v ;; updated) up=$v ;; deleted) del=$v ;; description) desc=$v ;; agent) ag=$v ;; agent_machine) am=$v ;; agent_pane) ap=$v ;; esac
        done < "$f"
        [ "$del" = 1 ] && continue
        case "$title$wf$desc$ag$am$ap$st" in *[[:cntrl:]]*) title=${title//[[:cntrl:]]/}; wf=${wf//[[:cntrl:]]/}; desc=${desc//[[:cntrl:]]/}; ag=${ag//[[:cntrl:]]/}; am=${am//[[:cntrl:]]/}; ap=${ap//[[:cntrl:]]/}; st=${st//[[:cntrl:]]/} ;; esac
        case "$st" in now|waiting|later|done) ;; *) st=now ;; esac
        case "$ws" in *[!0-9]*) ws="" ;; esac; case "$up" in ''|*[!0-9]*) up=0 ;; esac
        id=${f##*/}; id=${id%.topic}
        a_file[$n]=$f; a_id[$n]=$id; a_title[$n]=$title; a_st[$n]=$st; a_wf[$n]=$wf; a_ws[$n]=$ws; a_up[$n]=$up; a_desc[$n]=$desc; a_ag[$n]=$ag; a_am[$n]=$am; a_ap[$n]=$ap; n=$(( n + 1 ))
    done
    T_FILE=(); T_ID=(); T_TITLE=(); T_STATUS=(); T_WFOR=(); T_WSINCE=(); T_UPD=(); T_DESC=(); T_AG=(); T_AM=(); T_AP=()
    for s in now waiting later done; do
        for (( i = 0; i < n; i++ )); do
            [ "${a_st[$i]}" = "$s" ] || continue
            T_FILE[$m]=${a_file[$i]}; T_ID[$m]=${a_id[$i]}; T_TITLE[$m]=${a_title[$i]}; T_STATUS[$m]=$s
            T_WFOR[$m]=${a_wf[$i]}; T_WSINCE[$m]=${a_ws[$i]}; T_UPD[$m]=${a_up[$i]}; T_DESC[$m]=${a_desc[$i]}; T_AG[$m]=${a_ag[$i]}; T_AM[$m]=${a_am[$i]}; T_AP[$m]=${a_ap[$i]}; m=$(( m + 1 ))
        done
    done
    T_N=$m
}
sel_index() {  # the index of the selected topic in the arrays (SEL_ID, else the first); needs topics_load first
    local i; SEL_IDX=0
    for (( i = 0; i < T_N; i++ )); do [ "${T_ID[$i]}" = "${SEL_ID:-}" ] && { SEL_IDX=$i; return; }; done
}
topics_ordered() { local i; topics_load; for (( i = 0; i < T_N; i++ )); do printf '%s\n' "${T_FILE[$i]}"; done; }
sel_file() { topics_load; sel_index; [ "$T_N" -gt 0 ] && printf '%s' "${T_FILE[$SEL_IDX]}"; }
sel_move() {  # sel_move <+1|-1>: wraps around, like a menu in an old game
    [ -n "${T_N:-}" ] || topics_load; [ "$T_N" -gt 0 ] || return 0   # the arrays of the last frame; ui_load reloads right after
    sel_index; SEL_IDX=$(( (SEL_IDX + $1 + T_N) % T_N )); SEL_ID=${T_ID[$SEL_IDX]}
}
topic_files() { topics_ordered; }
topics_count() { topics_load; echo "$T_N"; }
age_set() {  # age_set <var> <epoch>: "now" / "5m" / "3h" / "2d", relative to NOW
    local d t; [ -n "${NOW:-}" ] || NOW=$(date +%s)
    case "$2" in ''|*[!0-9]*) printf -v "$1" '%s' '?'; return ;; esac
    d=$(( NOW - $2 )); [ "$d" -lt 0 ] && d=0
    if [ "$d" -lt 60 ]; then t="now"; elif [ "$d" -lt 3600 ]; then t="$(( d / 60 ))m"; elif [ "$d" -lt 172800 ]; then t="$(( d / 3600 ))h"; else t="$(( d / 86400 ))d"; fi
    printf -v "$1" '%s' "$t"
}
age_text() { age_set _AGE "$1"; printf '%s' "$_AGE"; }
ago_set() { age_set "$1" "$2"; if [ "${!1}" = now ]; then printf -v "$1" '%s' 'just now'; else printf -v "$1" '%s ago' "${!1}"; fi; }   # "3h ago"
ago() { ago_set _AGO "$1"; printf '%s' "$_AGO"; }
store_sync_run() {  # merge the local copy with the replica on the chosen machine. Returns 1 while that machine is unreachable.
    [ "$(cfg_get STORE local)" = remote ] || { rm -f "$STORE_STATUS"; return 0; }
    local label host tmp f l r ok=1 NOW_SYNC; NOW_SYNC=$(date +%s)
    label=$(cfg_get STORE_MACHINE ''); host=$(store_host "$label")
    [ -n "$host" ] || { store_note offline; return 1; }
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/bhote.sync.XXXXXX"); mkdir -p "$TOPIC_DIR"
    # 1) everything the machine has: one stream, "@@name" before each file
    # (a newline before every marker: a file without a final newline must not swallow the next one; at most 8 MB are read)
    store_sh "$host" "umask 077; mkdir -p $REMOTE_TOPIC_DIR && cd $REMOTE_TOPIC_DIR && for f in *.topic; do [ -f \"\$f\" ] && { printf '\\n@@%s\\n' \"\$f\"; cat \"\$f\"; }; done; echo; echo @@END" 2>/dev/null | head -c 8000001 > "$tmp/dump"
    # only a complete dump counts (ssh can die in the middle and still leave a plausible half): it must end with the @@END line
    if [ "$(wc -c < "$tmp/dump")" -gt 8000000 ] || [ "$(tail -n 1 "$tmp/dump")" != "@@END" ]; then
        rm -rf "$tmp"; store_note offline; return 1
    fi
    # only plain topic names are accepted from the other side: a name like ../../x must never become a path
    mkdir "$tmp/remote"; awk -v d="$tmp/remote" '/^@@/ { if (f != "") close(f); f = ""; if ($0 ~ /^@@[A-Za-z0-9][A-Za-z0-9_-]*\.topic$/) f = d "/" substr($0, 3); next } $0 == "" { next } f != "" { print > f }' "$tmp/dump"
    for f in "$tmp/remote"/*.topic; do [ -f "$f" ] && ! topic_valid "$f" "$NOW_SYNC" && rm -f "$f"; done   # a malformed replica file is not taken
    # 2) per topic: the newer one wins, in both directions
    { ls "$tmp/remote" 2>/dev/null; ls "$TOPIC_DIR" 2>/dev/null; } | grep -E '^[A-Za-z0-9][A-Za-z0-9_-]*\.topic$' | sort -u > "$tmp/ids"
    while IFS= read -r f; do
        l=0; r=0
        [ -f "$TOPIC_DIR/$f" ] && l=$(topic_get "$TOPIC_DIR/$f" updated 0)
        [ -f "$tmp/remote/$f" ] && r=$(topic_get "$tmp/remote/$f" updated 0)
        l=$(num_or "$l" 0); r=$(num_or "$r" 0)
        if [ "$r" -gt "$l" ]; then
            cp "$tmp/remote/$f" "$TOPIC_DIR/$f.tmp.$$" || continue
            # a local change that happened during the dump must not be overwritten
            if [ -f "$TOPIC_DIR/$f" ] && [ "$(num_or "$(topic_get "$TOPIC_DIR/$f" updated 0)" 0)" != "$l" ]; then rm -f "$TOPIC_DIR/$f.tmp.$$"; continue; fi
            mv "$TOPIC_DIR/$f.tmp.$$" "$TOPIC_DIR/$f"
        elif [ "$l" -gt "$r" ]; then
            store_sh "$host" "umask 077; cat > $REMOTE_TOPIC_DIR/$f.tmp && mv $REMOTE_TOPIC_DIR/$f.tmp $REMOTE_TOPIC_DIR/$f" < "$TOPIC_DIR/$f" 2>/dev/null || ok=0
        fi
    done < "$tmp/ids"
    rm -rf "$tmp"
    if [ "$ok" = 1 ]; then store_note ok; else store_note offline; return 1; fi
}
topic_valid() {  # topic_valid <file> <now>: KEY=value lines only, no key twice, numbers are digits, not from the future, small
    awk -F= -v now="$2" '
        NF < 2 || $1 !~ /^[a-z_]+$/ { bad = 1 }
        seen[$1]++ { bad = 1 }
        ($1 == "updated" || $1 == "created" || $1 == "waiting_since") && $2 !~ /^[0-9]*$/ { bad = 1 }
        ($1 == "updated" || $1 == "created" || $1 == "waiting_since") && $2 != "" && $2 + 0 > now + 300 { bad = 1 }
        length($0) > 4000 || NR > 64 { bad = 1 }
        END { exit bad }' "$1" 2>/dev/null
}
# One sync at a time over all panels of this machine (and the CLI). The lock is a directory with the pid of its owner inside;
# it is stale when that process is gone (or after 3 minutes). store_sync returns 2 when another sync is running.
store_sync() {
    local lock=$DATA_DIR/sync.lock rc owner=""
    mkdir -p "$DATA_DIR"
    if ! mkdir "$lock" 2>/dev/null; then
        [ -r "$lock/pid" ] && read -r owner < "$lock/pid"
        if { [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; } || [ -n "$(find "$lock" -maxdepth 0 -mmin +3 2>/dev/null)" ]; then
            rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 2
        else return 2; fi
    fi
    echo "$$" > "$lock/pid"
    store_sync_run; rc=$?
    [ "$(cat "$lock/pid" 2>/dev/null)" = "$$" ] && rm -rf "$lock"    # only our own lock
    return $rc
}
store_summary() {  # one line for the settings screen: where the data lives and whether it is in step
    local label st ok_at pending f n=0
    if [ "$(cfg_get STORE local)" != remote ]; then printf 'local only (%s)' "${TOPIC_DIR/#$HOME/~}"; return; fi
    label=$(cfg_get STORE_MACHINE '?')
    st=$(awk -F= '$1 == "state" { print $2 }' "$STORE_STATUS" 2>/dev/null); ok_at=$(num_or "$(awk -F= '$1 == "ok_at" { print $2 }' "$STORE_STATUS" 2>/dev/null)" 0)
    case "$st" in
        ok) printf 'in sync with %s (%s)' "$label" "$(ago "$ok_at")" ;;
        offline) for f in "$TOPIC_DIR"/*.topic; do [ -f "$f" ] && [ "$(num_or "$(topic_get "$f" updated 0)" 0)" -gt "$ok_at" ] && n=$(( n + 1 )); done
                 printf 'OFFLINE: saving locally, %s change(s) wait for %s' "$n" "$label" ;;
        *) printf 'connecting to %s ...' "$label" ;;
    esac
}

if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ] && [ -z "${BHOTE_FORCE_COLOR:-}" ]; then
    rgb() { :; }; X=""; R=""; NN=""; S=""; C=""; L=""; D=""; color=0
else
    color=1; esc=$'\033'
    rgb() { printf '%s[38;2;%sm' "$esc" "$1"; }
    X="${esc}[0m"
    R=$(rgb "203;166;247")            # ring: mauve
    NN=$(rgb "243;139;168")           # north half of the needle: red
    S=$(rgb "148;226;213")            # south half: teal
    C=$(rgb "250;179;135")            # centre: peach
    L="${esc}[1m$(rgb "205;214;244")" # N E S W: bold, bright
    D=$(rgb "108;112;134")            # arrows, tagline: dim
fi

stops=("148 226 213" "137 180 250" "203 166 247" "245 194 231" "250 179 135")
gradient() {            # gradient <text> : colours the characters of one line left to right
    local line=$1 n=$(( ${#stops[@]} - 1 )) w=${#1} i ch p seg t r1 g1 b1 r2 g2 b2 out=""
    [ "$color" = 1 ] || { printf '%s' "$line"; return; }
    for (( i = 0; i < w; i++ )); do
        ch=${line:$i:1}
        if [ "$ch" = " " ]; then out="$out "; continue; fi
        p=$(( i * n * 100 / (w - 1) )); seg=$(( p / 100 )); [ $seg -ge $n ] && seg=$(( n - 1 )); t=$(( p - seg * 100 ))
        read -r r1 g1 b1 <<< "${stops[$seg]}"; read -r r2 g2 b2 <<< "${stops[$((seg + 1))]}"
        out="$out$(rgb "$(( r1 + (r2 - r1) * t / 100 ));$(( g1 + (g2 - g1) * t / 100 ));$(( b1 + (b2 - b1) * t / 100 ))")$ch"
    done
    printf '%s%s' "$out" "$X"
}

Y=""; GREEN=""; BLUE=""
if [ "$color" = 1 ]; then Y=$(rgb "249;226;175"); GREEN=$(rgb "166;227;161"); BLUE=$(rgb "137;180;250"); fi   # waiting / prompt, done, Mac
B="" ; [ "$color" = 1 ] && B=$(rgb "108;112;134")      # frame colour (dim)
INNER=$(( WIDTH - 2 ))
hline() { local _s; printf -v _s '%*s' "$1" ''; printf '%s' "${_s// /─}"; }   # n times ─ (GNU tr cannot map to a multibyte character)
at_col() { [ "$color" = 1 ] && printf '%s[%dG' "$esc" "$1"; }

# One framed line: the right edge is placed by cursor column, so wide or combining characters cannot push it.
row() {  # row <shown text>
    printf '%s│%s%s' "$B" "$X" "$1"
    if [ "$color" = 1 ]; then printf '%s[K' "$esc"; at_col "$WIDTH"; printf '%s│%s\n' "$B" "$X"    # clear what an earlier frame left behind
    else printf '%*s│\n' $(( INNER - ${2:-0} )) ""; fi
}
mid() { local plain=$1 shown=$2 w=${3:-${#1}}; row "$(printf '%*s' $(( (INNER - w) / 2 )) "")$shown" $(( (INNER - w) / 2 + w )); }
blank() { row "" 0; }
blanks() { local n; for (( n = 0; n < $1; n++ )); do blank; done; }

top() {
    local title=" Bhote v$VERSION " n
    n=$(( INNER - ${#title} - 1 ))
    printf '%s╭─%s%s%s%s%s╮%s\n' "$B" "$X$L" "$title" "$X$B" "$(hline "$n")" "" "$X"
}
bottom() { printf '%s╰%s╯%s\n' "$B" "$(hline "$INNER")" "$X"; }

info() {   # info <label> <value>
    local label=$1 value=$2 pad=${INFO_PAD:-1}       # INFO_PAD centres the whole block (bhote_splash sets it)
    row "$(printf '%*s' "$pad" '')${D}${label}${X} ${value}" $(( pad + ${#label} + ${#value} + 1 ))
}


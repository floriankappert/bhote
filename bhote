    { echo "$(( cw + 3 ))"; for (( r = 0; r < shown; r++ )); do printf '%s\036%s\036%s\n' "$r" "${lid[$r]:-}" "${rid[$r]:-}"; done; } 2>/dev/null > "$RUN_DIR/agmap"
    for (( r = 0; r < n; r++ )); do

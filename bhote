                if [ "$off" = 1 ]; then case "$st" in working|testing) ic="${MUTED}✶" ;; blocked) ic="${MUTED}◉" ;; done) ic="${MUTED}✓" ;; *) ic="${MUTED}○" ;; esac; nc=$MUTED; fi
                dw_set plain "$label"; cells[$nc2]="$ic$X ${pre:+$D$pre$X}$nc$label$X"; cwid[$nc2]=$(( plain + plen + 2 ))
                tt=""; for (( tj = 0; tj < T_N; tj++ )); do   # the topic this agent works on (in work, review, waiting or next; a parked one is not "its" work)
                    [ "${T_AP[$tj]}" = "$id" ] && [ "${T_AM[$tj]}" = "$m" ] || continue
                    case "${T_STATUS[$tj]}" in now|review|waiting|next) tt=${T_TITLE[$tj]}; break ;; esac
                done
                if [ -n "$tt" ] && [ $(( cw - 1 - cwid[$nc2] )) -ge 5 ]; then   # the topic after the name: a hint of seven characters at most, no elbow
                    tw=$(( cw - 1 - cwid[$nc2] )); [ "$tw" -gt 7 ] && tw=7; clip_set tt "$tt" "$tw"; dw_set tw "$tt"

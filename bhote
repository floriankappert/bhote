        printf '  %s%s%s' "$S" "$(clip "$FLASH_MSG" "$room")" "$X"; return
    fi
    [ -n "${FOCUS_KEY:-}" ] && right="$FOCUS_KEY ⇄"         # bottom right: the herdr key that jumps here and back
    dw_set lw "$left"; dw_set rw "$right"
    if [ -n "$right" ] && [ $(( lw + 3 + rw )) -gt "$room" ]; then left=", settings$sg"; dw_set lw "$left"; fi
    if [ -n "$right" ] && [ $(( lw + 3 + rw )) -gt "$room" ]; then left=${sg# · }; dw_set lw "$left"; fi   # narrow: suggestions and the key
    if [ -n "$right" ] && [ $(( lw + 1 + rw )) -le "$room" ]; then
        printf '  %s%s%*s%s%s%s' "$D" "$left" $(( room - lw - rw )) "" "$S" "$right" "$X"
    else printf '  %s%s%s' "$D" "$(clip "$left" "$room")" "$X"; fi
}
count_lines() {  # count_lines <var> <text>  (a read loop: pattern substitution on text full of escapes and UTF-8 is very slow in bash 3.2)
    local _n=0 _l; while IFS= read -r _l; do _n=$(( _n + 1 )); done <<< "$2"; printf -v "$1" '%s' "$_n"
}
bhote_view() {  # head on top, topics below it (scrolling with the selection), agents + rule + keys at the BOTTOM edge
    local head topics bottom hh th bh avail pad=0 i off sel=-1 content tl=() n=0 line
    head=$(view_head); topics=$(topics_block); bottom=$(view_bottom)
    count_lines hh "$head"; count_lines th "$topics"; count_lines bh "$bottom"
    avail=$(( ${ROWS:-40} - hh - bh ))
    printf '%s\n' "$head"
    if [ "$th" -le "$avail" ]; then
        printf '%s\n' "${topics//$'\001'/}"; pad=$(( avail - th ))
    elif [ "$avail" -ge 4 ]; then       # more topics than room: a window that follows the selection, one row for the marker
        content=$(( avail - 1 ))
        while IFS= read -r line; do case "$line" in $'\001'*) sel=$n; line=${line#$'\001'} ;; esac; tl[$n]=$line; n=$(( n + 1 )); done <<< "$topics"
        [ "$sel" = -1 ] && sel=0
        local sh=1; while [ "$sh" -lt 4 ] && [ $(( sel + sh )) -lt "$n" ] && [ -n "${tl[$(( sel + sh ))]}" ]; do sh=$(( sh + 1 )); done
        off=$(( sel + sh - content )); [ "$off" -gt "$sel" ] && off=$sel; [ "$off" -lt 0 ] && off=0; [ "$off" -gt $(( th - content )) ] && off=$(( th - content ))
        for (( i = off; i < off + content; i++ )); do printf '%s\n' "${tl[$i]}"; done
        printf ' %s↑↓ %d more lines%s\n' "$D" $(( th - content )) "$X"
    else                                # hardly any room: as many topic lines as fit, never more than the pane
        n=0; while IFS= read -r line && [ "$n" -lt "$avail" ]; do printf '%s\n' "${line#$'\001'}"; n=$(( n + 1 )); done <<< "$topics"
    fi
    for (( i = 0; i < pad; i++ )); do printf '\n'; done
    echo $(( ${ROWS:-40} - bh + 1 )) > "$RUN_DIR/divrow" 2>/dev/null     # the divider is the first line of the bottom part
    printf '%s' "$bottom"
}

# Word wrap with a hanging indent: every line of a paragraph starts at the same column and ends before the panel's edge.
wrap_print() {  # wrap_print <indent> <colour> <text>
    local ind=$1 col=$2 width=$(( ${COLS:-44} - 2 - $1 )) line="" word pad
    printf -v pad '%*s' "$ind" ''
    set -f
    local ww lw=0
    for word in $3; do
        dw_set ww "$word"; [ "$ww" -gt "$width" ] && { clip_set word "$word" "$width"; dw_set ww "$word"; }   # a path or URL that cannot break
        if [ -z "$line" ]; then line=$word; lw=$ww
        elif [ $(( lw + 1 + ww )) -le "$width" ]; then line="$line $word"; lw=$(( lw + 1 + ww ))
        else printf '%s%s%s%s\n' "$pad" "$col" "$line" "$X"; line=$word; lw=$ww; fi
    done
    set +f
    [ -n "$line" ] && printf '%s%s%s%s\n' "$pad" "$col" "$line" "$X"
}
set_row() {  # set_row <selected 0|1> <label> <value, plain> <value, coloured> [extra indent]: label left, value right-aligned
    local sel=$1 label=$2 vp=$3 vc=$4 ind=${5:-0} w=$(( ${COLS:-44} - 2 )) pad lw vw
    dw_set vw "$vp"; clip_set label "$label" $(( w - 5 - ind - vw )); dw_set lw "$label"
    pad=$(( w - 4 - ind - lw - vw )); [ "$pad" -lt 1 ] && pad=1
    if [ "$sel" = 1 ]; then printf '\001%s   %s%*s%s%s%*s%s%s%s\n' "$SELBG" "$LSEL" "$ind" "" "$label" "$X$SELBG" "$pad" "" "$vc" "$SELBG " "$X"
    else printf '   %*s%s%s%s%*s%s\n' "$ind" "" "$D" "$label" "$X" "$pad" "" "$vc"; fi
}

# ── the settings screen (","). Rows: the remote switch, one row per saved machine, the intervals, the animation.
# ↑/↓ (or k/j) choose, space or enter switches, ←/→ change a number, "," or esc goes back. Every change is saved at once.
SET_ROWS=()
settings_rows() {   # fills SET_ROWS with "kind|key|label"; the machine rows exist only while REMOTE_AGENTS is on
    SET_ROWS=("choice|STORE|Data location" "enum|SYNC_VIA|Sync through" "bool|REMOTE_AGENTS|Remote agents (via herdr)")
    [ "$(cfg_get REMOTE_AGENTS off)" = on ] && SET_ROWS[${#SET_ROWS[@]}]="bool|PUSH_STATES|Push agent states at once"
    if [ "$(cfg_get REMOTE_AGENTS off)" = on ]; then
        local id label host prof enabled
        while IFS=$US read -r id label host prof enabled; do
            label=${label//[[:cntrl:]|]/}; host=${host//[[:cntrl:]]/}
            [ -n "$label" ] && SET_ROWS[${#SET_ROWS[@]}]="machine|$label|$label ($host)"
        done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
        SET_ROWS[${#SET_ROWS[@]}]="num|REMOTE_EVERY|Remote interval (s)"
    fi
    SET_ROWS[${#SET_ROWS[@]}]="num|PANEL_MIN_WIDTH|Panel width min"
    SET_ROWS[${#SET_ROWS[@]}]="num|PANEL_MAX_WIDTH|Panel width max"
    SET_ROWS[${#SET_ROWS[@]}]="num|LOCAL_EVERY|Local interval (s)"
    SET_ROWS[${#SET_ROWS[@]}]="bool|TESTS_BUSY|Running tests = agent busy"
    SET_ROWS[${#SET_ROWS[@]}]="bool|AUTO_ASSIGN|Auto-assign now topics"
    [ "$(cfg_get AUTO_ASSIGN off)" = on ] && SET_ROWS[${#SET_ROWS[@]}]="prefer|AUTO_ASSIGN_MACHINE|Prefer agents on"
    SET_ROWS[${#SET_ROWS[@]}]="bool|AGENT_CAN_CLOSE|Agents may close topics"
    SET_ROWS[${#SET_ROWS[@]}]="bool|NOTIFY|herdr notifications"
    SET_ROWS[${#SET_ROWS[@]}]="num|WAIT_REMIND|Remind waiting after (h)"
    SET_ROWS[${#SET_ROWS[@]}]="enum|THEME|Colours"
    SET_ROWS[${#SET_ROWS[@]}]="bool|ANIMATION|Animation (blink, pant)"
    SET_ROWS[${#SET_ROWS[@]}]="bool|SPLASH_AUTOCLOSE|Close welcome screen after 15 s"
    SET_ROWS[${#SET_ROWS[@]}]="bool|AUTOSTART|Auto-start with herdr"
    SET_ROWS[${#SET_ROWS[@]}]="key|JUMP_KEY|Jump key (herdr)"
    SET_ROWS[${#SET_ROWS[@]}]="key|FIND_KEY|Find key (herdr)"
    SET_ROWS[${#SET_ROWS[@]}]="link|SETUP|Setup wizard"
    SET_ROWS[${#SET_ROWS[@]}]="link|HOTKEYS|Hotkeys"
}
bhote_settings() {
    local i row kind key label vp vc v def cur=${SET_IDX:-0} sel ind off
    settings_rows
    printf '\n %sSettings%s  %s%s%s\n' "$L" "$X" "$D" "$(clip "${CONFIG_FILE/#$HOME/~}" $(( ${COLS:-44} - 13 )))" "$X"
    rule; printf '\n'
    for (( i = 0; i < ${#SET_ROWS[@]}; i++ )); do
        row=${SET_ROWS[$i]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}; label=${row#*|}; ind=0; sel=0
        [ "$i" = "$cur" ] && sel=1
        case "$kind" in
            bool) setting_row "$key"; def=${S_DEF:-off}; cfg_var v "$key" $def
                  if [ "$v" = on ]; then vp="[x]"; vc="${GREEN}[x]${X}"; else vp="[ ]"; vc="${D}[ ]${X}"; fi ;;
            choice) cfg_var v STORE local
                  if [ "$v" = remote ]; then cfg_var v STORE_MACHINE '?'; vp="‹ $v ›"; else vp="‹ local ›"; fi; vc="${C}${vp}${X}" ;;
            machine) ind=2; cfg_var off MACHINES_OFF ""
                  case ",$off,"  in *",$key,"*) vp="[ ]"; vc="${D}[ ]${X}" ;; *) vp="[x]"; vc="${GREEN}[x]${X}" ;; esac ;;
            num) setting_row "$key"; def=$S_DEF; cfg_var v "$key" "$def"; vp=$v; vc="${C}${v}${X}" ;;
            link) vp="›"; vc="${D}›${X}" ;;
            key) if [ "$key" = FIND_KEY ]; then vp=${FIND_KEY_SHOW:-off}; else vp=${FOCUS_KEY:-off}; fi; vc="${C}${vp}${X}" ;;
            enum) setting_row "$key"; cfg_var v "$key" "$S_DEF"; vp="‹ $v ›"; vc="${C}${vp}${X}" ;;
            prefer) ind=2; cfg_var v "$key" any; vp="‹ $v ›"; vc="${C}${vp}${X}" ;;
        esac
        set_row "$sel" "$label" "$vp" "$vc" "$ind"
        case "$key" in
            STORE) wrap_print 5 "$D" "$(store_summary)" ;;
            REMOTE_AGENTS) wrap_print 5 "$D" "Off by default. Asks herdr for the agents of its saved machines." ;;
            JUMP_KEY) wrap_print 5 "$D" "$([ "$KEY_MSG_FOR" = JUMP_KEY ] && [ -n "$KEY_MSG" ] && printf '%s' "$KEY_MSG" || printf '⏎ change. Jumps from the agent to this panel and back.')" ;;
            FIND_KEY) wrap_print 5 "$D" "$([ "$KEY_MSG_FOR" = FIND_KEY ] && [ -n "$KEY_MSG" ] && printf '%s' "$KEY_MSG" || printf '⏎ change. Find a topic or an agent and jump to it.')" ;;
        esac
    done
    printf '\n'; rule
    printf ' %s%s%s\n' "$D" "$(clip "↑↓ select · space/⏎ toggle" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "←→ change · , or esc back" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "list: ⏎ open · n new · e/d edit · x done" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "s start · a from agents · q quit" $(( ${COLS:-44} - 3 )))" "$X"
}
bhote_hotkeys() {  # every key, grouped by screen
    local k
    printf '\n %sHotkeys%s\n' "$L" "$X"; rule
    hk_group "LIST"
    hk "↑↓ jk" "move"; hk "→ ⏎" "open the topic menu"; hk "n" "new topic (Title; description @Name)"
    hk "e" "edit the title"; hk "d" "edit the description"
    hk "s" "start on a free agent"; hk "t" "Steal & Transfer to another agent"; hk "x" "mark done"; hk "a" "suggestions from agents"
    hk "," "settings"; hk "S" "welcome screen"; hk "q" "quit"
    hk_group "MENUS AND PICKERS"
    hk "↑↓" "choose"; hk "→ ⏎" "do it"; hk "← esc" "back"; hk "x" "dismiss a suggestion"
    hk_group "SETTINGS"
    hk "↑↓" "select"; hk "space ⏎" "switch"; hk "←→" "change a value"; hk ", esc" "back"
    hk_group "HERDR"
    if [ -n "${FOCUS_KEY:-}" ]; then hk "$FOCUS_KEY" "jump to this panel and back"
    else hk "-" "jump here: settings › Jump key"; fi
    if [ -n "${FIND_KEY_SHOW:-}" ]; then hk "$FIND_KEY_SHOW" "find a topic or agent, jump to it"
    else hk "-" "find and jump: settings › Find key"; fi
    hk_group "MOUSE"
    hk "drag ═══" "resize the agent area"; hk "click agent" "focus it in herdr"
    printf '\n'; rule
    printf ' %s← esc back%s\n' "$D" "$X"
}
hk_group() { printf '\n  %s%s%s\n' "$D" "$1" "$X"; }
hk() {  # hk <keys> <what>
    local w=$(( ${COLS:-44} - 18 )) t k; clip_set t "$2" "$w"; pad_set k "$1" 12
    printf '   %s%s%s %s\n' "$C" "$k" "$X" "$t"
}
store_cycle() {  # step the data location through: local, then every saved machine (→ / space forward, ← back)
    local opts=(local) id label host prof enabled cur i n k=$1 dir=1
    while IFS=$US read -r id label host prof enabled; do label=${label//[[:cntrl:]]/}; [ -n "$label" ] && opts[${#opts[@]}]="$label"; done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
    cur=local; [ "$(cfg_get STORE local)" = remote ] && cur=$(cfg_get STORE_MACHINE '')
    n=${#opts[@]}; [ "$k" = LEFT ] && dir=$(( n - 1 ))
    for (( i = 0; i < n; i++ )); do [ "${opts[$i]}" = "$cur" ] && break; done
    i=$(( (i + dir) % n ))
    if [ "${opts[$i]}" = local ]; then cfg_set STORE local; else cfg_set STORE remote STORE_MACHINE "${opts[$i]}"; fi
    : > "$STORE_DIRTY"
}
settings_key() {  # settings_key <key as read>  (an arrow arrives as ESC [ A/B/C/D)
    local k=$1 n=${#SET_ROWS[@]} row kind key cur v off
    settings_rows; n=${#SET_ROWS[@]}
    case "$k" in
        UP|k) SET_IDX=$(( (${SET_IDX:-0} + n - 1) % n )) ;;
        DOWN|j) SET_IDX=$(( (${SET_IDX:-0} + 1) % n )) ;;
        " "|ENTER|LEFT|RIGHT) row=${SET_ROWS[${SET_IDX:-0}]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}
            if [ "$kind" = choice ]; then store_cycle "$k"; return; fi
            if [ "$kind" = num ]; then                               # ← → change it; space and Enter do nothing here
                [ "$k" = LEFT ] || [ "$k" = RIGHT ] || return
                setting_row "$key"; local lo=${S_TYPE#int:}; lo=${lo%%:*}
                v=$(num_or "$(cfg_get "$key" "$S_DEF")" "$S_DEF")
                if [ "$k" = RIGHT ]; then v=$(( v + 1 )); else v=$(( v > lo ? v - 1 : lo )); fi
                setting_check "$key" "$v" 2>/dev/null && cfg_set "$key" "$v"; return
            fi
            if [ "$kind" = key ]; then                               # ⏎ / space: type a new key (herdr's syntax)
                [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                local cur_raw fn=jump_key_apply; focus_key_set FOCUS_KEY; cur_raw=${FOCUS_KEY_RAW:-prefix+t}
                if [ "$key" = FIND_KEY ]; then fn=find_key_apply; cfg_var cur_raw FIND_KEY off; [ "$cur_raw" = off ] && cur_raw=ctrl+alt+t; fi
                if ask "herdr key (prefix+t, ctrl+alt+t, off): " "$cur_raw" 40 && [ -n "$ANSWER" ]; then
                    KEY_MSG_FOR=$key
                    if "$fn" "$ANSWER" 2> "$RUN_DIR/jkerr"; then
                        KEY_MSG="Saved: $([ "$key" = FIND_KEY ] && printf '%s' "${FIND_KEY_SHOW:-off}" || printf '%s' "${FOCUS_KEY:-off}"). herdr has it now."
                    else KEY_MSG=$(head -1 "$RUN_DIR/jkerr"); KEY_MSG=${KEY_MSG#bhote: }; KEY_MSG="Not changed: ${KEY_MSG:-herdr refused it}"; fi
                fi
                return
            fi
            if [ "$kind" = prefer ]; then                            # any, this machine, the saved machines (← → or space)
                local opts=(any "$HOST") lb2 n2 cur3 i2 _id _h _p _e
                while IFS=$US read -r _id lb2 _h _p _e; do lb2=${lb2//[[:cntrl:]]/}; [ -n "$lb2" ] && [ "$lb2" != "$HOST" ] && opts[${#opts[@]}]=$lb2; done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
                cfg_var cur3 "$key" any; n2=${#opts[@]}
                for (( i2 = 0; i2 < n2; i2++ )); do [ "${opts[$i2]}" = "$cur3" ] && break; done; [ "$i2" -ge "$n2" ] && i2=0
                if [ "$k" = LEFT ]; then i2=$(( (i2 + n2 - 1) % n2 )); else i2=$(( (i2 + 1) % n2 )); fi
                cfg_set "$key" "${opts[$i2]}"; return
            fi
            if [ "$kind" = link ]; then [ "$k" = LEFT ] || { [ "$key" = SETUP ] && SETTINGS_GO=setup || SETTINGS_GO=hotkeys; }; return; fi
            if [ "$kind" = enum ]; then                              # step through the allowed values
                setting_row "$key"; local vals cur2 nxt="" prev="" first="" last="" found=0 x IFS=:
                vals=${S_TYPE#enum:}; cfg_var cur2 "$key" "$S_DEF"
                for x in $vals; do [ -z "$first" ] && first=$x; [ "$found" = 1 ] && [ -z "$nxt" ] && nxt=$x; [ "$x" = "$cur2" ] && { found=1; prev=$last; }; last=$x; done
                unset IFS; [ -z "$nxt" ] && nxt=$first; [ -z "$prev" ] && prev=$last
                if [ "$k" = LEFT ]; then cfg_set "$key" "$prev"; else cfg_set "$key" "$nxt"; fi; : > "$STORE_DIRTY"; return
            fi
            [ "$k" = LEFT ] || [ "$k" = RIGHT ] || case "$kind" in
                bool) setting_row "$key"; cur=${S_DEF:-off}
                      [ "$(cfg_get "$key" $cur)" = on ] && cfg_set "$key" off || cfg_set "$key" on ;;
                machine) off=$(cfg_get MACHINES_OFF '')
                      case ",$off,"  in
                          *",$key,"*) local x out="" IFS=,; for x in $off; do [ "$x" = "$key" ] || out=${out:+$out,}$x; done; unset IFS
                                      cfg_set MACHINES_OFF "$out" ;;
                          *) cfg_set MACHINES_OFF "${off:+$off,}$key" ;;
                      esac ;;
            esac ;;
    esac
}

# ── the animation. A background ticker only DECIDES which picture is due (eyes open or closed, tongue out or in) and tells
# the main loop with USR1; the main loop is the only one that writes to the screen, so two writers can never mix their
# escape sequences. It redraws just the dog, at an absolute position, so nothing flickers.
ANIM_FILE="$RUN_DIR/anim"
SPIN_FRAMES=("·" "✢" "✳" "✶" "✻" "✽" "✻" "✶" "✳" "✢")       # Claude Code's spinner, there and back
spin_cells() {  # SPIN_CELLS = "row:col ..." of the busy agents' icons in the frame just drawn (from the agent map)
    local div split line r l rr rest st; SPIN_CELLS=""
    div=$(num_or "$(cat "$RUN_DIR/divrow" 2>/dev/null)" 0); [ "$div" -gt 0 ] || return 0
    { IFS= read -r split; split=$(num_or "$split" 0)
      while IFS=$'\036' read -r r l rr; do
          for line in "l:$l" "r:$rr"; do
              rest=${line#?:}; [ -n "$rest" ] || continue; st=${rest##*$US}
              case "$st" in working|testing) ;; *) continue ;; esac
              if [ "${line%%:*}" = l ]; then SPIN_CELLS="$SPIN_CELLS $(( div + 2 + r )):3"; else SPIN_CELLS="$SPIN_CELLS $(( div + 2 + r )):$(( split + 1 ))"; fi
          done
      done; } < "$RUN_DIR/agmap" 2>/dev/null
}
dog_ticker() {  # dog_ticker <main pid>
    local tick=0 closed tin idx last="" blink bl_last="" _an
    while true; do
        sleep 0.3; tick=$(( tick + 1 ))
        kill -0 "$1" 2>/dev/null || exit 0
        blink=on; [ $(( (tick / 2) % 2 )) -eq 1 ] && blink=off
        closed=0; [ $(( RANDOM % 14 )) -eq 0 ] && closed=1
        tin=0; [ $(( tick % 9 )) -ge 6 ] && tin=1
        idx=$(( closed + 2 * tin ))
        cfg_var _an ANIMATION on; [ "$_an" = on ] || { idx=0; tick=0; }
        [ "$idx $blink $tick" = "$last" ] && continue           # (the tick: the star of the busy agents dances on every one)
        last="$idx $blink $tick"; echo "$idx $blink $tick" > "$ANIM_FILE"; kill -USR1 "$1" 2>/dev/null || exit 0
    done
}
dog_animate() {  # the main loop's answer to USR1 (only on the splash and the list); draws only what changed
    local idx blink tick c
    [ "$TOO_SMALL" = 1 ] && return 0
    [ "$1" = splash ] && ! splash_fits && return 0
    read -r idx blink tick < "$ANIM_FILE" 2>/dev/null || { idx=0; blink=on; tick=0; }
    case "$1" in
        splash) if [ "$idx" != "${DRAWN_IDX:-}" ]; then DOG_IDX=$idx; dog_at big $(( 4 + SG0 )) $(( 2 + (WIDTH - 2 - DOG_W) / 2 )); DRAWN_IDX=$idx; fi
                if [ "$blink" != "${DRAWN_BLINK:-}" ]; then splash_prompt_at "$blink"; DRAWN_BLINK=$blink; fi ;;
        main) [ -n "${SPIN_CELLS:-}" ] || return 0               # the busy agents' star, like Claude's: only its cells are drawn
              num_set tick "$tick" 0; SPIN_CH=${SPIN_FRAMES[$(( tick % ${#SPIN_FRAMES[@]} ))]}
              for c in $SPIN_CELLS; do printf '\033[%d;%dH%s%s%s' "${c%%:*}" "${c#*:}" "$ORANGE" "$SPIN_CH" "$X"; done ;;
    esac
}

# Is another byte waiting on the terminal within a few milliseconds? bash 4+ can wait 0.05 s itself; bash 3.2 (macOS) only knows
# whole seconds, so it asks perl. (A lone Esc used to wait a full second for a byte that never came.)
HAVE_PERL=""; command -v perl >/dev/null 2>&1 && HAVE_PERL=1
read_soon() {  # read_soon <var>: one more byte if it arrives within ~50 ms, else empty (rc 1)
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then IFS= read -rsn1 -t 0.05 "$1" 2>/dev/null && return 0
    elif [ -n "$HAVE_PERL" ]; then
        perl -MIO::Select -e 'exit(IO::Select->new(\*STDIN)->can_read(0.05) ? 0 : 1)' </dev/tty 2>/dev/null \
            && IFS= read -rsn1 -t 1 "$1" 2>/dev/null && return 0
    else IFS= read -rsn1 -t 1 "$1" 2>/dev/null && return 0; fi
    printf -v "$1" '%s' ""; return 1
}
ask_drain() {  # throw away input that is still waiting (the rest of a multi-line paste): it must not turn into commands
    local _j
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then while IFS= read -rsn1 -t 0.05 _j </dev/tty 2>/dev/null; do :; done
    elif [ -n "$HAVE_PERL" ]; then
        perl -MIO::Select -e '$s = IO::Select->new(\*STDIN); while ($s->can_read(0.05)) { sysread(STDIN, $b, 4096) or last }' </dev/tty 2>/dev/null
    fi
    return 0
}
# The divider above the agents is a handle like herdr's sidebar split: press on it, drag, release. Its row is written by the frame
# (bhote_view runs in a subshell, so it leaves it in a file); the agent area's height is kept as AGENT_ROWS in the config.
MOUSE_ON=$'\033[?1002h\033[?1006h'; MOUSE_OFF=$'\033[?1002l\033[?1006l'; DRAG=0; DRAG_ROWS=""
mouse_event() {  # mouse_event <b;x;y> <M|m>: sets MOUSE_KEY (DRAG while the divider moves, else empty)
    local b x y div rest; MOUSE_KEY=""
    b=${1%%;*}; rest=${1#*;}; x=${rest%%;*}; y=${rest#*;}
    case "$b$x$y" in *[!0-9]*) return ;; esac
    case "$b" in 64|65|66|67) return ;; esac                 # the wheel does nothing (it must not move the selection)
    div=$(cat "$RUN_DIR/divrow" 2>/dev/null); div=$(num_or "$div" 0)
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$DRAG" != 1 ] && [ "$div" -gt 0 ] && [ "$y" -ge $(( div + 2 )) ]; then   # below the FREE/BUSY line: an agent?
        local split rel line ag; split=$(head -1 "$RUN_DIR/agmap" 2>/dev/null); split=$(num_or "$split" 0); rel=$(( y - div - 2 ))
        line=$(awk -F'\036' -v r="$rel" 'NR > 1 && $1 == r { print; exit }' "$RUN_DIR/agmap" 2>/dev/null)
        if [ -n "$line" ] && [ "$split" -gt 0 ]; then
            if [ "$x" -le "$split" ]; then ag=$(printf '%s' "$line" | cut -d$'\036' -f2); else ag=$(printf '%s' "$line" | cut -d$'\036' -f3); fi
            [ -n "$ag" ] && { CLICK_M=${ag%%$US*}; CLICK_P=${ag#*$US}; CLICK_P=${CLICK_P%%$US*}; MOUSE_KEY=AGENT; return; }
        fi
    fi
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$y" = "$div" ]; then
        DRAG=1; DRAG_Y0=$y; DRAG_R0=$(num_or "$(cat "$RUN_DIR/agrows" 2>/dev/null)" 1); return
    fi
    if [ "$DRAG" = 1 ] && [ "$2" = M ] && [ "$b" = 32 ]; then       # moving with the button held: up = more agent rows
        DRAG_ROWS=$(( DRAG_R0 + DRAG_Y0 - y )); [ "$DRAG_ROWS" -lt 1 ] && DRAG_ROWS=1; MOUSE_KEY=DRAG; return
    fi
    if [ "$DRAG" = 1 ] && [ "$2" = m ]; then
        DRAG=0; [ -n "$DRAG_ROWS" ] && cfg_set AGENT_ROWS "$(agent_rows_clamp "$DRAG_ROWS")"; DRAG_ROWS=""; MOUSE_KEY=DRAG
    fi
}
agent_rows_clamp_set() {  # agent_rows_clamp_set <var> <n>: at least 1 agent row, and at least 4 lines stay for the topics
    local _n _max=$(( ${ROWS:-40} - 3 - 4 - 4 ))   # head 3, divider/header/rule/keys 4, topics 4
    num_set _n "$2" 1
    [ "$_max" -lt 1 ] && _max=1; [ "$_n" -gt "$_max" ] && _n=$_max; [ "$_n" -lt 1 ] && _n=1
    printf -v "$1" '%s' "$_n"
}
agent_rows_clamp() { agent_rows_clamp_set _ARC "$1"; printf '%s' "$_ARC"; }
# The one-line editor at the bottom. ←→ move, Option+←→ (also Ctrl) jump a word, Shift adds a selection (Shift+Option by words),
# Home/End or Ctrl-A/Ctrl-E (Cmd+←→), Backspace/Delete remove the selection or one character, Option+Backspace a word,
# Ctrl-U/Ctrl-K cut to the start/end. Typing replaces the selection. Enter keeps the text, Esc throws it away.
ED_BUF=""; ED_CUR=0; ED_ANC=-1                               # the text, the cursor (characters before it), the selection anchor (-1: none)
ed_word_left() {  # ED_TO = start of the word left of the cursor
    local i=$ED_CUR
    while [ "$i" -gt 0 ] && [ "${ED_BUF:$(( i - 1 )):1}" = " " ]; do i=$(( i - 1 )); done
    while [ "$i" -gt 0 ] && [ "${ED_BUF:$(( i - 1 )):1}" != " " ]; do i=$(( i - 1 )); done
    ED_TO=$i
}
ed_word_right() {  # ED_TO = end of the word right of the cursor
    local i=$ED_CUR n=${#ED_BUF}
    while [ "$i" -lt "$n" ] && [ "${ED_BUF:$i:1}" = " " ]; do i=$(( i + 1 )); done
    while [ "$i" -lt "$n" ] && [ "${ED_BUF:$i:1}" != " " ]; do i=$(( i + 1 )); done
    ED_TO=$i
}
ed_move() {  # ed_move <to> <select 0|1>
    if [ "$2" = 1 ]; then [ "$ED_ANC" -lt 0 ] && ED_ANC=$ED_CUR; else ED_ANC=-1; fi
    ED_CUR=$1; [ "$ED_CUR" -lt 0 ] && ED_CUR=0; [ "$ED_CUR" -gt "${#ED_BUF}" ] && ED_CUR=${#ED_BUF}
    [ "$ED_ANC" = "$ED_CUR" ] && ED_ANC=-1; return 0
}
ed_cut() {  # ed_cut <from> <to>: remove that range, the cursor goes to its start
    local a=$1 b=$2; [ "$a" -gt "$b" ] && { a=$2; b=$1; }
    ED_BUF="${ED_BUF:0:$a}${ED_BUF:$b}"; ED_CUR=$a; ED_ANC=-1
}
ed_cut_sel() { [ "$ED_ANC" -ge 0 ] || return 1; ed_cut "$ED_ANC" "$ED_CUR"; }
ed_insert() {  # ed_insert <text> <max>
    ed_cut_sel
    local room=$(( $2 - ${#ED_BUF} )) t=$1; [ "$room" -le 0 ] && return 0; t=${t:0:$room}
    ED_BUF="${ED_BUF:0:$ED_CUR}$t${ED_BUF:$ED_CUR}"; ED_CUR=$(( ED_CUR + ${#t} ))
}
ed_key_csi() {  # ed_key_csi <params> <final>: the cursor keys of xterm (1;2 Shift, 1;3 / 1;9 Option, 1;4 / 1;10 Shift+Option, 1;5 Ctrl)
    local p=$1 f=$2 sel=0 word=0
    case "$p" in 1\;2) sel=1 ;; 1\;3|1\;9|1\;5) word=1 ;; 1\;4|1\;10|1\;6) sel=1; word=1 ;; esac
    case "$f" in
        D) if [ "$word" = 1 ]; then ed_word_left; ed_move "$ED_TO" "$sel"
           elif [ "$sel" = 0 ] && [ "$ED_ANC" -ge 0 ]; then local a=$ED_ANC; [ "$a" -gt "$ED_CUR" ] && a=$ED_CUR; ed_move "$a" 0
           else ed_move $(( ED_CUR - 1 )) "$sel"; fi ;;
        C) if [ "$word" = 1 ]; then ed_word_right; ed_move "$ED_TO" "$sel"
           elif [ "$sel" = 0 ] && [ "$ED_ANC" -ge 0 ]; then local a=$ED_ANC; [ "$a" -lt "$ED_CUR" ] && a=$ED_CUR; ed_move "$a" 0
           else ed_move $(( ED_CUR + 1 )) "$sel"; fi ;;
        H) ed_move 0 "$sel" ;;
        F) ed_move "${#ED_BUF}" "$sel" ;;
        "~") case "$p" in 3) ed_cut_sel || ed_cut "$ED_CUR" $(( ED_CUR + 1 )) ;; 1|7) ed_move 0 0 ;; 4|8) ed_move "${#ED_BUF}" 0 ;; esac ;;
    esac
}
ask() {  # ask <label> [text to start with] [max length]: the editor on the last row -> ANSWER. Enter keeps it, Esc throws it away.
    local ch k2 k3 n p cancel=0 max=${3:-500} b
    ED_BUF=${2:-}; ED_BUF=${ED_BUF:0:$max}; ED_CUR=${#ED_BUF}; ED_ANC=-1; ASK_MAX=${3:-}
    trap '' USR1                                           # the animation must not cut the typing short
    printf '%s\033[?25h' "$MOUSE_OFF"                       # no mouse reports in the text; cursor on
    ask_draw "$1"
    while true; do
        IFS= read -rsn1 ch </dev/tty || { cancel=1; break; }   # end of input: treat as cancel
        case "$ch" in
            "") break ;;                                    # Enter
            $'\033')
                read_soon k2
                case "$k2" in
                    "") cancel=1; break ;;                  # a lone Esc: throw the entry away
                    "["|O) p=""; k3=""; n=0
                        while IFS= read -rsn1 -t 1 k3 </dev/tty && [ "$n" -lt 24 ]; do
                            case "$k3" in [0123456789\;\<\=\>\?\ \!\"\#\$\%\&\'\(\)\*\+\,\-\.\/]) p="$p$k3" ;; *) break ;; esac
                            [ "$k2" = O ] && break; n=$(( n + 1 ))
                        done
                        ed_key_csi "$p" "$k3" ;;
                    b) ed_word_left; ed_move "$ED_TO" 0 ;;   # Option+← / Option+→ as Meta (ESC b / ESC f)
                    f) ed_word_right; ed_move "$ED_TO" 0 ;;
                    $'\177'|$'\010') ed_cut_sel || { ed_word_left; ed_cut "$ED_TO" "$ED_CUR"; } ;;   # Option+Backspace: a word
                    l) ed_insert "@" "$max" ;;              # a left Option arrives as Alt: ESC l / ESC 7 are @ and | (German keyboard)
                    7) ed_insert "|" "$max" ;;
                esac ;;
            $'\177'|$'\010') ed_cut_sel || { [ "$ED_CUR" -gt 0 ] && ed_cut $(( ED_CUR - 1 )) "$ED_CUR"; } ;;
            $'\001') ed_move 0 0 ;;                         # Ctrl-A (Cmd+←)
            $'\005') ed_move "${#ED_BUF}" 0 ;;              # Ctrl-E (Cmd+→)
            $'\025') ed_cut 0 "$ED_CUR" ;;                  # Ctrl-U
            $'\013') ed_cut "$ED_CUR" "${#ED_BUF}" ;;       # Ctrl-K
            $'\027') ed_word_left; ed_cut "$ED_TO" "$ED_CUR" ;;   # Ctrl-W
            [[:cntrl:]]) ;;
            *) if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then    # bash 3.2 reads one BYTE: collect the rest of a UTF-8 character
                   LC_ALL=C printf -v b '%d' "'$ch"; [ "$b" -lt 0 ] && b=$(( b + 256 )); n=0   # bash 3.2: bytes >= 0x80 come back negative
                   [ "$b" -ge 192 ] && n=1; [ "$b" -ge 224 ] && n=2; [ "$b" -ge 240 ] && n=3
                   while [ "$n" -gt 0 ] && IFS= read -rsn1 -t 1 k3 </dev/tty; do ch="$ch$k3"; n=$(( n - 1 )); done
               fi
               ed_insert "$ch" "$max" ;;
        esac
        ask_draw "$1"
    done
    ask_drain                                               # the rest of a multi-line paste must not become commands
    printf '\033[0m\033[?25l%s' "$MOUSE_ON"; trap 'anim=1' USR1; ASK_MAX=""
    if [ "$cancel" = 1 ]; then ANSWER=""; return 1; fi
    ANSWER=${ED_BUF//[[:cntrl:]]/}; ANSWER=${ANSWER#"${ANSWER%%[! ]*}"}; ANSWER=${ANSWER%"${ANSWER##*[! ]}"}
    return 0
}
ask_draw() {  # ask_draw <label>: the prompt row with ED_BUF; the part around the cursor when it is longer than the room
    local rows=${ASK_ROW:-${ROWS:-40}} w=$(( ${COLS:-44} - 1 )) room cnt="" off a b pre mid post col lab lw
    [ -n "${ASK_MAX:-}" ] && cnt="$(( ASK_MAX - ${#ED_BUF} )) left"   # how many characters are left, on the right
    clip_set lab "$1" $(( w - 3 - ${#cnt} - 2 - 12 )); dw_set lw "$lab"   # a long label (a title in "Delete ...?") leaves room to type
    room=$(( w - 3 - lw - 1 - ${#cnt} - 1 )); [ "$room" -lt 4 ] && room=4
    off=0; [ "$ED_CUR" -gt "$room" ] && off=$(( ED_CUR - room ))   # scroll so that the cursor stays visible
    a=$ED_CUR; b=$ED_CUR; [ "$ED_ANC" -ge 0 ] && { a=$ED_ANC; [ "$a" -gt "$b" ] && { a=$ED_CUR; b=$ED_ANC; }; }
    [ "$a" -lt "$off" ] && a=$off; [ "$b" -lt "$off" ] && b=$off
    pre=${ED_BUF:$off:$(( a - off ))}; mid=${ED_BUF:$a:$(( b - a ))}; post=${ED_BUF:$b}
    post=${post:0:$(( room - ${#pre} - ${#mid} ))}
    printf '\033[%d;1H\033[2K%s%*s' "$rows" "$SELBG" "$w" ""
    [ -n "$cnt" ] && printf '\033[%d;%dH%s%s' "$rows" $(( w - ${#cnt} )) "$D" "$cnt"
    printf '\033[%d;1H%s%s▶ %s%s%s%s\033[7m%s\033[27m%s' "$rows" "$SELBG" "$ORANGE" "$L" "$lab" "$X$SELBG$L" "$pre" "$mid" "$post"
    col=$(( 3 + lw + ED_CUR - off )); printf '\033[%d;%dH' "$rows" "$col"   # "▶ " is 2 columns, the label starts in column 3
}
menu_line() {  # menu_line <selected: 1 or empty> <text>: a choice; the selected one is a bar over the whole width
    local w=$(( ${COLS:-44} - 2 )) t; clip_set t "$2" $(( w - 4 ))
    local tw; dw_set tw "$t"
    if [ -n "$1" ]; then printf '\001%s   %s%s%*s%s\n' "$SELBG" "$LSEL" "$t" $(( w - 3 - tw )) "" "$X"
    else printf '   %s%s%s\n' "$D" "$t" "$X"; fi
}
MENU_ITEMS=()                                                  # "key|label", made for the selected topic (menu_build)
menu_build() {  # menu_build <file>
    local f=$1 st ag; st=$(topic_get "$f" status now); ag=$(topic_get "$f" agent)
    MENU_ITEMS=("start|Start with agent ...")
    [ "$st" = waiting ] && [ -n "$ag" ] && [ -n "$(topic_get "$f" agent_pane)" ] && MENU_ITEMS[${#MENU_ITEMS[@]}]="resume|The wait is over: $ag goes on"
    [ -n "$ag" ] && [ -n "$(topic_get "$f" agent_pane)" ] && MENU_ITEMS[${#MENU_ITEMS[@]}]="transfer|Transfer to another agent ..."
    [ "$st" = next ] || MENU_ITEMS[${#MENU_ITEMS[@]}]="next|Up next"
    MENU_ITEMS=("${MENU_ITEMS[@]}" "wait|Waiting for ..." "later|Park for later" "done|Mark done" "rename|Rename" "describe|Describe ..." "delete|Delete" "back|Back")
}
bhote_menu() {  # the topic's page: title and description in full (wrapped), its status, then the numbered actions
    local f i st sc wf ws ag am age line sl; f=$(sel_file); [ -n "$f" ] || { printf '\n  %sno topic selected%s\n' "$D" "$X"; return; }
    menu_build "$f"
    st=$(topic_get "$f" status now); wf=$(topic_get "$f" waiting_for); ws=$(topic_get "$f" waiting_since); ag=$(topic_get "$f" agent); am=$(topic_get "$f" agent_machine)
    case "$st" in now) sc=$ORANGE ;; next) sc=$S ;; waiting) sc=$Y ;; review) sc=$BLUE ;; later) sc=$R ;; done) sc=$GREEN ;; *) sc=$D ;; esac
    printf '\n  %sTITLE%s\n' "$D" "$X"
    field_block title "$TITLE" "$(topic_get "$f" title '(untitled)')"
    printf '\n  %sDESCRIPTION%s\n' "$D" "$X"
    line=$(topic_get "$f" description); if [ -n "$line" ]; then field_block description "$DESC" "$line"; else field_block description "$D" "– (⏎ adds one)"; fi
    printf '\n  %sSTATUS%s\n' "$D" "$X"
    printf '  %s%s%s' "$sc" "$st" "$X"
    if [ "$st" = waiting ] && [ -n "$wf" ]; then ago_set age "${ws:-$NOW}"; printf ' %s·%s %s%s%s %s· %s%s' "$D" "$X" "$BLUE" "$wf" "$X" "$D" "$age" "$X"; fi
    printf '\n'
    [ -n "$ag" ] && printf '  %sagent%s %s%s%s%s\n' "$D" "$X" "$BLUE" "$(clip "$ag" $(( ${COLS:-44} - 12 )))" "$X" "${am:+ ${D}· $am$X}"
    printf '\n'; rule
    printf '\n  %sACTIONS%s\n' "$D" "$X"
    for (( i = 0; i < ${#MENU_ITEMS[@]}; i++ )); do
        sl=""; [ "$i" = "${MENU_IDX:-0}" ] && sl=1
        menu_num_line "$sl" "$(( i + 1 ))" "${MENU_ITEMS[$i]#*|}"
    done
    printf '\n'; rule
    printf '  %s%s%s\n' "$D" "$(clip "↑↓ 1-9 choose · ⏎ do it / edit · esc back" $(( ${COLS:-44} - 4 )))" "$X"
}
# Title and description on the topic page are choices, too (MENU_IDX -2 and -1, above the actions): on the bar when chosen,
# and edited in place (EDIT_FIELD): the field is then one line, marked with \002 so that bhote_paint knows its row (EDIT_ROW)
# and the editor opens right there.
field_block() {  # field_block <title|description> <colour> <text>
    local l w=$(( ${COLS:-44} - 2 )) lw mk="" sel="" first=1
    case "$1:${MENU_IDX:-0}" in title:-2|description:-1) sel=1; mk=$'\001' ;; esac
    if [ "${EDIT_FIELD:-}" = "$1" ]; then printf '%s\002%s%*s%s\n' "$mk" "$SELBG" "$w" "" "$X"; return; fi
    while IFS= read -r l; do
        l=${l//$X/}
        if [ -n "$sel" ]; then dw_set lw "$l"; printf '%s%s%s%s%*s%s\n' "$mk" "$SELBG" "$LSEL" "$l" $(( w - lw )) "" "$X"; mk=""
        else printf '%s%s%s\n' "$2" "$l" "$X"; fi
    done <<< "$(wrap_print 2 "" "$3")"
}
menu_edit_field() {  # menu_edit_field <title|description>: the editor where the field stands; Enter keeps, Esc throws away
    local f fld=$1 cur; f=$(sel_file); [ -n "$f" ] || return 0
    cur=$(topic_get "$f" "$fld")
    EDIT_FIELD=$fld; EDIT_ROW=""; bhote_paint menu
    if [ "$fld" = title ]; then ASK_ROW=$EDIT_ROW ask "" "$cur" && [ -n "$ANSWER" ] && topic_set "$f" title "$ANSWER"
    else ASK_ROW=$EDIT_ROW ask "" "$cur" "$DESC_MAX" && topic_set "$f" description "$ANSWER"; fi
    EDIT_FIELD=""; EDIT_ROW=""
}
menu_num_line() {  # menu_num_line <selected 1|""> <number> <text>: an action with its number key; the selected one on the bar
    local w=$(( ${COLS:-44} - 2 )) t; clip_set t "$3" $(( w - 6 ))
    if [ -n "$1" ]; then printf '%s  %s%s%s  %s%s%*s%s\n' "$SELBG" "$C" "$2" "$X$SELBG" "$LSEL" "$t" $(( w - 5 - ${#t} )) "" "$X"
    else printf '  %s%s%s  %s%s%s\n' "$C" "$2" "$X" "$L" "$t" "$X"; fi
}
# ── suggestions: what the running agents work on (the "task" of each agent pane) and is not a topic yet. "a" lists them; adopting one
# makes it a topic that is already assigned to that agent. "x" dismisses one for good (kept in $DATA_DIR/dismissed).
SUG_MAP=(); SUG_IDX=0
eq_ci() { local r=1; shopt -s nocasematch; [[ $1 == "$2" ]] && r=0; shopt -u nocasematch; return $r; }
suggest_build() {  # SUG_MAP = indexes into AG_LINES of agents whose task is neither a topic nor assigned nor dismissed
    local i m id st name task t known line; SUG_MAP=()
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        [ -n "$task" ] || continue
        known=0
        for (( t = 0; t < T_N; t++ )); do
            [ "${T_STATUS[$t]}" = done ] && continue
            if [ "${T_AM[$t]}" = "$m" ] && [ "${T_AP[$t]}" = "$id" ]; then known=1; break; fi
            eq_ci "${T_TITLE[$t]}" "$task" && { known=1; break; }
        done
        [ "$known" = 0 ] && [ -r "$DATA_DIR/dismissed" ] && while IFS= read -r line; do [ "$line" = "$m|$id|$task" ] && { known=1; break; }; done < "$DATA_DIR/dismissed"
        [ "$known" = 0 ] && SUG_MAP[${#SUG_MAP[@]}]=$i
    done
}
bhote_suggest() {
    local i m id st name task sl
    printf '\n %sFrom running agents%s\n %sTheir tasks that are no topic yet%s\n' "$L" "$X" "$D" "$X"
    rule; printf '\n'
    suggest_build
    for (( i = 0; i < ${#SUG_MAP[@]}; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[${SUG_MAP[$i]}]}"
        sl=0; [ "$i" = "$SUG_IDX" ] && sl=1
        topic_item "$sl" "$D" "" "$TITLE" "$task" "" "$name" "$m" 0
    done
    [ "${#SUG_MAP[@]}" -gt 0 ] || printf '   %snothing to suggest%s\n' "$D" "$X"
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ add as topic%s\n %sx dismiss · ←/esc back%s\n' "$D" "$X" "$D" "$X"
}
suggest_do() {  # suggest_do <adopt|dismiss> <index>
    local m id st name task f
    suggest_build; [ -n "${SUG_MAP[$2]:-}" ] || return 0
    IFS=$US read -r m id st name task <<< "${AG_LINES[${SUG_MAP[$2]}]}"
    if [ "$1" = dismiss ]; then printf '%s|%s|%s\n' "$m" "$id" "$task" >> "$DATA_DIR/dismissed"; return 0; fi
    topic_new "$task" "" "" || return 0
    f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"; SEL_ID=$NEW_TOPIC_ID
    topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
}
# ── the picker: "Start" asks which free agent takes the topic. Free = idle or done; entry 0 only marks the topic as started.
PICK_MAP=(); PICK_IDX=0
agent_taken() {  # agent_taken <machine> <pane>: already working on another open topic
    local _t; for (( _t = 0; _t < T_N; _t++ )); do
        [ "${T_STATUS[$_t]}" = now ] && [ "${T_AM[$_t]}" = "$1" ] && [ "${T_AP[$_t]}" = "$2" ] && [ "${T_ID[$_t]}" != "${SEL_ID:-}" ] && return 0
    done; return 1
}
PICK_MODE=start
pick_build() {  # PICK_MAP = indexes into AG_LINES of the free agents (for a transfer: not the agent that has the topic now)
    local i m id st name task sm="" sp="" f; PICK_MAP=()
    if [ "$PICK_MODE" = transfer ]; then f=$(sel_file); [ -n "$f" ] && { sm=$(topic_get "$f" agent_machine); sp=$(topic_get "$f" agent_pane); }; fi
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        [ -n "$sp" ] && [ "$m" = "$sm" ] && [ "$id" = "$sp" ] && continue
        case "$st" in idle|done) agent_taken "$m" "$id" || PICK_MAP[${#PICK_MAP[@]}]=$i ;; esac
    done
}
pick_first() { [ "$PICK_MODE" = transfer ] && echo 1 || echo 0; }   # the first entry: 0 = "just mark as started", 1 = an agent
bhote_pick() {
    local f i k m id st name task title n=0 label sl
    f=$(sel_file); [ -n "$f" ] || { printf '\n  %sno topic selected%s\n' "$D" "$X"; return; }
    clip_set title "$(topic_get "$f" title '(untitled)')" $(( ${COLS:-44} - 8 ))
    printf '\n %s▸ %s%s\n %s%s%s\n' "$ORANGE" "$L$title" "$X" "$D" "$([ "$PICK_MODE" = transfer ] && echo "Transfer to which agent?" || echo "Who takes it?")" "$X"
    rule; printf '\n'
    pick_build
    for (( i = $(pick_first); i <= ${#PICK_MAP[@]}; i++ )); do
        if [ "$i" = 0 ]; then label="Just mark as started"
        else
            IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( i - 1 ))]}]}"
            label="$m · $name"; [ "$st" = done ] && label="$label ✓"
        fi
        clip_set label "$label" $(( ${COLS:-44} - 8 ))
        sl=""; [ "$i" = "$PICK_IDX" ] && sl=1; menu_line "$sl" "$label"
    done
    [ "${#PICK_MAP[@]}" -gt 0 ] || printf '\n   %sno free agent right now%s\n' "$D" "$X"
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ start · ←/esc back%s\n' "$D" "$X"
}
# ── talking to agents: the live state of one agent pane, and a prompt to it (both through herdr, --machine for other machines)
machine_known() {  # machine_known <label>: this machine, or a machine saved in herdr (a label from another machine's view is not)
    [ -n "$1" ] || return 1; [ "$1" = "$HOST" ] && return 0
    herdr machine list 2>/dev/null | awk -F'\t' -v l="$1" '$2 == l { f = 1 } END { exit !f }'
}
agent_live() {  # agent_live <machine> <pane>: LIVE_ST (idle|done|working|blocked|gone|noagent|unknown), LIVE_SESS, LIVE_CWD
    local opt=() out; LIVE_SESS=""; LIVE_CWD=""
    machine_known "$1" || { LIVE_ST=unknown; return 0; }
    [ "$1" = "$HOST" ] || opt=(--machine "$1")
    out=$(herdr "${opt[@]}" pane list 2>/dev/null | jq -r --arg p "$2" '[.result.panes[] | select(.pane_id == $p)][0]
        | if . == null then "gone" elif (.agent // "") == "" then "noagent" else
          [(.agent_status // ""), ((.agent_session.value // "") | tostring | gsub("[^A-Za-z0-9-]"; "")), ((.foreground_cwd // .cwd // "") | tostring | gsub("[\u0001-\u001f]"; ""))] | join("\u001f") end' 2>/dev/null)
    LIVE_ST=${out%%$US*}; LIVE_SESS=""; LIVE_CWD=""
    case "$out" in *"$US"*) out=${out#*$US}; LIVE_SESS=${out%%$US*}; LIVE_CWD=${out#*$US} ;; esac
    [ -n "$LIVE_ST" ] || LIVE_ST=gone
}
AGENT_SEND_SYNC=""                                              # the CLI waits for herdr and reports a failure; the panel does not wait
agent_send() {  # agent_send <machine> <pane> <text>: a prompt to that agent
    local opt=(); machine_known "$1" || return 1; [ "$1" = "$HOST" ] || opt=(--machine "$1")
    case "$2" in ''|*[!A-Za-z0-9:_-]*) return 1 ;; esac
    if [ -n "$AGENT_SEND_SYNC" ]; then
        herdr "${opt[@]}" agent prompt "$2" "${3//[[:cntrl:]]/ }" >/dev/null 2>&1 || { echo "bhote: herdr could not send the prompt to $1/$2" >&2; return 1; }
    else ( herdr "${opt[@]}" agent prompt "$2" "${3//[[:cntrl:]]/ }" >/dev/null 2>&1 ) & fi
}
how_to_finish() {  # how_to_finish <id>: the sentence every agent gets about reporting back
    local h="when you are finished, run \`bhote review $1\` so that I check it"
    [ "$(cfg_get AGENT_CAN_CLOSE on)" = on ] && h="$h, or \`bhote done $1\` when nothing needs checking"
    printf '%s' "$h"
}

# ── Steal & Transfer: an agent stops, commits its state on its branch with a handover in the commit message, and another
# (free) agent takes over that branch. bhote transfer starts it; the source agent reports with bhote handover; then the
# target agent gets the topic. The topic remembers both ends while it travels (transfer_* keys).
transfer_start() {  # transfer_start <topic file> <from machine> <from pane> <from name> <to machine> <to pane> <to name>
    local f=$1 id title to_ref
    agent_live "$5" "$6"; case "$LIVE_ST" in idle|done) ;; *) echo "bhote: $7 is not free ($LIVE_ST)" >&2; return 1 ;; esac
    local to_cwd=$LIVE_CWD
    agent_live "$2" "$3"; case "$LIVE_ST" in
        gone|noagent) echo "bhote: $4 is no agent any more" >&2; return 1 ;;
        blocked) echo "bhote: $4 is waiting for an answer (permission?): answer it first" >&2; return 1 ;;
        unknown) echo "bhote: $2 is not a machine herdr knows here" >&2; return 1 ;;
    esac
    id=$(topic_id "$f"); title=$(topic_get "$f" title); to_ref="$5/$6"
    local undo; undo=$(mktemp "$RUN_DIR/undo.XXXXXX") && cp "$f" "$undo"
    topic_set "$f" status now; topic_set "$f" waiting_for ""
    topic_set "$f" transfer_to "$to_ref"; topic_set "$f" transfer_to_name "$7"; topic_set "$f" transfer_from "$2/$3"
    topic_set "$f" agent "$4"; topic_set "$f" agent_machine "$2"; topic_set "$f" agent_pane "$3"
    if ! agent_send "$2" "$3" "Steal & Transfer (bhote topic $id: $title): stop here and hand this work over to $7. 1) Commit everything on your current branch (do not create a new branch; only on a detached HEAD create one: git switch -c bhote-$id); put a handover into the commit message body: the goal, what is done, what is open, the next steps, how to test. 2) If the repository has a remote, push the branch. 3) Note the branch and the commit: b=\$(git rev-parse --abbrev-ref HEAD); c=\$(git rev-parse HEAD). 4) If ${to_cwd:-the folder of the other agent} is another worktree of this repository, free the branch with git switch --detach. 5) Run: bhote handover $id --to '$to_ref' --branch \"\$b\" --commit \"\$c\". Then stop."; then
        [ -s "$undo" ] && cp "$undo" "$f" && topic_set "$f" transfer_to ""     # back as it was (newer, so that it wins a merge)
        rm -f "$undo"; return 1
    fi
    rm -f "$undo"; : > "$STORE_DIRTY"
}
transfer_finish() {  # transfer_finish <topic file> <to machine/pane> <branch> <commit>: the target agent takes over
    local f=$1 id title tm tp name from b c
    id=$(topic_id "$f"); title=$(topic_get "$f" title); tm=${2%%/*}; tp=${2#*/}
    name=$(topic_get "$f" transfer_to_name "$tp"); from=$(topic_get "$f" agent "the other agent")
    b=${3//[!A-Za-z0-9._\/-]/}; c=${4//[!A-Za-z0-9]/}
    agent_live "$tm" "$tp"; case "$LIVE_ST" in gone|noagent|unknown) echo "bhote: $name is no agent any more" >&2; return 1 ;; esac
    local get="git switch $b"; case "$b" in ''|HEAD) get="git switch --detach ${c:-<commit>}" ;; esac   # no branch: the commit itself
    # first the prompt: when it does not arrive, the topic stays with the transfer (the handover can be run again)
    agent_send "$tm" "$tp" "Steal & Transfer: take over \"$title\" (bhote topic $id) from $from. The work is on branch ${b:-?} (commit ${c:0:12}): if there is a remote, git fetch; then $get; read the handover with git log -1 ${c:-HEAD}; then continue the work. $(how_to_finish "$id")." || return 1
    topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$tm"; topic_set "$f" agent_pane "$tp"; topic_set "$f" agent_session "$LIVE_SESS"
    topic_set "$f" delegated "$(date +%s)"; topic_set "$f" status now
    topic_set "$f" transfer_to ""; topic_set "$f" transfer_to_name ""; topic_set "$f" transfer_from ""
    topic_set "$f" handover_branch "$b"; topic_set "$f" handover_commit "$c"
    notify "Transferred" "$title → $name" done
    : > "$STORE_DIRTY"
}
delegation_text() {  # delegation_text <file>: the prompt an agent gets: the topic, and how it reports back
    local f=$1 id title desc how
    id=$(topic_id "$f"); title=$(topic_get "$f" title); desc=$(topic_get "$f" description)
    printf '%s%s (bhote topic %s: %s.)' "$title" "${desc:+. $desc}" "$id" "$(how_to_finish "$id")"
}
pick_do() {  # pick_do <index>: hand the topic to that agent (as a prompt through herdr) and mark it started; or transfer it
    local f m id st name task opt=() title desc live sess; f=$(sel_file); [ -n "$f" ] || return 0
    if [ "$PICK_MODE" = transfer ]; then
        [ "$1" -ge 1 ] || return 0                                  # (index -1 would be the LAST agent in bash 4)
        pick_build; [ -n "${PICK_MAP[$(( $1 - 1 ))]:-}" ] || return 0
        IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( $1 - 1 ))]}]}"
        transfer_start "$f" "$(topic_get "$f" agent_machine)" "$(topic_get "$f" agent_pane)" "$(topic_get "$f" agent agent)" "$m" "$id" "$name" 2>/dev/null
        return 0
    fi
    if [ "$1" -gt 0 ]; then
        pick_build
        [ -n "${PICK_MAP[$(( $1 - 1 ))]:-}" ] || return 0
        IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( $1 - 1 ))]}]}"
        agent_state_set st "$m" "$id"; case "$st" in idle|done) ;; *) return 0 ;; esac     # taken in the meantime: change nothing
        [ "$m" = "$HOST" ] || opt=(--machine "$m")
        # the lists are a few seconds old: right before typing, ask herdr itself that this pane still runs a FREE agent
        # (a pane that is now a plain shell would execute the text)
        live=$(herdr "${opt[@]}" pane list 2>/dev/null | jq -r --arg p "$id" '[.result.panes[] | select(.pane_id == $p)][0] | if . == null then "gone" elif (.agent // "") == "" then "noagent" else ((.agent_status // "") + "\u001f" + ((.agent_session.value // "") | tostring | gsub("[^A-Za-z0-9-]"; ""))) end' 2>/dev/null)
        st=${live%%$US*}; sess=""; case "$live" in *"$US"*) sess=${live#*$US} ;; esac
        case "$st" in idle|done) ;; *) return 0 ;; esac
    fi
    topic_set "$f" status now; topic_set "$f" waiting_for ""
    if [ "$1" -gt 0 ]; then
        topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
        topic_set "$f" agent_session "$sess"; topic_set "$f" delegated "$(date +%s)"
        agent_send "$m" "$id" "Your bhote topic: $(delegation_text "$f")"
    else
        local k; for k in agent agent_machine agent_pane agent_session delegated; do topic_set "$f" "$k" ""; done
    fi
    : > "$STORE_DIRTY"
}
menu_do() {  # menu_do <index>: run the chosen action on the selected topic; 0 = stay in the menu, 1 = leave it
    local f k; f=$(sel_file); [ -n "$f" ] || return 1
    menu_build "$f"; k=${MENU_ITEMS[$1]%%|*}
    case "$k" in
        start) PICK_MODE=start; PICK_IDX=0; view=pick; return 0 ;;     # the picker of free agents (view is bhote_main's variable)
        transfer) PICK_MODE=transfer; PICK_IDX=1; view=pick; return 0 ;;
        resume) topic_resume "$f" ;;
        wait) ask "Waiting for: " "$(topic_get "$f" waiting_for)"; [ -n "$ANSWER" ] || return 0
           topic_set "$f" status waiting; topic_set "$f" waiting_for "$ANSWER"; topic_set "$f" waiting_since "$(date +%s)" ;;
        next) topic_set "$f" status next ;;
        later) topic_set "$f" status later ;;
        done) topic_set "$f" status done ;;
        rename) ask "Title: " "$(topic_get "$f" title)" || return 0; [ -n "$ANSWER" ] && topic_set "$f" title "$ANSWER"; [ -n "$ANSWER" ] || return 0 ;;
        describe) ask "Description: " "$(topic_get "$f" description)" "$DESC_MAX" || return 0     # Esc keeps the old text; an emptied line removes it
           topic_set "$f" description "$ANSWER" ;;
        delete) ask "Delete \"$(topic_get "$f" title)\"? y/N: "; [ "$ANSWER" = y ] || [ "$ANSWER" = Y ] || return 0
           topic_set "$f" deleted 1; SEL_ID="" ;;
        *) ;;
    esac
    return 1
}
topic_resume() {  # topic_resume <file>: a waiting topic of an agent: the wait is over, the agent goes on (a prompt through herdr)
    local f=$1 id title wf desc am ap ag
    id=$(topic_id "$f"); title=$(topic_get "$f" title); wf=$(topic_get "$f" waiting_for); desc=$(topic_get "$f" description)
    am=$(topic_get "$f" agent_machine); ap=$(topic_get "$f" agent_pane); ag=$(topic_get "$f" agent)
    topic_set "$f" status now; topic_set "$f" waiting_for ""; topic_set "$f" delegated "$(date +%s)"
    [ -n "$ap" ] || return 0
    agent_live "$am" "$ap"; case "$LIVE_ST" in gone|noagent) echo "bhote: ${ag:-the agent} is not there any more" >&2; return 0 ;; esac
    agent_send "$am" "$ap" "The wait is over${wf:+ ($wf)}: $title${desc:+. Go on with: $desc} (bhote topic $id: $(how_to_finish "$id"))."
}
prompt_new_topic() {  # [text to start with] "Title", "Title; description", "Title @Name" or "Title > Name" (= waiting for Name); the new topic gets selected
    ask "Topic: " "${1:-}" || return 1
    new_topic_from "$ANSWER"
}
new_topic_from() {  # new_topic_from <text>: the same syntax as the prompt, without asking; NEW_TOPIC_ID, and it gets selected
    local title=$1 who="" desc=""
    case "$title" in *" @"*) who=${title##* @}; title=${title% @*} ;; *" > "*) who=${title##* > }; title=${title% > *} ;; esac   # the name goes last
    case "$title" in *";"*) desc=${title#*;}; title=${title%%;*} ;; esac
    title=${title%"${title##*[! ]}"}; desc=${desc#"${desc%%[! ]*}"}
    topic_new "$title" "$who" "$desc" && SEL_ID=$NEW_TOPIC_ID
}

# ── run. BHOTE_ONCE=1 prints a view once and exits (BHOTE_VIEW=splash|main|settings picks it); otherwise it runs as a panel:
# the start screen first, any key moves on to the topic list (the dog shrinks), "s" shows the start screen again, "," the
# settings, "q" quits. On a short terminal it starts with the list. The window title says "Bhote" so that herdr's
# autostart can tell that it is there.
# The panel works between MIN and MAX columns: wider than MAX it uses only the left MAX columns, narrower than MIN (or shorter
# than MIN_ROWS) it shows a hint instead of a broken picture. The start screen is a fixed picture (WIDTH x SPLASH_ROWS):
# where it does not fit, the list is shown instead.
MIN_COLS=${BHOTE_MIN_COLS:-30}; MAX_COLS=${BHOTE_MAX_COLS:-$(num_or "$(cfg_get PANEL_MAX_WIDTH 60)" 60)}; MIN_ROWS=${BHOTE_MIN_ROWS:-20}; SPLASH_ROWS=39; TOO_SMALL=0
splash_fits() { [ "${REAL_COLS:-44}" -ge "$SPLASH_W" ] && [ "${REAL_ROWS:-40}" -ge "$SPLASH_ROWS" ]; }
# The start screen fills the pane: the frame is as wide and as high as the pane; the extra width centres the content, the extra
# height becomes space between the sections (all of it above the prompt, so the keys stay on the bottom edge).
SG0=1; SG1=1; SG2=1; SG3=1; SG4=1; SPLASH_E=0
splash_geometry() {
    local e q r
    WIDTH=${REAL_COLS:-44}; [ "$WIDTH" -lt "$SPLASH_W" ] && WIDTH=$SPLASH_W; INNER=$(( WIDTH - 2 ))
    e=$(( ${REAL_ROWS:-40} - SPLASH_ROWS )); [ "$e" -lt 0 ] && e=0; SPLASH_E=$e
    # five gaps (under the greeting, the dog, the wordmark, the prompt, the info), each one line plus an equal share of the rest
    q=$(( e / 5 )); r=$(( e % 5 ))
    SG0=$(( 1 + q + (r > 0) )); SG1=$(( 1 + q + (r > 1) )); SG2=$(( 1 + q + (r > 2) )); SG3=$(( 1 + q + (r > 3) )); SG4=$(( 1 + q ))
    SPLASH_PROMPT_ROW=$(( 28 + SG0 + SG1 + SG2 ))
}
term_size() {
    local sz; sz=$(stty size </dev/tty 2>/dev/null); REAL_COLS=${sz#* }; REAL_ROWS=${sz% *}; REAL_COLS=${REAL_COLS:-44}; REAL_ROWS=${REAL_ROWS:-40}
    TOO_SMALL=0; { [ "$REAL_COLS" -lt "$MIN_COLS" ] || [ "$REAL_ROWS" -lt "$MIN_ROWS" ]; } && TOO_SMALL=1
    COLS=$REAL_COLS; [ "$COLS" -gt "$MAX_COLS" ] && COLS=$MAX_COLS; [ "$COLS" -lt "$MIN_COLS" ] && COLS=$MIN_COLS
    ROWS=$REAL_ROWS; splash_geometry
    RULE_LINE=$(hline $(( COLS - 5 ))); DASH_LINE=$(dline $(( COLS - 5 )))
}
harden_perms() {  # data, config and their folders: this user only (older versions created them open)
    mkdir -p "$TOPIC_DIR" "$(dirname "$CONFIG_FILE")" 2>/dev/null
    chmod 700 "$DATA_DIR" "$TOPIC_DIR" "$(dirname "$CONFIG_FILE")" 2>/dev/null
    [ -f "$CONFIG_FILE" ] && chmod 600 "$CONFIG_FILE" 2>/dev/null
    return 0
}
# ── the setup wizard. On the first start of every machine it opens by itself (once; one panel only), later from the settings
# ("Setup wizard") or as `bhote setup`. Every step explains itself and asks first; Enter takes the [default], s skips a step,
# q ends the setup. It never asks for a password: when ssh needs one, ssh asks for it itself, and bhote never sees it.
W_STEPS=9; W_QUIT=0
W_LOG="$DATA_DIR/setup.log"                                   # what the wizard did and saw: every check, every command and its output
w_log() { mkdir -p "$DATA_DIR" 2>/dev/null; printf '%s %s\n' "$(date '+%F %T')" "${*//[[:cntrl:]]/}" >> "$W_LOG" 2>/dev/null; }
w_width() { W=$(( ${COLS:-44} - 4 )); [ "$W" -lt 26 ] && W=26; [ "$W" -gt 72 ] && W=72; }
w_screen() {  # w_screen <step> <TITLE>: a clean screen with the progress dots and the step's caption
    local i dots=""; w_width
    for (( i = 1; i <= W_STEPS; i++ )); do
        if [ "$i" -lt "$1" ]; then dots="$dots${GREEN}●${X}"; elif [ "$i" = "$1" ]; then dots="$dots${C}●${X}"; else dots="$dots${D}○${X}"; fi
    done
    printf '\033[H\033[2J\n  %s%s\n  %s\n  %s\n\n  %s%s%s  %sstep %d of %d%s\n\n' "${HEAD_GRAD:-${L}Bhote setup}" "$X" "$B$(hline "$W")$X" "$dots" "$R" "$2" "$X" "$D" "$1" "$W_STEPS" "$X"
    w_log "== step $1: $2"
}
w_say() { local col=${2:-$D} COLS=$(( W + 4 )); wrap_print 2 "$col" "$1"; }          # a paragraph, wrapped at the left edge
w_mark() {  # w_mark <colour> <mark> <name> <detail>: aligned check lines (mark, name in 16 columns, detail cut to the edge)
    local n d; clip_set n "$3" 16; pad_set n "$n" 16; clip_set d "${4:-}" $(( W - 19 )); w_log "$2 $3: ${4:-}"
    printf '  %s%s%s %s %s%s%s\n' "$1" "$2" "$X" "$n" "$D" "$d" "$X"
}
w_ok()   { w_mark "$GREEN" "✓" "$@"; }
w_bad()  { w_mark "$NN" "✗" "$@"; }
w_warn() { w_mark "$Y" "!" "$@"; }
w_opt()  { local COLS=$(( W + 4 )); printf '  %s%s%s' "$C" "$1" "$X"; wrap_print 5 "$L" "$2" | sed '1s/^   //'; }   # a numbered choice
w_line() { printf '\n'; }
w_read() {  # w_read <var> <prompt> [default]: one answer (cooked terminal); q ends the wizard
    local __wr_a __wr_q __wr_w __wr_line="" __wr_first=1 __wr_room=$(( W - 2 ))
    local __wr_ws; read -r -a __wr_ws <<< "$2"                 # split into words (no globbing: a * in the text stays a *)
    printf '\n'
    for __wr_w in ${__wr_ws[@]+"${__wr_ws[@]}"}; do             # word wrap: the first line after "▶ ", the others under the text
        if [ -z "$__wr_line" ]; then __wr_line=$__wr_w
        elif [ $(( ${#__wr_line} + 1 + ${#__wr_w} )) -le "$__wr_room" ]; then __wr_line="$__wr_line $__wr_w"
        else
            if [ "$__wr_first" = 1 ]; then printf '  %s▶%s %s%s%s\n' "$C" "$X" "$L" "$__wr_line" "$X"; __wr_first=0; else printf '    %s%s%s\n' "$L" "$__wr_line" "$X"; fi
            __wr_line=$__wr_w
        fi
    done
    __wr_q="${3:+[$3]}"; [ $(( ${#__wr_line} + 1 + ${#__wr_q} )) -gt "$__wr_room" ] && { if [ "$__wr_first" = 1 ]; then printf '  %s▶%s %s%s%s\n' "$C" "$X" "$L" "$__wr_line" "$X"; else printf '    %s%s%s\n' "$L" "$__wr_line" "$X"; fi; __wr_first=0; __wr_line=""; }
    if [ "$__wr_first" = 1 ]; then printf '  %s▶%s %s%s%s %s%s%s ' "$C" "$X" "$L" "$__wr_line" "$X" "$D" "$__wr_q" "$X"
    else printf '    %s%s%s%s%s%s%s ' "$L" "$__wr_line" "$X" "${__wr_line:+ }" "$D" "$__wr_q" "$X"; fi
    IFS= read -e -r __wr_a </dev/tty || __wr_a=q           # readline: arrows move inside the answer, nothing leaks into it
    __wr_a=${__wr_a//[[:cntrl:]]/}; __wr_a=${__wr_a#"${__wr_a%%[! ]*}"}; __wr_a=${__wr_a%"${__wr_a##*[! ]}"}
    [ "$__wr_a" = q ] && W_QUIT=1
    printf -v "$1" '%s' "${__wr_a:-${3:-}}"
}
w_key() {  # w_key <allowed keys, e.g. "ynsq">: waits for one of them or Enter (-> ENTER); everything else is swallowed
    local k _s _r; _s=$(stty -g </dev/tty 2>/dev/null); stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    while true; do
        IFS= read -rsn1 k </dev/tty || { k=q; break; }
        case "$k" in
            "") k=ENTER; break ;;
            $'\033') while read_soon _r; do :; done; continue ;;   # an arrow, the wheel, F-keys: the whole sequence goes
            *) case "$1" in *"$k"*) break ;; esac
               case "$k" in [A-Z]) case "$1" in *"$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]')"*) k=$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]'); break ;; esac ;; esac ;;
        esac
    done
    stty "$_s" </dev/tty 2>/dev/null
    W_KEY=$k
}
w_yn() {  # w_yn <question> <Y|N>: 0 yes, 1 no, 2 skip (s), 3 quit (q); only y, n, Enter, s and q are taken
    local hint="Y/n" __q __w __ws __line="" __first=1 __room=$(( W - 7 )); [ "$2" = N ] && hint="y/N"
    read -r -a __ws <<< "$1"; printf '\n'
    for __w in ${__ws[@]+"${__ws[@]}"}; do
        if [ -z "$__line" ]; then __line=$__w
        elif [ $(( ${#__line} + 1 + ${#__w} )) -le "$__room" ]; then __line="$__line $__w"
        else if [ "$__first" = 1 ]; then printf '  %s▶%s %s%s%s\n' "$C" "$X" "$L" "$__line" "$X"; __first=0; else printf '    %s%s%s\n' "$L" "$__line" "$X"; fi; __line=$__w; fi
    done
    if [ "$__first" = 1 ]; then printf '  %s▶%s %s%s%s %s[%s]%s ' "$C" "$X" "$L" "$__line" "$X" "$D" "$hint" "$X"
    else printf '    %s%s%s %s[%s]%s ' "$L" "$__line" "$X" "$D" "$hint" "$X"; fi
    w_key ynsqj
    case "$W_KEY" in
        y|j) printf '%syes%s\n' "$GREEN" "$X"; return 0 ;;
        n) printf '%sno%s\n' "$D" "$X"; return 1 ;;
        ENTER) if [ "$2" = Y ]; then printf '%syes%s\n' "$GREEN" "$X"; return 0; else printf '%sno%s\n' "$D" "$X"; return 1; fi ;;
        s) printf '%sskipped%s\n' "$D" "$X"; return 2 ;;
        q) printf '%send%s\n' "$D" "$X"; W_QUIT=1; return 3 ;;
    esac
}
w_choose() {  # w_choose <var> <prompt> <allowed keys, e.g. 123> <default>: one key from the list (Enter = default, q ends)
    printf '\n  %s▶%s %s%s%s %s[%s]%s ' "$C" "$X" "$L" "$2" "$X" "$D" "$4" "$X"
    w_key "${3}q"
    case "$W_KEY" in ENTER) W_KEY=$4 ;; q) W_QUIT=1; printf '%send%s\n' "$D" "$X"; return 1 ;; esac
    printf '%s%s%s\n' "$GREEN" "$W_KEY" "$X"; printf -v "$1" '%s' "$W_KEY"
}
w_button() { if [ "$color" = 1 ]; then printf '%s\033[7m %s \033[27m%s' "$L" "$1" "$X"; else printf '[ %s ]' "$1"; fi; }   # light on dark, inverted
w_continue() {  # the way on: a button for Enter, quitting next to it (quiet)
    printf '\n  %s  %sq end the setup%s ' "$(w_button "⏎ next")" "$D" "$X"
    w_key q; [ "$W_KEY" = q ] && W_QUIT=1; printf '\n'; return 0
}
w_run() {  # w_run <what> <command...>: runs it visibly (ssh may ask for a password here), then says how it went
    printf '\n  %s→ %s%s\n' "$C" "$1" "$X"; w_log "run: $1"; shift
    local out="$RUN_DIR/wrun.$$"
    "$@" 2>&1 | tee "$out"; local rc=${PIPESTATUS[0]}       # visible here, and kept in the setup log
    sed 's/^/    | /' "$out" >> "$W_LOG" 2>/dev/null; rm -f "$out"; w_log "exit $rc"
    if [ "$rc" = 0 ]; then w_ok "done"; else w_bad "failed" "exit $rc"; fi
    return $rc
}
W_RPATH='PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; export PATH; '   # (expanded on the other machine)
w_ssh() {  # w_ssh <machine label> <sh script>: on the other machine, through the ssh target herdr saved for it (asks for a password if needed)
    local host; host=$(store_host "$1"); case "$host" in ''|-*|*[!A-Za-z0-9._@:%-]*) return 1 ;; esac
    "${BHOTE_SSH:-ssh}" -n -o ConnectTimeout=8 "$host" "sh -lc $(printf '%q' "$W_RPATH$2")"    # -n: no stdin (it would eat a loop's input)
}
w_ts() {  # w_ts <args>: the Tailscale CLI, also the one inside the macOS app (not on PATH there)
    local t; t=$(command -v tailscale 2>/dev/null)
    [ -n "$t" ] || { [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ] && t=/Applications/Tailscale.app/Contents/MacOS/Tailscale; }
    [ -n "$t" ] || return 127; "$t" "$@"
}
w_has_ts() { command -v tailscale >/dev/null 2>&1 || [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; }
w_share() {  # w_share <part>: where a part of bhote lives (herdr-plugin, integrations/...): this checkout or a package's share folder
    local d s; s=$(w_self_dir)
    for d in "$s" "$s/../share/bhote" /usr/share/bhote /usr/local/share/bhote /opt/homebrew/share/bhote; do
        [ -e "$d/$1" ] && { (cd "$d" && pwd); return 0; }
    done; return 1
}
w_rbhote() { printf 'b=$(command -v bhote || echo "$HOME/.local/bin/bhote"); "$b" %s' "$1"; }   # bhote on the other machine
w_self_dir() {  # the folder of this checkout (bhote is usually a link in ~/.local/bin)
    local p=$0 l; while [ -L "$p" ]; do l=$(readlink "$p"); case "$l" in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac; done
    (cd "$(dirname "$p")" && pwd)
}
w_ssh_note() { w_say "If ssh needs a password for $1, ssh asks for it itself, right here. bhote never sees it and stores nothing."; }
w_inbound_ssh() { (exec 3<>/dev/tcp/127.0.0.1/22) 2>/dev/null; }                    # can other machines log in here at all?
w_self_target() {  # how other machines reach this one: user@<local name>.local on macOS, user@<host name> elsewhere
    if [ "$(uname -s)" = Darwin ]; then printf '%s@%s.local' "$USER" "$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
    else printf '%s@%s' "$USER" "$(hostname 2>/dev/null || uname -n)"; fi
}
w_machines() { herdr machine list 2>/dev/null | tr '\t' '\037' | while IFS=$US read -r id label host prof en; do [ -n "$label" ] && printf '%s\037%s\037%s\n' "$label" "$host" "$en"; done; }

# Finding the other machine without knowing its host name: Tailscale devices, machines that offer ssh on the local network
# (Bonjour / Avahi), and the aliases in ~/.ssh/config. One "host US where" line each, no duplicates.
w_hosts() {
    local t
    {
        if w_has_ts && command -v jq >/dev/null 2>&1; then
            w_ts status --json 2>/dev/null | jq -r '(.Self.UserID) as $me | [.Peer[]? | select(.UserID == $me)          # only your own devices (a tailnet can share others)
                | select((.OS // "") as $o | ($o != "iOS" and $o != "android" and $o != "tvOS"))]
                | sort_by(if .Online then 0 else 1 end)[] | ((.DNSName // "") | rtrimstr(".")) + "\u001fTailscale · " + (.OS // "?") + " · " + (.TailscaleIPs[0] // "") + (if .Online then "" else " · offline" end)' 2>/dev/null
        fi
        if [ -r "$HOME/.ssh/config" ]; then awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i "\037~/.ssh/config" }' "$HOME/.ssh/config"; fi
        if command -v dns-sd >/dev/null 2>&1; then
            # a Bonjour service name ("Flo's MacBook") is not a host name: dns-sd -L tells the host behind it
            t=$(mktemp "$RUN_DIR/mdns.XXXXXX"); dns-sd -B _ssh._tcp local. > "$t" 2>/dev/null & local p=$!; sleep 2; kill "$p" 2>/dev/null; wait "$p" 2>/dev/null
            awk '$2 == "Add" { n = ""; for (i = 7; i <= NF; i++) n = n (n ? " " : "") $i; if (!s[n]++) print n }' "$t" | head -6 | while IFS= read -r n; do
                ( r=$(mktemp "$RUN_DIR/mdnsl.XXXXXX"); dns-sd -L "$n" _ssh._tcp local. > "$r" 2>/dev/null & q=$!; sleep 1.5; kill "$q" 2>/dev/null; wait "$q" 2>/dev/null
                  awk '/can be reached at/ { for (i = 1; i < NF; i++) if ($i == "at") { h = $(i + 1); sub(/:[0-9]+$/, "", h); sub(/\.$/, "", h); print h "\037local network (Bonjour)"; exit } }' "$r"
                  rm -f "$r" ) &
            done; wait; rm -f "$t"
        elif command -v avahi-browse >/dev/null 2>&1; then
            avahi-browse -tpr _ssh._tcp 2>/dev/null | awk -F';' '$1 == "=" && $3 == "IPv4" { print $7 "\037local network (Avahi)" }'
        fi
    } | awk -F'\037' '$1 ~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/ && !seen[$1]++' | w_not_saved | head -9 | w_reach   # plain host names only
}
w_reach() {  # every candidate is tried at once (ssh, 3 s): the answer goes into its description, reachable ones first
    local h w i=0 n r rest dir; dir=$(mktemp -d "$RUN_DIR/reach.XXXXXX")
    while IFS=$US read -r h w; do
        [ -n "$h" ] || continue; i=$(( i + 1 )); printf '%s\n%s\n' "$h" "$w" > "$dir/$i.in"
        ( out=$("${BHOTE_SSH:-ssh}" -n -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$dir/$i.kh" "$USER@$h" true 2>&1); rc=$?
          case "$rc:$out" in 0:*) echo "0 ssh ok" ;; *ermission*|*publickey*) echo "1 needs a password" ;; *) echo "2 not reachable" ;; esac > "$dir/$i.out" ) &
    done
    wait
    for (( n = 1; n <= i; n++ )); do
        { IFS= read -r h; IFS= read -r w; } < "$dir/$n.in"; read -r r rest < "$dir/$n.out"
        printf '%s %s\037%s · %s\n' "$r" "$h" "$rest" "$w"      # the answer first: it must not be cut off
    done | sort -s -n -k1,1 | cut -d' ' -f2-
    rm -rf "$dir"
}
w_saved_shorts() {  # the short names (and Tailscale IPs) of the machines herdr has saved already
    local label host en ip
    while IFS=$US read -r label host en <&3; do
        host=${host#*@}; printf '%s\n' "$(printf '%s' "${host%%.*}" | tr '[:upper:]' '[:lower:]')"
        w_has_ts && { ip=$(w_ts ip -4 "${host%%.*}" 2>/dev/null | head -1); [ -n "$ip" ] && printf '%s\n' "$ip"; }
    done 3<<< "$(w_machines)"
}
w_not_saved() {  # filter for w_hosts: drop candidates that are saved machines already (same short name or Tailscale IP)
    local saved; saved=" $(w_saved_shorts | tr '\n' ' ') "
    awk -F'\037' -v saved="$saved" '{ s = $1; sub(/^.*@/, "", s); sub(/\..*$/, "", s); s = tolower(s)
        ip = $2; sub(/^.* · /, "", ip); sub(/ .*$/, "", ip); n = split($2, parts, " · "); ip = (n >= 3 ? parts[3] : "")
        if (index(saved, " " s " ") || (ip != "" && index(saved, " " ip " "))) next; print }'
}
w_self_targets() {  # how the others can reach THIS machine: Tailscale name, local network name, IP address
    local u=$USER ts ln ip
    if w_has_ts; then ts=$(w_ts status --json 2>/dev/null | jq -r '(.Self.DNSName // "") | rtrimstr(".")' 2>/dev/null); [ -n "$ts" ] && printf '%s@%s\037Tailscale (works from anywhere in your tailnet)\n' "$u" "$ts"; fi
    if [ "$(uname -s)" = Darwin ]; then ln=$(scutil --get LocalHostName 2>/dev/null); [ -n "$ln" ] && printf '%s@%s.local\037local network name (same Wi-Fi/LAN)\n' "$u" "$ln"
        ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
    else ln=$(hostname 2>/dev/null); [ -n "$ln" ] && printf '%s@%s\037host name\n' "$u" "$ln"; ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')   # (no hostname -I on Arch)
        [ -n "$ip" ] || ip=$(hostname -I 2>/dev/null | awk '{print $1}'); fi
    [ -n "$ip" ] && printf '%s@%s\037IP address (can change)\n' "$u" "$ip"
}
w_pick() {  # w_pick <var> <question> <US-separated lines>: a numbered list; a number picks, anything else is taken as typed
    local _v=$1 _q=$2 _lines=$3 _i=0 _h _w _a _vals=()
    while IFS=$US read -r _h _w; do
        [ -n "$_h" ] || continue; _i=$(( _i + 1 )); _vals[$_i]=$_h
        printf '  %s%d%s  %s%s%s\n     %s%s%s\n' "$C" "$_i" "$X" "$L" "$(clip "$_h" $(( W - 5 )))" "$X" "$D" "$(clip "$_w" $(( W - 5 )))" "$X"
    done <<< "$_lines"
    [ "$_i" -gt 0 ] || w_say "Nothing found nearby: type it (a host name, user@host, or an IP address)."
    w_read _a "$_q" "$([ "$_i" -gt 0 ] && echo 1)"; [ "$W_QUIT" = 1 ] && return
    case "$_a" in
        *[!0-9,\ ]*|"") ;;                                  # typed: taken as it is
        *) local _n _out=""; for _n in ${_a//,/ }; do [ -n "${_vals[$_n]:-}" ] && _out="${_out:+$_out }${_vals[$_n]}"; done
           [ -n "$_out" ] && _a=$_out ;;                     # numbers: one or several ("1 2", "1,2")
    esac
    printf -v "$_v" '%s' "$_a"
}
w_probe() {  # w_probe <ssh target>: can we get there? W_PROBE = ok | password | unknown | refused | unreachable | other
    local out; out=$("${BHOTE_SSH:-ssh}" -n -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new "$1" true 2>&1); local rc=$?
    if [ $rc = 0 ]; then W_PROBE=ok; return 0; fi
    case "$out" in
        *"ermission denied"*|*"publickey"*) W_PROBE=password ;;
        *"ould not resolve"*|*"not known"*|*"Name or service"*) W_PROBE=unknown ;;
        *"onnection refused"*) W_PROBE=refused ;;
        *"timed out"*|*"o route"*|*"nreachable"*) W_PROBE=unreachable ;;
        *) W_PROBE=other ;;
    esac
    return 1
}
w_probe_say() {  # what the probe means, in one line
    case "$W_PROBE" in
        ok) w_ok "reachable" "ssh works with your key" ;;
        password) w_ok "reachable" "ssh will ask for the password (bhote never sees it)" ;;
        unknown) w_bad "unknown name" "pick it from the list or check the spelling" ;;
        refused) w_bad "no ssh there" "switch on Remote Login (macOS) or sshd (Linux)" ;;
        unreachable) w_bad "not reachable" "is it on and in the same network or tailnet?" ;;
        *) w_bad "ssh failed" "try another address" ;;
    esac
}
w_remote_knows() {  # w_remote_knows <machine label>: does that machine have THIS one saved in herdr? 0 yes, 1 no, 2 cannot tell
    # (herdr does not run `machine list` through --machine; this asks the other side over ssh, read-only, never for a password)
    local host list; host=$(store_host "$1"); case "$host" in ''|-*|*[!A-Za-z0-9._@:%-]*) return 2 ;; esac
    list=$("${BHOTE_SSH:-ssh}" -n -o BatchMode=yes -o ConnectTimeout=6 "$host" "sh -lc $(printf '%q' "${W_RPATH}herdr machine list")" 2>/dev/null) || return 2
    printf '%s\n' "$list" | awk -F'\t' -v h="$HOST" '$2 == h { f = 1 } END { exit !f }' && return 0
    return 1
}
setup_step_checks() {
    w_screen 1 "CHECKS"
    w_say "What bhote needs on this machine. Nothing is changed in this step unless you say so."; w_line
    local dir hook="$HOME/.claude/settings.json" r
    command -v jq >/dev/null 2>&1 && w_ok "jq" "$(jq --version 2>/dev/null)" || w_bad "jq" "install it: brew install jq / pacman -S jq"
    if command -v herdr >/dev/null 2>&1; then w_ok "herdr" "${HERDR_V:-?}"; else w_bad "herdr" "not found: bhote lives next to herdr"; fi
    herdr pane list >/dev/null 2>&1 && w_ok "herdr server" "running" || w_warn "herdr server" "not reachable right now"
    command -v bhote >/dev/null 2>&1 && w_ok "bhote command" "$(command -v bhote | sed "s#^$HOME#~#")" || w_warn "bhote command" "not on PATH (install.sh links ~/.local/bin/bhote)"
    for t in gzip base64 perl; do command -v "$t" >/dev/null 2>&1 && w_ok "$t" "" || w_warn "$t" "missing: some extras are off"; done
    if w_inbound_ssh; then w_ok "ssh into here" "open (other machines can reach $HOST)"; else w_warn "ssh into here" "closed: step 4 can switch it on"; fi
    if w_has_ts && w_ts status >/dev/null 2>&1; then w_ok "Tailscale" "on (machines are found by name)"
    else w_warn "Tailscale" "not running: machines are found in the local network only"; fi
    if herdr plugin list 2>/dev/null | grep -q 'bhote.panel'; then w_ok "herdr plugin" "bhote.panel"
    else
        w_bad "herdr plugin" "not linked: no autostart, no events, no sync through herdr"
        dir=$(w_share herdr-plugin)
        if [ -n "$dir" ]; then w_yn "Link the plugin from $dir/herdr-plugin?" Y; r=$?; [ $r = 3 ] && return
            [ $r = 0 ] && w_run "herdr plugin link" herdr plugin link "$dir/herdr-plugin"; fi
    fi
    if [ -f "$hook" ]; then
        if grep -q 'bhote current' "$hook" 2>/dev/null; then w_ok "Claude hook" "agents learn their topic at start"
        else
            w_warn "Claude hook" "not set: an agent does not learn its topic at start"
            w_say "Adds a SessionStart hook (bhote current) to $hook."
            w_yn "Add it?" Y; r=$?; [ $r = 3 ] && return
            if [ $r = 0 ] && command -v jq >/dev/null 2>&1; then
                local tmp="$hook.tmp.$$"
                jq '.hooks.SessionStart = ((.hooks.SessionStart // [{"matcher":"*","hooks":[]}]) | .[0].hooks += [{"type":"command","command":"command -v bhote >/dev/null 2>&1 && bhote current 2>/dev/null; true","timeout":10}])' "$hook" > "$tmp" \
                    && jq empty "$tmp" && mv "$tmp" "$hook" && w_ok "Claude hook" "added" || { rm -f "$tmp"; w_bad "Claude hook" "could not be added"; }
            fi
        fi
    else w_warn "Claude Code" "no ~/.claude/settings.json: the hook is skipped"; fi
    local sk="$HOME/.claude/skills/bhote" src; src="$(w_share integrations/claude/skills/bhote)/integrations/claude/skills/bhote"
    if [ -e "$sk/SKILL.md" ]; then w_ok "Claude skill" "agents create waiting topics"
    elif [ -d "$HOME/.claude" ] && [ -f "$src/SKILL.md" ]; then
        w_warn "Claude skill" "not installed: agents do not create waiting topics"
        w_yn "Install the bhote skill for Claude Code (~/.claude/skills/bhote)?" Y; r=$?; [ $r = 3 ] && return
        [ $r = 0 ] && { mkdir -p "$sk" && cp "$src/SKILL.md" "$sk/SKILL.md" && w_ok "Claude skill" "installed" || w_bad "Claude skill" "could not be copied"; }
    fi
    w_continue
}
setup_step_name() {
    w_screen 2 "THIS MACHINE"
    w_say "How this machine is called in the agent lists. Other machines must know it by the same name (herdr machine label)."
    local n old=$HOST f; w_read n "Name of this machine:" "$HOST"; [ "$W_QUIT" = 1 ] && return
    n=${n//[!A-Za-z0-9 ._-]/}; [ -n "$n" ] && { cfg_set HOST_LABEL "$n"; HOST=$n; w_ok "name" "$n"; }
    if [ -n "$n" ] && [ "$n" != "$old" ]; then
        for f in "$TOPIC_DIR"/*.topic; do [ -f "$f" ] && [ "$(topic_get "$f" agent_machine)" = "$old" ] && topic_set "$f" agent_machine "$n"; done
        [ -n "$(w_machines)" ] && w_warn "renamed" "machines that saved $old: rename it there (herdr)"
    fi
    w_continue
}
setup_add_machine() {  # setup_add_machine <host or user@host>: user, test, label, no duplicates, herdr machine add
    local h=$1 t u lab short dup
    printf '\n  %s%s%s\n' "$R" "$(clip "$h" $(( W - 2 )))" "$X"
    case "$h" in *@*) t=$h ;; *)                         # a ~/.ssh/config alias knows its user; else ask, with this user as default
        if [ -r "$HOME/.ssh/config" ] && awk -v h="$h" 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i == h) f = 1 } END { exit !f }' "$HOME/.ssh/config"; then t=$h
        else w_read u "User name on it:" "$USER"; [ "$W_QUIT" = 1 ] && return; t="$u@$h"; fi ;;
    esac
    case "$t" in -*|*[!A-Za-z0-9._@:%-]*) w_bad "refused" "odd characters in $t"; return ;; esac
    short=${t#*@}; short=${short%%.*}
    dup=$(w_machines | while IFS=$US read -r l2 h2 e2; do h2=${h2#*@}; [ "${h2%%.*}" = "$short" ] && { echo "$l2"; break; }; done)
    if [ -n "$dup" ]; then w_warn "$short" "saved already as $dup"; return; fi
    printf '  %s→ %s%s\n' "$C" "$(clip "testing ssh to $t" $(( W - 2 )))" "$X"; w_probe "$t"; w_probe_say
    case "$W_PROBE" in ok|password) ;; *) return ;; esac
    lab="$(printf '%s' "${short:0:1}" | tr '[:lower:]' '[:upper:]')${short:1}"
    w_read lab "Label for it in herdr and bhote:" "$lab"; [ "$W_QUIT" = 1 ] && return
    case "$lab" in ''|*[!A-Za-z0-9._\ -]*) w_bad "refused" "letters, digits, . _ - and spaces only"; return ;; esac
    if w_machines | awk -F'\037' -v l="$lab" '$1 == l { f = 1 } END { exit !f }'; then w_warn "$lab" "this label is taken"; return; fi
    w_ssh_note "$t"
    w_run "herdr machine add --label $lab $t" herdr machine add --label "$lab" "$t"
}
setup_step_machines() {
    local label host en r t lab
    while true; do
        w_screen 3 "OTHER MACHINES"
        w_say "The machines herdr knows (herdr machine list). bhote reaches them through herdr: their agents, and the topics."; w_line
        local any=0
        while IFS=$US read -r label host en <&3; do
            any=1
            if herdr --machine "$label" pane list >/dev/null 2>&1; then w_ok "$label" "$host · reachable"; else w_warn "$label" "$host · not reachable now"; fi
        done 3<<< "$(w_machines)"
        [ "$any" = 1 ] || w_warn "none yet" "add one to see its agents here"
        w_yn "Add a machine?" N; r=$?; [ $r = 3 ] && return; [ $r = 0 ] || break
        w_screen 3 "ADD A MACHINE"
        local saved_list; saved_list=$(w_machines | awk -F'\037' '{ printf "%s%s", (NR > 1 ? ", " : ""), $1 }')
        w_say "Which machines? Found nearby; a number picks one, several numbers (1 2) pick several, or type a name or an address."
        [ -n "$saved_list" ] && { w_line; w_ok "already saved" "$saved_list"; }
        w_line
        local hs h u
        w_pick hs "Machines:" "$(w_hosts)"; [ "$W_QUIT" = 1 ] && return; [ -n "$hs" ] || continue
        for h in $hs; do setup_add_machine "$h"; [ "$W_QUIT" = 1 ] && return; done
        w_continue; [ "$W_QUIT" = 1 ] && return                 # the result (also a failed test, with its reason) stays readable
    done
}
w_wait_ssh() {  # w_wait_ssh <seconds>: until ssh is open here (checked every second); any key stops waiting
    local n=0 k; printf '  %swaiting for ssh to open (any key stops)%s ' "$D" "$X"
    while [ "$n" -lt "$1" ]; do
        w_inbound_ssh && { printf '\n'; return 0; }
        IFS= read -rsn1 -t 1 k </dev/tty && { printf '\n'; return 1; }
        printf '%s·%s' "$D" "$X"; n=$(( n + 1 ))
    done
    printf '\n'; return 1
}
setup_open_ssh() {  # ssh into this machine is closed: switch it on here (sudo asks for the password itself), or open the settings
    local c unit=sshd
    [ "$(uname -s)" = Darwin ] || systemctl cat sshd.service >/dev/null 2>&1 || unit=ssh
    w_say "Other machines can reach $HOST only when ssh is open here."
    w_line
    if [ "$(uname -s)" = Darwin ]; then
        w_opt 1 "switch on Remote Login now (sudo asks for your Mac password; bhote never sees it)"
        w_opt 2 "open System Settings › Sharing; I switch on Remote Login there"
    else
        w_opt 1 "start the ssh server now (sudo systemctl enable --now $unit; sudo asks for your password)"
        w_opt 2 "I start it myself in another terminal"
    fi
    w_opt 3 "skip it"
    w_choose c "Choose:" 123 1 || return 1
    case "$c" in
        1) if [ "$(uname -s)" = Darwin ]; then
               # systemsetup needs Full Disk Access for the terminal on current macOS; launchd starts the same ssh service without it
               w_run "sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist" sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist
           else w_run "sudo systemctl enable --now $unit" sudo systemctl enable --now "$unit"; fi
           w_wait_ssh 10 ;;
        2) [ "$(uname -s)" = Darwin ] && open "x-apple.systempreferences:com.apple.Sharing-Settings.extension" 2>/dev/null
           w_wait_ssh 180 ;;
        *) return 1 ;;
    esac
    if w_inbound_ssh; then w_ok "ssh into $HOST" "open now"; return 0; fi
    return 1
}
setup_step_twoway() {

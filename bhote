    else printf '\035%s\035  %s●%s %s%s%s%*s%s%s%s\n' "${T_ID[$i]}" "$dc" "$X" "$TITLE" "$t" "$X" $(( w - 5 - tw - ${#tm} )) "" "$D" "$tm" "$X"; fi
}
topics_block() {  # the topics on now, grouped by status (review, now, next, waiting); parked ones only counted, done ones below
    local i prev="" st label lc tc age ast desc cp sl who state tm sc nlater=0 nl_shown=0 open=0 TI_REF TI_BAR rn ra rline
    sel_index
    for (( i = 0; i < T_N; i++ )); do panel_shows "${T_STATUS[$i]}" && in_scope "$i" && open=$(( open + 1 )); done
    if [ "${U_SCOPE:-all}" = project ] && [ -n "${CUR_PROJ:-}" ]; then   # which project this panel lists
        printf '\n  %s%s%s %s· its topics%s\n' "$L" "$(project_name "$CUR_PROJ")" "$X" "$D" "$X"
    fi
    [ "$open" -gt 0 ] || bored_agents                           # nothing in review, now, next or waiting: on top, a checked one below
    local TI_FRAME=1 TI_OPEN=0
    for (( i = 0; i < T_N; i++ )); do
        st=${T_STATUS[$i]}; desc=${T_DESC[$i]:-}; tc=$TITLE; cp=0
        [ "$st" = done ] && continue                             # (in done_block, above the agents)
        in_scope "$i" || continue                                # another project's (TOPICS_SCOPE=project)
        case "$st" in next|waiting|later)                        # only review and now are cards; the others are lines, grouped by status
            if [ "$st" = later ] && [ "$i" != "$SEL_IDX" ] && [ "$nl_shown" -ge 5 ]; then nlater=$(( nlater + 1 )); continue; fi
            if [ "$st" != "$prev" ]; then
                case "$st" in next) label=Next ;; waiting) label=Waiting ;; *) label=Later ;; esac
                printf '\n'; dash_caption "$label"; prev=$st
            fi
            [ "$st" = later ] && nl_shown=$(( nl_shown + 1 ))
            topic_line "$i"; continue ;;
        esac
        if ! panel_shows "$st" && [ "$i" != "$SEL_IDX" ]; then   # (a selected parked one stays: chosen in the search)
            nlater=$(( nlater + 1 )); continue
        fi
        if [ "$st" != "$prev" ]; then
            case "$st" in now) label=NOW; lc=$ORANGE ;; next) label=NEXT; lc=$S ;; waiting) label=WAITING; lc=$Y ;; review) label=REVIEW; lc=$BLUE ;; later) label=LATER; lc=$R ;; done) label=DONE; lc=$GREEN ;; esac
            printf '\n'                                                  # (a card brings its own edges, the caption its blank row)
            printf '  %s%s%s\n' "$lc" "$label" "$X"; prev=$st
        fi
        topic_meta "$i"; who=$TM_WHO; state=$TM_ST; sc=$TM_SC; tm=$TM_TM
        case "$st" in
            now) [ "$state" = finished ] && [ "$i" = "$SEL_IDX" ] && state="finished · x = done" ;;
            done) tc="$BOLD$D"; desc=""; cp=1 ;;   # muted but bold like every title, one line, no gap
        esac
        sl=0; [ "$i" = "$SEL_IDX" ] && sl=1; TI_REF=${T_ID[$i]}
        rn=""; ra=""; TI_BAR=$lc                                 # (the bar on the card has the colour of its group: review blue, now orange, next teal, waiting yellow)
        if [ "$st" = review ]; then                              # the card the agent put under it (summary and the action's button)
            while IFS= read -r rline; do case "$rline" in review_note=*) rn=${rline#*=} ;; review_ask=*) ra=${rline#*=} ;; esac; done < "${T_FILE[$i]}"
            rn=${rn//[[:cntrl:]]/}; ra=${ra//[[:cntrl:]]/}
        fi
        topic_item "$sl" "$sc" "$tm" "$tc" "${T_TITLE[$i]:-(untitled)}" "$desc" "$who" "$state" "$cp" "$TM_BR" "$rn" "$ra"
    done
    if [ "$nlater" -gt 0 ]; then                                # where the others are
        local rest="+$nlater more parked"; [ -n "${FIND_KEY_SHOW:-}" ] && rest="$rest · ${FIND_KEY_SHOW} search"
        printf '\n  %s%s%s\n' "$D" "$(clip "$rest" $(( ${COLS:-44} - 4 )))" "$X"
    fi
}
done_mc() {  # done_mc <topic index>: DONE_MC = the short code of the machine whose agent did it (MAC, OMR), only with more than one machine
    local _m=${T_AM[$1]:-}; DONE_MC=""; [ -n "$_m" ] || return 0

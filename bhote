setup_step_checks() {
    w_screen 1 "CHECKS" || return
    w_say "What bhote needs on this machine. Nothing is changed in this step unless you say so."; w_line
    local cdir=${CLAUDE_CONFIG_DIR:-$HOME/.claude} dir hook r; hook="$cdir/settings.json"

    rgb() { :; }; X=""; R=""; NN=""; S=""; C=""; L=""; D=""; BOLD=""; color=0
else
    color=1; esc=$'\033'
    rgb() { printf '%s[38;2;%sm' "$esc" "$1"; }
    X="${esc}[0m"; BOLD="${esc}[1m"                          # (a variable: drawing must not fork for it)
fi
stops=("148 226 213" "137 180 250" "203 166 247" "245 194 231" "250 179 135")
gradient() {            # gradient <text> : colours the characters of one line left to right
    local line=$1 n=$(( ${#stops[@]} - 1 )) w=${#1} i ch p seg t r1 g1 b1 r2 g2 b2 out=""
    [ "$color" = 1 ] || { printf '%s' "$line"; return; }
    if [ -n "${GRAD_ANSI:-}" ]; then                        # terminal theme: the palette's colours, spread over the text
        local cols=($GRAD_ANSI) nc; nc=${#cols[@]}
        for (( i = 0; i < w; i++ )); do ch=${line:$i:1}; out="$out${esc}[${cols[$(( i * nc / (w > 0 ? w : 1) ))]}m$ch"; done
        printf '%s%s' "$out" "$X"; return
    fi
    for (( i = 0; i < w; i++ )); do
        ch=${line:$i:1}
        if [ "$ch" = " " ]; then out="$out "; continue; fi
        p=$(( i * n * 100 / (w - 1) )); seg=$(( p / 100 )); [ $seg -ge $n ] && seg=$(( n - 1 )); t=$(( p - seg * 100 ))
        read -r r1 g1 b1 <<< "${stops[$seg]}"; read -r r2 g2 b2 <<< "${stops[$((seg + 1))]}"
        out="$out$(rgb "$(( r1 + (r2 - r1) * t / 100 ));$(( g1 + (g2 - g1) * t / 100 ));$(( b1 + (b2 - b1) * t / 100 ))")$ch"
    done
    printf '%s%s' "$out" "$X"
}

# ── themes. THEME=terminal (default) uses the terminal's own 16 colours, so bhote follows the terminal theme (Omarchy's
# system theme, a light terminal) at once; THEME=catppuccin and THEME=dracula use exact truecolor values. COLOR_<ROLE>=#rrggbb overrides one
# role in either theme. The dog keeps its own colours.
#   TEXT  DIM  FRAME  SELECTION (a background)  ACCENT (teal)  NOW (= busy)  WAITING  REVIEW  LATER  DONE (= free)  ERROR
THEME_SIG=""
hex_rgb() { local h=${1#\#}; case "$h" in [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}" ;; *) return 1 ;; esac; }
theme_apply() {  # sets every colour variable from THEME and the COLOR_* overrides
    PINK=""; Y=""; GREEN=""; BLUE=""; B=""; SELBG=""; CARDBG=""; CARDSEL=""; CARDHOV=""; CARDSUB=""; CARDBTN=""; MUTED=""; R=""; NN=""; S=""; C=""; L=""; D=""; LSEL=""; DSEL=""; DESC=""; DESCSEL=""; TITLE=""; TITLESEL=""
    [ "$color" = 1 ] || { TEAL=""; ORANGE=""; PINK=""; return 0; }
    ORANGE=""
    local th v k; cfg_var th THEME terminal
    if [ "$th" = catppuccin ]; then
        R=$(rgb "203;166;247"); NN=$(rgb "243;139;168"); S=$(rgb "148;226;213"); C=$(rgb "250;179;135"); PINK=$(rgb "245;194;231"); ORANGE=$(rgb "217;119;87")   # (ORANGE: Claude's own, not Catppuccin's peach)
        L="${esc}[1m$(rgb "205;214;244")"; D=$(rgb "108;112;134"); B=$D
        Y=$(rgb "249;226;175"); GREEN=$(rgb "166;227;161"); BLUE=$(rgb "137;180;250"); SELBG="${esc}[48;2;49;50;68m"; CARDBG="${esc}[48;2;33;34;50m"; CARDSEL="${esc}[48;2;49;50;68m"; CARDHOV="${esc}[48;2;40;41;58m"; CARDSUB="${esc}[48;2;25;25;38m"; CARDBTN="${esc}[48;2;108;112;134m${esc}[1;38;2;30;30;46m"; MUTED=$(rgb "69;71;90")
        LSEL="${esc}[1m$(rgb "245;247;255")"; DSEL=$(rgb "186;194;222")         # on the selection: brighter than the plain text
        TITLE="${esc}[1m$(rgb "166;173;200")"; TITLESEL="${esc}[1m$(rgb "205;214;244")"   # a topic: the title bold in the softer colour,
        DESC="${esc}[3m$(rgb "205;214;244")"; DESCSEL="${esc}[3m$(rgb "245;247;255")"     # the description italic in the full text colour
        stops=("148 226 213" "137 180 250" "203 166 247" "245 194 231" "250 179 135"); GRAD_ANSI=""
    elif [ "$th" = dracula ]; then                           # the Dracula palette, its roles as in Dracula's own terminal colours
        R=$(rgb "255;121;198"); NN=$(rgb "255;85;85"); S=$(rgb "139;233;253"); C=$(rgb "255;184;108"); PINK=$(rgb "255;146;223"); ORANGE=$(rgb "217;119;87")   # (magenta = pink, blue = purple; ORANGE: Claude's own)
        L="${esc}[1m$(rgb "248;248;242")"; D=$(rgb "98;114;164"); B=$D
        Y=$(rgb "241;250;140"); GREEN=$(rgb "80;250;123"); BLUE=$(rgb "189;147;249"); SELBG="${esc}[48;2;68;71;90m"; CARDBG="${esc}[48;2;46;48;62m"; CARDSEL="${esc}[48;2;68;71;90m"; CARDHOV="${esc}[48;2;56;58;74m"; CARDSUB="${esc}[48;2;33;34;44m"; CARDBTN="${esc}[48;2;98;114;164m${esc}[1;38;2;40;42;54m"; MUTED=$(rgb "68;71;90")
        LSEL="${esc}[1m$(rgb "255;255;255")"; DSEL=$(rgb "189;195;223")         # on the selection: brighter than the plain text
        TITLE="${esc}[1m$(rgb "214;216;228")"; TITLESEL="${esc}[1m$(rgb "248;248;242")"   # a topic: the title bold in the softer colour,
        DESC="${esc}[3m$(rgb "248;248;242")"; DESCSEL="${esc}[3m$(rgb "255;255;255")"     # the description italic in the full text colour
        stops=("139 233 253" "189 147 249" "255 121 198" "255 184 108" "241 250 140"); GRAD_ANSI=""
    else                                                     # the terminal's palette: magenta, red, cyan, yellow, ...
        R="${esc}[35m"; NN="${esc}[31m"; S="${esc}[36m"; C="${esc}[33m"; L="${esc}[1;39m"; D="${esc}[90m"; B=$D
        PINK="${esc}[95m"; ORANGE="${esc}[38;5;173m"; Y="${esc}[93m"; GREEN="${esc}[32m"; BLUE="${esc}[34m"; GRAD_ANSI="36 34 35 95 33"; MUTED="${esc}[2;90m"
        # the selected row: a dark grey from the 256 colours. "Bright black" (100) is the colour of dim text itself, which then
        # disappears on it; 236 keeps text and dim text readable on dark themes (COLOR_SELECTION overrides it).
        SELBG="${esc}[48;5;236m"; CARDBG="${esc}[48;5;234m"; CARDSEL="${esc}[48;2;46;46;60m"; CARDHOV="${esc}[48;2;36;36;46m"; CARDSUB="${esc}[48;2;22;22;30m"   # (between the panel and the card: no step of the 256 colours fits)
        CARDBTN="${esc}[48;5;244m${esc}[1;38;5;232m"; LSEL="${esc}[1;97m"; DSEL="${esc}[38;5;251m"   # on the selection: white and a light grey
        TITLE="${esc}[1;37m"; TITLESEL="${esc}[1;97m"                            # a topic: the title bold in the softer colour,
        DESC="${esc}[3;39m"; DESCSEL="${esc}[3;97m"                              # the description italic in the full text colour
    fi
    for k in TEXT DIM FRAME SELECTION ACCENT NOW WAITING REVIEW LATER DONE ERROR; do
        cfg_var v "COLOR_$k" ""; [ -n "$v" ] || continue; v=$(hex_rgb "$v") || continue
        case "$k" in
            TEXT) L="${esc}[1m$(rgb "$v")"; LSEL=$L; TITLE=$L; TITLESEL=$L; DESC="${esc}[3m$(rgb "$v")"; DESCSEL=$DESC ;;
            DIM) D=$(rgb "$v"); DSEL=$D ;; FRAME) B=$(rgb "$v") ;; SELECTION) SELBG="${esc}[48;2;${v}m"; CARDSEL=$SELBG ;;
            ACCENT) S=$(rgb "$v") ;; NOW) C=$(rgb "$v"); ORANGE=$C ;; WAITING) Y=$(rgb "$v") ;; REVIEW) BLUE=$(rgb "$v") ;;
            LATER) R=$(rgb "$v") ;; DONE) GREEN=$(rgb "$v") ;; ERROR) NN=$(rgb "$v") ;;
        esac
    done
    MUTED=${MUTED:-$B}; TEAL=$S; ORANGE=${ORANGE:-$C}; HEAD_GRAD=""; LSEL=${LSEL:-$L}; DSEL=${DSEL:-$D}; DESC=${DESC:-$D}; DESCSEL=${DESCSEL:-$DSEL}
    TITLE=${TITLE:-$L}; TITLESEL=${TITLESEL:-$LSEL}
}
theme_sig() {  # theme_sig <var>: the settings the colours come from, as one string (a change re-applies the theme)
    local _l _sig=""
    [ -r "$CONFIG_FILE" ] && while IFS= read -r _l; do case "$_l" in THEME=*|COLOR_*) _sig="$_sig|$_l" ;; esac; done < "$CONFIG_FILE"
    printf -v "$1" '%s' "$_sig"
}
INNER=$(( WIDTH - 2 ))
hline() { local _s; printf -v _s '%*s' "$1" ''; printf '%s' "${_s// /─}"; }
dline() { local _s; printf -v _s '%*s' "$1" ''; printf '%s' "${_s// /┈}"; }   # the same, dashed (the machine dividers)   # n times ─ (GNU tr cannot map to a multibyte character)
at_col() { [ "$color" = 1 ] && printf '%s[%dG' "$esc" "$1"; }

# One framed line: the right edge is placed by cursor column, so wide or combining characters cannot push it.
row() {  # row <shown text>
    printf '%s│%s%s' "$B" "$X" "$1"
    if [ "$color" = 1 ]; then printf '%s[K' "$esc"; at_col "$WIDTH"; printf '%s│%s\n' "$B" "$X"    # clear what an earlier frame left behind
    else printf '%*s│\n' $(( INNER - ${2:-0} )) ""; fi
}
mid() { local plain=$1 shown=$2 w=${3:-${#1}}; row "$(printf '%*s' $(( (INNER - w) / 2 )) "")$shown" $(( (INNER - w) / 2 + w )); }
blank() { row "" 0; }
blanks() { local n; for (( n = 0; n < $1; n++ )); do blank; done; }

top() {
    local title=" Bhote v$VERSION " n
    n=$(( INNER - ${#title} - 1 ))
    printf '%s╭─%s%s%s%s%s╮%s\n' "$B" "$X$L" "$title" "$X$B" "$(hline "$n")" "" "$X"
}
bottom() { printf '%s╰%s╯%s\n' "$B" "$(hline "$INNER")" "$X"; }

info() {   # info <label> <value>
    local label=$1 value=$2 pad=${INFO_PAD:-1}       # INFO_PAD centres the whole block (bhote_splash sets it)
    row "$(printf '%*s' "$pad" '')${D}${label}${X} ${value}" $(( pad + ${#label} + ${#value} + 1 ))
}


        lowsrc="$lowsrc${T_TITLE[$i]} ${T_DESC[$i]} ${T_STATUS[$i]} ${T_AG[$i]} ${T_WFOR[$i]} $TM_WHO $TM_ST topic"$'\n'; n=$(( n + 1 ))

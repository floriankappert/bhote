    local LC_ALL=C; _s=${_s//[[:ascii:]]/}
    for (( _i = 0; _i < ${#_s}; _i++ )); do
        printf -v _b '%d' "'${_s:_i:1}"; [ "$_b" -lt 0 ] && _b=$(( _b + 256 ))
        if [ "$_b" -ge 240 ]; then _x=$(( _x + 1 )); _i=$(( _i + 3 ))
        elif [ "$_b" -ge 224 ]; then
            printf -v _c '%d' "'${_s:_i+1:1}"; printf -v _d '%d' "'${_s:_i+2:1}"; [ "$_c" -lt 0 ] && _c=$(( _c + 256 )); [ "$_d" -lt 0 ] && _d=$(( _d + 256 ))
            _cp=$(( ((_b & 15) << 12) | ((_c & 63) << 6) | (_d & 63) )); _i=$(( _i + 2 ))
            if (( (_cp >= 0x1100 && _cp <= 0x115F) || (_cp >= 0x2E80 && _cp <= 0xA4CF && _cp != 0x303F) || (_cp >= 0xAC00 && _cp <= 0xD7A3) || (_cp >= 0xF900 && _cp <= 0xFAFF) || (_cp >= 0xFE30 && _cp <= 0xFE4F) || (_cp >= 0xFF00 && _cp <= 0xFF60) || (_cp >= 0xFFE0 && _cp <= 0xFFE6) )); then _x=$(( _x + 1 ))
            elif (( (_cp >= 0x200B && _cp <= 0x200F) || (_cp >= 0xFE00 && _cp <= 0xFE0F) || (_cp >= 0x20D0 && _cp <= 0x20FF) )); then _x=$(( _x - 1 )); fi
        elif [ "$_b" -ge 192 ]; then
            printf -v _c '%d' "'${_s:_i+1:1}"; [ "$_c" -lt 0 ] && _c=$(( _c + 256 ))
            _cp=$(( ((_b & 31) << 6) | (_c & 63) )); _i=$(( _i + 1 ))
            (( _cp >= 0x300 && _cp <= 0x36F )) && _x=$(( _x - 1 ))
        fi

            for (( i = 0; i < AG_N; i++ )); do
                IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
                [ "$m" = "$mm" ] || continue
                if [ "$pm" = "-" ]; then project_name "${apj[$i]}" >/dev/null && continue; else [ "${apj[$i]}" = "$pm" ] || continue; fi
                pre=""; plen=0; [ -n "$pre0" ] && { agentnum_set an "$m" "$name"; pre="$pre0$an|"; plen=${#pre}; }
                raw=$st; off=0; case "$st" in off-*) off=1; st=${st#off-} ;; esac   # its machine does not answer: as seen last, muted
                case "$st" in working|testing) rkst=0 ;; blocked) rkst=1 ;; *) rkst=2 ;; esac; [ "$rkst" = "$rk" ] || continue
                case "$st" in working|testing) ic="${ORANGE}${SPIN_CH:-✶}" ;; blocked) ic="${NN}◉" ;; *) ic="${D}○" ;; esac
                [ -n "$pre" ] && case "$name" in "$mm / "*) name=${name#"$mm / "} ;; esac   # (MAC|Mac / root says it twice)
                case "$st" in working|testing) nc=$ORANGE ;; blocked) nc=$NN ;; *) nc=$D ;; esac   # the whole agent: orange at work, red when it needs you, grey idle

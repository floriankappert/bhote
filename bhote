# An agent's status changed (the herdr plugin passes the event as HERDR_PLUGIN_EVENT_JSON, or on stdin). When an agent that
# holds a running topic stops working (done / idle) and did not report back itself, the topic goes to review and you get a
# notification. Either way the collector is poked, so every panel shows the new state at once.
# Push: an agent here changed its state; the other machines ask this one again at once (the plugin action "changed" there),
# like herdr's own client does with its live connection. One push at a time: an event during a push makes it run once more.
push_peers() {
    [ "$(cfg_get REMOTE_AGENTS off)" = on ] && [ "$(cfg_get PUSH_STATES on)" = on ] || return 0
    local lock=$SHARED_DIR/push.lock id label host prof en p k
    if ! lock_take "$lock" "$$"; then : > "$SHARED_DIR/push.pending"; return 0; fi
    while true; do
        rm -f "$SHARED_DIR/push.pending"
        herdr machine list 2>/dev/null | tr '\t' '\037' | while IFS=$US read -r id label host prof en; do
            [ -n "$label" ] && [ "$label" != "$HOST" ] && [ "$en" = enabled ] || continue
            herdr --machine "$label" plugin action invoke changed --plugin bhote.panel >/dev/null 2>&1 & p=$!
            ( sleep 6; kill "$p" 2>/dev/null ) & k=$!                # an unreachable machine must not hold the event up
            wait "$p" 2>/dev/null; kill "$k" 2>/dev/null
        done
        [ -e "$SHARED_DIR/push.pending" ] || break
    done
    lock_drop "$lock" "$$"
}
pane_question_text() {  # pane_question_text: stdin = the pane's text; prints the agent's last line when it ends with a question (above the input box, footers skipped)
    awk '{ l[NR] = $0 }
        END { box = 0; n2 = 0
            for (i = NR; i >= 1; i--) if (l[i] ~ /^(─)+$/) { n2++; if (n2 == 2) { box = i; break } }
            if (box == 0) box = NR + 1
            for (i = box - 1; i >= 1; i--) {
                t = l[i]; gsub(/^[ \t]+|[ \t\r]+$/, "", t)
                if (t == "" || t ~ /^(✻|✽|✶|✢|※|\*|·)( |$)/ || t ~ /^(⏵|⏸)/) continue
                sub(/^(●|⏺) */, "", t)
                if (t ~ /\?[)"\047”»]*$/) print t
                exit
            } }'
}
cli_event() {
    local ev pane st sess i f now; ev=${HERDR_PLUGIN_EVENT_JSON:-}; [ -n "$ev" ] || ev=$(head -c 65536)
    command -v jq >/dev/null 2>&1 || return 0
    read -r pane st sess <<< "$(printf '%s' "$ev" | jq -r '(.data // .) as $d | ($d.pane // $d) as $p |
        [ ($p.pane_id // $d.pane_id // ""), ($d.agent_status // $p.agent_status // $d.status // ""), (($p.agent_session.value // $d.agent_session.value // "") | tostring) ]
        | map(tostring | gsub("[^A-Za-z0-9:_-]"; "")) | map(if . == "" then "-" else . end) | join(" ")' 2>/dev/null)"
    poke
    push_peers                                                 # the other machines' panels show it at once, too
    # the state this pane was in before (the first event after a start has none: an agent that was never busy is not "handing back")
    local prev="" sf="$SHARED_DIR/evstate/${pane//[^A-Za-z0-9:_-]/}"
    if [ -n "$pane" ] && [ "$pane" != - ]; then mkdir -p "$SHARED_DIR/evstate" 2>/dev/null; { read -r prev < "$sf"; } 2>/dev/null; printf '%s\n' "$st" > "$sf" 2>/dev/null; fi
    case "$st" in done|idle|blocked|working) ;; *) return 0 ;; esac
    store_synced && store_sync >/dev/null 2>&1   # the topic may have been handed out on the other machine
    [ "$pane" = - ] && pane=""; [ "$sess" = - ] && sess=""
    topics_load; now=$(date +%s)
    local hit=0 auto
    for (( i = 0; i < T_N; i++ )); do
        # the session decides when both sides know it; a pane alone only on this machine, and only with no other session on record
        if { [ -n "$sess" ] && [ "${T_AS[$i]}" = "$sess" ]; } \
           || { [ -n "$pane" ] && [ "${T_AP[$i]}" = "$pane" ] && [ "${T_AM[$i]}" = "$HOST" ] && { [ -z "$sess" ] || [ -z "${T_AS[$i]}" ]; }; }; then
            f=${T_FILE[$i]}
            [ "$(topic_get "$f" auto_now)" = 1 ] && continue                              # (the card bhote made for an agent without a topic is no topic of its own)
            case "${T_STATUS[$i]}" in now|review|waiting|next) hit=1 ;; esac             # (it has a topic: no extra one)
            case "$st" in
                working)                                           # the user answered: what bhote put under review for it goes away or back
                    if [ "$(topic_get "$f" auto)" = 1 ]; then topic_set "$f" deleted 1
                    elif [ "${T_STATUS[$i]}" = review ] && { [ "$(topic_get "$f" auto_back)" = 1 ] || [ "$prev" != working ]; }; then
                        topic_set "$f" status now; topic_set "$f" auto_back ""     # (any review topic: the agent working again is the answer; no need for the agent to remember)
                    fi ;;
                *)
                    [ "${T_STATUS[$i]}" = now ] || continue
                    [ $(( now - $(num_or "${T_DL[$i]}" 0) )) -ge 5 ] || continue      # the idle right after handing it over is not "finished"
                    topic_set "$f" status review; topic_set "$f" auto_back 1
                    notify "Ready for review" "${T_TITLE[$i]} (${T_AG[$i]:-agent})" request ;;
            esac
        fi
    done
    # no topic at all and the agent waits for an answer (blocked) or ends its turn with a question: a review topic of its own, gone when it works again
    local ask=""
    if [ "$st" != working ] && [ "$hit" = 0 ] && [ "$prev" = working ] && [ -n "$pane" ] && [ "$(cfg_get AUTO_REVIEW on)" = on ]; then
        if [ "$st" = blocked ]; then ask="needs your answer"
        elif [ "${BHOTE_FAKE_QUESTION+x}" = x ]; then ask=$BHOTE_FAKE_QUESTION
        else ask=$(herdr pane read "$pane" --source recent-unwrapped --lines 80 2>/dev/null | pane_question_text); fi
    fi
    if [ -n "$ask" ]; then
        local line m_ aid ast anm atask; anm=""; atask=""
        # shellcheck disable=SC2066  # one file on purpose (a loop, so that break ends the search)
        for line in "$AGENT_LOCAL"; do [ -r "$line" ] && while IFS=$US read -r m_ aid ast anm atask; do [ "$m_" = "$HOST" ] && [ "$aid" = "$pane" ] && break; anm=""; atask=""; done < "$line"; done
        anm=${anm:-agent}
        [ "$ask" = "needs your answer" ] && atask="needs your answer" || atask=$ask            # the question itself is the description
        if topic_new "Question from ${anm//[[:cntrl:]]/}" "" "${atask//[[:cntrl:]]/}"; then
            f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"
            topic_set "$f" status review; topic_set "$f" auto 1; topic_set "$f" agent "$anm"; topic_set "$f" agent_machine "$HOST"; topic_set "$f" agent_pane "$pane"
            [ -n "$sess" ] && topic_set "$f" agent_session "${sess//[^A-Za-z0-9-]/}"
            notify "Question from $anm" "${atask:0:80}" request
        fi
    fi
    return 0
}
# `bhote current`: the topic of the agent that asks (its Claude session, else its herdr pane). For a SessionStart hook: the
# agent learns what it works on and how to report back. Prints nothing (exit 0) when there is none.
cli_bar() {  # bhote bar: one line for a status bar (Waybar-style JSON: text, tooltip, class), from the topic files and the
    # panels' agent lists (no herdr call): the number of things for you (topics in review, agents that wait for an answer)
    local i n=0 rv=0 wt=0 nw=0 busy=0 blk=0 m id st name task tip="" line
    topics_load
    for (( i = 0; i < T_N; i++ )); do
        case "${T_STATUS[$i]}" in
            review) rv=$(( rv + 1 )); [ "$rv" -le 6 ] && tip="$tip"$'\n'"  ● ${T_TITLE[$i]}" ;;
            waiting) wt=$(( wt + 1 )) ;; now) nw=$(( nw + 1 )) ;;
        esac
    done
    while IFS=$US read -r m id st name task; do
        case "$st" in working|testing) busy=$(( busy + 1 )) ;; blocked) blk=$(( blk + 1 )); line="  ◉ $name ($m)"; tip="$tip"$'\n'"$line" ;; esac
    done < <(agents_all)
    n=$(( rv + blk ))
    local text="" cls=idle head
    [ "$n" -gt 0 ] && { text="$n"; cls=attention; }
    [ "$n" = 0 ] && [ "$busy" -gt 0 ] && cls=busy
    head="bhote: $rv in review · $blk need an answer · $busy busy · $nw now · $wt waiting"
    printf '{"text":%s,"tooltip":%s,"class":%s,"review":%d,"blocked":%d,"busy":%d,"now":%d,"waiting":%d}\n' \
        "$(json_str "$text")" "$(json_str "$head$tip")" "$(json_str "$cls")" "$rv" "$blk" "$busy" "$nw" "$wt"
}
cli_current() {
    local i f hit=""; topics_load
    for (( i = 0; i < T_N; i++ )); do
        case "${T_STATUS[$i]}" in now|review|waiting) ;; *) continue ;; esac
        if { [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "${T_AS[$i]}" = "${CLAUDE_CODE_SESSION_ID//[!A-Za-z0-9-]/}" ]; } \
           || { [ -n "${HERDR_PANE_ID:-}" ] && [ "${T_AP[$i]}" = "$HERDR_PANE_ID" ] && [ "${T_AM[$i]}" = "$HOST" ] \

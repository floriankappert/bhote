# Where this runs: the first name, the machine, herdr's version and the agents of ALL machines (see collect_agents).
bhote_info() {  # what never changes while bhote runs: asked once (its own guard: an exported HOST must not skip it)
    if [ -z "${BHOTE_INFO_DONE:-}" ]; then
        BHOTE_INFO_DONE=1
        WHO=$(git config user.name 2>/dev/null | awk '{print $1}'); WHO=${WHO:-${USER:-friend}}
        HERDR_V=$(herdr --version 2>/dev/null | awk '{print $NF}')
        # how this machine is called in the lists: HOST_LABEL in the config, else "Mac" on macOS, else the short host name
        cfg_var HOST HOST_LABEL ""
        [ -n "$HOST" ] || { HOST=$([ "$(uname -s)" = Darwin ] && echo Mac || { hostname -s 2>/dev/null || uname -n; }); HOST=${HOST%%.*}; }
        HOST=${HOST//[[:cntrl:]]/}; HOST=${HOST:-local}
        HAS_MACHINES=$([ -n "$(herdr machine list 2>/dev/null)" ] && echo 1 || echo 0)
        focus_key_set FOCUS_KEY; cfg_var FIND_KEY_SHOW FIND_KEY off; key_pretty FIND_KEY_SHOW "$FIND_KEY_SHOW"
    fi
}
# Everything a screen needs, read ONCE per repaint and without starting a single process (except one `date`): the settings,
# the sync state, both agent files and the topics. The screen functions then only print. (Every awk/cat/wc/cut that the
# drawing used to start cost 5 to 15 ms; a key press took 300 ms.)
ui_load() {
    local line st="" f sig
    theme_sig sig; [ "$sig" = "$THEME_SIG" ] || { theme_apply; THEME_SIG=$sig; }   # THEME / COLOR_* changed: new colours now
    if [ -z "${HEAD_GRAD:-}" ]; then                         # once: one colour per character costs a process each
        HEAD_GRAD=$(gradient "Bhote v$VERSION"); [ "$color" = 1 ] && HEAD_GRAD="${esc}[1m$HEAD_GRAD"
    fi
    [ -n "${NOW_BASE:-}" ] || NOW_BASE=$(( $(date +%s) - SECONDS ))   # one date for the whole run, then SECONDS counts on
    NOW=$(( NOW_BASE + SECONDS ))
    cfg_var U_NAME_COLORS NAME_COLORS ""; cfg_var U_GITHUB GITHUB_BRANCHES on; cfg_var U_DONE_MAX DONE_MAX 7; cfg_var U_AGENT_ROWS AGENT_ROWS ""; num_set U_AGENT_ROWS "$U_AGENT_ROWS" ""; cfg_var U_STORE STORE local; cfg_var U_STORE_MACHINE STORE_MACHINE ""; cfg_var U_REMOTE REMOTE_AGENTS off
    U_STORE_HUB=""; U_STORE_HUB_ONLINE=""
    if [ -r "$STORE_STATUS" ]; then while IFS= read -r line; do case "$line" in state=*) st=${line#state=} ;; hub=*) U_STORE_HUB=${line#hub=} ;; hub_online=*) U_STORE_HUB_ONLINE=${line#hub_online=} ;; esac; done < "$STORE_STATUS"; fi
    U_STORE_STATE=$st
    if [ -n "${KEYS_CACHE:-}" ] && [ "$KEYS_CACHE" -nt "$RUN_DIR/keys.loaded" ]; then focus_key_set FOCUS_KEY; cfg_var FIND_KEY_SHOW FIND_KEY off; key_pretty FIND_KEY_SHOW "$FIND_KEY_SHOW"; fi   # (the other machine's keys arrived or changed)
    local _sd _wl; cfg_var _sd SETUP_DONE ""; cfg_var _wl WIZARD_LEVEL ""; num_set _wl "$_wl" 1; NEWFEAT=0
    [ -n "$_sd" ] && [ "$_wl" -lt "$FEATURE_LEVEL" ] && NEWFEAT=1
    local _uc; cfg_var _uc UPDATE_CHECK on; UPD_LATEST=""; [ "$_uc" = on ] && update_load
    HEAD_ROWS=0; HEAD_NOTE=""
    [ -n "$UPD_LATEST" ] && { [ -n "${UPD_CMD:-}" ] || UPD_CMD=$(update_command); HEAD_NOTE="⬆ Update available v$UPD_LATEST · , settings"; HEAD_ROWS=1; }
    [ "$NEWFEAT" = 1 ] && HEAD_ROWS=$(( HEAD_ROWS + 1 ))
    store_tag > /dev/null; STORE_TAG=$STORE_TAG_OUT
    AG_N=0; AG_LINES=()
    for f in "$AGENT_LOCAL" "$AGENT_REMOTE"; do
        [ -r "$f" ] && while IFS= read -r line; do [ -n "$line" ] && { AG_LINES[$AG_N]=$line; AG_N=$(( AG_N + 1 )); }; done < "$f"
    done
    AGENTS=$AG_N
    topics_load
    projects_load; current_project; topics_projects; cfg_var U_SCOPE TOPICS_SCOPE all
}

# ── the agents of every machine: this one and every enabled saved machine (herdr --machine <label>). Collected in the
# background (ssh takes a second or two), so drawing never waits for it. One line per agent in AGENT_LOCAL / AGENT_REMOTE:
# machine US pane id US status US workspace US topic   (US = the unit separator, 0x1F; control characters are cleaned out of every field)
US=$'\037'      # field separator of the agent lists: not whitespace, so empty fields stay fields (a TAB would collapse them)
AGENT_LOCAL="$SHARED_DIR/agents.local"
AGENT_REMOTE="$SHARED_DIR/agents.remote"
agents_all() { cat "$AGENT_LOCAL" "$AGENT_REMOTE" 2>/dev/null; }
herdr_m() { if [ "${1:-}" = --machine ]; then with_timeout 20 herdr "$@"; else herdr "$@"; fi; }   # another machine: a hung ssh ends as an error
collect_one() {  # collect_one <machine label> [herdr options: --machine X]
    local label=$1 panes="" ws="" snap; shift
    if [ $# -gt 0 ]; then                                      # another machine: one call (each one costs an ssh connection)
        snap=$(herdr_m "$@" api snapshot 2>/dev/null)
        if [ -n "$snap" ]; then
            panes=$(printf '%s' "$snap" | jq -c '{result: {panes: (.result.snapshot.panes // empty)}}' 2>/dev/null)
            ws=$(printf '%s' "$snap" | jq -c '{result: {workspaces: (.result.snapshot.workspaces // [])}}' 2>/dev/null)
        fi
    fi
    if [ -z "$panes" ]; then panes=$(herdr_m "$@" pane list 2>/dev/null) || { [ $# -gt 0 ] && return 2; return 0; }; ws=$(herdr_m "$@" workspace list 2>/dev/null); fi
    if [ -n "${COLLECT_META:-}" ]; then                       # per pane: its tab, whether an agent runs there, the repo and project tokens
        printf '%s' "$panes" | jq -r --arg m "$label" '.result.panes[]? | [$m, .pane_id, (.tab_id // ""), (if .agent then "a" else "" end), (.tokens.repo // ""), (.tokens.project // ""), (.foreground_cwd // .cwd // "")] | map(tostring | gsub("[\u0000-\u001f]"; "")) | join("\u001f")' >> "$COLLECT_META" 2>/dev/null
    fi
    if [ $# -eq 0 ]; then                                      # this machine: where its agents work (their branch, see branch_sync)
        printf '%s' "$panes" | jq -r '.result.panes[] | select(.agent) | [.pane_id, ((.foreground_cwd // .cwd // "") | tostring | gsub("[\u0000-\u001f]"; ""))] | join("\u001f")' > "$AGENT_CWD.tmp.$$" 2>/dev/null \
            && mv "$AGENT_CWD.tmp.$$" "$AGENT_CWD" 2>/dev/null
    fi
    # control characters out of every text (a name must not carry escape codes to the terminal), only plain pane ids
    local tb; cfg_var tb TESTS_BUSY off
    printf '%s\n%s\n' "$panes" "$ws" | jq -rs --arg m "$label" --arg tb "$tb" '
        def clean: gsub("[\u0001-\u001f\u007f-\u009f]"; "");
        ((.[1].result.workspaces // []) | map({(.workspace_id): (.label | tostring | clean)}) | add // {}) as $w |
        # a test run in the workspace of the agent (its tests token starts with ◌ while it runs or waits) makes it busy
        ((.[1].result.workspaces // []) | map({(.workspace_id): ((.tokens.tests // "") | tostring | startswith("◌"))}) | add // {}) as $t
        | .[0].result.panes[] | select(.agent) | select(.pane_id | test("^[A-Za-z0-9:_-]+$"))
        | [($m | clean), .pane_id, (if ($tb == "on") and ($t[.workspace_id] // false) and ((.agent_status // "") != "working") then "testing" else ((.agent_status // "") | tostring | clean) end), (($w[.workspace_id] // .workspace_id // "") | tostring | clean), ((.tokens.task // "") | tostring | clean | ltrimstr("∟ "))] | join("\u001f")' 2>/dev/null
}
agents_put() {  # agents_put <tmp> <list file>: only a changed list replaces the old one, and counts up the revision the panels watch
    if cmp -s "$1" "$2" 2>/dev/null; then rm -f "$1"; touch "$2" 2>/dev/null; return 0; fi   # (its time says "fresh" to bhote find)
    mv "$1" "$2"; printf '%s %s\n' "$(date +%s)" "$$$RANDOM" > "$SHARED_DIR/agents.rev" 2>/dev/null
}
collect_local() {
    : > "$AGENT_META_L.tmp.$$"; COLLECT_META="$AGENT_META_L.tmp.$$" collect_one "$HOST" > "$AGENT_LOCAL.tmp.$$"
    mv "$AGENT_META_L.tmp.$$" "$AGENT_META_L" 2>/dev/null; agents_put "$AGENT_LOCAL.tmp.$$" "$AGENT_LOCAL"
}
AGENT_META_L="$SHARED_DIR/agents.meta.local"; AGENT_META_R="$SHARED_DIR/agents.meta.remote"   # machine US pane US tab US a US repo US project US cwd
agent_meta() {  # agent_meta <machine> <pane>: AM_REPO, AM_PROJECT, AM_TAB of an agent (from the last collection)
    local m p t a r j c; AM_REPO=""; AM_PROJECT=""; AM_TAB=""
    while IFS=$US read -r m p t a r j c; do [ "$m" = "$1" ] && [ "$p" = "$2" ] && { AM_REPO=$r; AM_PROJECT=$j; AM_TAB=$t; return 0; }; done < <(cat "$AGENT_META_L" "$AGENT_META_R" 2>/dev/null)
    return 1
}
project_sync() {  # this machine's agents carry their repository and project as herdr tokens (repo, project): the other machines read them
    [ -r "$AGENT_META_L" ] || return 0
    local m p t a r j c key ws cache="$SHARED_DIR/repo.cache" line hit name
    projects_load
    while IFS=$US read -r m p t a r j c; do
        [ "$a" = a ] || continue
        hit=""; [ -r "$cache" ] && while IFS=$US read -r line key; do [ "$line" = "$c" ] && { hit=1; break; }; done < "$cache"
        if [ -z "$hit" ]; then git_repo_key_set key "$c" || key=""; printf '%s\n' "$c$US$key" >> "$cache"; fi   # once per folder
        ws=""; while IFS=$US read -r _m _id _st name _tk; do [ "$_id" = "$p" ] && { ws=$name; break; }; done < "$AGENT_LOCAL"
        project_for "$key" "$ws" || PROJ_ID=""
        [ "$key" = "$r" ] && [ "$PROJ_ID" = "$j" ] && continue
        herdr pane report-metadata "$p" --source bhote $( [ -n "$key" ] && echo "--token repo=$key" || echo "--clear-token repo" ) \
            $( [ -n "$PROJ_ID" ] && echo "--token project=$PROJ_ID" || echo "--clear-token project" ) >/dev/null 2>&1   # (the pane first: herdr wants it so)
    done < "$AGENT_META_L"
    return 0
}
AGENT_CWD="$SHARED_DIR/agents.cwd"                             # pane US working folder of this machine's agents (for their branch)
git_branch_set() {  # git_branch_set <var> <folder>: the branch checked out there (worktrees too), "@1234abc" when detached; read from .git, no git call
    local _d=$2 _h="" _g _l _n=0; printf -v "$1" '%s' ""
    while [ -n "$_d" ] && [ "$_n" -lt 40 ]; do
        if [ -d "$_d/.git" ]; then _h="$_d/.git/HEAD"; break; fi
        if [ -f "$_d/.git" ]; then IFS= read -r _g < "$_d/.git"; _g=${_g#gitdir: }; case "$_g" in /*) ;; *) _g="$_d/$_g" ;; esac; _h="$_g/HEAD"; break; fi
        [ "$_d" = / ] && break; _d=${_d%/*}; [ -n "$_d" ] || _d=/; _n=$(( _n + 1 ))
    done
    [ -n "$_h" ] && [ -r "$_h" ] || return 1
    IFS= read -r _l < "$_h" || return 1
    case "$_l" in "ref: refs/heads/"*) printf -v "$1" '%s' "${_l#ref: refs/heads/}" ;; [0-9a-f]*) printf -v "$1" '@%s' "${_l:0:7}" ;; *) return 1 ;; esac
}
branch_sync() {  # the topics of this machine's agents carry their branch (agent_branch, only written on a change: it travels with the topics)
    [ "$(cfg_get GITHUB_BRANCHES on)" = on ] && [ -r "$AGENT_CWD" ] || return 0
    local i p c br map=$'\n'
    while IFS=$US read -r p c; do [ -n "$p" ] && map="$map$p$US$c"$'\n'; done < "$AGENT_CWD"
    topics_load
    for (( i = 0; i < T_N; i++ )); do
        [ "${T_AM[$i]}" = "$HOST" ] && [ -n "${T_AP[$i]}" ] || continue
        case "${T_STATUS[$i]}" in done|later) continue ;; esac
        c=${map#*$'\n'"${T_AP[$i]}$US"}; [ "$c" = "$map" ] && continue; c=${c%%$'\n'*}
        git_branch_set br "$c" || br=""
        [ -n "$br" ] && [ "$br" != "${T_BR[$i]}" ] && topic_set "${T_FILE[$i]}" agent_branch "$br"
    done
    return 0
}
collect_remote() {  # only the saved machines that are switched on; with the setting off the file is emptied. A machine that does not
    # answer (herdr reconnecting) keeps the agents seen last, marked "off-<state>": the panel shows them muted, nobody gets work
    local id label host prof enabled out rc line m aid st name task offl="$SHARED_DIR/machines.offline"
    : > "$offl.tmp.$$"; : > "$AGENT_META_R.tmp.$$"
    { herdr machine list 2>/dev/null | tr '\t' '\037' | while IFS=$US read -r id label host prof enabled; do
          [ "$label" = "$HOST" ] && continue                   # would look like this machine's own agents (HOST_LABEL clash)
          [ "$enabled" = enabled ] && machine_wanted "$label" || continue
          out=$(COLLECT_META="$AGENT_META_R.tmp.$$" collect_one "$label" --machine "$label"); rc=$?
          if [ "$rc" = 2 ]; then
              echo "$label" >> "$offl.tmp.$$"
              [ -r "$AGENT_META_R" ] && awk -F"$US" -v l="$label" '$1 == l' "$AGENT_META_R" >> "$AGENT_META_R.tmp.$$" 2>/dev/null
              [ -r "$AGENT_REMOTE" ] && while IFS= read -r line; do
                  case "$line" in "$label$US"*) IFS=$US read -r m aid st name task <<< "$line"
                      case "$st" in off-*) ;; *) st="off-$st" ;; esac; printf '%s\n' "$m$US$aid$US$st$US$name$US$task" ;; esac
              done < "$AGENT_REMOTE"
          elif [ -n "$out" ]; then printf '%s\n' "$out"; fi
      done; } > "$AGENT_REMOTE.tmp.$$"
    mv "$offl.tmp.$$" "$offl" 2>/dev/null; mv "$AGENT_META_R.tmp.$$" "$AGENT_META_R" 2>/dev/null
    agents_put "$AGENT_REMOTE.tmp.$$" "$AGENT_REMOTE"
}
# herdr (0.9) gives every `herdr --machine` call an ssh master of its own (ControlPersist=yes, the socket in <tmp>/herdr-ssh-<pid>-<n>/)
# and nothing ends it after the call: the collector's calls left one per round, thousands overnight, until fork failed. The masters
# of herdr processes that are gone are ended here; a running herdr's (the server's, a call in progress) stay.
herdr_mux_sweep() {
    local t d o s seen=" " tmps=(/tmp "${TMPDIR:-/tmp}"); [ -n "${BHOTE_HERDR_TMP:-}" ] && tmps=("$BHOTE_HERDR_TMP")   # (herdr: $TMPDIR, else /tmp)
    for t in "${tmps[@]}"; do
        t=${t%/}; case "$seen" in *" $t "*) continue ;; esac; seen="$seen$t "
        for d in "$t"/herdr-ssh-*-*; do
            [ -d "$d" ] && [ ! -L "$d" ] && [ -O "$d" ] || continue
            o=${d##*/herdr-ssh-}; o=${o%%-*}
            case "$o" in ''|*[!0-9]*) continue ;; esac
            kill -0 "$o" 2>/dev/null && continue                 # its herdr still runs
            for s in "$d"/cm-*; do [ -S "$s" ] && "${BHOTE_SSH:-ssh}" -F /dev/null -o BatchMode=yes -O exit -S "$s" herdr >/dev/null 2>&1 </dev/null; done
            rm -rf "$d"
        done
    done
}
remind_waiting() {  # once per waiting topic that waits longer than WAIT_REMIND hours: a notification (remembered locally)
    local h i f now id; cfg_var h WAIT_REMIND 24; num_set h "$h" 24; [ "$h" -gt 0 ] || return 0
    topics_load; now=$(date +%s)
    for (( i = 0; i < T_N; i++ )); do
        [ "${T_STATUS[$i]}" = waiting ] || continue
        [ $(( now - $(num_or "${T_WSINCE[$i]}" "$now") )) -ge $(( h * 3600 )) ] || continue
        id="${T_ID[$i]}:${T_WSINCE[$i]}"; grep -qxF "$id" "$DATA_DIR/reminded" 2>/dev/null && continue
        echo "$id" >> "$DATA_DIR/reminded"
        notify "Still waiting" "${T_TITLE[$i]} · ${T_WFOR[$i]:-?} for ${h}h+" request
    done
}
# One panel per machine collects (herdr is asked once, not once per panel); the others only read the files. The collector is
# whoever holds $SHARED_DIR/collector.lock; when that process is gone, another panel takes over.
collector_lead() {  # collector_lead <main pid>: 0 when this panel is the collector
    lock_take "$SHARED_DIR/collector.lock" "$1"
}
# Auto-assign (AUTO_ASSIGN=on): a running topic without an agent goes to the next free agent, 20 s after its last change (time
# to add a description), the agents of AUTO_ASSIGN_MACHINE first (any: this machine). Each agent is asked live right before.
# It runs in the collector, so once per machine: when two machines share the topics, switch it on on ONE of them.
project_autoselect() {  # project_autoselect <text>: PROJ_ID of the project whose name stands in the text as whole words (the longest name; none when two differ)
    local txt pn best="" bl=0 k tie=0 n; PROJ_ID=""
    projects_load                                              # (the projects may have changed since the last look)
    txt=" $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]' ' ' | tr -s ' ') "
    for (( k = 0; k < P_N; k++ )); do
        pn=$(printf '%s' "${P_NAME[$k]}" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]' ' ' | tr -s ' '); pn=${pn# }; pn=${pn% }
        [ "${#pn}" -ge 3 ] || continue
        case "$txt" in *" $pn "*) n=${#pn}
            if [ "$n" -gt "$bl" ]; then best=${P_ID[$k]}; bl=$n; tie=0; elif [ "$n" = "$bl" ] && [ "${P_ID[$k]}" != "$best" ]; then tie=1; fi ;; esac
    done
    [ -n "$best" ] && [ "$tie" = 0 ] || return 1
    PROJ_ID=$best
}
agent_cards() {  # a working agent of this machine without a topic gets a card on now (auto_now=1); it goes when the agent stops or gets a topic
    local on; cfg_var on AGENT_CARDS on; [ "$on" = on ] && [ -r "$AGENT_LOCAL" ] || return 0
    local i m id st name task key f title now cd="$RUN_DIR/cards" work=$'\n' owned=$'\n' cards=$'\n'
    mkdir -p "$cd"; now=$(date +%s)
    while IFS=$US read -r m id st name task; do
        [ "$m" = "$HOST" ] || continue
        key=${id//[^A-Za-z0-9_-]/_}
        case "$st" in
            working|testing) work="$work$id"$'\n'; [ -e "$cd/$key" ] || printf '%s\n' "$now" > "$cd/$key" ;;   # (the file: since when it works)
            *) rm -f "$cd/$key" ;;
        esac
    done < "$AGENT_LOCAL"
    topics_load
    for (( i = 0; i < T_N; i++ )); do
        [ "${T_AM[$i]}" = "$HOST" ] && [ -n "${T_AP[$i]}" ] || continue
        [ "$(topic_get "${T_FILE[$i]}" auto_now)" = 1 ] && continue
        case "${T_STATUS[$i]}" in now|review|waiting|next) owned="$owned${T_AP[$i]}"$'\n' ;; esac
    done
    for (( i = 0; i < T_N; i++ )); do
        [ "${T_AM[$i]}" = "$HOST" ] && [ -n "${T_AP[$i]}" ] || continue
        f=${T_FILE[$i]}; [ "$(topic_get "$f" auto_now)" = 1 ] || continue
        case "$work" in *$'\n'"${T_AP[$i]}"$'\n'*) ;; *) topic_set "$f" deleted 1; continue ;; esac       # the agent stopped
        case "$owned" in *$'\n'"${T_AP[$i]}"$'\n'*) topic_set "$f" deleted 1; continue ;; esac            # it got a topic of its own
        cards="$cards${T_AP[$i]}"$'\n'
        while IFS=$US read -r m id st name task; do
            [ "$m" = "$HOST" ] && [ "$id" = "${T_AP[$i]}" ] || continue
            title=${task:-$name}; title=${title//[[:cntrl:]]/}; [ -n "$title" ] && [ "$title" != "${T_TITLE[$i]}" ] && topic_set "$f" title "${title:0:500}"
        done < "$AGENT_LOCAL"
    done
    while IFS=$US read -r m id st name task; do
        [ "$m" = "$HOST" ] || continue
        case "$work" in *$'\n'"$id"$'\n'*) ;; *) continue ;; esac
        case "$owned$cards" in *$'\n'"$id"$'\n'*) continue ;; esac
        key=${id//[^A-Za-z0-9_-]/_}; [ $(( now - $(num_or "$(cat "$cd/$key" 2>/dev/null)" "$now") )) -ge 15 ] || continue   # short turns make no card
        title=${task:-$name}
        topic_new "$title" "" "" || continue
        f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"
        topic_set "$f" auto_now 1; topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$HOST"; topic_set "$f" agent_pane "$id"
    done < "$AGENT_LOCAL"
    return 0
}
auto_assign() {
    local on pref i k m id st name task f now used="" pass t pick sess tpj SEL_ID=""
    cfg_var on AUTO_ASSIGN off; [ "$on" = on ] || return 0
    cfg_var pref AUTO_ASSIGN_MACHINE any; [ "$pref" = any ] && pref=$HOST
    topics_load; now=$(date +%s)
    AG_N=0; AG_LINES=()
    for f in "$AGENT_LOCAL" "$AGENT_REMOTE"; do [ -r "$f" ] && while IFS= read -r t; do [ -n "$t" ] && { AG_LINES[$AG_N]=$t; AG_N=$(( AG_N + 1 )); }; done < "$f"; done
    for (( i = 0; i < T_N; i++ )); do
        [ "${T_STATUS[$i]}" = now ] && [ -z "${T_AP[$i]}" ] && [ -z "${T_TN[$i]}" ] || continue
        [ $(( now - $(num_or "${T_UPD[$i]}" "$now") )) -ge 20 ] || continue
        # the project decides which agents come into question: a topic without one gets it from its words (project_autoselect), else it waits
        tpj=${T_PJ[$i]}
        if [ -z "$tpj" ]; then project_autoselect "${T_TITLE[$i]} ${T_DESC[$i]}" && { tpj=$PROJ_ID; topic_set "${T_FILE[$i]}" project "$tpj"; topic_set "${T_FILE[$i]}" project_auto 1; }; fi
        [ -n "$tpj" ] || continue
        pick=""
        for pass in pref other; do
            for (( k = 0; k < AG_N; k++ )); do
                IFS=$US read -r m id st name task <<< "${AG_LINES[$k]}"
                agent_meta "$m" "$id"; [ "$AM_PROJECT" = "$tpj" ] || continue                  # only the agents of the topic's project
                if [ "$pass" = pref ]; then [ "$m" = "$pref" ] || continue; else [ "$m" != "$pref" ] || continue; fi
                case "$st" in idle|done) ;; *) continue ;; esac
                case " $used " in *" $m/$id "*) continue ;; esac
                agent_taken "$m" "$id" && continue
                agent_live "$m" "$id"; case "$LIVE_ST" in idle|done) ;; *) continue ;; esac   # the lists are seconds old
                pick="$m$US$id$US$name"; sess=$LIVE_SESS; break 2
            done
        done
        [ -n "$pick" ] || continue                             # no free agent of this project now: the next round (another project may have one)
        IFS=$US read -r m id name <<< "$pick"; used="$used $m/$id"; f=${T_FILE[$i]}
        [ "$(topic_get "$f" status)" = now ] && [ -z "$(topic_get "$f" agent_pane)" ] || continue   # changed meanwhile
        topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
        topic_set "$f" agent_session "$sess"; topic_set "$f" delegated "$now"
        agent_send "$m" "$id" "Your bhote topic: $(delegation_text "$f")"
        notify "Auto-assigned" "${T_TITLE[$i]} → $name" done
    done
}
collector() {  # collector <main pid>; runs in the background: local often, remote less often, both read the settings anew each round
    local every_l every_r last_r=-999999 last_s=-999999 sync_pid="" last_k=-999999 slack_pid="" every_k w
    local last_d=-999999 dep_pid="" every_d last_t=-999999 tst_pid="" every_t rem_pid="" lead upd_pid="" last_u=-999999 last_h=-999999 key_pid="" mux_pid="" last_x=-999999
    local KW_READ="" KW_WATCH="" KW_AT=0 KW_WAIT=0 KW_NEXT=0 me every_s   # the kharka follower (kharka_follow_keep)
    self_pid_set me 2>/dev/null; [ -n "$me" ] || me=$1                 # (the follower ends when this pid is gone; else the panel's)
    trap 'kharka_follow_stop; kill $sync_pid $slack_pid $dep_pid $tst_pid $rem_pid $upd_pid $key_pid $mux_pid 2>/dev/null; exit 0' TERM   # its background rounds do not outlive it
    find "$SHARED_DIR" -maxdepth 1 -name 'agents.*.tmp.*' -mmin +1 -exec rm -f {} + 2>/dev/null   # left by a killed collector
    while true; do
        kill -0 "$1" 2>/dev/null || { kharka_follow_stop; kill $sync_pid $slack_pid $dep_pid $tst_pid $rem_pid $upd_pid $key_pid $mux_pid 2>/dev/null; exit 0; }   # the panel is gone (also after kill -9): stop, never loop on alone
        cfg_var every_l LOCAL_EVERY 3; cfg_var every_r REMOTE_EVERY 5
        case "$every_l" in ''|*[!0-9]*|0) every_l=3 ;; esac; case "$every_r" in ''|*[!0-9]*|0) every_r=5 ;; esac
        lead=0
        if collector_lead "$1"; then
            lead=1; local remote_due=0; [ $(( SECONDS - last_r )) -ge "$every_r" ] && { remote_due=1; last_r=$SECONDS; }
            [ -e "$SHARED_DIR/remote.due" ] && ! { [ -n "$rem_pid" ] && kill -0 "$rem_pid" 2>/dev/null; } && { rm -f "$SHARED_DIR/remote.due"; remote_due=1; last_r=$SECONDS; }   # pushed by the other machine (kept while a round still runs)
            collect_local                                       # first what the panels show; the merge can take a moment
            agentnum_assign
            branch_sync; project_sync
            if [ "$(cfg_get REMOTE_AGENTS off)" = on ]; then
                # in the background (a slow machine must not hold up the local agents, auto-assign and the reminders); one at a time
                if [ "$remote_due" = 1 ] && ! { [ -n "$rem_pid" ] && kill -0 "$rem_pid" 2>/dev/null; }; then ( collect_remote ) & rem_pid=$!; fi
            elif [ -s "$AGENT_REMOTE" ]; then : > "$AGENT_REMOTE.tmp.$$"; agents_put "$AGENT_REMOTE.tmp.$$" "$AGENT_REMOTE"; fi
            # the data location: at once after a local change, otherwise every REMOTE_EVERY seconds (its own clock: a push of
            # the other machine's agents does not move it). In the background: over herdr a merge takes a few seconds, and an
            # agent push must not wait for it. One at a time (its pid: in a subshell $$ is ours, so the lock alone cannot tell)
            # With kharka its watch asks for a merge and wakes us at once (kharka_follow_keep); every minute is only a safety net.
            kharka_follow_keep "$me"
            cfg_var every_s STORE local; if [ "$every_s" = kharka ]; then every_s=60; else every_s=$every_r; fi
            if [ -n "$sync_pid" ] && kill -0 "$sync_pid" 2>/dev/null; then :
            elif [ -e "$STORE_DIRTY" ]; then rm -f "$STORE_DIRTY"; last_s=$SECONDS
                ( store_sync; [ $? = 2 ] && : > "$STORE_DIRTY" ) & sync_pid=$!
            elif [ $(( SECONDS - last_s )) -ge "$every_s" ]; then last_s=$SECONDS; ( store_sync ) & sync_pid=$!; fi
            if [ "$(cfg_get SLACK_WATCH off)" = on ] && ! { [ -n "$slack_pid" ] && kill -0 "$slack_pid" 2>/dev/null; }; then
                cfg_var every_k SLACK_EVERY 120; num_set every_k "$every_k" 120
                [ $(( SECONDS - last_k )) -ge "$every_k" ] && { last_k=$SECONDS; ( slack_check ) & slack_pid=$!; }   # in the background: a call takes seconds
            fi
            if [ "$(cfg_get DEPLOY_MONITOR off)" = on ] && ! { [ -n "$dep_pid" ] && kill -0 "$dep_pid" 2>/dev/null; }; then
                cfg_var every_d DEPLOY_EVERY 60; num_set every_d "$every_d" 60
                [ $(( SECONDS - last_d )) -ge "$every_d" ] && { last_d=$SECONDS; ( monitor_fetch deploys ) & dep_pid=$!; }
            fi
            if [ "$(cfg_get TEST_MONITOR off)" = on ] && ! { [ -n "$tst_pid" ] && kill -0 "$tst_pid" 2>/dev/null; }; then
                cfg_var every_t TEST_EVERY 60; num_set every_t "$every_t" 60
                [ $(( SECONDS - last_t )) -ge "$every_t" ] && { last_t=$SECONDS; ( monitor_fetch tests ) & tst_pid=$!; }
            fi
            if [ "$(cfg_get UPDATE_CHECK on)" = on ] && [ $(( SECONDS - last_u )) -ge 21600 ] && ! { [ -n "$upd_pid" ] && kill -0 "$upd_pid" 2>/dev/null; }; then
                last_u=$SECONDS; ( update_fetch ) & upd_pid=$!                  # the first time at start, then every 6 hours
            fi
            keys_cache_set                                       # the keys of the herdr you type into, when that is another machine
            if [ -n "$KEYS_CACHE" ] && ! { [ -n "$key_pid" ] && kill -0 "$key_pid" 2>/dev/null; } \
               && { [ $(( SECONDS - last_h )) -ge 300 ] || { [ ! -s "$KEYS_CACHE" ] && [ $(( SECONDS - last_h )) -ge 20 ]; }; }; then
                last_h=$SECONDS; ( keys_fetch ) & key_pid=$!
            fi
            if [ $(( SECONDS - last_x )) -ge 60 ] && ! { [ -n "$mux_pid" ] && kill -0 "$mux_pid" 2>/dev/null; }; then
                last_x=$SECONDS; ( herdr_mux_sweep ) & mux_pid=$!           # the ssh masters herdr leaves behind (at start, then every minute)
            fi
            remind_waiting
            auto_assign
            agent_cards
        fi
        if [ "$lead" = 0 ]; then kharka_follow_stop; sleep "$every_l"; continue; fi   # not the lead: nobody takes a poke here (and nobody follows kharka), one sleep
        w=0; while [ "$w" -lt $(( every_l * 5 )) ]; do         # wait in 0.2 s steps: a poke (agent event, CLI change) ends it
            if [ -e "$SHARED_DIR/poke" ] && [ "$(readlink "$SHARED_DIR/collector.lock" 2>/dev/null)" = "$1" ]; then
                rm -f "$SHARED_DIR/poke"; break                     # only the collector takes the poke (the others would swallow it)
            fi; sleep 0.2; w=$(( w + 1 )); done
    done
}

# The line of an old arcade game, in capitals, blinking: drawn once with the frame (splash_prompt_row), then toggled in
# place by the animation (splash_prompt_at). SPLASH_PROMPT_ROW is the screen row of that line (tests/smoke.sh checks it).
PROMPT_TEXT="PRESS ANY KEY TO START"
SPLASH_PROMPT_ROW=35      # grows by SPLASH_E on a taller pane
prompt_shown() {  # prompt_shown <on|off>
    if [ "$1" = on ]; then printf '%s%s%s%s' "$Y" "$BOLD" "$PROMPT_TEXT" "$X"; else printf '%*s' "${#PROMPT_TEXT}" ""; fi
}
splash_prompt_row() { mid "$PROMPT_TEXT" "$(prompt_shown on)"; }
splash_prompt_at() {  # splash_prompt_at <on|off>
    printf '%s[%d;%dH%s' "$esc" "$SPLASH_PROMPT_ROW" $(( 2 + (WIDTH - 2 - ${#PROMPT_TEXT}) / 2 )) "$(prompt_shown "$1")"
}


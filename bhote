                 [ -n "${T_SL[$i]}" ] && { state="Slack monitor (${T_SL[$i]})"; sc=$S; } ;;   # a pinned Slack channel is watched
        review) who=${T_AG[$i]}; state="ready for review"; sc=$BLUE; ago_set tm "${T_UPD[$i]:-$NOW}"
                [ -n "${T_SM[$i]}" ] && { who="slack"; state=${T_SM[$i]//¶/}; state=${state//\`/}; state=${state//\*/}
                    while [ "${state/  / }" != "$state" ]; do state=${state//  / }; done; sc=$S; } ;;   # an answer in Slack
        next|later) ago_set tm "${T_UPD[$i]:-$NOW}" ;;
        done) ago_set tm "${T_UPD[$i]:-$NOW}" ;;            # (the panel shows done ones in their own area, with this time)

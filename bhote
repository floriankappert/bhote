#!/usr/bin/env bash
# bhote — start screen: a framed welcome like Claude Code's (name and version in the top edge), a compass over a
# gradient wordmark, then a few lines about where it runs. Truecolor; NO_COLOR=1 prints it plain. Bash 3.2 compatible.
# Palette = the Catppuccin values of the herdr sidebar (teal, blue, mauve, pink, peach); the dog has its own.
# UTF-8 is needed (the frame, the dog, ${#var} counting characters). Only when the current locale is not UTF-8, switch to one
# that is installed (forcing a missing one would drop to the C locale and garble every multibyte character).
case "$(locale charmap 2>/dev/null)" in
    UTF-8|utf8|utf-8) ;;
    *) for _l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
           if locale -a 2>/dev/null | grep -qx "$_l"; then export LC_ALL=$_l; break; fi
       done ;;
esac
umask 077                                                             # everything bhote writes is for this user only
RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bhote.XXXXXX") || exit 1         # private (0700) scratch dir: nothing predictable in /tmp
trap 'rm -rf "$RUN_DIR"' EXIT
# What all panels of this machine share (the agent lists, "a change is waiting", which panel collects): a private folder that
# must belong to this user; if it does not (or cannot be made), every panel keeps to its own scratch dir.
SHARED_DIR=${BHOTE_SHARED:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/bhote-$UID}
if [ -L "$SHARED_DIR" ]; then SHARED_DIR=$RUN_DIR                    # a symlink there is not ours: never follow it (not even chmod)
else
    { [ -d "$SHARED_DIR" ] || mkdir -m 700 "$SHARED_DIR"; } 2>/dev/null
    if [ -d "$SHARED_DIR" ] && [ -O "$SHARED_DIR" ] && [ ! -L "$SHARED_DIR" ]; then chmod 700 "$SHARED_DIR" 2>/dev/null; else SHARED_DIR=$RUN_DIR; fi
fi
SPLASH_W=${BHOTE_WIDTH:-42}       # the start screen's least width; it grows with the pane (see splash_geometry)
WIDTH=$SPLASH_W
VERSION=${BHOTE_VERSION:-0.7.0}
# FEATURE_LEVEL: count it up whenever new options come to the settings (and put their wizard step in step_level). A machine whose
# wizard ran at a lower level (WIZARD_LEVEL, 1 when never set) shows "New Features Available" in the head, and `w` runs only the new steps.
FEATURE_LEVEL=3
NEWS="Steal & Transfer · see GitHub"   # one line for the welcome screen, e.g. "Steal & Transfer · read more on GitHub" (empty: none)
NEWS_LINK="see GitHub"                 # the part of NEWS that links to NEWS_URL (dotted underline, a terminal hyperlink: OSC 8)
NEWS_URL="https://github.com/floriankappert/bhote/blob/main/docs/steal-and-transfer.md"

# ── settings: ~/.config/bhote/config, plain KEY=value lines (never sourced). Everything that reaches beyond this machine
# is OFF until the user switches it on in the settings screen (","): bhote must not open SSH connections unasked.
#   REMOTE_AGENTS=on|off   ask the saved herdr machines for their agents, in the background (default off)
#   MACHINES_OFF=a,b       saved machines that stay out even when REMOTE_AGENTS is on
#   REMOTE_EVERY=10        seconds between two remote queries      LOCAL_EVERY=3   seconds between two local ones
#   TESTS_BUSY=on|off      an agent whose workspace is running tests counts as busy, not free (default off)
#   HOST_LABEL=Name        how this machine is called in the agent lists (default: Mac on macOS, else the host name)
#   NAME_COLORS=a=teal,b=mauve   colour agents by a part of their name (case-insensitive); colours: red teal peach mauve blue green yellow
#   SPLASH_AUTOCLOSE=on|off   the welcome screen closes by itself after SPLASH_SECONDS (default on, 15)
#   AUTOSTART=on|off       the herdr plugin opens the panel next to the agents when herdr starts (default on)
CONFIG_FILE=${BHOTE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bhote/config}
cfg_var() {  # cfg_var <var> <key> <default>: no subshell, no awk (the screen asks a dozen times)
    local _cl _cv=""   # odd names: the caller's target variable must never be shadowed
    if [ -r "$CONFIG_FILE" ]; then while IFS= read -r _cl; do [ "${_cl%%=*}" = "$2" ] && _cv=${_cl#*=}; done < "$CONFIG_FILE"; fi
    printf -v "$1" '%s' "${_cv:-$3}"
}
cfg_get() { cfg_var _CFG "$1" "$2"; printf '%s' "$_CFG"; }
# num_or <value> <default>: digits only, without leading zeros ("08" would be octal in $(( ))), at most 18 digits
num_or() { case "$1" in ''|*[!0-9]*) printf '%s' "$2" ;; *) local _v=${1#"${1%%[!0]*}"}; _v=${_v:-0}; [ "${#_v}" -le 18 ] || _v=$2; printf '%s' "$_v" ;; esac; }
num_set() {  # the same into a variable (no subshell)
    case "$2" in ''|*[!0-9]*) printf -v "$1" '%s' "$3" ;; *) local _v=${2#"${2%%[!0]*}"}; _v=${_v:-0}; [ "${#_v}" -le 18 ] || _v=$3; printf -v "$1" '%s' "$_v" ;; esac
}
# Every value that ends up in $(( )) must be plain digits first: bash expands a[$(cmd)] inside arithmetic and would RUN cmd.
cfg_set() {  # cfg_set KEY value [KEY value ...]: one rewrite, one mv (a value never contains a control character: it could add a line)
    local tmp line k keep a i=0 o
    mkdir -p "$(dirname "$CONFIG_FILE")"
    while ! ln -s "$$" "$CONFIG_FILE.lock" 2>/dev/null; do        # one writer at a time (the panel, the CLI, the wizard)
        o=$(readlink "$CONFIG_FILE.lock" 2>/dev/null); [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null && rm -f "$CONFIG_FILE.lock"
        i=$(( i + 1 )); [ "$i" -gt 40 ] && break; sleep 0.05
    done
    tmp=$(mktemp "$CONFIG_FILE.XXXXXX") || { rm -f "$CONFIG_FILE.lock"; return 1; }
    { if [ -r "$CONFIG_FILE" ]; then while IFS= read -r line; do
          k=${line%%=*}; keep=1
          for (( a = 1; a <= $#; a += 2 )); do [ "$k" = "${!a}" ] && keep=0; done
          [ "$keep" = 1 ] && printf '%s\n' "$line"
      done < "$CONFIG_FILE"; fi
      while [ $# -ge 2 ]; do printf '%s=%s\n' "$1" "${2//[[:cntrl:]]/}"; shift 2; done
    } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
    [ "$(readlink "$CONFIG_FILE.lock" 2>/dev/null)" = "$$" ] && rm -f "$CONFIG_FILE.lock"
}
# Every setting: KEY|default|type|description. Types: bool (on/off), int:min:max, enum:a:b, text, list (comma-separated).
# The panel, `bhote config` and docs/configuration.md all follow this table; a value that does not fit is refused.
SETTINGS='SETUP_DONE||text|When the setup wizard ran on this machine (empty: it opens at the next start)
STORE|local|enum:local:remote:kharka|Where the topics are kept: local, a replica on STORE_MACHINE, or kharka (a local-first store on every machine)
STORE_MACHINE||text|The saved herdr machine that holds the replica (herdr machine list)
KHARKA||text|The kharka binary for STORE=kharka (empty: kharka on the PATH; the environment variable KHARKA comes first)
SYNC_VIA|herdr|enum:herdr:ssh|How topics travel: herdr (its saved machine; each side pulls from the other) or plain ssh
PUSH_STATES|on|bool|When an agent here changes its state, tell the other machines at once (through herdr), so that their panels show it within a second (only with REMOTE_AGENTS on)
REMOTE_AGENTS|off|bool|Also list the agents of the saved herdr machines (opens ssh connections)
MACHINES_OFF||list|Saved machines that stay out even with REMOTE_AGENTS=on
PANEL_MIN_WIDTH|36|int:30:200|The narrowest the panel pane may get in herdr (columns); a narrower one is widened again (the agent keeps 40)
PANEL_MAX_WIDTH|60|int:30:300|The widest the panel pane may get in herdr (columns); a wider one is narrowed again
LOCAL_EVERY|3|int:1:3600|Seconds between two queries of the agents of this machine
REMOTE_EVERY|5|int:1:3600|Seconds between two queries of the other machines and the regular merge
TESTS_BUSY|off|bool|An agent whose workspace runs tests counts as busy
AUTO_ASSIGN|off|bool|A running (now) topic with a project and without an agent goes to the next free agent OF THAT PROJECT by itself, 20 s after its last change (a topic without a project gets it from a project name in its title or description; if there is none, nothing starts)
AUTO_ASSIGN_MACHINE|any|text|Whose free agents auto-assign tries first: any (this machine first) or a machine label
AGENT_CAN_CLOSE|on|bool|An agent may close its topic itself (bhote done); off: it can only hand it over for review
AGENT_TOPICS|on|bool|An agent may create topics (bhote add, as the bhote skill tells it to); off: bhote add run by an agent creates nothing (the "Question from" topics are AUTO_REVIEW)
AGENT_CARDS|on|bool|A working agent without a topic gets a card on now by itself (title: what it works on), gone when it stops working or gets a topic; 15 s of work first
NOTIFY|on|bool|herdr notifications: a topic is ready, done, or waits too long
GITHUB_BRANCHES|on|bool|GitHub: show the git branch the agent of a topic works on (read from its working folder by the machine it runs on)
SLACK_WATCH|off|bool|Watch the Slack channels pinned to waiting topics, from this machine (through Claude Code and its Slack connector; one machine is enough): a new message from someone else sets the topic to review
SLACK_EVERY|120|int:30:3600|Seconds between two Slack checks (one short Claude call each, only while a waiting topic has a pin)
CLAUDE_CONFIG_DIR||text|Slack watch: the Claude Code profile it runs in (its folder, e.g. ~/.claude2; empty: the one of this process, else ~/.claude). Set it when the Slack connector lives in a second profile
DEPLOY_MONITOR|off|bool|Deployment monitor: the last deployments of the projects (GitHub Actions, CircleCI) above the agents
DEPLOY_EVERY|60|int:15:3600|Seconds between two deployment checks
DEPLOY_GITHUB|on|bool|Deployment monitor: GitHub Actions (through gh and its login)
DEPLOY_CIRCLECI|on|bool|Deployment monitor: CircleCI (its API v2, with the CircleCI token)
TEST_MONITOR|off|bool|Test monitor: the last test runs (local runs, CI test jobs) above the agents
TEST_EVERY|60|int:15:3600|Seconds between two test checks
TEST_LOCAL|on|bool|Test monitor: local runs (bhote test run -- <command>) and live status files
TEST_GITHUB|on|bool|Test monitor: the test jobs of GitHub Actions
TEST_CIRCLECI|on|bool|Test monitor: the test jobs of CircleCI
TEST_STATUS_DIR|~/.cache/bhote/test-status|text|Folder with live test status files (one JSON per suite: tree, suite, done, total, passed, failed, ok; the format is in docs/monitors.md)
HERDR_KEYS_MACHINE|any|text|The machine whose herdr you type into (its keyboard): the keys shown in the panel (jump key, prefix) are read from the herdr config.toml of that machine. any: this machine
UPDATE_CHECK|on|bool|Look on GitHub every few hours for a newer bhote and say so (settings, head of the panel) with the command that updates it
AUTO_REVIEW|on|bool|An agent that has no topic and waits for an answer or ends its turn with a question gets a review topic of its own (the question is its description); it goes when the agent works again
MONITOR_ROWS|4|int:1:20|Entries each monitor shows in the panel (the rest is counted: +3 more)
CIRCLECI_TOKEN||secret|CircleCI personal API token (else $CIRCLECI_TOKEN)
WAIT_REMIND|24|int:0:720|Hours after which a waiting topic is reminded (0 = never)
THEME|terminal|enum:terminal:catppuccin:dracula|Colours: terminal (follows the terminal and system theme), catppuccin or dracula (exact colours)
SPLASH_AUTOCLOSE|on|bool|The welcome screen closes by itself
SPLASH_SECONDS|15|int:1:600|Seconds until the welcome screen closes itself
AUTOSTART|on|bool|The herdr plugin opens the panel next to the agents when herdr starts
FIND_KEY||text|The herdr key that opens the search popup: find a topic or an agent and jump to it (e.g. ctrl+alt+t; off removes it)
JUMP_KEY||text|The herdr key that jumps between the agent and this panel (e.g. prefix+t; off removes it); written into the herdr config.toml
AGENT_ROWS||int:1:200|Height of the agent area in rows (empty: automatic)
TOPICS_SCOPE|all|enum:all:project|Which topics the panel lists: all, or those of its project (the project of the agent in its herdr tab; topics without a project are always there)
DONE_MAX|7|int:0:999|The last done topics shown above the agents (0: none)
HOST_LABEL||text|How this machine is called in agent lists (default: Mac on macOS, else the host name)
NAME_COLORS||text|Colour agents by part of their name: api=teal,web=mauve
PROJECT_COLORS||text|Colour of the project captions in the agent list: part-of-name=colour (red teal peach mauve blue green yellow pink orange grey), first match wins; other projects are grey
COLOR_TEXT||color|Override: text (#rrggbb)
COLOR_DIM||color|Override: dim text
COLOR_FRAME||color|Override: lines and frames
COLOR_SELECTION||color|Override: the background of the selected row
COLOR_ACCENT||color|Override: accent (teal)
COLOR_NOW||color|Override: running topics, busy agents, the prompt
COLOR_WAITING||color|Override: waiting topics
COLOR_REVIEW||color|Override: topics ready for review
COLOR_LATER||color|Override: parked topics
COLOR_DONE||color|Override: done topics, free agents
COLOR_ERROR||color|Override: blocked agents, errors'
setting_row() {  # setting_row <KEY>: sets S_DEF, S_TYPE, S_DESC; 1 when the key is unknown
    local line; S_DEF=""; S_TYPE=""; S_DESC=""
    while IFS= read -r line; do
        [ "${line%%|*}" = "$1" ] || continue
        line=${line#*|}; S_DEF=${line%%|*}; line=${line#*|}; S_TYPE=${line%%|*}; S_DESC=${line#*|}; return 0
    done <<< "$SETTINGS"
    return 1
}
setting_check() {  # setting_check <KEY> <value>: 0 when the value fits the key's type (an empty value = back to the default)
    local v=$2 t lo hi opts; setting_row "$1" || { echo "bhote: unknown setting '$1' (bhote config list)" >&2; return 1; }
    [ -z "$v" ] && return 0
    case "$v" in *[[:cntrl:]]*) echo "bhote: no control characters in a value" >&2; return 1 ;; esac
    t=$S_TYPE
    case "$t" in
        bool) case "$v" in on|off) return 0 ;; esac; echo "bhote: $1 is on or off" >&2; return 1 ;;
        int:*) lo=${t#int:}; hi=${lo#*:}; lo=${lo%%:*}
               case "$v" in *[!0-9]*) ;; *) [ "${#v}" -le 6 ] && [ "$v" -ge "$lo" ] && [ "$v" -le "$hi" ] && return 0 ;; esac
               echo "bhote: $1 is a whole number from $lo to $hi" >&2; return 1 ;;
        enum:*) opts=":${t#enum:}:"; case "$opts" in *":$v:"*) return 0 ;; esac
                echo "bhote: $1 is one of: $(printf '%s' "${t#enum:}" | tr ':' ' ')" >&2; return 1 ;;
        color) hex_rgb "$v" >/dev/null && return 0; echo "bhote: $1 is a colour like #89b4fa" >&2; return 1 ;;
        *) [ "${#v}" -le 500 ] && return 0; echo "bhote: $1 is at most 500 characters" >&2; return 1 ;;
    esac
}
machine_wanted() {  # machine_wanted <label>: remote queries on, and this machine not switched off
    [ "$(cfg_get REMOTE_AGENTS off)" = on ] || return 1
    case ",$(cfg_get MACHINES_OFF ''),"  in *",$1,"*) return 1 ;; esac
    return 0
}

# ── topics: one small KEY=value file per topic (id, title, status now|waiting|later|done, waiting_for, waiting_since,
# created, updated, deleted). The LOCAL copy is always the working copy: it is read and written, also when the chosen data
# location is a saved machine (STORE=remote, STORE_MACHINE=<label>). That machine holds a replica which is merged in the
# background whenever it can be reached; while it cannot, bhote simply keeps working locally ("offline") and the changes
# wait. Merging is per topic, the newer `updated` wins (a deleted topic stays as a tombstone with deleted=1 so that the
# deletion travels, too). BHOTE_SSH replaces ssh (the tests use a fake one); BHOTE_REMOTE_DIR the folder on the machine.
# STORE=kharka: the same, with kharka (github.com/jakobbeyer/kharka) as the other side: its daemon on this machine holds a
# replica of everything and syncs with the other machines through its hub, so the merge never leaves the machine.
DATA_DIR=${BHOTE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/bhote}
TOPIC_DIR=$DATA_DIR/topics
REMOTE_TOPIC_DIR=${BHOTE_REMOTE_DIR:-.local/share/bhote/topics}      # relative to the remote home
STORE_STATUS="$DATA_DIR/store.status"                                 # state=ok|offline, ok_at=<epoch>; shared by all panels
STORE_DIRTY="$SHARED_DIR/dirty"                          # touched by every local change: sync at once
store_ssh() { local host=$1; shift; case "$host" in ''|-*|*[!A-Za-z0-9._@:%-]*) return 1 ;; esac   # never an option, never odd characters
    "${BHOTE_SSH:-ssh}" -o BatchMode=yes -o ConnectTimeout=4 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$host" "$@"; }
# The remote LOGIN shell may be zsh or fish: an empty glob aborts a zsh command line. So every remote script goes to
# `sh -c` as one safely quoted word, and does not depend on what the login shell would make of it.
store_sh() { local host=$1 script=$2; store_ssh "$host" "sh -c $(printf '%q' "$script")"; }
store_host() {  # store_host <saved machine label> -> its ssh target
    herdr machine list 2>/dev/null | awk -F'\t' -v l="$1" '$2 == l { print $3; exit }'
}
store_synced() { case "$(cfg_get STORE local)" in remote|kharka) return 0 ;; esac; return 1; }   # is there a replica to merge with?
store_place() {  # where the replica is: the machine's label, kharka, or local
    case "$(cfg_get STORE local)" in remote) cfg_get STORE_MACHINE '?' ;; kharka) printf 'kharka' ;; *) printf 'local' ;; esac
}
# kharka holds every topic file as one entry, its KEY=value lines as a JSON object: bhote.topics/<id>, and the records
# bhote.projects/proj-…, bhote.machines/mach-…, bhote.agentnums/an-…. The binary: $KHARKA, else the setting KHARKA, else kharka
# on the PATH; the daemon is found where kharka looks itself ($KHARKA_SOCKET, else its default socket).
kharka_bin_set() { local _kbv=${KHARKA:-}; [ -n "$_kbv" ] || cfg_var _kbv KHARKA ""; printf -v "$1" '%s' "${_kbv:-kharka}"; }   # kharka_bin_set <var> (an odd name: never the caller's)
kharka_run() { local _kb; kharka_bin_set _kb; "$_kb" "$@"; }   # kharka_run <kharka arguments>
kharka_found() { local _kb; kharka_bin_set _kb; command -v "$_kb" >/dev/null 2>&1; }
kharka_key() {  # kharka_key <file name>: the key of its entry (KHARKA_JQ_KEY below decides the same way)
    local id=${1%.topic}
    case "$id" in
        proj-*) printf 'bhote.projects/%s' "$id" ;; mach-*) printf 'bhote.machines/%s' "$id" ;;
        an-*) printf 'bhote.agentnums/%s' "$id" ;; *) printf 'bhote.topics/%s' "$id" ;;
    esac
}
# The jq of the entries. An entry counts only under the key kharka_key gives its id (bhote.projects/proj-z, never
# bhote.topics/proj-z: the two would stand for one file). A value becomes the file's lines, a file becomes a value; the dump and
# the push use the same lines, so that a file pushed and read back is byte for byte the file that was pushed.
KHARKA_JQ_KEY='def file: sub("^[^/]*/"; "") + ".topic";
    def wanted: (.key | test("^bhote\\.(topics|projects|machines|agentnums)/[A-Za-z0-9][A-Za-z0-9_-]*$"))
        and (.value | type == "object")
        and ((.key | sub("/.*$"; "")) == (.key | sub("^[^/]*/"; "")
            | if startswith("proj-") then "bhote.projects" elif startswith("mach-") then "bhote.machines"
              elif startswith("an-") then "bhote.agentnums" else "bhote.topics" end));'
KHARKA_JQ_LINES='to_entries[] | select(.value | type == "string") | "\(.key)=\(.value | gsub("[\u0000-\u001f]"; ""))"'
# shellcheck disable=SC2016  # ($k and $v are jq variables)
KHARKA_JQ_VALUE='reduce (inputs | select(test("^[a-z_]+=")) | [sub("=.*$"; ""), sub("^[a-z_]+="; "")]) as [$k, $v]
    ({}; if has($k) then . else .[$k] = $v end)'
kharka_dump() {  # kharka_dump <scratch dir>: every bhote entry in kharka as a dump (the format of topics_dump), and each
    # file's stamp in kharka in <dir>/hlcs, for the conditional push and delete (not "stamps": the merge has a file of that
    # name). Nothing at all (no @@END) when the daemon does not answer; its complaint is in <dir>/err.
    local d=$1
    kharka_run ls bhote. --entries > "$d/entries" 2> "$d/err" || return 1
    jq -r "$KHARKA_JQ_KEY"' select(wanted) | "\(.key | file)\t\(.hlc)"' "$d/entries" > "$d/hlcs" 2>/dev/null || return 1
    jq -r "$KHARKA_JQ_KEY"' select(wanted) | "\n@@\(.key | file)", (.value | '"$KHARKA_JQ_LINES"')' "$d/entries" 2>/dev/null || return 1
    printf '\n@@END\n'
}
kharka_stamp() { awk -F'\t' -v f="$2" '$1 == f { print $2; exit }' "$1/hlcs" 2>/dev/null; }   # kharka_stamp <scratch dir> <file name>
kharka_push() {  # kharka_push <topic file> <scratch dir> [stamp] [the dump's copy]: the file as its entry; with a stamp only
    # while the entry still has it (another machine's write in the meantime is not overwritten: exit 4, and the merge runs again).
    # Afterwards the local file has the form kharka gives back (a final newline, only KEY=value lines, each key once, valid
    # UTF-8, no control characters): else it would differ from its entry on every round and be pushed every round.
    local f=$1 d=$2/push rc=0 tf args=()
    mkdir -p "$d" && cp "$f" "$d/was" 2>/dev/null || return 1
    jq -Rn "$KHARKA_JQ_VALUE" < "$d/was" > "$d/value" 2>/dev/null && jq -r "$KHARKA_JQ_LINES" "$d/value" > "$d/lines" 2>/dev/null || return 1
    if [ -n "${4:-}" ] && cmp -s "$d/lines" "$4"; then :       # kharka has it already: only the local file was not in its form
    else
        [ -n "${3:-}" ] && args=(--if-hlc "$3")
        kharka_run put "$(kharka_key "${f##*/}")" - "${args[@]}" < "$d/value" > /dev/null 2> "$2/err"; rc=$?
    fi
    if [ "$rc" = 0 ] && ! cmp -s "$d/was" "$d/lines" && cmp -s "$d/was" "$f"; then   # (not when it changed meanwhile)
        tf=$(mktemp "$f.XXXXXX") && cp "$d/lines" "$tf" && mv "$tf" "$f"
    fi
    return $rc
}
kharka_err_set() {  # kharka_err_set <var> <file>: kharka's complaint in one clean line (for store.status and the summary)
    local _ke=""; { IFS= read -r _ke < "$2"; } 2>/dev/null
    _ke=${_ke//[[:cntrl:]]/}; _ke=${_ke#kharka: }; printf -v "$1" '%s' "${_ke:0:200}"
}
# The collector follows `kharka watch bhote.`: every change there (another machine's, or our own push) asks for a merge and
# wakes the collector at once. The watch and the loop that reads it are two processes joined by a fifo, so that both have a
# pid of their own and both are stopped (a pipeline in the background leaves its first command running). They are started
# from a subshell: no jobs of the collector, whose shell would print "Terminated" into the panel when they are stopped.
kharka_follow_start() {  # kharka_follow_start <collector pid>: sets KW_WATCH and KW_READ
    local fifo="$RUN_DIR/kharka.watch"
    rm -f "$fifo" "$fifo.pids"; mkfifo "$fifo" 2>/dev/null || return 1
    ( kharka_run watch bhote. > "$fifo" 2>/dev/null & w=$!; kharka_follow_read "$fifo" "$w" "$1" & echo "$w $!" > "$fifo.pids" )
    read -r KW_WATCH KW_READ < "$fifo.pids" 2>/dev/null; rm -f "$fifo.pids"
    [ -n "$KW_READ" ]
}
kharka_follow_read() {  # kharka_follow_read <fifo> <watch pid> <collector pid>: until the watch ends or the collector is gone
    local line s
    while true; do
        s=$SECONDS
        if IFS= read -r -t 5 line; then [ -n "$line" ] && { : > "$STORE_DIRTY"; poke; }
        elif [ $(( SECONDS - s )) -lt 4 ]; then break          # the watch ended (bash 3.2 tells a timeout from the end only by the time)
        else kill -0 "$3" 2>/dev/null || break; fi             # quiet for 5 s: is the collector still there? (after a kill -9 nobody stops us)
    done < "$1"
    kill "$2" 2>/dev/null
}
kharka_follow_stop() { [ -n "${KW_READ:-}" ] && kill "$KW_READ" 2>/dev/null; [ -n "${KW_WATCH:-}" ] && kill "$KW_WATCH" 2>/dev/null; KW_READ=""; KW_WATCH=""; }
kharka_follow_keep() {  # kharka_follow_keep <collector pid>: every round of the lead collector: the follower runs while
    # STORE=kharka. One that ended soon (no daemon) starts again after 5, 10, 20 … at most 60 s, not on every round.
    local _ks; cfg_var _ks STORE local; [ "$_ks" = kharka ] || { kharka_follow_stop; return 0; }

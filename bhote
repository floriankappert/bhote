        for mm in "${machines[@]}"; do                         # the machines this project runs on: one only? then it goes into the caption
            for (( i = 0; i < AG_N; i++ )); do
                [ "${AG_LINES[$i]%%$US*}" = "$mm" ] || continue
                if [ "$pm" = "-" ]; then project_name "${apj[$i]}" >/dev/null && continue; else [ "${apj[$i]}" = "$pm" ] || continue; fi
                pmach[$npm]=$mm; npm=$(( npm + 1 )); break

}
done_block() {  # done_block <max>: the last done topics (newest first, a green check each), above the agents; a chosen one too
    local max=$1 i k n=0 all=0 idx=() tc t tw tm w=$(( ${COLS:-44} - 2 ))
    [ "$max" -gt 0 ] || return 0
    local dn=() used=" " best bu u j sel_in=0                 # newest first: by the last change (checking off is one); builtins only
    for (( i = 0; i < T_N; i++ )); do [ "${T_STATUS[$i]}" = done ] && in_scope "$i" && dn[${#dn[@]}]=$i; done; all=${#dn[@]}
    while [ "$n" -lt "$max" ] && [ "$n" -lt "$all" ]; do
        best=-1; bu=-1
        for j in "${dn[@]}"; do case "$used" in *" $j "*) continue ;; esac; u=${T_UPD[$j]:-0}; [ "$u" -ge "$bu" ] && { bu=$u; best=$j; }; done
        idx[$n]=$best; used="$used$best "; n=$(( n + 1 )); [ "${T_ID[$best]}" = "${SEL_ID:-}" ] && sel_in=1
    done
    if [ "$sel_in" = 0 ] && [ -n "${SEL_ID:-}" ]; then          # a chosen one (just checked off) is there even when older
        for j in ${dn[@]+"${dn[@]}"}; do [ "${T_ID[$j]}" = "$SEL_ID" ] && { idx[$n]=$j; n=$(( n + 1 )); break; }; done
    fi
    [ "$n" -gt 0 ] || return 0
    dash_caption Done
    for (( k = 0; k < n; k++ )); do
        i=${idx[$k]}; ago_set tm "${T_UPD[$i]:-${NOW:-0}}"                  # when it was checked off (its last change), on the right
        done_mc "$i"; [ -n "$DONE_MC" ] && tm="$DONE_MC $tm"                        # and in front of it the machine of the agent that did it
        clip_set t "${T_TITLE[$i]:-(untitled)}" $(( w - 7 - ${#tm} )); dw_set tw "$t"
        tc="$BOLD$D"     # muted but bold like every title, one line each
        if [ "${T_ID[$i]}" = "${SEL_ID:-}" ]; then              # chosen (just checked off, or in the search): the bar
            tc="$BOLD$DSEL"
            printf '\035%s\035\001%s  %s✓%s %s%s%s%*s%s%s%s %s\n' "${T_ID[$i]}" "$SELBG" "$GREEN" "$X$SELBG" "$tc" "$t" "$X$SELBG" $(( w - 5 - tw - ${#tm} )) "" "$DSEL" "$tm" "$X$SELBG" "$X"
        else printf '\035%s\035  %s✓%s %s%s%s%*s%s%s%s\n' "${T_ID[$i]}" "$GREEN" "$X" "$tc" "$t" "$X" $(( w - 5 - tw - ${#tm} )) "" "$D" "$tm" "$X"; fi
    done
    [ "$all" -gt "$n" ] && printf '  %s+%d more done%s\n' "$D" $(( all - n )) "$X"
    return 0
}
bored_agents() {  # the empty list: two agents with nothing to do, centred under the head rule (narrow or low: one line)

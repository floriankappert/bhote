agents_block() {  # the agents by project (a caption each; the panel's own project first, those without one last), two columns;
    # with more than one machine each name has its machine's code in front (MAC|name). The icon says the state (as in the herdr
    # sidebar), muted when the machine does not answer. A project's agents come from their repo/project tokens (project_sync).
    local i k m id st raw off name task ic nc label cw maxr cell plain _ln n=0 shown hidden=0 r lines=() lc=() lid=() rid=()
    maxr=$(( ${ROWS:-40} - 21 - ${HEAD_ROWS:-0} )); [ "$maxr" -lt 1 ] && maxr=1     # automatic: the head, the keys and four lines of topics always stay

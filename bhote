# The herdr key that jumps between agent and panel (the plugin action bhote.panel.focus), as herdr's config.toml binds it:
# a [[keys.command]] block, or the inline form term-theme writes. "prefix+t" is shown with the prefix: "^b t".
HERDR_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml
focus_key_set() {  # focus_key_set <var>: the key in short form, or empty when none is bound
    local _k="" _p
    if [ -r "$HERDR_CONFIG" ]; then
        _k=$(awk '
            function val(s, name) { if (!match(s, name " *= *\"[^\"]*\"")) return ""; s = substr(s, RSTART, RLENGTH); sub(/^[^"]*"/, "", s); sub(/"$/, "", s); return s }
            /^[ \t]*\[/ { if (blk && cmd == "bhote.panel.focus" && k != "") { print k; done = 1; exit }
                            blk = ($0 ~ /^[ \t]*\[\[keys\.command\]\]/); k = ""; cmd = ""; next }
            /bhote\.panel\.focus/ && /key *= *"/ { n = split($0, parts, "}"); for (i = 1; i <= n; i++) if (parts[i] ~ /bhote\.panel\.focus/) { print val(parts[i], "key"); done = 1; exit } }
            blk && /^[ \t]*key *= *"/ { k = val($0, "key") }
            blk && /^[ \t]*command *= *"bhote\.panel\.focus"/ { cmd = "bhote.panel.focus" }
            END { if (!done && blk && cmd == "bhote.panel.focus" && k != "") print k }' "$HERDR_CONFIG" 2>/dev/null)

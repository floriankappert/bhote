            lc[$n]=$(( 1 + (r + 1 < nc2) )); lid[$n]=${cid[$r]}; rid[$n]=${cid[$(( r + 1 ))]:-}; n=$(( n + 1 ))
        done
    done
    shown=$n; [ "$shown" -gt "$maxr" ] && shown=$maxr
    if [ -n "$want" ]; then echo "$maxr"; else echo "$shown"; fi 2>/dev/null > "$RUN_DIR/agrows"   # the rows shown: where a drag starts

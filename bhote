    tmp=$(mktemp "$HERDR_CONFIG.XXXXXX") || return 1
    awk '/^# >>> bhote/ { skip = 1; next } /^# <<< bhote/ { skip = 0; next } !skip { l[++n] = $0 }
         END { while (n > 0 && l[n] == "") n--; for (i = 1; i <= n; i++) print l[i] }' "$HERDR_CONFIG" > "$tmp"

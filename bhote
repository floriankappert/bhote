        done 3<<< "$(w_machines)"
        [ "$any" = 1 ] || w_warn "none yet" "add one to see its agents here"
        w_yn "Add a machine?" N; r=$?; [ $r = 3 ] && return; [ $r = 0 ] || break
        w_screen 3 "ADD A MACHINE" || return

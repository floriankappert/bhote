          [ -n "$fk" ] && printf '[[keys.command]]\nkey = "%s"\ntype = "plugin_action"\ncommand = "bhote.panel.search"\ndescription = "bhote search"\n' "$fk"
          printf '# <<< bhote\n'; } >> "$tmp"
    fi
    mv "$tmp" "$HERDR_CONFIG"
    out=$(herdr server reload-config 2>&1) || out=$(herdr config check 2>&1 && echo '"status":"applied","diagnostics":[]')
    case "$out" in *'"status":"applied"'*'"diagnostics":[]'*|*'"diagnostics":[]'*'"status":"applied"'*) ;;
        *) cp "$old" "$HERDR_CONFIG"; rm -f "$old"; herdr server reload-config >/dev/null 2>&1

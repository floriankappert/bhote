    if [ -n "${HERDR_PANE_ID:-}" ] && [ -z "$(topic_get "$1" agent_pane)" ]; then
        bhote_info; topic_set "$1" agent_pane "${HERDR_PANE_ID//[!A-Za-z0-9:_-]/}"; topic_set "$1" agent_machine "$HOST"   # a pane id alone repeats on every machine
    fi

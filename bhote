            case "$_c" in red) _col=$NN ;; teal) _col=$S ;; peach) _col=$C ;; mauve) _col=$R ;; blue) _col=$BLUE ;; green) _col=$GREEN ;; yellow) _col=$Y ;; pink) _col=$PINK ;; orange) _col=$ORANGE ;; grey|gray) _col=$D ;; esac; break; fi

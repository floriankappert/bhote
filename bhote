    done
}
w_wait_ssh() {  # w_wait_ssh <seconds>: until ssh is open here (checked every second); any key stops waiting
    local n=0 k; printf '  %swaiting for ssh to open (any key stops)%s ' "$D" "$X"
    while [ "$n" -lt "$1" ]; do
        w_inbound_ssh && { printf '\n'; return 0; }
        IFS= read -rsn1 -t 1 k </dev/tty && { printf '\n'; return 1; }
        printf '%s·%s' "$D" "$X"; n=$(( n + 1 ))
    done
    printf '\n'; return 1
}
setup_open_ssh() {  # ssh into this machine is closed: switch it on here (sudo asks for the password itself), or open the settings
    local c unit=sshd
    [ "$(uname -s)" = Darwin ] || systemctl cat sshd.service >/dev/null 2>&1 || unit=ssh
    w_say "Other machines can reach $HOST only when ssh is open here."
    w_line
    if [ "$(uname -s)" = Darwin ]; then
        w_opt 1 "switch on Remote Login now (sudo asks for your Mac password; bhote never sees it)"
        w_opt 2 "open System Settings › Sharing; I switch on Remote Login there"
    else
        w_opt 1 "start the ssh server now (sudo systemctl enable --now $unit; sudo asks for your password)"
        w_opt 2 "I start it myself in another terminal"
    fi
    w_opt 3 "skip it"
    w_choose c "Choose:" 123 1 || return 1
    case "$c" in
        1) if [ "$(uname -s)" = Darwin ]; then
               # systemsetup needs Full Disk Access for the terminal on current macOS; launchd starts the same ssh service without it
               w_run "sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist" sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist
           else w_run "sudo systemctl enable --now $unit" sudo systemctl enable --now "$unit"; fi
           w_wait_ssh 10 ;;
        2) [ "$(uname -s)" = Darwin ] && open "x-apple.systempreferences:com.apple.Sharing-Settings.extension" 2>/dev/null
           w_wait_ssh 180 ;;
        *) return 1 ;;
    esac
    if w_inbound_ssh; then w_ok "ssh into $HOST" "open now"; return 0; fi
    return 1
}
setup_step_twoway() {
    w_screen 4 "THE OTHER WAY ROUND" || return
    w_say "So that the other machines see the agents of this one, and topics can travel both ways, they must know this machine too."; w_line
    local label host en r tgt key fp ak="$HOME/.ssh/authorized_keys" known
    while IFS=$US read -r label host en <&3; do
        [ -n "$label" ] || continue
        w_remote_knows "$label"; case $? in
            0) w_ok "$label" "knows $HOST already"; continue ;;
            1) w_warn "$label" "does not know $HOST yet" ;;
            *) w_warn "$label" "cannot tell (no ssh without a password yet)" ;;
        esac
        w_yn "Set up $label → $HOST now (uses ssh to $label, asks before every change)?" Y; r=$?; [ $r = 3 ] && return; [ $r = 0 ] || continue
        w_ssh_note "$host"
        # 1) can anyone log in here?
        if ! w_inbound_ssh; then
            w_bad "ssh into $HOST" "not open"
            setup_open_ssh || { w_bad "ssh into $HOST" "still closed: $label is skipped"; w_continue; continue; }
            [ "$W_QUIT" = 1 ] && return
        fi
        w_ok "ssh into $HOST" "open"
        # 2) the address of this machine as seen from there
        w_line; w_say "How can $label reach $HOST? Pick one; Tailscale works from anywhere, the local name only in the same network."
        w_pick tgt "Address of $HOST:" "$(w_self_targets)"; [ "$W_QUIT" = 1 ] && return
        case "$tgt" in ''|-*|*[!A-Za-z0-9._@:%-]*) w_bad "refused" "odd characters in the target"; continue ;; esac
        # 3) the key of the other machine, shown with its fingerprint, allowed here only when you say so
        key=$(w_ssh "$label" 'for f in ~/.ssh/id_ed25519.pub ~/.ssh/id_ecdsa.pub ~/.ssh/id_rsa.pub; do [ -f "$f" ] && { head -1 "$f"; exit 0; }; done; exit 3'); r=$?
        if [ $r = 3 ]; then
            w_warn "key of $label" "none yet"
            w_yn "Create an ssh key on $label (ed25519, no passphrase)?" Y; r=$?; [ $r = 3 ] && return
            [ $r = 0 ] || { w_say "Without a key $label cannot log in here: it is skipped."; w_continue; continue; }
            key=$(w_ssh "$label" 'ssh-keygen -q -t ed25519 -N "" -f ~/.ssh/id_ed25519 </dev/null && head -1 ~/.ssh/id_ed25519.pub')
        fi
        key=$(printf '%s\n' "$key" | tr -d '\r' | grep -E '^(ssh-ed25519|ecdsa-sha2-nistp[0-9]+|ssh-rsa) [A-Za-z0-9+/]+=*( [^[:cntrl:]]*)?$' | head -1)   # a login banner may come first
        fp=$([ -n "$key" ] && printf '%s\n' "$key" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')
        [ -n "$fp" ] || { w_bad "key of $label" "could not be read"; w_continue; continue; }
        w_line; w_say "The key of $label:" "$L"; printf '  %s%s%s\n' "$C" "${fp:-?}" "$X"
        w_yn "Allow $label to log in to $HOST with this key (added to ~/.ssh/authorized_keys)?" N; r=$?; [ $r = 3 ] && return
        if [ $r != 0 ]; then
            w_say "Then $label cannot reach $HOST: it shows no agents of $HOST, and topics travel only from $label to here (pick ssh in the next step, or keep them local). You can run the setup again any time." "$Y"
            w_continue; continue
        fi
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"; touch "$ak" && chmod 600 "$ak"
        local blob; blob=$(printf '%s' "$key" | awk '{print $2}')
        if ! awk -v b="$blob" '{ for (i = 1; i <= NF; i++) if ($i == b) f = 1 } END { exit !f }' "$ak" 2>/dev/null; then
            [ -s "$ak" ] && [ -n "$(tail -c1 "$ak")" ] && printf '\n' >> "$ak"     # the last line may lack its newline
            printf '%s\n' "$key" >> "$ak"
        fi
        w_ok "key of $label" "allowed here"
        # 4) does it work from there? then let herdr there save this machine
        if w_ssh "$label" "ssh -n -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 $(printf '%q' "$tgt") true" >/dev/null 2>&1; then
            w_ok "$label → $HOST" "ssh works"
        else w_bad "$label → $HOST" "ssh does not work (address? firewall?)"; w_continue; continue; fi
        w_yn "Save $HOST as a machine in herdr on $label?" Y; r=$?; [ $r = 3 ] && return
        [ $r = 0 ] && w_run "on $label: herdr machine add --label $HOST $tgt" w_ssh "$label" "herdr machine add --label $(printf '%q' "$HOST") $(printf '%q' "$tgt")"
    done 3<<< "$(w_machines)"
    w_continue
}

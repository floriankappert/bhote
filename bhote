# ── the topic list: after the start screen the dog shrinks into the header. The topics are SAMPLE DATA for now.
theme_apply; theme_sig THEME_SIG                              # the colours of this run (ui_load re-applies them after a change)
rule() { printf '  %s%s%s\n' "$B" "${RULE_LINE:-───────────────────────────────────────}" "$X"; }   # from the same left edge as the text
group() {  # group <CAPTION> [colour]: a status caption; everything below starts in the same column
    printf '\n  %s%s%s\n' "${2:-$D}" "$1" "$X"
}
wrap_lines() {  # wrap_lines <array var> <width> <max lines> <text>: the text in words, cut into lines; what does not fit goes as "…" at the end of the last line
    local _v=$1 _w=$2 _m=$3 _line="" _word _ww _lw=0 _n=0 _more=0; eval "$_v=()"
    set -f
    for _word in $4; do
        dw_set _ww "$_word"; [ "$_ww" -gt "$_w" ] && { clip_set _word "$_word" "$_w"; dw_set _ww "$_word"; }
        if [ -z "$_line" ]; then _line=$_word; _lw=$_ww
        elif [ $(( _lw + 1 + _ww )) -le "$_w" ]; then _line="$_line $_word"; _lw=$(( _lw + 1 + _ww ))
        else
            if [ "$_n" -ge $(( _m - 1 )) ]; then _more=1; break; fi
            eval "${_v}[$_n]=\$_line"; _n=$(( _n + 1 )); _line=$_word; _lw=$_ww
        fi
    done
    set +f
    [ "$_more" = 1 ] && { clip_set _line "$_line $_word" "$_w"; [ "${_line: -1}" = "…" ] || _line="${_line:0:$(( ${#_line} - 1 ))}…"; }
    [ -n "$_line" ] && eval "${_v}[$_n]=\$_line"
}
# One entry: the title, the description below it, then the elbow line with the meta (who/what, how long ago). The selected one
# gets the highlighted bar over all its lines (no pointer); its first line starts with an invisible \001 so that bhote_view can
# find it for scrolling (and strips it). Done entries are one muted line. With TI_REF set every line starts with \035id\035
# before that: bhote_view strips it too and notes the row, so that a click selects the topic (TOPIC_MAP).
topic_item() {  # topic_item <selected 0|1> <state colour> <time> <title colour> <title> <description> <who> <state> [compact 1] [branch]
    # The meta line "∟ who · state · time": who in blue, the state in its own colour, the time grey. The description is italic.
    local w=$(( ${COLS:-44} - 2 )) bg="" mk="" t d tc=$4 dc=$DESC mc=${2:-$D} gc=$D wc=$BLUE who=$7 st=$8 tm=$3 room n rm=""
    [ -n "${TI_REF:-}" ] && rm=$'\035'"$TI_REF"$'\035'
    local tw dw2; clip_set t "$5" $(( w - 3 )); clip_set d "$6" $(( w - 3 )); dw_set tw "$t"; dw_set dw2 "$d"
    local bl="  " gap=${TI_FRAME:-0} bar=""        # TI_FRAME (the panel's list): every entry is a card, the selected one a lighter card
    local hov=0
    if [ "$gap" = 1 ]; then bg=$CARDBG; bar=${TI_BAR:-${2:-$D}}; [ -n "${TI_REF:-}" ] && [ "$TI_REF" = "${HOVER_ID:-}" ] && { bg=$CARDHOV; hov=1; }; fi   # (hovered: a step lighter)
    if [ "$hov" = 1 ] && [ "$1" != 1 ]; then dc=$DESCSEL; gc=$DSEL; [ "$mc" = "$D" ] && mc=$DSEL; fi          # (and its small text readable on the lighter ground)
    if [ "$1" = 1 ]; then                                      # the selection: its own, brighter text colours (contrast on the bar)
        bg=$SELBG; mk=$'\001'; dc=$DESCSEL; gc=$DSEL; [ "$mc" = "$D" ] && mc=$DSEL
        case "$tc" in "$TITLE"|"$L") tc=$TITLESEL ;; *) tc="$BOLD$DSEL" ;; esac   # muted (done) titles: readable
        [ "$gap" = 1 ] && bg=$CARDSEL
    fi
    [ "$hov" = 1 ] && bar=$'\033[38;2;255;111;97m'            # under the pointer: the bar is coral red, so that you see which card you are on
    [ "$gap" = 1 ] && bl="${bar}▌${X}${bg} "                 # the status colour as a bar on the left edge (review blue, now orange, waiting yellow)
    if [ "$gap" = 1 ]; then ti_edge "$rm" "$bg" ▄; fi
    printf '%s%s%s%s%s%s%s%*s%s\n' "$rm" "$mk" "$bg" "$bl" "$tc" "$t" "$X$bg" $(( w - 2 - tw )) "" "$X"
    [ -n "$d" ] && printf '%s%s%s%s%s%s%*s%s\n' "$rm" "$bg" "$bl" "$dc" "$d" "$X$bg" $(( w - 2 - dw2 )) "" "$X"
    [ -n "$who$st$tm" ] || { if [ "$gap" = 1 ]; then ti_edge "$rm" "$bg" ▀; TI_OPEN=1; elif [ "${9:-}" != 1 ]; then printf '\n'; fi; return 0; }
    room=$(( w - 4 ))                                          # too long: the time goes first, then the state is cut, then who
    local ww sw; [ -n "$who" ] && clip_set who "$who" "$room"; dw_set ww "$who"; dw_set sw "$st"
    n=$(( ww + sw + ${#tm} + (ww > 0 && sw > 0 ? 3 : 0) + (${#tm} > 0 && ww + sw > 0 ? 3 : 0) ))
    if [ "$n" -gt "$room" ]; then tm=""; n=$(( ww + sw + (ww > 0 && sw > 0 ? 3 : 0) )); fi
    if [ "$n" -gt "$room" ]; then
        if [ -n "$who" ]; then clip_set st "$st" $(( room - ww - 3 )); else clip_set st "$st" "$room"; fi
        dw_set sw "$st"; n=$(( ww + sw + (ww > 0 && sw > 0 ? 3 : 0) ))
    fi
    printf '%s%s%s%s∟ ' "$rm" "$bg" "$bl" "$gc"
    [ -n "$who" ] && printf '%s%s' "$wc" "$who"
    [ -n "$who" ] && [ -n "$st" ] && printf '%s · ' "$gc"
    [ -n "$st" ] && printf '%s%s' "$mc" "$st"
    [ -n "$tm" ] && { [ -n "$who$st" ] && printf '%s · ' "$gc"; printf '%s%s' "$gc" "$tm"; }
    printf '%s%*s%s\n' "$X$bg" $(( room - n )) "" "$X"
    if [ -n "${10:-}" ]; then                                  # the agent's git branch, a line of its own
        local bt bw; clip_set bt "${10}" $(( w - 6 )); dw_set bw "$bt"
        printf '%s%s%s%s⎇ %s%s%*s%s\n' "$rm" "$bg" "$bl" "$gc" "$bt" "$X$bg" $(( w - 4 - bw )) "" "$X"
    fi
    if [ "$gap" = 1 ] && [ -n "${11:-}${12:-}" ]; then ti_subcard "$rm" "$bg" "${11:-}" "${12:-}" "${TI_REF:-}" "$w" "$bl"; fi
    if [ "$gap" = 1 ]; then ti_edge "$rm" "$bg" ▀; TI_OPEN=1; elif [ "${9:-}" != 1 ]; then printf '\n'; fi
}
# Cards: the row above an entry is its top edge, a lower half block (▄) in the card colour, the row below its bottom edge, an upper
# half block (▀): half a row of air inside the card on both sides, and the other halves of the two rows between two cards are the
# gap. The edge rows belong to the card (a click on them selects it).
ti_edge() {  # ti_edge <ref marker> <card background> <▄|▀>
    local _s; printf -v _s '%*s' $(( ${COLS:-44} - 2 )) ''; _s=${_s// /$3}
    printf '%s%s%s%s\n' "$1" "${2//\[48;/[38;}" "$_s" "$X"
}
# The card under a review topic: what the agent did (a few lines, a card of its own, a step lighter) and, docked to its bottom
# edge on the right, the button with the action (key y). The button row's ref carries its columns, "<id>!<from>!<to>" (1-based),
# so that a click on it can be told from a click on the card.
ti_subcard() {  # ti_subcard <ref marker> <card bg> <note> <ask: labels joined by ¦> <topic id> <card width> <left edge: the bar>
    local rm=$1 bg=$2 note=$3 ask=$4 id=$5 w=$6 bl=$7 sub=$CARDSUB sfg lines=() l lw pad sw=$(( $6 - 4 )) iw=$(( $6 - 6 ))
    sfg=${sub//\[48;/[38;}
    local edge; printf -v edge '%*s' "$sw" ''; edge=${edge// /▄}
    printf '%s%s%s%s%s%s%s  %s\n' "$rm" "$bg" "$bl" "$sfg" "$edge" "$X" "$bg" "$X"                   # (the top edge: half a row of air above the text)
    if [ -n "$note" ]; then
        wrap_lines lines "$iw" 3 "$note"
        for l in "${lines[@]}"; do
            dw_set lw "$l"; printf -v pad '%*s' $(( iw - lw )) ''
            printf '%s%s%s%s %s%s%s %s%s  %s\n' "$rm" "$bg" "$bl" "$sub" $'\033[38;2;238;240;250m' "$l" "$pad" "$X" "$bg" "$X"   # (brighter than the other text: it sits on the darkest ground)
        done
    fi
    if [ -n "$ask" ]; then                                       # up to three buttons, flush right: side by side with two columns between them, else one under the other
        local labs=() rest=$ask lab n=0 i tot=0 gapw=2 bws=() texts=() btnbg row gp start ranges rid k
        while [ -n "$rest" ] && [ "$n" -lt 3 ]; do lab=${rest%%¦*}; labs[$n]=$lab; n=$(( n + 1 )); [ "$rest" = "$lab" ] && break; rest=${rest#*¦}; done
        for (( i = 0; i < n; i++ )); do
            lab=${labs[$i]}; clip_set lab "$lab" $(( sw - 6 )); texts[$i]=" [$(( i + 1 ))] $lab "; dw_set lw "${texts[$i]}"; bws[$i]=$lw; tot=$(( tot + lw ))
        done
        tot=$(( tot + gapw * (n - 1) ))
        case "$BLUE" in *"[38;"*) btnbg=${BLUE//\[38;/[48;} ;; *) btnbg=${BLUE//\[3/[4} ;; esac     # the button has the colour of review (the fg of BLUE as a background)
        btnbg="$btnbg"$'\033[1;38;2;24;24;37m'
        if [ "$tot" -le "$sw" ]; then                             # side by side: one row, the ref carries every button's columns
            start=$(( 2 + sw - tot )); ranges=""; printf -v pad '%*s' $(( sw - tot )) ''; row=$pad
            for (( i = 0; i < n; i++ )); do
                [ "$i" -gt 0 ] && { printf -v gp '%*s' "$gapw" ''; row="$row$gp"; start=$(( start + gapw )); }
                row="$row$btnbg${texts[$i]}$X$bg"; ranges="$ranges!$(( start + 1 ))!$(( start + bws[i] ))"; start=$(( start + bws[i] ))
            done
            rid=""; [ -n "$id" ] && rid=$'\035'"$id$ranges"$'\035'
            printf '%s%s%s%s%s  %s\n' "$rid" "$bg" "$bl" "$row" "$X$bg" "$X"
        else                                                      # too wide: a row each (the labels stay whole); the filler pairs 0!0 keep the button's number in the ref
            for (( i = 0; i < n; i++ )); do
                printf -v pad '%*s' $(( sw - bws[i] )) ''; ranges=""; for (( k = 0; k < i; k++ )); do ranges="$ranges!0!0"; done
                ranges="$ranges!$(( 2 + sw - bws[i] + 1 ))!$(( 2 + sw ))"
                rid=""; [ -n "$id" ] && rid=$'\035'"$id$ranges"$'\035'
                printf '%s%s%s%s%s%s%s%s  %s\n' "$rid" "$bg" "$bl" "$pad" "$btnbg" "${texts[$i]}" "$X" "$bg" "$X"
            done
        fi
    else
        printf '%s%s%s%s%s%s%s  %s\n' "$rm" "$bg" "$bl" "$sfg" "${edge//▄/▀}" "$X" "$bg" "$X"
    fi
}
agent_state_set() {  # agent_state_set <var> <machine> <pane>: working | idle | blocked | done | gone, from the last agent lists
    local _i _m _id _st _r _x gone=gone
    for (( _i = 0; _i < AG_N; _i++ )); do
        IFS=$US read -r _m _id _st _r _x <<< "${AG_LINES[$_i]}"
        if [ "$_m" = "$2" ] && [ "$_id" = "$3" ]; then gone=${_st:-idle}; break; fi

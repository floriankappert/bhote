}
topic_meta() {  # topic_meta <topic index>: TM_WHO, TM_ST, TM_SC (the state's colour), TM_TM: the meta line, for the panel and the search
    local i=$1 who="" state="" tm="" sc=$D ast; [ -n "${NOW:-}" ] || NOW=$(date +%s)
    case "${T_STATUS[$i]}" in
        now) ago_set tm "${T_UPD[$i]:-$NOW}"
             if [ -n "${T_TN[$i]}" ]; then who="${T_AG[$i]:-?} → ${T_TN[$i]}"; state="handing over"; sc=$C; tm=""
             elif [ -n "${T_AG[$i]}" ]; then    # given to an agent: say what that agent is doing now
                 who=${T_AG[$i]}; tm=""; agent_state_set ast "${T_AM[$i]}" "${T_AP[$i]}"
                 case "$ast" in working) state=working; sc=$ORANGE ;; testing) state="running tests"; sc=$ORANGE ;; blocked) state="needs you"; sc=$NN ;;
                     idle|done) state=finished; sc=$GREEN ;; off-*) state="offline (${T_AM[$i]} reconnecting)"; sc=$D ;; *) state=gone; sc=$D ;; esac
             fi ;;

gradient() {            # gradient <text> : colours the characters of one line left to right
    local line=$1 n=$(( ${#stops[@]} - 1 )) w=${#1} i ch p seg t r1 g1 b1 r2 g2 b2 out=""
    [ "$color" = 1 ] || { printf '%s' "$line"; return; }
    if [ -n "${GRAD_ANSI:-}" ]; then                        # terminal theme: the palette's colours, spread over the text
        local cols=($GRAD_ANSI) nc; nc=${#cols[@]}
        for (( i = 0; i < w; i++ )); do ch=${line:$i:1}; out="$out${esc}[${cols[$(( i * nc / (w > 0 ? w : 1) ))]}m$ch"; done
        printf '%s%s' "$out" "$X"; return
    fi
    for (( i = 0; i < w; i++ )); do
        ch=${line:$i:1}
        if [ "$ch" = " " ]; then out="$out "; continue; fi
        p=$(( i * n * 100 / (w - 1) )); seg=$(( p / 100 )); [ $seg -ge $n ] && seg=$(( n - 1 )); t=$(( p - seg * 100 ))
        read -r r1 g1 b1 <<< "${stops[$seg]}"; read -r r2 g2 b2 <<< "${stops[$((seg + 1))]}"
        out="$out$(rgb "$(( r1 + (r2 - r1) * t / 100 ));$(( g1 + (g2 - g1) * t / 100 ));$(( b1 + (b2 - b1) * t / 100 ))")$ch"
    done
    printf '%s%s' "$out" "$X"
}

# ── themes. THEME=terminal (default) uses the terminal's own 16 colours, so bhote follows the terminal theme (Omarchy's
# system theme, a light terminal) at once; THEME=catppuccin uses exact truecolor values. COLOR_<ROLE>=#rrggbb overrides one
# role in either theme. The dog keeps its own colours.
#   TEXT  DIM  FRAME  SELECTION (a background)  ACCENT (teal)  NOW (= busy)  WAITING  REVIEW  LATER  DONE (= free)  ERROR
THEME_SIG=""
hex_rgb() { local h=${1#\#}; case "$h" in [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}" ;; *) return 1 ;; esac; }
theme_apply() {  # sets every colour variable from THEME and the COLOR_* overrides
    Y=""; GREEN=""; BLUE=""; B=""; SELBG=""; MUTED=""; R=""; NN=""; S=""; C=""; L=""; D=""; LSEL=""; DSEL=""; DESC=""; DESCSEL=""; TITLE=""; TITLESEL=""
    [ "$color" = 1 ] || { TEAL=""; ORANGE=""; return 0; }
    local th v k; cfg_var th THEME terminal
    if [ "$th" = catppuccin ]; then
        R=$(rgb "203;166;247"); NN=$(rgb "243;139;168"); S=$(rgb "148;226;213"); C=$(rgb "250;179;135")
        L="${esc}[1m$(rgb "205;214;244")"; D=$(rgb "108;112;134"); B=$D
        Y=$(rgb "249;226;175"); GREEN=$(rgb "166;227;161"); BLUE=$(rgb "137;180;250"); SELBG="${esc}[48;2;49;50;68m"; MUTED=$(rgb "69;71;90")
        LSEL="${esc}[1m$(rgb "245;247;255")"; DSEL=$(rgb "186;194;222")         # on the selection: brighter than the plain text
        TITLE="${esc}[1m$(rgb "166;173;200")"; TITLESEL="${esc}[1m$(rgb "205;214;244")"   # a topic: the title bold in the softer colour,
        DESC="${esc}[3m$(rgb "205;214;244")"; DESCSEL="${esc}[3m$(rgb "245;247;255")"     # the description italic in the full text colour
        stops=("148 226 213" "137 180 250" "203 166 247" "245 194 231" "250 179 135"); GRAD_ANSI=""
    else                                                     # the terminal's palette: magenta, red, cyan, yellow, ...
        R="${esc}[35m"; NN="${esc}[31m"; S="${esc}[36m"; C="${esc}[33m"; L="${esc}[1;39m"; D="${esc}[90m"; B=$D
        Y="${esc}[93m"; GREEN="${esc}[32m"; BLUE="${esc}[34m"; GRAD_ANSI="36 34 35 95 33"; MUTED="${esc}[2;90m"
        # the selected row: a dark grey from the 256 colours. "Bright black" (100) is the colour of dim text itself, which then
        # disappears on it; 236 keeps text and dim text readable on dark themes (COLOR_SELECTION overrides it).
        SELBG="${esc}[48;5;236m"; LSEL="${esc}[1;97m"; DSEL="${esc}[38;5;251m"   # on the selection: white and a light grey
        TITLE="${esc}[1;37m"; TITLESEL="${esc}[1;97m"                            # a topic: the title bold in the softer colour,
        DESC="${esc}[3;39m"; DESCSEL="${esc}[3;97m"                              # the description italic in the full text colour
    fi
    for k in TEXT DIM FRAME SELECTION ACCENT NOW WAITING REVIEW LATER DONE ERROR; do
        cfg_var v "COLOR_$k" ""; [ -n "$v" ] || continue; v=$(hex_rgb "$v") || continue
        case "$k" in
            TEXT) L="${esc}[1m$(rgb "$v")"; LSEL=$L; TITLE=$L; TITLESEL=$L; DESC="${esc}[3m$(rgb "$v")"; DESCSEL=$DESC ;;
            DIM) D=$(rgb "$v"); DSEL=$D ;; FRAME) B=$(rgb "$v") ;; SELECTION) SELBG="${esc}[48;2;${v}m" ;;
            ACCENT) S=$(rgb "$v") ;; NOW) C=$(rgb "$v") ;; WAITING) Y=$(rgb "$v") ;; REVIEW) BLUE=$(rgb "$v") ;;
            LATER) R=$(rgb "$v") ;; DONE) GREEN=$(rgb "$v") ;; ERROR) NN=$(rgb "$v") ;;
        esac
    done
    MUTED=${MUTED:-$B}; TEAL=$S; ORANGE=$C; HEAD_GRAD=""; LSEL=${LSEL:-$L}; DSEL=${DSEL:-$D}; DESC=${DESC:-$D}; DESCSEL=${DESCSEL:-$DSEL}
    TITLE=${TITLE:-$L}; TITLESEL=${TITLESEL:-$LSEL}
}
theme_sig() {  # theme_sig <var>: the settings the colours come from, as one string (a change re-applies the theme)
    local _l _sig=""
    [ -r "$CONFIG_FILE" ] && while IFS= read -r _l; do case "$_l" in THEME=*|COLOR_*) _sig="$_sig|$_l" ;; esac; done < "$CONFIG_FILE"

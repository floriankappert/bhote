}
age_text() { age_set _AGE "$1"; printf '%s' "$_AGE"; }
ago_set() { age_set "$1" "$2"; if [ "${!1}" = now ]; then printf -v "$1" '%s' 'just now'; else printf -v "$1" '%s ago' "${!1}"; fi; }   # "3h ago"
ago() { ago_set _AGO "$1"; printf '%s' "$_AGO"; }
store_sync_run() {  # merge the local copy with the replica (a machine, or kharka). Returns 1 while it is unreachable, 3 when
    # kharka changed during the merge (a write of ours was refused by --if-hlc: the merge has to run again).
    store_synced || { rm -f "$STORE_STATUS"; return 0; }
    local label host tmp f l r ok=1 NOW_SYNC via n again=0 err="" rc; NOW_SYNC=$(date +%s)
    local old=$(( NOW_SYNC - 30 * 86400 ))                      # deletions travel as tombstones; after 30 days both sides have them
    if [ "$(cfg_get STORE local)" = kharka ]; then             # kharka's daemon on this machine is the other side
        label=kharka; host=""; via=kharka
        command -v jq >/dev/null 2>&1 || { store_note offline "error=jq is not installed"; return 1; }
        kharka_found || { kharka_bin_set err; store_note offline "error=no kharka binary: $err (the setting KHARKA)"; return 1; }
    else
        label=$(cfg_get STORE_MACHINE ''); host=$(store_host "$label"); cfg_var via SYNC_VIA herdr
        [ -n "$host" ] || { store_note offline; return 1; }    # not a saved herdr machine (both transports need that)
    fi
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/bhote.sync.XXXXXX"); mkdir -p "$TOPIC_DIR"
    # 1) everything the machine has: one stream, "@@name" before each file
    # (a newline before every marker: a file without a final newline must not swallow the next one; at most 8 MB are read)
    if [ "$via" = kharka ]; then kharka_dump "$tmp" | head -c 8000001 > "$tmp/dump"
    elif [ "$via" = herdr ]; then herdr_dump "$label" 2>/dev/null | head -c 8000001 > "$tmp/dump"
    else store_sh "$host" "umask 077; mkdir -p $REMOTE_TOPIC_DIR && cd $REMOTE_TOPIC_DIR && for f in *.topic; do [ -f \"\$f\" ] && { printf '\\n@@%s\\n' \"\$f\"; cat \"\$f\"; }; done; echo; echo @@END" 2>/dev/null | head -c 8000001 > "$tmp/dump"; fi
    # only a complete dump counts (ssh can die in the middle and still leave a plausible half): it must end with the @@END line
    if [ "$(wc -c < "$tmp/dump")" -gt 8000000 ] || [ "$(tail -n 1 "$tmp/dump")" != "@@END" ]; then
        # through herdr a cut-off dump means: more topics than herdr hands over (64 KB packed); ssh has no such limit
        [ "$via" = herdr ] && [ -s "$tmp/dump" ] && echo "bhote: the topics of $label do not fit through herdr; SYNC_VIA=ssh has no limit" >&2
        if [ "$via" = kharka ]; then kharka_err_set err "$tmp/err"; store_note offline "error=${err:-the kharka daemon did not answer}"
        else store_note offline; fi
        rm -rf "$tmp"; return 1
    fi
    # only plain topic names are accepted from the other side: a name like ../../x must never become a path
    mkdir "$tmp/remote"; awk -v d="$tmp/remote" '/^@@/ { if (f != "") close(f); f = ""; if ($0 ~ /^@@[A-Za-z0-9][A-Za-z0-9_-]*\.topic$/) f = d "/" substr($0, 3); next } $0 == "" { next } f != "" { print > f }' "$tmp/dump"
    # a malformed replica file is not taken, and remembered: its local copy must not be pushed over it either (ssh)
    : > "$tmp/rejected"; n=0
    for f in "$tmp/remote"/*.topic; do
        [ -f "$f" ] || continue; n=$(( n + 1 ))
        if [ "$n" -gt 2000 ] || ! topic_valid "$f" "$NOW_SYNC" || [ "$(topic_get "$f" id)" != "$(topic_id "$f")" ]; then
            echo "${f##*/}" >> "$tmp/rejected"; rm -f "$f"
        fi
    done
    [ -s "$tmp/rejected" ] && echo "bhote: $(wc -l < "$tmp/rejected" | tr -d ' ') topic(s) from $label were not taken (malformed, from the future, or too many)" >&2
    # 2) per topic: the newer one wins, in both directions
    { ls "$tmp/remote" 2>/dev/null; ls "$TOPIC_DIR" 2>/dev/null; } | grep -E '^[A-Za-z0-9][A-Za-z0-9_-]*\.topic$' | sort -u > "$tmp/ids"
    # only the topics that differ go through the loop below (a round with nothing to merge forks a handful of times, not 5 per topic):
    # stamps and checksums of both sides are read in one pass; a name refused from the other side is neither pulled nor pushed
    awk -F= 'FNR == 1 { s = 0 } $1 == "updated" && !s { s = 1; print FILENAME "\t" $2 }' "$tmp/remote"/*.topic "$TOPIC_DIR"/*.topic > "$tmp/stamps" 2>/dev/null
    cksum "$tmp/remote"/*.topic "$TOPIC_DIR"/*.topic > "$tmp/sums" 2>/dev/null
    awk -v rd="$tmp/remote/" -v fs="$tmp/stamps" -v fc="$tmp/sums" -v fr="$tmp/rejected" '
        FILENAME == fr { rej[$0] = 1; next }
        FILENAME == fs { split($0, a, "\t"); p = a[1]; n = p; sub(/^.*\//, "", n); st[(index(p, rd) == 1) ? "r" : "l", n] = a[2] + 0; next }
        FILENAME == fc { p = $3; n = p; sub(/^.*\//, "", n); sm[(index(p, rd) == 1) ? "r" : "l", n] = $1 " " $2; next }
        { n = $0; if (n in rej) next; hl = (("l", n) in sm); hr = (("r", n) in sm); l = st["l", n] + 0; r = st["r", n] + 0
          if (!hl || !hr || l != r) print n; else if (l != 0 && sm["l", n] != sm["r", n]) print n }' "$tmp/rejected" "$tmp/stamps" "$tmp/sums" "$tmp/ids" > "$tmp/todo"
    while IFS= read -r f; do
        l=0; r=0
        [ -f "$TOPIC_DIR/$f" ] && l=$(topic_get "$TOPIC_DIR/$f" updated 0)
        [ -f "$tmp/remote/$f" ] && r=$(topic_get "$tmp/remote/$f" updated 0)
        l=$(num_or "$l" 0); r=$(num_or "$r" 0)
        if [ "$r" -gt "$l" ]; then
            local pt; pt=$(mktemp "$TOPIC_DIR/.pull.XXXXXX") || continue
            cp "$tmp/remote/$f" "$pt" || { rm -f "$pt"; continue; }
            # a local change that happened during the dump must not be overwritten
            if [ -f "$TOPIC_DIR/$f" ] && [ "$(num_or "$(topic_get "$TOPIC_DIR/$f" updated 0)" 0)" != "$l" ]; then rm -f "$pt"; continue; fi
            mv "$pt" "$TOPIC_DIR/$f"
        elif [ "$l" -gt "$r" ] && [ "$via" = kharka ]; then
            # a tombstone that is cleared below is not pushed first (the clearing deletes the entry)
            [ "$l" -lt "$old" ] && [ "$(topic_get "$TOPIC_DIR/$f" deleted 0)" = 1 ] && continue
            kharka_push "$TOPIC_DIR/$f" "$tmp" "$(kharka_stamp "$tmp" "$f")"; rc=$?
            case "$rc" in 0) ;; 4) again=1 ;; *) ok=0; kharka_err_set err "$tmp/err" ;; esac
        elif [ "$l" -gt "$r" ] && [ "$via" != herdr ]; then     # through herdr the other side pulls by itself: nothing is pushed
            # pushed only when the remote file is still what the dump showed (an edit there in the meantime wins the next round)
            store_sh "$host" "umask 077; f=$REMOTE_TOPIC_DIR/$f; cur=\$(sed -n 's/^updated=//p' \"\$f\" 2>/dev/null | head -1); if [ \"\${cur:-0}\" = $r ]; then cat > \"\$f.tmp\" && mv \"\$f.tmp\" \"\$f\"; else cat >/dev/null; fi" < "$TOPIC_DIR/$f" 2>/dev/null || ok=0
        elif [ "$l" = "$r" ] && [ "$l" != 0 ] && [ -f "$tmp/remote/$f" ] && ! cmp -s "$TOPIC_DIR/$f" "$tmp/remote/$f"; then
            # the same stamp, other contents: both sides decide the same way (the larger checksum wins)
            local cl cr; cl=$(cksum < "$TOPIC_DIR/$f" | cut -d' ' -f1); cr=$(cksum < "$tmp/remote/$f" | cut -d' ' -f1)
            if [ "$cr" -gt "$cl" ]; then local tf; tf=$(mktemp "$TOPIC_DIR/$f.XXXXXX") && cp "$tmp/remote/$f" "$tf" && mv "$tf" "$TOPIC_DIR/$f"   # (a unique name: two merges may meet)
            elif [ "$via" = kharka ]; then
                kharka_push "$TOPIC_DIR/$f" "$tmp" "$(kharka_stamp "$tmp" "$f")" "$tmp/remote/$f"; rc=$?
                case "$rc" in 0) ;; 4) again=1 ;; *) ok=0; kharka_err_set err "$tmp/err" ;; esac
            elif [ "$via" != herdr ]; then store_sh "$host" "umask 077; cat > $REMOTE_TOPIC_DIR/$f.tmp && mv $REMOTE_TOPIC_DIR/$f.tmp $REMOTE_TOPIC_DIR/$f" < "$TOPIC_DIR/$f" 2>/dev/null || ok=0; fi
        fi
    done < "$tmp/todo"
    local tomb st
    for tomb in $(grep -l '^deleted=1' "$TOPIC_DIR"/*.topic 2>/dev/null); do
        [ "$(num_or "$(topic_get "$tomb" updated 0)" 0)" -lt "$old" ] || continue
        if [ "$via" = kharka ] && st=$(kharka_stamp "$tmp" "${tomb##*/}") && [ -n "$st" ]; then
            # deleted in kharka too (it keeps a tombstone of its own), only while the entry is what the merge read: an
            # entry written again meanwhile (exit 4) is merged first, and the local tombstone stays for that
            kharka_run del "$(kharka_key "${tomb##*/}")" --if-hlc "$st" >/dev/null 2> "$tmp/err"; rc=$?
            case "$rc" in 0) ;; 4) again=1; continue ;; *) ok=0; kharka_err_set err "$tmp/err"; continue ;; esac
        fi
        rm -f "$tomb"
    done
    rm -rf "$tmp"
    if [ "$ok" != 1 ]; then
        if [ "$via" = kharka ]; then store_note offline "error=${err:-kharka refused a write}"; else store_note offline; fi
        return 1
    fi
    [ "$via" = kharka ] || { store_note ok; return 0; }
    # kharka: in step with the daemon here; how far the others are is the daemon's hub and its pending writes
    local status; status=$(kharka_run status 2>/dev/null | jq -r '"hub=\(.hub // "" | gsub("[\u0000-\u001f]"; ""))",
        "hub_online=\(.online == true)", "pending=\(.pending // 0 | tostring | gsub("[^0-9]"; ""))"' 2>/dev/null)
    if [ "$again" = 1 ]; then store_note again "$status"; return 3; fi
    store_note ok "$status"
}
topics_dump() {  # topics_dump [max bytes]: every topic in one stream, the most recently changed first: "@@name" before each,
    # "@@END" at the end (the merge needs it). With a limit, it stops before that many bytes (only whole topics).
    local max=${1:-0}
    ls "$TOPIC_DIR" 2>/dev/null | grep -E '^[A-Za-z0-9][A-Za-z0-9_-]*\.topic$' | sed "s#^#$TOPIC_DIR/#" 2>/dev/null > "$RUN_DIR/dumplist"
    if [ -s "$RUN_DIR/dumplist" ]; then
        tr '\n' '\0' < "$RUN_DIR/dumplist" | xargs -0 awk -F= '$1 == "updated" && !(FILENAME in u) { u[FILENAME] = $2 + 0 }
            END { for (f in u) print u[f], f } ' 2>/dev/null | sort -rn | cut -d' ' -f2- | tr '\n' '\0' \
            | xargs -0 awk -v max="$max" 'FNR == 1 { if (max > 0 && total > max) exit; n = split(FILENAME, p, "/"); printf "\n@@%s\n", p[n] }
                { print; total += length($0) + 1 }' 2>/dev/null
    fi
    printf '\n@@END\n'
}
# herdr keeps at most 64 KB of an action's output: the dump for herdr travels packed (gzip, base64), about 5 times smaller.
topics_dump_packed() {  # about 10x smaller packed; 400 KB of topics stay well under herdr's 64 KB (the oldest are left out beyond)
    if command -v gzip >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1; then echo "@@GZ"; topics_dump 400000 | gzip -c | base64
    else topics_dump 50000; fi
}
dump_unpack() {  # stdin: a packed or plain dump -> the plain one (a damaged packed dump gives nothing, so the merge sees no @@END)
    local first; IFS= read -r first
    if [ "$first" = "@@GZ" ]; then { base64 -d 2>/dev/null || base64 -D 2>/dev/null; } | gzip -dc 2>/dev/null
    else printf '%s\n' "$first"; cat; fi
}
herdr_dump() {  # herdr_dump <machine label>: the other machine's topics through herdr: its bhote plugin runs `bhote dump`,
    # and herdr keeps the output in that plugin's log, which this machine reads. No ssh of our own.
    # (the newest dump in the log before we ask is the baseline: only a newer one counts. No clocks of two machines compared.)
    local m=$1 i out base q='def lid: (.log_id // "" | tostring | capture("(?<n>[0-9]+)$").n // "0" | tonumber);'
    base=$(with_timeout 20 herdr --machine "$m" plugin log list --plugin bhote.panel 2>/dev/null | jq -r "$q"' [.result.logs[] | select(.action_id == "dump") | lid] | max // 0' 2>/dev/null)
    [ -n "$base" ] || return 1                                  # no baseline: an old dump must not count as new
    base=$(num_or "$base" 0)
    with_timeout 20 herdr --machine "$m" plugin action invoke dump --plugin bhote.panel >/dev/null 2>&1 || return 1
    for (( i = 0; i < 20; i++ )); do
        out=$(with_timeout 20 herdr --machine "$m" plugin log list --plugin bhote.panel 2>/dev/null | jq -r --argjson b "$base" "$q"'
            [.result.logs[] | select(.action_id == "dump" and .status == "succeeded" and (lid > $b))] | last | .stdout // empty' 2>/dev/null)
        [ -n "$out" ] && { printf '%s\n' "$out" | dump_unpack; return 0; }
        sleep 0.5
    done
    return 1
}
topic_valid() {  # topic_valid <file> <now>: KEY=value lines only, no key twice, numbers are digits, not from the future, small
    awk -F= -v now="$2" '
        NF < 2 || $1 !~ /^[a-z_]+$/ { bad = 1 }
        seen[$1]++ { bad = 1 }
        ($1 == "updated" || $1 == "created" || $1 == "waiting_since") && $2 !~ /^[0-9]*$/ { bad = 1 }
        ($1 == "updated" || $1 == "created" || $1 == "waiting_since") && $2 != "" && $2 + 0 > now + 300 { bad = 1 }
        length($0) > 4000 || NR > 64 { bad = 1 }
        END { exit bad }' "$1" 2>/dev/null
}
# Locks are symlinks to the pid of their owner: `ln -s` is atomic, so a lock never exists without its owner. A lock whose
# owner is gone is taken over. (Older versions used directories: one of those is removed.)
lock_take() {  # lock_take <path> <pid>: 0 when it is (now) ours
    local o; o=$(readlink "$1" 2>/dev/null)
    [ "$o" = "$2" ] && return 0
    if [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null; then rm -f "$1"; fi
    [ -d "$1" ] && [ ! -L "$1" ] && rm -rf "$1"
    ln -s "$2" "$1" 2>/dev/null
}
lock_drop() { [ "$(readlink "$1" 2>/dev/null)" = "$2" ] && rm -f "$1"; return 0; }   # lock_drop <path> <pid>: only our own
self_pid_set() {  # self_pid_set <var>: the pid of THIS (sub)shell. $$ is the main shell's in every subshell (the collector, a background
    # sync), and bash 3.2 has no BASHPID. sh's parent is the shell that runs it, as long as no $(...) stands in between: hence the file.
    if [ -n "${BASHPID:-}" ]; then printf -v "$1" '%s' "$BASHPID"; return 0; fi
    local _spf="$RUN_DIR/pid.$RANDOM$RANDOM"
    sh -c 'echo $PPID' 2>/dev/null > "$_spf"; read -r "$1" < "$_spf"; rm -f "$_spf"
}
# One sync at a time over all panels of this machine (and the CLI). store_sync returns 2 when another sync is running (or
# kharka kept changing during the merge: then the collector merges again in a moment).
store_sync() {
    local lock=$SHARED_DIR/sync.lock rc me
    mkdir -p "$DATA_DIR"; self_pid_set me                         # (not $$: the panel's own sync and the collector's would share it)
    lock_take "$lock" "$me" || return 2
    store_sync_run; rc=$?
    [ "$rc" = 3 ] && { store_sync_run; rc=$?; }                   # kharka changed during the merge: once more at once
    lock_drop "$lock" "$me"
    [ "$rc" = 3 ] && { : > "$STORE_DIRTY"; poke; rc=2; }          # and still: the collector merges again in a moment
    return $rc
}
store_summary() {  # one line for the settings screen: where the data lives and whether it is in step
    local label st="" ok_at=0 f n=0 line err="" hub="" hub_online="" pending=0 more=""
    store_synced || { printf 'local only (%s)' "${TOPIC_DIR/#$HOME/~}"; return; }
    label=$(store_place)
    if [ -r "$STORE_STATUS" ]; then while IFS= read -r line; do
        case "$line" in state=*) st=${line#*=} ;; ok_at=*) num_set ok_at "${line#*=}" 0 ;; error=*) err=${line#*=} ;;
            hub=*) hub=${line#*=} ;; hub_online=*) hub_online=${line#*=} ;; pending=*) num_set pending "${line#*=}" 0 ;; esac
    done < "$STORE_STATUS"; fi
    err=${err//[[:cntrl:]]/}; hub=${hub//[[:cntrl:]]/}
    if [ "$label" = kharka ]; then                             # in step with the daemon here; the others through its hub
        if [ -z "$hub" ]; then more=" · no hub: this machine only"
        elif [ "$hub_online" != true ]; then more=" · hub offline"; [ "$pending" -gt 0 ] && more="$more, $pending pending"
        elif [ "$pending" -gt 0 ]; then more=" · $pending pending"; fi
    fi
    case "$st" in
        ok) printf 'in sync with %s (%s)%s%s' "$label" "$(ago "$ok_at")" "$more" "$([ "$label" != kharka ] && [ "$(cfg_get SYNC_VIA herdr)" = herdr ] && printf ' through herdr; %s should pull from here too' "$label")" ;;
        again) printf 'merging with %s again (an entry changed during the merge)%s' "$label" "$more" ;;
        offline) for f in "$TOPIC_DIR"/*.topic; do [ -f "$f" ] && [ "$(num_or "$(topic_get "$f" updated 0)" 0)" -gt "$ok_at" ] && n=$(( n + 1 )); done
                 printf 'OFFLINE: saving locally, %s change(s) wait for %s%s' "$n" "$label" "$([ "$label" = kharka ] && printf ' (%s)' "${err:-is a kharka daemon running?}")" ;;
        *) printf 'connecting to %s ...' "$label" ;;
    esac
}


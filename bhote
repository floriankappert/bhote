setup_step_done() {  # the end: what is set up, and a live check of every machine in both directions
    w_screen 9 "DONE"
    w_ok "machine" "$HOST"
    w_ok "topics" "$([ "$(cfg_get STORE local)" = remote ] && printf 'with %s through %s' "$(cfg_get STORE_MACHINE ?)" "$(cfg_get SYNC_VIA herdr)" || echo 'only here')"
    w_ok "remote agents" "$(cfg_get REMOTE_AGENTS off)"
    w_ok "autostart" "$(cfg_get AUTOSTART on)"
    local label host en n known
    while IFS=$US read -r label host en <&3; do
        [ -n "$label" ] || continue
        printf '\n  %s%s%s\n' "$R" "$label" "$X"
        n=$(herdr --machine "$label" pane list 2>/dev/null | jq '[.result.panes[] | select(.agent)] | length' 2>/dev/null)
        if [ -n "$n" ]; then w_ok "$HOST → $label" "reachable, $n agents"; else w_bad "$HOST → $label" "not reachable through herdr"; fi
        w_remote_knows "$label"; case $? in
            0) w_ok "$label → $HOST" "knows this machine" ;;
            1) w_warn "$label → $HOST" "does not know it (step 4)" ;;
            *) w_warn "$label → $HOST" "cannot tell" ;;
        esac
    done 3<<< "$(w_machines)"
    if [ "$(cfg_get STORE local)" = remote ]; then
        store_sync >/dev/null 2>&1; case $? in 0) w_ok "topics merge" "works" ;; 2) w_warn "topics merge" "busy, it runs again by itself" ;; *) w_bad "topics merge" "$(store_summary)" ;; esac
    fi
    w_line; w_say "Change anything later in the settings (,), or run the setup again: settings › Setup wizard, or bhote setup. A log of this setup: ${W_LOG/#$HOME/~}"
    w_continue
}
bhote_setup() {  # the whole wizard, in a normal (cooked) terminal
    local st old_int; W_QUIT=0; ask_drain                      # keys typed before it opened must not answer its first questions
    old_int=$(trap -p INT); trap 'W_QUIT=1' INT                 # Ctrl-C ends the wizard (and only the wizard)
    COLS=${COLS:-$(stty size </dev/tty 2>/dev/null | awk '{print $2}')}; COLS=${COLS:-44}
    HEAD_GRAD=$(gradient "Bhote setup"); [ "$color" = 1 ] && HEAD_GRAD="${esc}[1m$HEAD_GRAD"
    w_log "==== setup on $HOST (bhote $VERSION)"
    for st in checks name machines twoway topics agents behaviour panel done; do
        "setup_step_$st"; [ "$W_QUIT" = 1 ] && break
    done
    cfg_set SETUP_DONE "$(date +%Y-%m-%d)"
    HEAD_GRAD=""                                            # the list makes its own again
    if [ -n "$old_int" ]; then eval "$old_int"; else trap - INT; fi
    printf '\033[H\033[2J'
}
setup_status_json() {  # `bhote setup --json`: what is in place, nothing changes
    printf '{"machine":%s,"jq":%s,"herdr":%s,"plugin":%s,"claude_hook":%s,"machines":[' "$(json_str "$HOST")" \
        "$(command -v jq >/dev/null 2>&1 && echo true || echo false)" "$(command -v herdr >/dev/null 2>&1 && echo true || echo false)" \
        "$(herdr plugin list 2>/dev/null | grep -q bhote.panel && echo true || echo false)" "$(grep -q 'bhote current' "$HOME/.claude/settings.json" 2>/dev/null && echo true || echo false)"
    local label host en first=1 known
    while IFS=$US read -r label host en <&3; do
        [ -n "$label" ] || continue
        local reach=false; herdr --machine "$label" pane list >/dev/null 2>&1 && reach=true
        known=null; [ "$reach" = true ] && { w_remote_knows "$label"; case $? in 0) known=true ;; 1) known=false ;; esac; }
        [ "$first" = 1 ] || printf ','; first=0
        printf '{"label":%s,"reachable":%s,"knows_this_machine":%s}' "$(json_str "$label")" "$reach" "$known"
    done 3<<< "$(w_machines)"
    printf '],"setup_done":%s}\n' "$(json_opt "$(cfg_get SETUP_DONE '')")"
}

panel_setup() {  # the wizard from inside the panel: a normal terminal for it, then the panel mode again
    trap '' USR1; printf '%s\033[?25h' "$MOUSE_OFF"; stty "$stty_saved" </dev/tty 2>/dev/null
    bhote_setup
    stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null; printf '\033[?25l%s' "$MOUSE_ON"; trap 'anim=1' USR1; term_size
}
bhote_main() {
    local f pf chk seq tmo _sa _ss view=${BHOTE_VIEW:-splash} key rows m1 m2 last_m="" k2 k3 anim=0 rc MENU_IDX=0 resize=0
    harden_perms; bhote_info
    if [ -n "${BHOTE_ONCE:-}" ] || [ ! -t 0 ]; then
        AGENT_LOCAL=$RUN_DIR/agents.local; AGENT_REMOTE=$RUN_DIR/agents.remote
        collect_local; [ "$(cfg_get REMOTE_AGENTS off)" = on ] && collect_remote
        COLS=${BHOTE_COLS:-44}; ROWS=${BHOTE_ROWS:-40}; REAL_COLS=$COLS; REAL_ROWS=$ROWS; splash_geometry; [ "$COLS" -gt "$MAX_COLS" ] && COLS=$MAX_COLS; RULE_LINE=$(hline $(( COLS - 5 ))); DASH_LINE=$(dline $(( COLS - 5 ))); ui_load; bhote_draw "$view" | tr -d '\001'; rm -f "$AGENT_LOCAL" "$AGENT_REMOTE"; return
    fi
    printf '\033]2;Bhote\007'
    dog_init; dog_warm; term_size
    # never set up on this machine: the wizard opens once, in the first panel only (herdr may start several at a time)
    if [ -z "$(cfg_get SETUP_DONE '')" ]; then
        local sl=$SHARED_DIR/setup.lock                       # the panel that shows the wizard holds it
        if lock_take "$sl" "$$"; then
            printf '\033]2;Bhote\007'
            # the welcome screen comes first and says what a key does now; too small for it: straight into the setup
            if splash_fits; then SETUP_PENDING=1; PROMPT_TEXT="PRESS ANY KEY TO START SETUP"; else bhote_setup; lock_drop "$sl" "$$"; fi
        fi
    fi
    local pids="" stty_saved
    # The terminal must not echo what arrives between two reads: a mouse wheel in the alternate screen sends arrow keys
    # (ESC [ B) all the time, and with echo on they showed up as ^[[B on the screen. Restored on exit.
    # Byte by byte, not line by line (-icanon): only then does a waiting escape sequence count as "input waiting" (read_soon).
    stty_saved=$(stty -g </dev/tty 2>/dev/null); stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    cleanup() {
        trap '' INT TERM HUP QUIT USR1 WINCH                  # once, and not interrupted by the next signal
        kill $pids 2>/dev/null
        [ -n "$stty_saved" ] && stty "$stty_saved" </dev/tty 2>/dev/null
        lock_drop "$SHARED_DIR/collector.lock" "$$"; lock_drop "$DATA_DIR/sync.lock" "$$"; lock_drop "$SHARED_DIR/setup.lock" "$$"
        rm -rf "$RUN_DIR"
        printf '%s\033[0m\033[?25h\033[?1049l\033]2;\007' "$MOUSE_OFF" 2>/dev/null   # mouse off, colours, cursor, normal screen, title
    }
    trap 'cleanup; exit 0' INT TERM HUP QUIT EXIT
    trap 'redraw=1; resize=1; CLAMP_AT=$(( SECONDS + 1 ))' WINCH       # (the width is checked once the resizing has settled)
    CLAMP_AT=$(( SECONDS + 2 ))
    trap 'anim=1' USR1
    printf '\033[?1049h\033[?25l%s' "$MOUSE_ON"          # alternate screen, hidden cursor, mouse reports (wheel, divider)
    splash_fits || view=main
    collector "$$" & pids="$!"
    echo "0 on" > "$ANIM_FILE"; dog_ticker $$ & pids="$pids $!"
    local back=main
    redraw=1
    while true; do
        if [ "$redraw" = 1 ]; then
            redraw=0; anim=0; [ "$resize" = 1 ] && { resize=0; term_size; }
            [ "$view" = splash ] && ! splash_fits && view=main
            read -r DOG_IDX _ < "$ANIM_FILE" 2>/dev/null || DOG_IDX=0
            DRAWN_IDX=$DOG_IDX; DRAWN_BLINK=on
            bhote_paint "$view"; dog_prev_reset "$view"
            if [ "$view" = main ]; then spin_cells; else SPIN_CELLS=""; fi
        elif [ "$anim" = 1 ]; then anim=0; dog_animate "$view"; fi
        [ "$view" = splash ] && [ -z "${SPLASH_SINCE:-}" ] && SPLASH_SINCE=$SECONDS
        [ "$view" = splash ] || SPLASH_SINCE=""
        tmo=1                                                  # (the 2 s checks below and the auto-close need a short timeout)
        key=""; rc=0
        if [ -n "${SPIN_CELLS:-}" ] && [ "$view" = main ] && [ "${BASH_VERSINFO[0]}" -lt 4 ] && [ -n "$HAVE_PERL" ] \
           && ! perl -MIO::Select -e 'exit(IO::Select->new(\*STDIN)->can_read(0.3) ? 0 : 1)' </dev/tty 2>/dev/null; then
            rc=142                                             # the star dances in 0.3 s steps: bash 3.2 waits whole seconds only
        else
            [ -n "${SPIN_CELLS:-}" ] && [ "$view" = main ] && [ "${BASH_VERSINFO[0]}" -ge 4 ] && tmo=0.3
            IFS= read -rsn1 -t "$tmo" key 2>/dev/null; rc=$?
        fi
        [ "$rc" = 0 ] && [ -z "$key" ] && key=ENTER      # Enter reads as an empty key; a timeout (rc > 128) stays empty
        if [ "$key" = $'\033' ]; then      # an arrow key (ESC [ A..D, ESC O A..D), a mouse report, another sequence, or a lone Esc
            read_soon k2
            if [ "$k2" = "[" ] || [ "$k2" = O ]; then
                # read up to the final byte (@ .. ~): parameters such as 1;5 (Ctrl+arrow), mouse reports and paste markers
                # must not leak their tail as keys. Only a parameterless A..D is an arrow; the rest is ignored.
                k3=""; seq=""
                while IFS= read -rsn1 -t 1 k3 2>/dev/null; do
                    case "$k3" in [0123456789\;\<\=\>\?\ \!\"\#\$\%\&\'\(\)\*\+\,\-\.\/]) ;; *) [ "$k2" = O ] || [ -z "$seq" ] || k3="x$k3"; break ;; esac   # (no [@-~]: a range follows the locale)
                    [ "$k2" = O ] && break; seq="$seq$k3"; [ "${#seq}" -gt 24 ] && break
                done
                if [ "$k2" = "[" ] && [ -z "$seq" ] && [ "$k3" = M ]; then        # X10 mouse: three raw bytes follow
                    IFS= read -rsn1 -t 1 k3; IFS= read -rsn1 -t 1 k3; IFS= read -rsn1 -t 1 k3; k3=M
                fi
                case "$k3" in A) key=UP ;; B) key=DOWN ;; C) key=RIGHT ;; D) key=LEFT ;; *) key="" ;; esac
                case "$seq" in "<"*) mouse_event "${seq#<}" "${k3#x}"; key=$MOUSE_KEY ;; esac      # SGR mouse: < b ; x ; y M|m
            elif [ -z "$k2" ]; then key=ESC
            else key=""; fi                                    # Alt+key: nothing
        fi
        if [ "${SETUP_PENDING:-}" = 1 ]; then
            if [ "$view" != splash ]; then                     # the pane got too small for the welcome screen: next start
                SETUP_PENDING=0; PROMPT_TEXT="PRESS ANY KEY TO START"; lock_drop "$SHARED_DIR/setup.lock" "$$"
            elif [ -n "$key" ] && [ "$key" != DRAG ]; then
                case "$key" in
                    q|Q) exit 0 ;;                               # quit, the setup comes again next time
                    ESC) ;;                                      # not now: the list, the setup comes again next time
                    *) panel_setup ;;
                esac
                SETUP_PENDING=0; PROMPT_TEXT="PRESS ANY KEY TO START"; lock_drop "$SHARED_DIR/setup.lock" "$$"
                view=main; redraw=1; key=""
            fi
        fi
        if [ "$view" = settings ]; then
            case "$key" in
                ","|ESC|q|Q) view=$back; redraw=1 ;;
                ""|DRAG) ;;
                *) SETTINGS_GO=""; settings_key "$key"; [ "$SETTINGS_GO" = hotkeys ] && view=hotkeys
                   [ "$SETTINGS_GO" = setup ] && panel_setup
                   redraw=1 ;;
            esac
        elif [ "$view" = hotkeys ]; then
            case "$key" in ESC|LEFT|h|q|Q|","|ENTER) view=settings; redraw=1 ;; esac
        elif [ "$view" = suggest ]; then
            suggest_build
            case "$key" in
                UP|k) SUG_IDX=$(( (SUG_IDX + ${#SUG_MAP[@]} - 1) % (${#SUG_MAP[@]} + (${#SUG_MAP[@]} == 0)) )); redraw=1 ;;
                DOWN|j) SUG_IDX=$(( (SUG_IDX + 1) % (${#SUG_MAP[@]} + (${#SUG_MAP[@]} == 0)) )); redraw=1 ;;
                ENTER|RIGHT) suggest_do adopt "$SUG_IDX"; SUG_IDX=0; view=main; redraw=1 ;;
                x|X) suggest_do dismiss "$SUG_IDX"; SUG_IDX=0; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        elif [ "$view" = pick ]; then
            pick_build
            case "$key" in
                UP|k) pf=$(pick_first); PICK_IDX=$(( PICK_IDX - 1 )); [ "$PICK_IDX" -lt "$pf" ] && PICK_IDX=${#PICK_MAP[@]}; redraw=1 ;;
                DOWN|j) pf=$(pick_first); PICK_IDX=$(( PICK_IDX + 1 )); [ "$PICK_IDX" -gt "${#PICK_MAP[@]}" ] && PICK_IDX=$pf; redraw=1 ;;
                ENTER|RIGHT) pick_do "$PICK_IDX"; view=main; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        elif [ "$view" = menu ]; then       # the action menu of the selected topic
            case "$key" in
                UP|k) f=$(sel_file); [ -n "$f" ] && menu_build "$f"                    # title (-2), description (-1), then the actions
                      MENU_IDX=$(( MENU_IDX - 1 )); [ "$MENU_IDX" -lt -2 ] && MENU_IDX=$(( ${#MENU_ITEMS[@]} - 1 )); redraw=1 ;;
                DOWN|j) f=$(sel_file); [ -n "$f" ] && menu_build "$f"
                      MENU_IDX=$(( MENU_IDX + 1 )); [ "$MENU_IDX" -ge "${#MENU_ITEMS[@]}" ] && MENU_IDX=-2; redraw=1 ;;
                ENTER|RIGHT) case "$MENU_IDX" in
                                 -2) menu_edit_field title ;; -1) menu_edit_field description ;;
                                 *) if menu_do "$MENU_IDX"; then :; else view=main; fi ;;
                             esac; redraw=1 ;;
                [1-9]) f=$(sel_file); [ -n "$f" ] && menu_build "$f"
                       if [ "$key" -le "${#MENU_ITEMS[@]}" ]; then MENU_IDX=$(( key - 1 )); if menu_do "$MENU_IDX"; then :; else view=main; fi; fi; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        else
            case "$key" in
                "") ;;
                DRAG) [ "$view" = main ] && redraw=1 ;;
                AGENT) [ "$view" = main ] && { agent_jump "$CLICK_M" "$CLICK_P"; redraw=1; } ;;
                q|Q) exit 0 ;;
                s) if [ "$view" = main ] && [ -n "$(sel_file)" ]; then PICK_MODE=start; view=pick; PICK_IDX=0; else view=main; fi; redraw=1 ;;
                t|T) if [ "$view" = main ] && f=$(sel_file) && [ -n "$f" ] && [ -n "$(topic_get "$f" agent_pane)" ]; then PICK_MODE=transfer; PICK_IDX=1; view=pick; redraw=1; fi ;;
                S) splash_fits && view=splash; redraw=1 ;;
                a|A) if [ "$view" = main ]; then view=suggest; SUG_IDX=0; redraw=1; fi ;;
                x|X) if [ "$view" = main ]; then f=$(sel_file); [ -n "$f" ] && topic_set "$f" status done; redraw=1; fi ;;   # check it off
                e|E) if [ "$view" = main ]; then f=$(sel_file)                                              # edit the title
                         if [ -n "$f" ] && ask "Title: " "$(topic_get "$f" title)" && [ -n "$ANSWER" ]; then topic_set "$f" title "$ANSWER"; fi; redraw=1; fi ;;
                d|D) if [ "$view" = main ]; then f=$(sel_file)                                              # edit the description
                         if [ -n "$f" ] && ask "Description: " "$(topic_get "$f" description)" "$DESC_MAX"; then topic_set "$f" description "$ANSWER"; fi; redraw=1; fi ;;
                n|N) if [ "$view" = main ]; then prompt_new_topic; redraw=1; else view=main; redraw=1; fi ;;
                ",") back=$view; [ "$back" = splash ] && back=main; view=settings; SET_IDX=0; redraw=1 ;;
                UP|k) if [ "$view" = main ]; then sel_move -1; redraw=1; fi ;;      # on the start screen the wheel does nothing
                DOWN|j) if [ "$view" = main ]; then sel_move +1; redraw=1; fi ;;
                ENTER|RIGHT) if [ "$view" = splash ]; then view=main; elif [ -n "$(sel_file)" ]; then view=menu; MENU_IDX=0; fi; redraw=1 ;;
                *) if [ "$view" = splash ]; then view=main; redraw=1; fi ;;
            esac
        fi
        # the welcome screen closes by itself (setting, default on) when nobody pressed a key for SPLASH_SECONDS
        if [ "$view" = splash ] && [ -z "$key" ] && [ "${SETUP_PENDING:-}" != 1 ]; then
            cfg_var _sa SPLASH_AUTOCLOSE on; cfg_var _ss SPLASH_SECONDS 15
            if [ "$_sa" = on ] && [ $(( SECONDS - ${SPLASH_SINCE:-$SECONDS} )) -ge "$_ss" ]; then view=main; redraw=1; fi
        fi
        # the agent lists changed (the collector writes them every few seconds): redraw the list view
        # the collector rewrites its files every few seconds: only a change of CONTENT repaints the list
        # (only when idle: after a key press the screen is repainted anyway, and a key must not wait for this check)
        # Every 2 seconds, when no key was read: did the agent lists, the topics or the sync state change? (Not tied to a read
        # timeout: the animation wakes the loop all the time, and bash 3.2 returns 1 from a timed-out read, bash 4+ more than 128.)
        if [ -n "$FLASH_MSG" ] && [ "$SECONDS" -ge "$FLASH_UNTIL" ]; then FLASH_MSG=""; redraw=1; fi
        if [ -n "${CLAMP_AT:-}" ] && [ "$SECONDS" -ge "$CLAMP_AT" ]; then CLAMP_AT=""; ( panel_width_clamp ) & fi
        if [ -z "$key" ]; then                                 # the agent lists changed (the collector counts a revision up): at once
            local _rev=""; read -r _rev < "$SHARED_DIR/agents.rev" 2>/dev/null
            if [ "$_rev" != "${AG_REV:-}" ]; then AG_REV=$_rev; case "$view" in main) redraw=1 ;; esac; fi
        fi
        if [ -r "$SHARED_DIR/select" ]; then                   # bhote find chose a topic without an agent: select it here
            local _sid _snc _sact; read -r _sid _snc _sact < "$SHARED_DIR/select" 2>/dev/null
            if [ "$_sid $_snc" != "${SEL_SEEN:-}" ]; then        # (show: the topic's page, else the list with it selected)
                [ -n "${SEL_SEEN:-}" ] && case "$_sid" in ''|*[!A-Za-z0-9_-]*) ;; *) [ -f "$TOPIC_DIR/$_sid.topic" ] && {
                    SEL_ID=$_sid; view=main; [ "$_sact" = show ] && { view=menu; MENU_IDX=0; }; redraw=1; } ;; esac
                SEL_SEEN="$_sid $_snc"
            fi
        else SEL_SEEN=${SEL_SEEN:-none}; fi
        if [ -z "$key" ] && [ "$SECONDS" -ge $(( ${chk:-0} + 2 )) ]; then
            chk=$SECONDS
            m1=$( { agents_all; cat "$TOPIC_DIR"/*.topic 2>/dev/null; head -1 "$STORE_STATUS" 2>/dev/null; cat "$CONFIG_FILE" 2>/dev/null; } | cksum )   # also the settings: a new theme shows at once
            if [ "$m1" != "$last_m" ]; then last_m=$m1; case "$view" in main|settings) redraw=1 ;; esac; fi
        fi
    done
}
bhote_draw() { case "$1" in main) bhote_view ;; hotkeys) bhote_hotkeys ;; suggest) bhote_suggest ;; menu) bhote_menu ;; pick) bhote_pick ;; settings) bhote_settings ;; *) bhote_splash ;; esac; }
# One frame = ONE write: home, every line cleared to its end, then the rest of the screen cleared. No full clear first,
# so nothing flashes; and it is only called when what is on screen would really look different.
bhote_paint() {  # one write per frame; ui_load first (in THIS shell), the frame itself is built in a subshell that only prints
    local frame line out="" first=1
    if [ "$TOO_SMALL" = 1 ]; then     # too small for any picture: one line that cannot wrap
        printf '\033[H\033[J%s' "$(clip "Too small (min ${MIN_COLS}x${MIN_ROWS})" "$(( ${REAL_COLS:-30} - 1 ))")"; return 0
    fi
    ui_load
    frame=$(bhote_draw "$1")
    local fl=() n=0 sel=-1 off=0 rows=${ROWS:-40} i
    while IFS= read -r line; do
        case "$line" in $'\001'*) sel=$n; line=${line#$'\001'} ;; esac
        case "$line" in $'\002'*) EDIT_LINE=$n; line=${line#$'\002'} ;; esac   # the field being edited (menu_edit_field)
        fl[$n]=$line; n=$(( n + 1 ))
    done <<< "$frame"
    if [ "$n" -gt "$rows" ] && [ "$sel" -ge 0 ]; then         # taller than the pane (a long menu, settings): follow the selection
        off=$(( sel - rows / 2 )); [ "$off" -gt $(( n - rows )) ] && off=$(( n - rows )); [ "$off" -lt 0 ] && off=0
    fi
    for (( i = off; i < n && i < off + rows; i++ )); do
        [ "$first" = 1 ] || out="${out}"$'\n'; first=0
        out="${out}${fl[$i]}"$'\033[K'
    done
    [ -n "${EDIT_LINE:-}" ] && { EDIT_ROW=$(( EDIT_LINE - off + 1 )); EDIT_LINE=""; }
    printf '\033[H%s\033[J' "$out"
}

# ── the command line: the same topics as the panel, for scripts and for chats ("bhote help"). Every change that is made
# here is also merged with the data location at once (best effort: offline it stays local and is merged later).
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')"; }
title_has() { local r=1; shopt -s nocasematch; [[ $1 == *"$2"* ]] && r=0; shopt -u nocasematch; return $r; }   # case-insensitive, multibyte-safe
topic_ref_sync() {  # topic_ref_sync <ref>: like topic_ref, but when nothing matches and a replica exists, merge once and look again
    local r; topic_ref "$1" && return 0; r=$?
    [ "$r" = 1 ] && [ -z "${BHOTE_NO_SYNC:-}" ] && [ "$(cfg_get STORE local)" = remote ] || return $r
    store_sync >/dev/null 2>&1; topic_ref "$1" 2>/dev/null
}
topic_ref() {  # topic_ref <ref>  ->  prints the file. ref: the number from `bhote list`, an id (prefix), or part of the title.
    local ref=$1 i hits=0 hit="" low
    topics_load
    [ -n "$ref" ] || { echo "bhote: a topic is needed (number, id or part of the title)" >&2; return 1; }
    case "$ref" in *[!0-9]*) ;; *) if [ "${#ref}" -le 3 ]; then      # a number from `bhote list` (decimal, also with leading zeros)
        i=$(( 10#$ref )); if [ "$i" -ge 1 ] && [ "$i" -le "$T_N" ]; then printf '%s' "${T_FILE[$(( i - 1 ))]}"; return 0; fi
        echo "bhote: there is no topic number $ref (bhote list)" >&2; return 1; fi ;; esac
    low=$ref
    for (( i = 0; i < T_N; i++ )); do
        if [ "${T_ID[$i]}" = "$ref" ]; then printf '%s' "${T_FILE[$i]}"; return 0; fi
    done
    for (( i = 0; i < T_N; i++ )); do
        case "${T_ID[$i]}" in "$ref"*) hits=$(( hits + 1 )); hit=${T_FILE[$i]}; continue ;; esac
        title_has "${T_TITLE[$i]}" "$low" && { hits=$(( hits + 1 )); hit=${T_FILE[$i]}; }
    done
    if [ "$hits" = 1 ]; then printf '%s' "$hit"; return 0; fi
    if [ "$hits" = 0 ]; then echo "bhote: no topic matches '$ref'" >&2; return 1; fi
    echo "bhote: '$ref' matches $hits topics, be more specific:" >&2
    for (( i = 0; i < T_N; i++ )); do
        case "${T_ID[$i]}" in "$ref"*) echo "  $(( i + 1 ))  ${T_TITLE[$i]}  (id ${T_ID[$i]})" >&2; continue ;; esac
        title_has "${T_TITLE[$i]}" "$low" && echo "  $(( i + 1 ))  ${T_TITLE[$i]}" >&2
    done
    return 2
}
notify() {  # notify <title> <body> [sound: done|request|none]: a herdr notification, never blocking, never failing
    [ "$(cfg_get NOTIFY on)" = on ] || return 0
    command -v herdr >/dev/null 2>&1 || return 0
    ( herdr notification show "${1//[[:cntrl:]]/}" --body "${2//[[:cntrl:]]/}" --sound "${3:-done}" >/dev/null 2>&1 & ) 2>/dev/null
    return 0
}
poke() { : > "$SHARED_DIR/poke" 2>/dev/null; return 0; }   # the collector looks at once instead of after its interval
is_agent() {  # the caller is a coding agent: Claude Code says so (CLAUDECODE), or herdr reports an agent in HERDR_PANE_ID
    [ -n "${CLAUDECODE:-}" ] && return 0
    [ -n "${HERDR_PANE_ID:-}" ] || return 1
    [ -n "$(herdr pane list 2>/dev/null | jq -r --arg p "$HERDR_PANE_ID" '[.result.panes[] | select(.pane_id == $p)][0].agent // empty' 2>/dev/null)" ]
}
agent_note() {  # agent_note <file>: when an agent runs the command, remember which one (its herdr session and pane)
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || [ -n "${HERDR_PANE_ID:-}" ] || return 0
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && topic_set "$1" agent_session "${CLAUDE_CODE_SESSION_ID//[!A-Za-z0-9-]/}"
    if [ -n "${HERDR_PANE_ID:-}" ] && [ -z "$(topic_get "$1" agent_pane)" ]; then
        bhote_info; topic_set "$1" agent_pane "${HERDR_PANE_ID//[!A-Za-z0-9:_-]/}"; topic_set "$1" agent_machine "$HOST"   # a pane id alone repeats on every machine
    fi
    return 0
}
# An agent's status changed (the herdr plugin passes the event as HERDR_PLUGIN_EVENT_JSON, or on stdin). When an agent that
# holds a running topic stops working (done / idle) and did not report back itself, the topic goes to review and you get a
# notification. Either way the collector is poked, so every panel shows the new state at once.
# Push: an agent here changed its state; the other machines ask this one again at once (the plugin action "changed" there),
# like herdr's own client does with its live connection. One push at a time: an event during a push makes it run once more.
push_peers() {
    [ "$(cfg_get REMOTE_AGENTS off)" = on ] && [ "$(cfg_get PUSH_STATES on)" = on ] || return 0
    local lock=$SHARED_DIR/push.lock id label host prof en p k
    if ! lock_take "$lock" "$$"; then : > "$SHARED_DIR/push.pending"; return 0; fi
    while true; do
        rm -f "$SHARED_DIR/push.pending"
        herdr machine list 2>/dev/null | tr '\t' '\037' | while IFS=$US read -r id label host prof en; do
            [ -n "$label" ] && [ "$label" != "$HOST" ] && [ "$en" = enabled ] || continue
            herdr --machine "$label" plugin action invoke changed --plugin bhote.panel >/dev/null 2>&1 & p=$!
            ( sleep 6; kill "$p" 2>/dev/null ) & k=$!                # an unreachable machine must not hold the event up
            wait "$p" 2>/dev/null; kill "$k" 2>/dev/null
        done
        [ -e "$SHARED_DIR/push.pending" ] || break
    done
    lock_drop "$lock" "$$"
}
cli_event() {
    local ev pane st sess i f now; ev=${HERDR_PLUGIN_EVENT_JSON:-}; [ -n "$ev" ] || ev=$(head -c 65536)
    command -v jq >/dev/null 2>&1 || return 0
    read -r pane st sess <<< "$(printf '%s' "$ev" | jq -r '(.data // .) as $d | ($d.pane // $d) as $p |
        [ ($p.pane_id // $d.pane_id // ""), ($d.agent_status // $p.agent_status // $d.status // ""), (($p.agent_session.value // $d.agent_session.value // "") | tostring) ]
        | map(tostring | gsub("[^A-Za-z0-9:_-]"; "")) | map(if . == "" then "-" else . end) | join(" ")' 2>/dev/null)"
    poke
    push_peers                                                 # the other machines' panels show it at once, too
    case "$st" in done|idle) ;; *) return 0 ;; esac
    [ "$(cfg_get STORE local)" = remote ] && store_sync >/dev/null 2>&1   # the topic may have been handed out on the other machine
    [ "$pane" = - ] && pane=""; [ "$sess" = - ] && sess=""
    topics_load; now=$(date +%s)
    for (( i = 0; i < T_N; i++ )); do
        [ "${T_STATUS[$i]}" = now ] || continue
        # the session decides when both sides know it; a pane alone only on this machine, and only with no other session on record
        if { [ -n "$sess" ] && [ "${T_AS[$i]}" = "$sess" ]; } \
           || { [ -n "$pane" ] && [ "${T_AP[$i]}" = "$pane" ] && [ "${T_AM[$i]}" = "$HOST" ] && { [ -z "$sess" ] || [ -z "${T_AS[$i]}" ]; }; }; then
            [ $(( now - $(num_or "${T_DL[$i]}" 0) )) -ge 5 ] || continue      # the idle right after handing it over is not "finished"
            f=${T_FILE[$i]}; topic_set "$f" status review
            notify "Ready for review" "${T_TITLE[$i]} (${T_AG[$i]:-agent})" request
        fi
    done
    return 0
}
# `bhote current`: the topic of the agent that asks (its Claude session, else its herdr pane). For a SessionStart hook: the
# agent learns what it works on and how to report back. Prints nothing (exit 0) when there is none.
cli_current() {
    local i f hit=""; topics_load
    for (( i = 0; i < T_N; i++ )); do
        case "${T_STATUS[$i]}" in now|review|waiting) ;; *) continue ;; esac
        if { [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "${T_AS[$i]}" = "${CLAUDE_CODE_SESSION_ID//[!A-Za-z0-9-]/}" ]; } \
           || { [ -n "${HERDR_PANE_ID:-}" ] && [ "${T_AP[$i]}" = "$HERDR_PANE_ID" ] && [ "${T_AM[$i]}" = "$HOST" ] \
                && { [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || [ -z "${T_AS[$i]}" ]; }; }; then hit=${T_FILE[$i]}; break; fi
    done
    if [ -z "$hit" ]; then [ -n "$json" ] && printf 'null\n'; return 0; fi
    if [ -n "$json" ]; then topic_json "$hit"; printf '\n'; return 0; fi
    printf 'Your bhote topic: %s\n' "$(delegation_text "$hit")"
}
# ── the agents for the command line: fresh lists (this machine, and the others when REMOTE_AGENTS is on), numbered
cli_agents_load() {
    AGENT_LOCAL=$RUN_DIR/agents.local; AGENT_REMOTE=$RUN_DIR/agents.remote
    collect_local; if [ "$(cfg_get REMOTE_AGENTS off)" = on ]; then collect_remote; else : > "$AGENT_REMOTE"; fi
    ui_load
}
agent_ref() {  # agent_ref <ref>: AR_M AR_P AR_NAME AR_ST AR_TASK. ref: a number from `bhote agents`, machine/pane, a pane id, a part of the name
    local ref=$1 i m id st name task hits=0
    case "$ref" in
        ''|*[!0-9]*) ;;
        *) [ "$ref" -ge 1 ] && [ "$ref" -le "$AG_N" ] && { IFS=$US read -r AR_M AR_P AR_ST AR_NAME AR_TASK <<< "${AG_LINES[$(( ref - 1 ))]}"; return 0; }
           echo "bhote: there is no agent number $ref (bhote agents)" >&2; return 1 ;;
    esac
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        if [ "$ref" = "$m/$id" ] || { [ "$ref" = "$id" ] && [ "$m" = "$HOST" ]; }; then AR_M=$m; AR_P=$id; AR_ST=$st; AR_NAME=$name; AR_TASK=$task; return 0; fi
    done
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        title_has "$name" "$ref" && { hits=$(( hits + 1 )); AR_M=$m; AR_P=$id; AR_ST=$st; AR_NAME=$name; AR_TASK=$task; }
    done
    [ "$hits" = 1 ] && return 0
    if [ "$hits" = 0 ]; then echo "bhote: no agent matches '$ref' (bhote agents)" >&2; return 1; fi
    echo "bhote: '$ref' matches $hits agents, use the number or machine/pane (bhote agents)" >&2; return 2
}
cli_agents() {  # bhote agents [--json]
    local i m id st name task first=1 tid t
    cli_agents_load
    [ -n "$json" ] && printf '['
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        tid=""; for (( t = 0; t < T_N; t++ )); do [ "${T_STATUS[$t]}" != done ] && [ "${T_AM[$t]}" = "$m" ] && [ "${T_AP[$t]}" = "$id" ] && { tid=${T_ID[$t]}; break; }; done
        if [ -n "$json" ]; then
            [ "$first" = 1 ] || printf ','; first=0
            local free=false; case "$st" in idle|done) free=true ;; esac   # (not inside $( ): bash 3.2 misreads a case there)
            printf '{"n":%s,"machine":%s,"pane":%s,"status":%s,"name":%s,"task":%s,"free":%s,"topic":%s}' "$(( i + 1 ))" "$(json_str "$m")" "$(json_str "$id")" \
                "$(json_str "$st")" "$(json_str "$name")" "$(json_opt "$task")" "$free" "$(json_opt "$tid")"
        else local mp; pad_set mp "$m" 8; printf '%3s  %s %-9s %s%s\n' "$(( i + 1 ))" "$mp" "$st" "$name" "${task:+  · $task}"; fi
    done
    if [ -n "$json" ]; then printf ']\n'; fi
    return 0
}
cli_transfer() {  # bhote transfer <from agent> <to agent> [--topic <ref>]
    local from="" to="" tref="" f fm fp fn fs ft tm tp tn rc made=""
    while [ $# -gt 0 ]; do case "$1" in
        --topic|-t) tref=${2:-}; shift ;;
        -*) echo "bhote: unknown option '$1' for transfer" >&2; return 1 ;;
        *) if [ -z "$from" ]; then from=$1; elif [ -z "$to" ]; then to=$1; else echo "bhote: transfer takes two agents" >&2; return 1; fi ;;
    esac; shift; done
    [ -n "$from" ] && [ -n "$to" ] || { echo "bhote: transfer <from agent> <to agent> [--topic <ref>] (bhote agents lists them)" >&2; return 1; }
    cli_agents_load
    agent_ref "$from" || return $?; fm=$AR_M; fp=$AR_P; fn=$AR_NAME; ft=$AR_TASK
    agent_ref "$to" || return $?; tm=$AR_M; tp=$AR_P; tn=$AR_NAME
    [ "$fm/$fp" = "$tm/$tp" ] && { echo "bhote: an agent cannot take over from itself" >&2; return 1; }
    if [ -n "$tref" ]; then f=$(topic_ref_sync "$tref") || return $?
    else                                                       # the topic of the source agent, or a new one for its work
        local i; f=""; for (( i = 0; i < T_N; i++ )); do
            case "${T_STATUS[$i]}" in now|review|waiting) ;; *) continue ;; esac
            [ "${T_AM[$i]}" = "$fm" ] && [ "${T_AP[$i]}" = "$fp" ] && { f=${T_FILE[$i]}; break; }
        done
        if [ -z "$f" ]; then topic_new "${ft:-Work of $fn}" "" "" || return 1; f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"; made=1; fi
    fi
    transfer_start "$f" "$fm" "$fp" "$fn" "$tm" "$tp" "$tn" || { [ -n "$made" ] && rm -f "$f"; return 1; }
    cli_done; topics_load; cli_show "$f" $json
}
cli_handover() {  # bhote handover <topic> [--to <machine/pane>] [--branch <b>] [--commit <c>]: the source agent is done; the target takes over
    local ref="" to="" b="" c="" f
    while [ $# -gt 0 ]; do case "$1" in
        --to) to=${2:-}; shift ;; --branch) b=${2:-}; shift ;; --commit) c=${2:-}; shift ;;
        -*) echo "bhote: unknown option '$1' for handover" >&2; return 1 ;;
        *) [ -z "$ref" ] || { echo "bhote: handover takes one topic (quote --to when the machine name has spaces)" >&2; return 1; }; ref=$1 ;;
    esac; shift; done
    [ -n "$ref" ] || { echo "bhote: handover needs a topic" >&2; return 1; }
    f=$(topic_ref_sync "$ref") || return $?
    local want; want=$(topic_get "$f" transfer_to)
    [ -n "$want" ] || { echo "bhote: no transfer is pending for this topic" >&2; return 1; }
    [ -n "$to" ] || to=$want
    [ "$to" = "$want" ] || { echo "bhote: this topic goes to $want, not $to" >&2; return 1; }
    case "$to" in */*) ;; *) echo "bhote: handover needs --to <machine/pane> (the command you got says it)" >&2; return 1 ;; esac
    case "$to" in *[!A-Za-z0-9._:/\ -]*) echo "bhote: odd characters in --to" >&2; return 1 ;; esac
    bhote_info; transfer_finish "$f" "$to" "$b" "$c" || return 1
    cli_done; topics_load; cli_show "$f" $json
}
cli_config() {  # bhote config [list] | get <KEY> | set <KEY> <value> | unset <KEY>
    local sub=${1:-list} key=${2:-} v line k d first=1
    case "$sub" in
        list|ls)
            if [ -n "$json" ]; then printf '['; fi
            while IFS= read -r line; do
                k=${line%%|*}; setting_row "$k"; cfg_var v "$k" "$S_DEF"
                if [ -n "$json" ]; then
                    [ "$first" = 1 ] || printf ','; first=0
                    printf '{"key":%s,"value":%s,"default":%s,"type":%s,"description":%s}' "$(json_str "$k")" "$(json_opt "$v")" "$(json_opt "$S_DEF")" "$(json_str "$S_TYPE")" "$(json_str "$S_DESC")"
                else printf '%-17s %-10s %s\n' "$k" "${v:--}" "$S_DESC"; fi
            done <<< "$SETTINGS"
            if [ -n "$json" ]; then printf ']\n'; fi ;;
        get) setting_row "$key" || { echo "bhote: unknown setting '$key' (bhote config list)" >&2; return 1; }
             cfg_var v "$key" "$S_DEF"
             if [ -n "$json" ]; then printf '{"key":%s,"value":%s,"default":%s}\n' "$(json_str "$key")" "$(json_opt "$v")" "$(json_opt "$S_DEF")"; else printf '%s\n' "$v"; fi ;;
        set) [ $# -ge 3 ] || { echo "bhote: config set <KEY> <value>" >&2; return 1; }
             shift 2; v="$*"
             setting_check "$key" "$v" || return 1
             case "$S_TYPE" in int:*) v=$(num_or "$v" "$v") ;; esac     # stored plain: 007 is 7
             if [ "$key" = JUMP_KEY ]; then jump_key_apply "$v" || return 1; cli_config get "$key"; return; fi
             if [ "$key" = FIND_KEY ]; then find_key_apply "$v" || return 1; cli_config get "$key"; return; fi
             cfg_set "$key" "$v"
             case "$key" in STORE|STORE_MACHINE) : > "$STORE_DIRTY" ;; esac
             cli_config get "$key" ;;
        unset) setting_check "$key" "" || return 1
             [ "$key" = JUMP_KEY ] && { jump_key_apply off || return 1; }
             [ "$key" = FIND_KEY ] && { find_key_apply off || return 1; }
             local tmp="$CONFIG_FILE.tmp.$$"
             if [ -r "$CONFIG_FILE" ]; then grep -v "^$key=" "$CONFIG_FILE" > "$tmp"; mv "$tmp" "$CONFIG_FILE"; fi
             cli_config get "$key" ;;
        *) echo "bhote: config list | get <KEY> | set <KEY> <value> | unset <KEY>" >&2; return 1 ;;
    esac
}
cli_done() {  # after a change: merge with the data location (silent when the data is only local)
    [ -n "${BHOTE_NO_SYNC:-}" ] && return 0
    [ "$(cfg_get STORE local)" = remote ] || return 0
    store_sync >/dev/null 2>&1; case $? in
        0) ;;
        2) : > "$STORE_DIRTY" ;;                              # a panel is syncing right now: it takes this change with it
        *) echo "bhote: saved locally; $(cfg_get STORE_MACHINE) is not reachable, it will be merged later" >&2 ;;
    esac
}
# The JSON of one topic: the same object for `list --json`, `show --json` and every changing command with --json (schema:
# docs/schema/topic.schema.json). A value that is not there is null, never an empty string or 0.
json_num() { case "$1" in ''|*[!0-9]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }
json_opt() { if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi; }
topic_n() {  # topic_n <file>: its number in `bhote list --all` (1-based); needs topics_load
    local i; for (( i = 0; i < T_N; i++ )); do [ "${T_FILE[$i]}" = "$1" ] && { printf '%s' $(( i + 1 )); return; }; done; printf 'null'
}
topic_json() {  # topic_json <file>
    local f=$1 st wf ag am ap as agent=null
    st=$(topic_get "$f" status now); wf=$(topic_get "$f" waiting_for); ag=$(topic_get "$f" agent); am=$(topic_get "$f" agent_machine); ap=$(topic_get "$f" agent_pane)
    case "$st" in now|next|waiting|review|later|done) ;; *) st=now ;; esac
    as=$(topic_get "$f" agent_session)
    [ "$st" = waiting ] || wf=""
    [ -n "$ag$ap$as" ] && agent=$(printf '{"name":%s,"machine":%s,"pane":%s,"session":%s}' "$(json_opt "$ag")" "$(json_opt "$am")" "$(json_opt "$ap")" "$(json_opt "$as")")
    printf '{"id":%s,"n":%s,"title":%s,"description":%s,"status":%s,"waiting_for":%s,"waiting_since":%s,"agent":%s,"created":%s,"updated":%s}' \
        "$(json_str "$(topic_id "$f")")" "$(topic_n "$f")" "$(json_str "$(topic_get "$f" title)")" "$(json_opt "$(topic_get "$f" description)")" \
        "$(json_str "$st")" "$(json_opt "$wf")" "$( [ -n "$wf" ] && json_num "$(topic_get "$f" waiting_since)" || printf 'null')" "$agent" \
        "$(json_num "$(topic_get "$f" created)")" "$(json_num "$(topic_get "$f" updated)")"
}
cli_show() {  # cli_show <file> [--json]
    local f=$1 id title st wf ws desc ag
    if [ "${2:-}" = --json ]; then [ -n "${T_N:-}" ] || topics_load; topic_json "$f"; printf '\n'; return 0; fi
    id=$(topic_id "$f"); title=$(topic_get "$f" title); st=$(topic_get "$f" status now); wf=$(topic_get "$f" waiting_for)
    ws=$(topic_get "$f" waiting_since 0); desc=$(topic_get "$f" description); ag=$(topic_get "$f" agent)
    printf '%s\n  status: %s\n  id: %s\n' "$title" "$st" "$id"
    if [ -n "$desc" ]; then printf '  description: %s\n' "$desc"; fi
    if [ -n "$ag" ]; then printf '  agent: %s (%s)\n' "$ag" "$(topic_get "$f" agent_machine)"; fi
    if [ "$st" = waiting ] && [ -n "$wf" ]; then printf '  waiting for: %s (%s)\n' "$wf" "$(ago "$ws")"; fi
    return 0
}
# ── bhote find: a search over all agents and topics, for a herdr popup (settings › Find key). Type to filter (every word
# must appear), ↑↓ choose, ⏎ jump: an agent is focused in herdr (on another machine: selected there); a topic opens its page
# in the bhote panel of the tab. Esc closes.
FI_KIND=(); FI_LABEL=(); FI_LOW=(); FI_NAME=(); FI_M=(); FI_P=(); FI_REF=(); FI_ST=(); FI_GRP=(); FI_SUB=(); FI_SC=()
find_state() {  # find_state <topic index>: FS_TXT, FS_COL: what its agent does, as the list says it
    local ast; FS_TXT=""; FS_COL=$D
    case "${T_STATUS[$1]}" in
        now) if [ -n "${T_TN[$1]}" ]; then FS_TXT="handing over → ${T_TN[$1]}"; FS_COL=$C
             elif [ -n "${T_AP[$1]}" ]; then agent_state_set ast "${T_AM[$1]}" "${T_AP[$1]}"
                 case "$ast" in working) FS_TXT=working; FS_COL=$ORANGE ;; testing) FS_TXT="running tests"; FS_COL=$ORANGE ;; blocked) FS_TXT="needs you"; FS_COL=$NN ;;
                     idle|done) FS_TXT=finished; FS_COL=$GREEN ;; *) FS_TXT=gone ;; esac
             fi ;;
        review) FS_TXT="ready for review"; FS_COL=$BLUE ;;
        waiting) [ -n "${T_AG[$1]}" ] && { FS_TXT="${T_AG[$1]} waits"; FS_COL=$Y; } ;;
    esac
}
find_items() {  # topics in the list's status order (review, now, next, waiting, later, done), then the agents: busy, then free
    local i m id st name task lowsrc="" n=0 pass
    FI_KIND=(); FI_LABEL=(); FI_LOW=(); FI_NAME=(); FI_M=(); FI_P=(); FI_REF=(); FI_ST=(); FI_GRP=(); FI_SUB=(); FI_SC=()
    for (( i = 0; i < T_N; i++ )); do
        FI_KIND[$n]=topic; FI_NAME[$n]=${T_TITLE[$i]}; FI_M[$n]=${T_AM[$i]}; FI_P[$n]=${T_AP[$i]}; FI_ST[$n]=${T_STATUS[$i]}; FI_REF[$n]=${T_ID[$i]}
        FI_GRP[$n]=${T_STATUS[$i]}; FI_LABEL[$n]="${T_AG[$i]}${T_AG[$i]:+${T_WFOR[$i]:+ · }}${T_WFOR[$i]}"
        find_state "$i"; FI_SUB[$n]=$FS_TXT; FI_SC[$n]=$FS_COL
        lowsrc="$lowsrc${T_TITLE[$i]} ${T_DESC[$i]} ${T_STATUS[$i]} ${T_AG[$i]} ${T_WFOR[$i]} $FS_TXT topic"$'\n'; n=$(( n + 1 ))
    done
    for pass in busy free; do
        for (( i = 0; i < AG_N; i++ )); do
            IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
            case "$st" in idle|done) [ "$pass" = free ] || continue ;; *) [ "$pass" = busy ] || continue ;; esac
            FI_KIND[$n]=agent; FI_NAME[$n]=$name; FI_M[$n]=$m; FI_P[$n]=$id; FI_ST[$n]=$st; FI_REF[$n]=""; FI_GRP[$n]=$pass
            FI_LABEL[$n]="$m${task:+ · $task}"; lowsrc="$lowsrc$name $m $task agent"$'\n'; n=$(( n + 1 ))
        done
    done
    i=0; while IFS= read -r m; do FI_LOW[$i]=$m; i=$(( i + 1 )); done <<< "$(printf '%s' "$lowsrc" | tr '[:upper:]' '[:lower:]')"
}
FI_HIT=()
find_filter() {  # find_filter <query>: FI_HIT = the matching items (every word must appear), in their group order
    local q w i ok words=()
    q=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); read -r -a words <<< "$q"; FI_HIT=()
    for (( i = 0; i < ${#FI_KIND[@]}; i++ )); do
        ok=1; for w in ${words[@]+"${words[@]}"}; do case "${FI_LOW[$i]}" in *"$w"*) ;; *) ok=0; break ;; esac; done
        [ "$ok" = 1 ] && FI_HIT[${#FI_HIT[@]}]=$i
    done
}
find_draw() {  # find_draw <query> <selected hit> <note>: the hits under a caption per group (like the panel's list)
    local rows cols w i k n off sel=$2 out ic nm lb lw nw pad line room sr=0 r prev="" cap cc
    local rl=() rh=()                                          # screen rows: their text, and the hit they show (-1 = caption)
    read -r rows cols < <(stty size </dev/tty 2>/dev/null); rows=${rows:-20}; cols=${cols:-60}; w=$(( cols - 2 ))
    n=${#FI_HIT[@]}; room=$(( rows - 4 )); [ "$room" -lt 1 ] && room=1
    for (( k = 0; k < n; k++ )); do
        i=${FI_HIT[$k]}
        if [ "${FI_GRP[$i]}" != "$prev" ]; then
            prev=${FI_GRP[$i]}
            case "$prev" in review) cap=REVIEW; cc=$BLUE ;; now) cap=NOW; cc=$ORANGE ;; next) cap=NEXT; cc=$S ;; waiting) cap=WAITING; cc=$Y ;; later) cap=LATER; cc=$R ;;
                done) cap=DONE; cc=$GREEN ;; busy) cap="AGENTS · BUSY"; cc=$ORANGE ;; free) cap="AGENTS · FREE"; cc=$GREEN ;; *) cap=$prev; cc=$D ;; esac
            rl[${#rl[@]}]=$(printf ' %s%s%s' "$cc" "$cap" "$X"); rh[${#rh[@]}]=-1
        fi
        if [ "${FI_KIND[$i]}" = agent ]; then
            case "${FI_ST[$i]}" in working) ic="${ORANGE}◐" ;; testing) ic="${ORANGE}◌" ;; blocked) ic="${NN}◉" ;; done) ic="${GREEN}✓" ;; idle) ic="${GREEN}○" ;; *) ic="${D}○" ;; esac
        else
            case "${FI_ST[$i]}" in now) ic="${ORANGE}●" ;; next) ic="${S}●" ;; waiting) ic="${Y}●" ;; review) ic="${BLUE}●" ;; later) ic="${R}●" ;; done) ic="${GREEN}✓" ;; *) ic="${D}●" ;; esac
        fi
        local sb=${FI_SUB[$i]:-} sbw=0 sep=""
        clip_set nm "${FI_NAME[$i]}" $(( w * 3 / 5 )); dw_set nw "$nm"
        [ -n "$sb" ] && { clip_set sb "$sb" $(( w - 8 - nw )); dw_set sbw "$sb"; }  # the state first: it must not be cut away
        [ -n "$sb" ] && [ -n "${FI_LABEL[$i]}" ] && sep=" · "
        clip_set lb "${FI_LABEL[$i]}" $(( w - 8 - nw - sbw - ${#sep} )); dw_set lw "$lb"; [ -n "$lb" ] || sep=""
        pad=$(( w - 8 - nw - lw - ${#sep} - sbw )); [ "$pad" -lt 0 ] && pad=0
        [ "$k" = "$sel" ] && sr=${#rl[@]}
        if [ "$k" = "$sel" ]; then line=$(printf '%s   %s%s %s%s%s  %s%s%s%s%s%*s %s' "$SELBG" "$ic" "$X$SELBG" "$LSEL" "$nm" "$X$SELBG" "$DSEL" "$lb" "$sep" "${FI_SC[$i]:-}" "$sb" "$pad" "" "$X")
        else line=$(printf '   %s%s %s%s%s  %s%s%s%s%s%s' "$ic" "$X" "$TITLE" "$nm" "$X" "$D" "$lb" "$sep" "${FI_SC[$i]:-}" "$sb" "$X"); fi
        rl[${#rl[@]}]=$line; rh[${#rh[@]}]=$k
    done
    off=0; [ "$sr" -ge "$room" ] && off=$(( sr - room + 1 ))
    [ "$sr" -gt 0 ] && [ "${rh[$(( sr - 1 ))]}" = -1 ] && [ "$off" -gt $(( sr - 1 )) ] && off=$(( sr - 1 ))   # its caption stays in view
    out=$'\033[H'
    clip_set line "$1" $(( w - 14 ))
    out+=$(printf ' %s▶%s %s%s%s\033[7m \033[27m %s%d/%d%s' "$ORANGE" "$X" "$L" "$line" "$X" "$D" "$n" "${#FI_KIND[@]}" "$X")$'\033[K\n'
    out+=$(printf ' %s%s%s' "$B" "$(hline $(( w - 1 )))" "$X")$'\033[K\n'
    for (( r = off; r < off + room && r < ${#rl[@]}; r++ )); do out+="${rl[$r]}"$'\033[K\n'; done
    if [ "$n" = 0 ]; then                                     # nothing found: Enter makes it a topic
        if [ -n "$1" ]; then clip_set line "$1" $(( w - 40 )); out+=$(printf '   %snothing matches · %s⏎ %screate "%s"%s' "$D" "$S" "$L" "$line" "$X")$'\033[K\n'
        else out+=$(printf '   %snothing matches%s' "$D" "$X")$'\033[K\n'; fi
    fi
    out+=$'\033[J'
    local hint="↑↓ choose · ⏎ open · x done · ^n new · esc close"
    [ -n "$1" ] && hint="↑↓ choose · ⏎ open · ^x done · ^n new · esc close"
    [ "$n" = 0 ] && [ -n "$1" ] && hint="⏎ new topic \"$1\" · esc close"
    printf '%s\033[%d;1H %s%s%s\033[K' "$out" "$rows" "$([ -n "$3" ] && printf '%s' "$S" || printf '%s' "$D")" "$(clip "${3:-$hint}" $(( w - 1 )))" "$X"
}
panel_focus_active() {  # the bhote panel of the tab under the popup gets the focus (through herdr's socket: by pane id)
    local act tab pan sock=${HERDR_SOCKET_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock}
    act=${HERDR_ACTIVE_PANE_ID:-}
    [ -n "$act" ] || act=$(printf '%s' "${HERDR_PLUGIN_CONTEXT_JSON:-}" | jq -r '[.. | objects | (.focused_pane_id? // .pane_id?) | strings][0] // empty' 2>/dev/null)
    [ -n "$act" ] || act=$(herdr pane list 2>/dev/null | jq -r '[.result.panes[] | select(.focused)][0].pane_id // empty')
    tab=$(herdr pane list 2>/dev/null | jq -r --arg p "$act" '[.result.panes[] | select(.pane_id == $p)][0].tab_id // empty')
    pan=$(herdr pane list 2>/dev/null | jq -r --arg t "$tab" '[.result.panes[] | select(.tab_id == $t and (.agent // "") == "" and (.terminal_title_stripped // "") == "Bhote")][0].pane_id // empty')
    case "$pan" in ''|*[!A-Za-z0-9:_-]*) return 1 ;; esac
    perl -MIO::Socket::UNIX -e 'my $s = IO::Socket::UNIX->new(Peer => $ARGV[0]) or exit 1;
        print $s qq({"id":"bhote-find","method":"pane.focus","params":{"pane_id":"$ARGV[1]"}}\n); my $r = <$s>; exit(defined $r && $r =~ /"result"/ ? 0 : 1)' "$sock" "$pan"
}
find_act() {  # find_act <item>: 0 = done (close), 1 = stay (FIND_NOTE says why)
    local i=$1 m=${FI_M[$1]} p=${FI_P[$1]}
    FIND_NOTE=""
    if [ "${FI_KIND[$i]}" = topic ]; then                     # a topic: its page in the panel of this tab (the panel gets the focus)
        printf '%s %s show\n' "${FI_REF[$i]}" "$$$RANDOM" > "$SHARED_DIR/select" 2>/dev/null; poke
        panel_focus_active || { FIND_NOTE="no bhote panel in this tab: the panels show the topic"; return 1; }
        return 0
    fi
    [ -n "$m" ] || m=$HOST
    agent_jump "$m" "$p" || { FIND_NOTE="$m is not a machine herdr knows here"; return 1; }
    if [ "$m" != "$HOST" ]; then FIND_NOTE="selected on $m: switch to $m in herdr"; return 2; fi
    return 0
}
find_main() {
    [ -t 0 ] && [ -t 1 ] || { echo "bhote: find needs a terminal (bind it as a herdr popup: settings › Find key)" >&2; return 1; }
    local q="" sel=0 c k2 k3 r _s note="" k
    read -r ROWS COLS < <(stty size </dev/tty 2>/dev/null); ROWS=${ROWS:-20}; COLS=${COLS:-60}   # (ask draws on the last row)
    if [ -n "$(find "$AGENT_LOCAL" -mmin -1 2>/dev/null)" ]; then :                 # the panels' lists are fresh: no herdr round trip
    else AGENT_LOCAL=$RUN_DIR/agents.local; AGENT_REMOTE=$RUN_DIR/agents.remote; collect_local; [ "$(cfg_get REMOTE_AGENTS off)" = on ] && collect_remote; fi
    ui_load; topics_load; find_items; find_filter ""
    _s=$(stty -g </dev/tty 2>/dev/null); stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    trap 'stty "$_s" </dev/tty 2>/dev/null; printf "\033[?25h"; exit 0' INT TERM HUP
    printf '\033]2;bhote search\007\033[?25l\033[2J'
    while true; do
        [ "$sel" -ge "${#FI_HIT[@]}" ] && sel=$(( ${#FI_HIT[@]} - 1 )); [ "$sel" -lt 0 ] && sel=0
        find_draw "$q" "$sel" "$note"; note=""
        IFS= read -rsn1 c </dev/tty || break
        if [ "$c" = $'\016' ] || { [ -z "$c" ] && [ "${#FI_HIT[@]}" = 0 ] && [ -n "$q" ]; }; then
            # Ctrl-N: a new topic in the editor, the search text to start with; Enter when nothing matches: made at once
            # from the search text (both "Title; description @Name")
            read -r ROWS COLS < <(stty size </dev/tty 2>/dev/null)
            local made=1
            if [ "$c" = $'\016' ]; then prompt_new_topic "$q" || made=0; else new_topic_from "$q" || made=0; fi
            if [ "$made" = 1 ]; then
                poke; topics_load; find_items; q=""; find_filter ""; sel=0
                for (( k = 0; k < ${#FI_HIT[@]}; k++ )); do [ "${FI_REF[${FI_HIT[$k]}]}" = "$NEW_TOPIC_ID" ] && { sel=$k; break; }; done
                note="added · ⏎ shows it in the panel"
            fi
            printf '%s\033[?25l' "$MOUSE_OFF"; trap - USR1           # ask leaves mouse reports on: here they would arrive as typing
            continue
        fi
        if [ "$c" = $'\030' ] || { [ "$c" = x ] && [ -z "$q" ]; }; then   # Ctrl-X (or x while nothing is typed): the topic is done
            if [ "${#FI_HIT[@]}" -gt 0 ] && [ "${FI_KIND[${FI_HIT[$sel]}]}" = topic ]; then
                local xid=${FI_REF[${FI_HIT[$sel]}]} xf
                xf="$TOPIC_DIR/$xid.topic"
                if [ -f "$xf" ] && [ "$(topic_get "$xf" status)" != done ]; then
                    topic_set "$xf" status done; poke; note="done: $(topic_get "$xf" title)"
                    topics_load; find_items; find_filter "$q"
                    for (( k = 0; k < ${#FI_HIT[@]}; k++ )); do [ "${FI_REF[${FI_HIT[$k]}]}" = "$xid" ] && { sel=$k; break; }; done
                fi
            else note="x checks off a topic"; fi
            continue
        fi
        case "$c" in
            "") [ "${#FI_HIT[@]}" -gt 0 ] || continue
                find_act "${FI_HIT[$sel]}"; r=$?
                [ "$r" = 0 ] && break
                note=$FIND_NOTE; [ "$r" = 2 ] && { find_draw "$q" "$sel" "$note"; sleep 1.6; break; } ;;
            $'\033') read_soon k2
                case "$k2" in
                    "") break ;;
                    "["|O) k3=""; while IFS= read -rsn1 -t 1 k3 </dev/tty; do case "$k3" in [0123456789\;]) ;; *) break ;; esac; done
                           case "$k3" in A) sel=$(( sel - 1 )) ;; B) sel=$(( sel + 1 )) ;; esac ;;
                esac ;;
            $'\177'|$'\010') q=${q%?}; find_filter "$q"; sel=0 ;;
            $'\025') q=""; find_filter ""; sel=0 ;;                 # Ctrl-U
            $'\020') sel=$(( sel - 1 )) ;;                         # Ctrl-P
            $'\t') sel=$(( sel + 1 )) ;;
            [[:cntrl:]]) ;;
            *) [ "${#q}" -lt 60 ] && q="$q$c"; find_filter "$q"; sel=0 ;;
        esac
    done
    stty "$_s" </dev/tty 2>/dev/null; printf '\033[?25h'
    return 0
}
bhote_help() {
    cat <<'HELP'
bhote — topics and agents next to herdr.

  bhote                              the panel
  bhote add <title> [options]        new topic   -d <text> description · @Name or -w Name waiting for Name · -s now|next|later|done
  bhote list [--all] [-s <status>]   the open topics (--all: also done ones), numbered
  bhote show <ref>                   one topic
  bhote now|next|review|later|done <ref>   start or resume · up next · ready for review · park · mark done
  bhote wait <ref> <Name>            waiting for Name (from now)
  bhote rename <ref> <title>         new title
  bhote desc <ref> [<text>]          new description (at most 140 characters; none = remove it)
  bhote rm <ref>                     delete
  bhote sync                         merge with the data location now
  bhote config [list|get|set|unset]  read and change the settings (bhote config list shows them all)
  bhote current                      the topic of the agent that asks (for a Claude Code SessionStart hook)
  bhote agents                       the agents of herdr (numbered: refs for transfer)
  bhote transfer <from> <to> [-t <topic>]   Steal & Transfer: <from> commits and hands its work over to <to>
  bhote handover <topic> --to <m/p> --branch <b> --commit <c>   (the source agent reports; the command it gets says it)
  bhote setup [--json]               the setup wizard (--json: only what is in place)
  bhote find                         search topics and agents, jump there (for a herdr popup: settings › Find key)
  bhote event                        an agent status event from herdr (the plugin calls it)
  bhote version · bhote help

Every command takes --json: one topic object (list: an array) as described in docs/cli-reference.md.
<ref> is a number from `bhote list --all`, an id (or its start), or part of the title.
Exit codes: 0 ok · 1 error · 2 the ref matches more than one topic. Messages go to stderr.
Settings: ~/.config/bhote/config (or in the panel: ",").
HELP
}
bhote_cli() {
    local a json="" args=()
    for a in "$@"; do if [ "$a" = --json ]; then json=--json; else args[${#args[@]}]=$a; fi; done   # --json anywhere, also first
    set -- ${args[@]+"${args[@]}"}
    local cmd=${1:-}; [ $# -gt 0 ] && shift
    AGENT_SEND_SYNC=1                                               # a command waits for herdr and says when a prompt failed
    harden_perms
    trap 'rm -rf "$RUN_DIR"' EXIT
    case "$cmd" in
        help|-h|--help) bhote_help ;;
        config) cli_config "$@" ;;
        agents) bhote_info; cli_agents ;;
        transfer) bhote_info; cli_transfer "$@" ;;
        handover) cli_handover "$@" ;;
        setup) bhote_info; if [ -n "$json" ]; then setup_status_json; else term_size 2>/dev/null; bhote_setup; fi ;;
        event) bhote_info; cli_event ;;
        remote-changed) : > "$SHARED_DIR/remote.due"; poke ;;            # (the plugin action "changed": another machine's agents moved)
        dump) if [ "${1:-}" = --packed ]; then topics_dump_packed; else topics_dump; fi ;;   # for the herdr plugin action "dump"
        current) bhote_info; cli_current ;;
        find) bhote_info; find_main ;;
        version|--version|-V) if [ -n "$json" ]; then printf '{"version":%s}\n' "$(json_str "$VERSION")"; else echo "bhote $VERSION"; fi ;;
        add)  local title="" who="" st="" desc="" arg
              while [ $# -gt 0 ]; do
                  case "$1" in
                      --waiting|-w) who=${2:-}; shift ;;
                      --status|-s) st=${2:-}; shift ;;
                      --desc|-d) desc=${2:-}; shift ;;
                      @?*) who=${1#@} ;;
                      --) shift; title="${title:+$title }$*"; break ;;
                      -?*) echo "bhote: unknown option '$1' for add (a title starting with - goes after --)" >&2; return 1 ;;
                      *) title="${title:+$title }$1" ;;
                  esac; shift
              done
              case "$st" in ''|now|next|waiting|review|later|done) ;; *) echo "bhote: --status is one of now, next, review, later, done" >&2; return 1 ;; esac
              [ "$st" = waiting ] && [ -z "$who" ] && { echo "bhote: waiting needs a name (@Name or -w Name)" >&2; return 1; }
              [ "${#desc}" -gt "$DESC_MAX" ] && echo "bhote: the description is cut to $DESC_MAX characters" >&2
              topic_new "$title" "$who" "$desc" || { echo "bhote: a title is needed (bhote add <title>)" >&2; return 1; }
              f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"
              if is_agent; then                                     # created by an agent: it is that agent's topic
                  bhote_info; agent_note "$f"; topic_set "$f" agent_machine "$HOST"
                  [ -n "${HERDR_WORKSPACE_ID:-}" ] && topic_set "$f" agent "$(herdr workspace list 2>/dev/null | jq -r --arg w "$HERDR_WORKSPACE_ID" '[.result.workspaces[] | select(.workspace_id == $w)][0].label // "agent"' 2>/dev/null)"
              fi
              case "$st" in next|later|done|review) topic_set "$f" status "$st" ;; esac
              cli_done; topics_load; cli_show "$f" $json ;;
        list|ls) local all="" only="" i first=1
              while [ $# -gt 0 ]; do case "$1" in --all|-a) all=1 ;; --status|-s) only=${2:-}; shift ;; *) echo "bhote: unknown option '$1' for list" >&2; return 1 ;; esac; shift; done
              case "$only" in ''|now|next|waiting|review|later|done) ;; *) echo "bhote: --status is one of now, next, waiting, review, later, done" >&2; return 1 ;; esac
              NOW=$(date +%s); topics_load
              [ -n "$json" ] && printf '['
              for (( i = 0; i < T_N; i++ )); do
                  [ -n "$only" ] && [ "${T_STATUS[$i]}" != "$only" ] && continue
                  [ -z "$only" ] && [ -z "$all" ] && [ "${T_STATUS[$i]}" = done ] && continue
                  if [ -n "$json" ]; then
                      [ "$first" = 1 ] || printf ','; first=0
                      topic_json "${T_FILE[$i]}"
                  else
                      printf '%3s  %-8s %s' "$(( i + 1 ))" "${T_STATUS[$i]}" "${T_TITLE[$i]}"
                      if [ "${T_STATUS[$i]}" = waiting ]; then printf '  (%s, %s)' "${T_WFOR[$i]}" "$(ago "${T_WSINCE[$i]:-$NOW}")"; fi
                      printf '\n'
                  fi
              done
              if [ -n "$json" ]; then printf ']\n'; fi; return 0 ;;
        show) local f; f=$(topic_ref "${1:-}") || return $?; topics_load; cli_show "$f" $json ;;
        done|now|next|review|later|wait|rename|desc|rm)
              local f ref=${1:-}; [ -n "$ref" ] || { echo "bhote: $cmd needs a topic (number, id or part of the title)" >&2; return 1; }
              f=$(topic_ref_sync "$ref") || return $?; shift
              case "$cmd" in
                  done) local ag_call=""; is_agent && ag_call=1
                        if [ -n "$ag_call" ] && [ "$(cfg_get AGENT_CAN_CLOSE on)" != on ]; then   # an agent may only hand it over
                            echo "bhote: agents may not close topics here (AGENT_CAN_CLOSE=off): set to review" >&2; topic_set "$f" status review
                            notify "Ready for review" "$(topic_get "$f" title)" request
                        else topic_set "$f" status done; [ -n "$ag_call" ] && notify "Done" "$(topic_get "$f" title)" done; fi
                        agent_note "$f"; poke ;;
                  review) topic_set "$f" status review; agent_note "$f"; is_agent && notify "Ready for review" "$(topic_get "$f" title)" request; poke ;;
                  now) if [ "$(topic_get "$f" status)" = waiting ] && [ -n "$(topic_get "$f" agent_pane)" ] && [ -z "${CLAUDECODE:-}" ] && [ "${1:-}" != --quiet ]; then
                           bhote_info; topic_resume "$f"            # the wait is over: its agent gets told and goes on
                       else topic_set "$f" status now; topic_set "$f" waiting_for ""; fi ;;
                  later) topic_set "$f" status later ;;
                  next) topic_set "$f" status next ;;
                  wait) [ -n "${1:-}" ] || { echo "bhote: wait needs a name (bhote wait <ref> <Name>)" >&2; return 1; }
                        topic_set "$f" status waiting; topic_set "$f" waiting_for "$*"; topic_set "$f" waiting_since "$(date +%s)" ;;
                  rename) [ -n "${1:-}" ] || { echo "bhote: rename needs a title" >&2; return 1; }; topic_set "$f" title "$*" ;;
                  rm) local rid; rid=$(topic_id "$f"); topic_set "$f" deleted 1 ;;
                  desc) local dd="$*"; [ "${#dd}" -gt "$DESC_MAX" ] && echo "bhote: the description is cut to $DESC_MAX characters" >&2
                        topic_set "$f" description "$*" ;;
              esac
              cli_done
              if [ "$cmd" = rm ]; then if [ -n "$json" ]; then printf '{"deleted":%s}\n' "$(json_str "$rid")"; else echo "deleted"; fi
              else topics_load; cli_show "$f" $json; fi ;;
        sync) local m; m=$(cfg_get STORE_MACHINE '')
              sync_out() { if [ -n "$json" ]; then printf '{"sync":%s,"machine":%s}\n' "$(json_str "$1")" "$(json_opt "$m")"; fi; }
              if [ "$(cfg_get STORE local)" != remote ]; then sync_out local; [ -n "$json" ] || echo "data location is local, nothing to merge"
              else store_sync; case $? in
                  0) sync_out ok; [ -n "$json" ] || echo "in sync with $m" ;;
                  2) sync_out busy; echo "bhote: another sync is running right now, try again in a moment" >&2; return 1 ;;
                  *) sync_out offline; echo "bhote: $m is not reachable, changes stay local" >&2; return 1 ;;
              esac; fi ;;
        *) echo "bhote: unknown command '$cmd' (bhote help)" >&2; return 1 ;;
    esac
}

# BHOTE_SOURCE_ONLY=1 loads the functions without starting the panel (the tests do that).
if [ -n "${BHOTE_SOURCE_ONLY:-}" ]; then :
elif [ $# -gt 0 ]; then bhote_cli "$@"
else bhote_main; fi

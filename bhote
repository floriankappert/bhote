machine_offline() {  # machine_offline <label>: 0 when its last fetch failed (herdr reconnecting)
    local _l; [ -r "$SHARED_DIR/machines.offline" ] || return 1
    while IFS= read -r _l; do [ "$_l" = "$1" ] && return 0; done < "$SHARED_DIR/machines.offline"; return 1
}
metas_read() {  # metas_read <var>: the pane meta lists of both machines in one variable (no subshell, no cat)
    local _m=$'\n' _l _f; for _f in "$AGENT_META_L" "$AGENT_META_R"; do [ -r "$_f" ] && while IFS= read -r _l; do _m="$_m$_l"$'\n'; done < "$_f"; done
    printf -v "$1" '%s' "$_m"
}
agent_footer() {
    # saved machines exist but are not asked: say so, and where to change it
    if [ "$U_REMOTE" != on ] && [ "${HAS_MACHINES:-0}" = 1 ]; then
        printf '\n  %s%s%s\n' "$D" "$(clip "Remote agents off · , settings" $(( ${COLS:-44} - 4 )))" "$X"
    fi
}
dw_set() {  # dw_set <var> <text>: the columns the text takes on the terminal (East Asian wide characters and emoji 2,
    # combining marks 0). ASCII is counted at once; the rest byte by byte in the C locale (bash 3.2 has no wcwidth).
    local _s=$2 _n _x=0 _i _b _c _d _cp
    _n=${#_s}
    case "$_s" in *[![:ascii:]]*) ;; *) printf -v "$1" '%s' "$_n"; return ;; esac
    local LC_ALL=C; _s=${_s//[[:ascii:]]/}
    for (( _i = 0; _i < ${#_s}; _i++ )); do
        printf -v _b '%d' "'${_s:_i:1}"; [ "$_b" -lt 0 ] && _b=$(( _b + 256 ))
        if [ "$_b" -ge 240 ]; then _x=$(( _x + 1 )); _i=$(( _i + 3 ))
        elif [ "$_b" -ge 224 ]; then
            printf -v _c '%d' "'${_s:_i+1:1}"; printf -v _d '%d' "'${_s:_i+2:1}"; [ "$_c" -lt 0 ] && _c=$(( _c + 256 )); [ "$_d" -lt 0 ] && _d=$(( _d + 256 ))
            _cp=$(( ((_b & 15) << 12) | ((_c & 63) << 6) | (_d & 63) )); _i=$(( _i + 2 ))
            if (( (_cp >= 0x1100 && _cp <= 0x115F) || (_cp >= 0x2E80 && _cp <= 0xA4CF && _cp != 0x303F) || (_cp >= 0xAC00 && _cp <= 0xD7A3) || (_cp >= 0xF900 && _cp <= 0xFAFF) || (_cp >= 0xFE30 && _cp <= 0xFE4F) || (_cp >= 0xFF00 && _cp <= 0xFF60) || (_cp >= 0xFFE0 && _cp <= 0xFFE6) )); then _x=$(( _x + 1 ))
            elif (( (_cp >= 0x200B && _cp <= 0x200F) || (_cp >= 0xFE00 && _cp <= 0xFE0F) || (_cp >= 0x20D0 && _cp <= 0x20FF) )); then _x=$(( _x - 1 )); fi
        elif [ "$_b" -ge 192 ]; then
            printf -v _c '%d' "'${_s:_i+1:1}"; [ "$_c" -lt 0 ] && _c=$(( _c + 256 ))
            _cp=$(( ((_b & 31) << 6) | (_c & 63) )); _i=$(( _i + 1 ))
            (( _cp >= 0x300 && _cp <= 0x36F )) && _x=$(( _x - 1 ))
        fi
    done
    printf -v "$1" '%s' $(( _n + _x ))
}
clip_set() {  # clip_set <var> <text> <max columns>: cut with a … when wider (plain text only; a wide character counts 2)
    local _ct=$2 _w _o="" _i _c _cw _u=0
    if [ "$3" -lt 1 ]; then printf -v "$1" '%s' ""; return; fi
    case "$_ct" in *[![:ascii:]]*) ;; *) [ "${#_ct}" -gt "$3" ] && _ct="${_ct:0:$(( $3 - 1 ))}…"; printf -v "$1" '%s' "$_ct"; return ;; esac
    dw_set _w "$_ct"; [ "$_w" -le "$3" ] && { printf -v "$1" '%s' "$_ct"; return; }
    for (( _i = 0; _i < ${#_ct}; _i++ )); do
        _c=${_ct:_i:1}; dw_set _cw "$_c"; [ $(( _u + _cw )) -gt $(( $3 - 1 )) ] && break
        _o=$_o$_c; _u=$(( _u + _cw ))
    done
    printf -v "$1" '%s' "${_o}…"
}
pad_set() {  # pad_set <var> <text> <columns>: the text, filled with spaces to that many columns (printf %-Ns counts bytes)
    local _w _p; dw_set _w "$2"; _p=$(( $3 - _w )); [ "$_p" -lt 0 ] && _p=0
    printf -v "$1" '%s%*s' "$2" "$_p" ""
}
clip() { clip_set _CLIP "$1" "$2"; printf '%s' "$_CLIP"; }
view_head() {  # one line: name and version in colour, the tagline; then a rule (the dog lives on the welcome screen only)
    local name="Bhote v$VERSION" t; clip_set t " - Herd Management" $(( ${COLS:-44} - 5 - ${#name} ))
    printf '\n  %s%s%s%s\n' "${HEAD_GRAD:-$L$name$X}" "$D" "$t" "$X"
    [ -n "${HEAD_NOTE:-}" ] && { clip_set t "$HEAD_NOTE" $(( ${COLS:-44} - 4 )); printf '  %s%s%s\n' "$GREEN" "$t" "$X"; }
    [ "${NEWFEAT:-0}" = 1 ] && { clip_set t "✦ New Features Available · w Start Wizard" $(( ${COLS:-44} - 4 )); printf '  %s%s%s\n' "$ORANGE" "$t" "$X"; }
    rule
}
# The herdr key that jumps between agent and panel (the plugin action bhote.panel.focus), as herdr's config.toml binds it:
# a [[keys.command]] block, or the inline form term-theme writes. "prefix+t" is shown with the prefix: "^b t".
HERDR_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml; HERDR_CONFIG_OWN=$HERDR_CONFIG
# The keys belong to the herdr you TYPE into: with the panel on another machine than that herdr (a Mac attached to this Linux
# session) HERDR_KEYS_MACHINE names it, and its config.toml is read from a copy the collector keeps (keys_fetch).
keys_cache_set() { local _km; cfg_var _km HERDR_KEYS_MACHINE any; KEYS_CACHE=""
    [ "$_km" = any ] || [ "$_km" = "$HOST" ] || KEYS_CACHE=$SHARED_DIR/herdr-keys.${_km//[!A-Za-z0-9_-]/_}; KEYS_MACHINE=$_km; }
keys_fetch() {  # the other machine's herdr config.toml into the cache (only when it changed)
    local host tmp; keys_cache_set; [ -n "$KEYS_CACHE" ] || return 0
    host=$(store_host "$KEYS_MACHINE"); [ -n "$host" ] || return 1
    tmp=$(mktemp "$SHARED_DIR/herdr-keys.XXXXXX") || return 1
    local os; os=$(store_sh "$host" 'uname -s' 2>/dev/null | head -1); case "$os" in Darwin|Linux) printf '%s\n' "$os" > "$KEYS_CACHE.os" ;; esac   # (before the config: that file's arrival reloads the keys)
    store_sh "$host" 'cat "${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml"' 2>/dev/null | head -c 200000 > "$tmp"
    if [ -s "$tmp" ] && ! cmp -s "$tmp" "$KEYS_CACHE" 2>/dev/null; then mv "$tmp" "$KEYS_CACHE"; else rm -f "$tmp"; fi
}
focus_key_set() {  # focus_key_set <var>: the key in short form, or empty when none is bound
    local _k="" _p _cfg=$HERDR_CONFIG
    if [ "$HERDR_CONFIG" = "$HERDR_CONFIG_OWN" ]; then keys_cache_set; [ -n "$KEYS_CACHE" ] && _cfg=$KEYS_CACHE; fi   # (not when a scratch file is checked)
    HERDR_CONFIG_IN=$_cfg
    KEYS_OS=$KEYS_OS_LOCAL; [ -n "$KEYS_CACHE" ] && [ -r "$KEYS_CACHE.os" ] && { read -r KEYS_OS < "$KEYS_CACHE.os"; } 2>/dev/null   # (the other machine's own system)
    if [ -r "$_cfg" ]; then
        _k=$(awk '
            function val(s, name) { if (!match(s, name " *= *\"[^\"]*\"")) return ""; s = substr(s, RSTART, RLENGTH); sub(/^[^"]*"/, "", s); sub(/"$/, "", s); return s }
            /^[ \t]*\[/ { if (blk && cmd == "bhote.panel.focus" && k != "") { print k; done = 1; exit }
                            blk = ($0 ~ /^[ \t]*\[\[keys\.command\]\]/); k = ""; cmd = ""; next }
            /bhote\.panel\.focus/ && /key *= *"/ { n = split($0, parts, "}"); for (i = 1; i <= n; i++) if (parts[i] ~ /bhote\.panel\.focus/) { print val(parts[i], "key"); done = 1; exit } }
            blk && /^[ \t]*key *= *"/ { k = val($0, "key") }
            blk && /^[ \t]*command *= *"bhote\.panel\.focus"/ { cmd = "bhote.panel.focus" }
            END { if (!done && blk && cmd == "bhote.panel.focus" && k != "") print k }' "$_cfg" 2>/dev/null)
        _p=$(awk '/^[ \t]*\[/ { inkeys = ($0 ~ /^[ \t]*\[keys\][ \t]*$/); next } inkeys && /^[ \t]*prefix *= *"/ { s = $0; sub(/^[^"]*"/, "", s); sub(/".*/, "", s); print s; exit }' "$_cfg" 2>/dev/null)
    fi
    _k=${_k//[[:cntrl:]]/}; HERDR_PREFIX=${_p:-ctrl+b}; FOCUS_KEY_RAW=$_k
    [ -n "$KEYS_CACHE" ] && [ ! -r "$KEYS_CACHE" ] && { printf -v "$1" '%s' ""; return; }   # the other machine's keys are not there yet: none rather than the wrong ones
    [ -n "$KEYS_CACHE" ] && : > "$RUN_DIR/keys.loaded"
    key_pretty "$1" "$_k"
}
KEYS_OS_LOCAL=$(uname -s); KEYS_OS=$KEYS_OS_LOCAL      # the keyboard you type on decides the names: Mac (Control, Option, Command) or Linux
key_pretty() {  # key_pretty <var> <herdr key>: "prefix+t" -> "Ctrl+B|T", "ctrl+alt+t" -> "Ctrl+Option+T" on a Mac, "Ctrl+Alt+T" elsewhere
    local _k=${2//[[:cntrl:]]/} _o="" _t _parts _i _mac=0; [ "${KEYS_OS:-}" = Darwin ] && _mac=1
    case "$_k" in off|none|"") printf -v "$1" '%s' ""; return 0 ;; esac
    case "$_k" in prefix+*)                                         # the prefix, then the key: Ctrl+B|T
        local _kp _kr; key_pretty _kp "${HERDR_PREFIX:-ctrl+b}"; key_pretty _kr "${_k#prefix+}"; printf -v "$1" '%s' "$_kp|$_kr"; return 0 ;; esac
    IFS=+ read -ra _parts <<< "$_k"
    for (( _i = 0; _i < ${#_parts[@]}; _i++ )); do
        _t=${_parts[$_i]}
        case "$_t" in
            ctrl|control) _t=Ctrl ;; shift) _t=Shift ;;
            alt|option|opt) [ "$_mac" = 1 ] && _t=Option || _t=Alt ;;
            cmd|command|super|meta|win) [ "$_mac" = 1 ] && _t=Cmd || _t=Super ;;
            space) _t=Space ;; enter|return) _t=Enter ;; esc|escape) _t=Esc ;; tab) _t=Tab ;; backspace) _t=Backspace ;;
            up|down|left|right|home|end|delete|insert|pageup|pagedown) _t="$(printf '%s' "${_t:0:1}" | tr '[:lower:]' '[:upper:]')${_t:1}" ;;
            ?) _t=$(printf '%s' "$_t" | tr '[:lower:]' '[:upper:]') ;;
        esac
        _o="$_o${_o:++}$_t"
    done
    printf -v "$1" '%s' "$_o"
}
# The key is kept in a block of its own in herdr's config.toml ("# >>> bhote" .. "# <<< bhote"): bhote rewrites only that
# block, and tools that regenerate the file can keep it (the dotfiles' term-theme does). herdr checks it on reload; a key it
# does not take puts the old file back.
key_ok() {  # key_ok <herdr key>: plain key syntax only (it goes into a TOML string)
    case "$1" in *[!A-Za-z0-9+_\;,.\[\]/=-]*) echo "bhote: odd characters in the key" >&2; return 1 ;; esac
    [ "${#1}" -le 40 ] || { echo "bhote: the key is too long" >&2; return 1; }
}
herdr_keys_apply() {  # herdr_keys_apply <jump key|off> <find key|off>: 0 when herdr took both
    local j=$1 fk=$2 old tmp out
    case "$j" in off|none) j="" ;; esac; case "$fk" in off|none) fk="" ;; esac
    { [ -z "$j" ] || key_ok "$j"; } && { [ -z "$fk" ] || key_ok "$fk"; } || return 1
    [ -n "$j" ] && [ "$j" = "$fk" ] && { echo "bhote: the jump key and the find key must differ" >&2; return 1; }
    mkdir -p "$(dirname "$HERDR_CONFIG")" && touch "$HERDR_CONFIG" || return 1
    old=$(mktemp "$RUN_DIR/herdrcfg.XXXXXX") && cp "$HERDR_CONFIG" "$old" || return 1
    tmp=$(mktemp "$HERDR_CONFIG.XXXXXX") || return 1
    awk '/^# >>> bhote/ { skip = 1; next } /^# <<< bhote/ { skip = 0; next } !skip { l[++n] = $0 }
         END { while (n > 0 && l[n] == "") n--; for (i = 1; i <= n; i++) print l[i] }' "$HERDR_CONFIG" > "$tmp"
    if [ -n "$j" ] && HERDR_CONFIG=$tmp focus_key_set _JK_OTHER && [ -n "$_JK_OTHER" ]; then   # bound by hand elsewhere in the file
        rm -f "$tmp" "$old"; echo "bhote: bound by hand in config.toml ($_JK_OTHER): change it there" >&2; return 1
    fi
    if [ -n "$j$fk" ]; then
        [ -s "$tmp" ] && [ -n "$(tail -c1 "$tmp")" ] && printf '\n' >> "$tmp"
        { printf '\n# >>> bhote (settings › Jump key, Find key; bhote rewrites this block)\n'
          [ -n "$j" ] && printf '[[keys.command]]\nkey = "%s"\ntype = "plugin_action"\ncommand = "bhote.panel.focus"\ndescription = "Bhote panel"\n' "$j"
          [ -n "$fk" ] && printf '[[keys.command]]\nkey = "%s"\ntype = "plugin_action"\ncommand = "bhote.panel.search"\ndescription = "bhote search"\n' "$fk"
          printf '# <<< bhote\n'; } >> "$tmp"
    fi
    mv "$tmp" "$HERDR_CONFIG"
    out=$(herdr server reload-config 2>&1) || out=$(herdr config check 2>&1 && echo '"status":"applied","diagnostics":[]')
    case "$out" in *'"status":"applied"'*'"diagnostics":[]'*|*'"diagnostics":[]'*'"status":"applied"'*) ;;
        *) cp "$old" "$HERDR_CONFIG"; rm -f "$old"; herdr server reload-config >/dev/null 2>&1
           echo "bhote: herdr did not take it: $(printf '%s' "$out" | jq -r '[.result.diagnostics[]? | .message // tostring] | join("; ")' 2>/dev/null | head -c 160)" >&2; return 1 ;;
    esac
    rm -f "$old"; cfg_set JUMP_KEY "${j:-off}" FIND_KEY "${fk:-off}"; focus_key_set FOCUS_KEY; key_pretty FIND_KEY_SHOW "${fk:-off}"
    return 0
}
jump_key_apply() { local _f; cfg_var _f FIND_KEY off; herdr_keys_apply "$1" "$_f"; }   # jump_key_apply <key|off>
find_key_apply() { local _j; cfg_var _j JUMP_KEY off; herdr_keys_apply "$_j" "$1"; }   # find_key_apply <key|off>
# The panel's pane in herdr stays between PANEL_MIN_WIDTH and PANEL_MAX_WIDTH: after a resize has settled (a dragged divider,
# a smaller window) the split is moved back (pane.resize takes a share of the split). Only when the panel is the right part
# of a split; the agent next to it keeps at least 40 columns.
panel_width_clamp() {
    local p=${HERDR_PANE_ID:-} lo hi w sw want dir amt
    case "$p" in ''|*[!A-Za-z0-9:_-]*) return 0 ;; esac
    cfg_var lo PANEL_MIN_WIDTH 36; cfg_var hi PANEL_MAX_WIDTH 60; num_set lo "$lo" 36; num_set hi "$hi" 60; [ "$hi" -lt "$lo" ] && hi=$lo
    read -r w sw <<< "$(herdr pane layout --pane "$p" 2>/dev/null | jq -r --arg p "$p" '
        ([.result.layout.panes[] | select(.pane_id == $p)][0].rect) as $r
        | ([.result.layout.splits[] | select(.direction == "right" and (((.rect.x + .rect.width * .ratio) - $r.x) | fabs) <= 2
              and .rect.y <= $r.y and (.rect.y + .rect.height) >= ($r.y + $r.height))][0].rect.width // 0) as $sw
        | "\($r.width // 0) \($sw)"' 2>/dev/null)"
    num_set w "$w" 0; num_set sw "$sw" 0; [ "$w" -gt 0 ] && [ "$sw" -gt 0 ] || return 0
    if [ "$w" -gt "$hi" ]; then want=$hi; dir=right
    elif [ "$w" -lt "$lo" ]; then want=$lo; dir=left; [ $(( sw - want )) -ge 40 ] || return 0
    else return 0; fi
    amt=$(LC_ALL=C awk -v a="$w" -v b="$want" -v s="$sw" 'BEGIN { d = a - b; if (d < 0) d = -d; printf "%.4f", d / s }')
    herdr pane resize --pane "$p" --direction "$dir" --amount "$amt" >/dev/null 2>&1
}
# A click on an agent focuses it in herdr. On another machine herdr focuses it there, but only the herdr client can switch
# machines (the API cannot): the key line says so for a few seconds.
FLASH_MSG=""; FLASH_UNTIL=0
topic_jump() {  # the selected topic's agent, shown in herdr; in another tab of this machine the focus goes to the panel there, the topic selected. 1 when it has no agent that herdr knows now
    local f m p ast; f=$(sel_file); [ -n "$f" ] || return 1
    m=$(topic_get "$f" agent_machine); p=$(topic_get "$f" agent_pane); [ -n "$p" ] || return 1
    [ -n "$m" ] || m=$HOST
    agent_state_set ast "$m" "$p"; case "$ast" in gone|off-*) return 1 ;; esac   # not there (any more), or its machine does not answer
    [ "$m" = "$HOST" ] || { agent_jump "$m" "$p"; return; }
    case "$p" in ''|*[!A-Za-z0-9:_-]*) return 1 ;; esac
    # another tab: herdr shows it, the focus goes to the bhote panel there, and that panel has the topic selected (all do)
    printf '%s %s list\n' "$(topic_id "$f")" "$$$RANDOM" > "$SHARED_DIR/select" 2>/dev/null
    ( herdr agent focus "$p" >/dev/null 2>&1; panel_focus_of "$p" "${HERDR_PANE_ID:-}" ) >/dev/null 2>&1 </dev/null &
}
agent_jump() {  # agent_jump <machine> <pane>
    case "$2" in ''|*[!A-Za-z0-9:_-]*) return 1 ;; esac
    if [ "$1" = "$HOST" ]; then ( herdr agent focus "$2" >/dev/null 2>&1 & )
    else
        machine_known "$1" || return 1
        ( herdr --machine "$1" agent focus "$2" >/dev/null 2>&1 & )
        # herdr has no call that switches its window to another machine: the agent is focused over there, the switch is yours
        local _kw; key_pretty _kw "prefix+w"
        FLASH_MSG="focused on $1 · to go there: $_kw, pick it, ⏎"; FLASH_UNTIL=$(( SECONDS + 10 ))
    fi
}
view_bottom() {  # the agents, a rule and the keys: pinned to the bottom edge of the panel
    agents_block
    rule
    local sg="" left right="" room=$(( ${COLS:-44} - 4 )) lw rw
    left="↑↓ move · , settings"
    if [ -n "$FLASH_MSG" ] && [ "$SECONDS" -lt "$FLASH_UNTIL" ]; then     # a short note (a click on a remote agent) instead of the keys
        printf '  %s%s%s' "$S" "$(clip "$FLASH_MSG" "$room")" "$X"; return
    fi
    [ -n "${FOCUS_KEY:-}" ] && right="$FOCUS_KEY ⇄"         # bottom right: the herdr key that jumps here and back
    dw_set lw "$left"; dw_set rw "$right"
    if [ -n "$right" ] && [ $(( lw + 3 + rw )) -gt "$room" ]; then left=", settings$sg"; dw_set lw "$left"; fi
    if [ -n "$right" ] && [ $(( lw + 3 + rw )) -gt "$room" ]; then left=""; dw_set lw "$left"; fi   # narrow: only the key
    if [ -n "$right" ] && [ $(( lw + 1 + rw )) -le "$room" ]; then
        printf '  %s%s%*s%s%s%s' "$D" "$left" $(( room - lw - rw )) "" "$S" "$right" "$X"
    else printf '  %s%s%s' "$D" "$(clip "$left" "$room")" "$X"; fi
}
count_lines() {  # count_lines <var> <text>  (a read loop: pattern substitution on text full of escapes and UTF-8 is very slow in bash 3.2)
    local _n=0 _l; while IFS= read -r _l; do _n=$(( _n + 1 )); done <<< "$2"; printf -v "$1" '%s' "$_n"
}
bhote_view() {  # head on top, topics below it (scrolling with the selection), agents + rule + keys at the BOTTOM edge
    local head topics bottom dblk hh th bh dh=0 dn avail pad=0 i off sel=-1 content tl=() tr=() n=0 line
    head=$(view_head); topics=$(topics_block); bottom=$(view_bottom)
    count_lines hh "$head"; count_lines th "$topics"; count_lines bh "$bottom"
    num_set dn "${U_DONE_MAX:-}" 7; dblk=$(done_block "$dn"); [ -n "$dblk" ] && count_lines dh "$dblk"
    while [ "$dh" -gt 0 ] && [ $(( ${ROWS:-40} - hh - bh - dh )) -lt $(( th < 6 ? th : 6 )) ]; do   # low: fewer done ones, the list keeps room
        dn=$(( dn - 1 )); dblk=$(done_block "$dn"); dh=0; [ -n "$dblk" ] && count_lines dh "$dblk"
    done
    local mblk mh=0; mblk=$(monitors_block); [ -n "$mblk" ] && count_lines mh "$mblk"
    [ "$mh" -gt 0 ] && [ $(( ${ROWS:-40} - hh - bh - dh - mh )) -lt $(( th < 6 ? th : 6 )) ] && { mblk=""; mh=0; }   # low: no monitors
    avail=$(( ${ROWS:-40} - hh - bh - dh - mh ))
    case "$th:$topics" in *"the agents are bored"*) [ "$th" -gt "$avail" ] && {   # no room for the bored agents: their line only
        topics=$(BORED_SMALL=1 topics_block); count_lines th "$topics"; } ;; esac
    printf '%s\n' "$head"; VP_ROW=$hh; VP_MAP=""
    view_lines tl tr sel "$topics"; n=${#tl[@]}
    if [ "$th" -le "$avail" ]; then
        view_put 0 "$n"; pad=$(( avail - th )); rm -f "$RUN_DIR/toff" 2>/dev/null
    elif [ "$avail" -ge 4 ]; then       # more topics than room: a window that follows the selection, one row for the marker
        content=$(( avail - 1 ))
        [ "$sel" = -1 ] && sel=0
        local sh=1; while [ "$sh" -lt 4 ] && [ $(( sel + sh )) -lt "$n" ] && [ -n "${tl[$(( sel + sh ))]}" ]; do sh=$(( sh + 1 )); done
        local prev; { read -r prev < "$RUN_DIR/toff"; } 2>/dev/null; num_set prev "${prev:-}" -1
        if [ "$prev" -lt 0 ]; then off=$(( sel + sh - content ))   # the window of the last frame stays while the selection is in it (a click)
        elif [ "$sel" -lt "$prev" ]; then off=$sel; while [ "$off" -gt 0 ] && [ -z "${tr[$(( off - 1 ))]}" ]; do off=$(( off - 1 )); done   # with its caption
        elif [ $(( sel + sh )) -gt $(( prev + content )) ]; then off=$(( sel + sh - content ))
        else off=$prev; fi
        [ "$off" -gt "$sel" ] && off=$sel; [ "$off" -lt 0 ] && off=0; [ "$off" -gt $(( th - content )) ] && off=$(( th - content ))
        echo "$off" 2>/dev/null > "$RUN_DIR/toff"
        view_put "$off" $(( off + content ))
        printf ' %s↑↓ %d more lines%s\n' "$D" $(( th - content )) "$X"; VP_ROW=$(( VP_ROW + 1 ))
    else                                # hardly any room: as many topic lines as fit, never more than the pane
        view_put 0 $(( n < avail ? n : avail ))
    fi
    for (( i = 0; i < pad; i++ )); do printf '\n'; done; VP_ROW=$(( VP_ROW + pad ))
    [ "$dh" -gt 0 ] && { view_lines tl tr sel "$dblk"; view_put 0 "${#tl[@]}"; }
    [ "$mh" -gt 0 ] && printf '%s\n' "$mblk"
    printf '%s' "$VP_MAP" 2>/dev/null > "$RUN_DIR/tmap"           # the topics' rows on screen: a click selects one
    echo $(( ${ROWS:-40} - bh + 1 )) 2>/dev/null > "$RUN_DIR/divrow"     # the divider is the first line of the bottom part
    printf '%s' "$bottom"
}
view_lines() {  # view_lines <lines var> <refs var> <selected var> <text>: the lines without their markers (topic_item), the topic
    # id of each line (empty for captions and gaps), and the index of the selected line (-1: none)
    local _l _r _n=0 _s=-1; eval "$1=(); $2=()"
    while IFS= read -r _l; do
        _r=""; case "$_l" in $'\035'*) _l=${_l#$'\035'}; _r=${_l%%$'\035'*}; _l=${_l#*$'\035'} ;; esac
        case "$_l" in $'\001'*) _s=$_n; _l=${_l#$'\001'} ;; esac
        eval "$1[$_n]=\$_l; $2[$_n]=\$_r"; _n=$(( _n + 1 ))
    done <<< "$4"
    printf -v "$3" '%s' "$_s"
}
view_put() {  # view_put <from> <to>: prints tl[from..to-1] and notes the rows of the topics' lines in VP_MAP (row \036 id)
    local _i; for (( _i = $1; _i < $2; _i++ )); do
        printf '%s\n' "${tl[$_i]}"; VP_ROW=$(( VP_ROW + 1 ))
        [ -n "${tr[$_i]}" ] && VP_MAP="$VP_MAP$VP_ROW"$'\036'"${tr[$_i]}"$'\n'
    done
}

# Word wrap with a hanging indent: every line of a paragraph starts at the same column and ends before the panel's edge.
wrap_print() {  # wrap_print <indent> <colour> <text>
    local ind=$1 col=$2 width=$(( ${COLS:-44} - 2 - $1 )) line="" word pad
    printf -v pad '%*s' "$ind" ''
    set -f
    local ww lw=0
    for word in $3; do
        dw_set ww "$word"; [ "$ww" -gt "$width" ] && { clip_set word "$word" "$width"; dw_set ww "$word"; }   # a path or URL that cannot break
        if [ -z "$line" ]; then line=$word; lw=$ww
        elif [ $(( lw + 1 + ww )) -le "$width" ]; then line="$line $word"; lw=$(( lw + 1 + ww ))
        else printf '%s%s%s%s\n' "$pad" "$col" "$line" "$X"; line=$word; lw=$ww; fi
    done
    set +f
    [ -n "$line" ] && printf '%s%s%s%s\n' "$pad" "$col" "$line" "$X"
}
set_row() {  # set_row <selected 0|1> <label> <value, plain> <value, coloured> [extra indent]: label left, value right-aligned
    local sel=$1 label=$2 vp=$3 vc=$4 ind=${5:-0} w=$(( ${COLS:-44} - 2 )) pad lw vw
    dw_set vw "$vp"; clip_set label "$label" $(( w - 5 - ind - vw )); dw_set lw "$label"
    pad=$(( w - 4 - ind - lw - vw )); [ "$pad" -lt 1 ] && pad=1
    if [ "$sel" = 1 ]; then printf '\001%s   %s%*s%s%s%*s%s%s%s\n' "$SELBG" "$LSEL" "$ind" "" "$label" "$X$SELBG" "$pad" "" "$vc" "$SELBG " "$X"
    else printf '   %*s%s%s%s%*s%s\n' "$ind" "" "$D" "$label" "$X" "$pad" "" "$vc"; fi
}

# ── the settings screen (","). Rows: the remote switch, one row per saved machine, the intervals, the animation.

# The escape codes of every colour are made once (DOGC_x = foreground, DOGB_x = background), so drawing needs no
# subshell per cell. Two pixel rows per text row: ▀ with the upper pixel as foreground, the lower one as background.
dog_init() {
    local ch
    for ch in a b c C d e f g h i j k l m n o p q; do
        printf -v "DOGC_$ch" '%s' "$(rgb "$(dog_rgb "$ch")")"
        printf -v "DOGB_$ch" '%s' "${esc}[48;2;$(dog_rgb "$ch")m"
    done
}
dog_lines() {  # dog_lines <rows> <width>  ->  array DOGL with one coloured string per text row
    local rows=$1 w=$2 line top bot i t b out n=0 fg bg
    DOGL=()
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        top=${line%|*}; bot=${line##*|}; out=""
        for (( i = 0; i < w; i++ )); do
            t=${top:$i:1}; b=${bot:$i:1}
            if [ "$color" != 1 ]; then
                if [ "$t" = "." ] && [ "$b" = "." ]; then out="${out} "; else out="${out}█"; fi
            elif [ "$t" = "." ] && [ "$b" = "." ]; then out="${out} "
            elif [ "$b" = "." ]; then fg=DOGC_$t; out="${out}${!fg}▀${X}"
            elif [ "$t" = "." ]; then fg=DOGC_$b; out="${out}${!fg}▄${X}"
            else fg=DOGC_$t; bg=DOGB_$b; out="${out}${!fg}${!bg}▀${X}"; fi
        done
        DOGL[$n]=$out; n=$(( n + 1 ))
    done <<< "$rows"
}
dog_rows() {  # dog_rows <variant 0..3>  ->  the rows text of that variant of the big dog
    local v="DOG_ROWS_$1"
    printf '%s' "${!v}"
}
# The coloured rows of every picture are kept in variables (DOGR_<kind>_<variant>, rows joined by ): made once in dog_warm
# at the start, so a repaint or an animation step never has to build a picture again.
dog_lines_for() {  # dog_lines_for <variant>  ->  array DOGL
    local v="DOGR_big_$1" s n=0; s=${!v}
    if [ -z "$s" ]; then
        dog_lines "$(dog_rows "$1")" "$DOG_W"
        for (( n = 0; n < ${#DOGL[@]}; n++ )); do s="$s${DOGL[$n]}"$''; done
        printf -v "$v" '%s' "$s"; return
    fi
    DOGL=(); n=0
    while [ -n "$s" ]; do DOGL[$n]=${s%%$''*}; s=${s#*$''}; n=$(( n + 1 )); done
}
dog_warm() { local i; for i in 0 1 2 3; do dog_lines_for $i; done; }
dog() {  # the big dog, centred in the frame
    local i
    dog_lines_for "${DOG_IDX:-0}"
    for (( i = 0; i < ${#DOGL[@]}; i++ )); do mid "$(printf '%*s' "$DOG_W" '')" "${DOGL[$i]}" "$DOG_W"; done
}
# For the animation only the text rows that differ from what is on screen are written (eyes, tongue), at an absolute
# position. DOG_PREV_B remembers the rows on screen; dog_prev_reset sets it after every full repaint (the welcome screen only).
DOG_PREV_B=()
dog_prev_reset() {  # dog_prev_reset <splash|main>
    [ "$1" = splash ] || return 0
    dog_lines_for "${DOG_IDX:-0}"; DOG_PREV_B=("${DOGL[@]}")
}
dog_at() {  # dog_at <row> <col>: the big dog of the welcome screen
    local row=$1 col=$2 i
    dog_lines_for "${DOG_IDX:-0}"
    for (( i = 0; i < ${#DOGL[@]}; i++ )); do
        [ "${DOG_PREV_B[$i]:-}" = "${DOGL[$i]}" ] && continue; DOG_PREV_B[$i]=${DOGL[$i]}
        printf '%s[%d;%dH%s' "$esc" $(( row + i )) "$col" "${DOGL[$i]}"
    done
}

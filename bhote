bhote_settings() {
    local i row kind key label vp vc v def cur=${SET_IDX:-0} sel ind off
    settings_rows
    if [ "${SET_PAGE:-main}" = projects ]; then printf '\n %sSettings › Projects%s\n' "$L" "$X"
    elif [ "${SET_PAGE:-main}" = project ]; then projects_load; printf '\n %sSettings › Projects › %s%s\n' "$L" "$(project_name "$SET_PROJ")" "$X"
    elif [ "${SET_PAGE:-main}" = connections ]; then printf '\n %sSettings › Connections%s\n' "$L" "$X"
    else printf '\n %sSettings%s  %s%s%s\n' "$L" "$X" "$D" "$(clip "${CONFIG_FILE/#$HOME/~}" $(( ${COLS:-44} - 13 )))" "$X"; fi
    rule; printf '\n'
    if [ "${SET_PAGE:-main}" = main ]; then
        if [ -n "${UPD_LATEST:-}" ]; then wrap_print 1 "$GREEN" "Update available: v$UPD_LATEST (this is v$VERSION). Run: ${UPD_CMD:-$(update_command)}"; printf '\n'
        else printf ' %sbhote v%s%s\n\n' "$D" "$VERSION" "$X"; fi
    fi
    for (( i = 0; i < ${#SET_ROWS[@]}; i++ )); do
        row=${SET_ROWS[$i]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}; label=${row#*|}; ind=0; sel=0
        [ "$i" = "$cur" ] && sel=1
        case "$kind" in
            bool|sbool) setting_row "$key"; def=${S_DEF:-off}; cfg_var v "$key" $def; [ "$kind" = sbool ] && ind=2
                  if [ "$v" = on ]; then vp="[x]"; vc="${GREEN}[x]${X}"; else vp="[ ]"; vc="${D}[ ]${X}"; fi ;;
            choice) cfg_var v STORE local
                  case "$v" in remote) cfg_var v STORE_MACHINE '?'; vp="‹ $v ›" ;; kharka) vp="‹ kharka ›" ;; *) vp="‹ local ›" ;; esac; vc="${C}${vp}${X}" ;;
            machine) ind=2; cfg_var off MACHINES_OFF ""
                  case ",$off,"  in *",$key,"*) vp="[ ]"; vc="${D}[ ]${X}" ;; *) vp="[x]"; vc="${GREEN}[x]${X}" ;; esac ;;
            num) setting_row "$key"; def=$S_DEF; cfg_var v "$key" "$def"; vp=$v; vc="${C}${v}${X}" ;;
            link|projnew|pact) vp="›"; vc="${D}›${X}" ;;
            projrow) local pf2 pr pw np=0; pf2="$TOPIC_DIR/$key.topic"; pr=$(topic_get "$pf2" repos); pw=$(topic_get "$pf2" workspaces)
                  [ -n "$pr" ] && np=$(( np + $(printf '%s' "$pr" | tr ',' '\n' | grep -c .) )); [ -n "$pw" ] && np=$(( np + $(printf '%s' "$pw" | tr ',' '\n' | grep -c .) ))
                  vp="$np pinned ›"; vc="${D}${vp}${X}" ;;
            pagent) local pm2=${key%%$US*} pp2=${key#*$US}; agent_meta "$pm2" "$pp2"; local an2=${label%% · *}
                  if { [ -n "$AM_REPO" ] && list_has "$(topic_get "$TOPIC_DIR/$SET_PROJ.topic" repos)" "$AM_REPO"; } || list_has "$(topic_get "$TOPIC_DIR/$SET_PROJ.topic" workspaces)" "$an2"; then vp="[x]"; vc="${GREEN}[x]${X}"
                  else vp="[ ]"; vc="${D}[ ]${X}"; fi ;;
            key) if [ "$key" = FIND_KEY ]; then vp=${FIND_KEY_SHOW:-off}; else vp=${FOCUS_KEY:-off}; fi; vc="${C}${vp}${X}" ;;
            enum) setting_row "$key"; cfg_var v "$key" "$S_DEF"; vp="‹ $v ›"; vc="${C}${vp}${X}" ;;
            prefer) ind=2; cfg_var v "$key" any; vp="‹ $v ›"; vc="${C}${vp}${X}" ;;
            info) [ -n "${GH_INFO:-}" ] || { if gh_ok; then GH_INFO="✓ $(gh_user)"; else GH_INFO="not logged in"; fi; }
                  vp=$GH_INFO; vc="${D}${vp}${X}" ;;
            secret) if v=$(circleci_token_from); then vp="set"; vc="${GREEN}set${X}"; else vp="not set"; vc="${D}not set${X}"; fi ;;
            text) setting_row "$key"; cfg_var v "$key" "$S_DEF"; clip_set vp "${v:--}" 22; vc="${C}${vp}${X}" ;;
            pci) local pcv; pcv=$(topic_get "$TOPIC_DIR/$SET_PROJ.topic" ci); vp="${pcv:-none} ›"; [ -z "$pcv" ] && vp="detect ›"; clip_set vp "$vp" 26; vc="${D}${vp}${X}" ;;
            ptext) clip_set vp "$(topic_get "$TOPIC_DIR/$SET_PROJ.topic" "$key")" 24; [ -n "$vp" ] || vp="auto"; vc="${C}${vp}${X}" ;;
            mcode) machine_code_set v "$key"; local mx; for (( mx = 0; mx < MC_N; mx++ )); do [ "${MC_NAME[$mx]}" = "$key" ] && break; done
                  if [ "${MC_SET[$mx]:-0}" = 1 ]; then vp=$v; vc="${C}${v}${X}"; else vp="$v auto"; vc="${C}${v}${X}${D} auto${X}"; fi ;;
        esac
        set_row "$sel" "$label" "$vp" "$vc" "$ind"
        [ "$kind" = pagent ] && { if [ -n "$AM_REPO" ]; then wrap_print 5 "$D" "$AM_REPO"; else wrap_print 5 "$D" "its workspace (no git repository)"; fi; }
        if [ "$kind" = mcode ]; then
            if [ "$key" = "${MC_MSG_FOR:-}" ] && [ -n "${MC_MSG:-}" ]; then wrap_print 5 "$D" "$MC_MSG"
            elif [ -z "${mc_said:-}" ]; then wrap_print 5 "$D" "In front of the agents' names (MAC|name) when more than one machine is listed. ⏎ three letters; empty: made from the name."; fi
            local mc_said=1
        fi
        case "$key" in
            STORE) wrap_print 5 "$D" "$(store_summary)" ;;
            KHARKA) wrap_print 5 "$D" "Empty: kharka on the PATH. The other machines need STORE=kharka too, and a kharka daemon on the same hub." ;;
            CONNECTIONS) wrap_print 5 "$D" "$(connections_summary)" ;;
            PROJECTS) projects_load; wrap_print 5 "$D" "$( [ "$P_N" -gt 0 ] && printf '%s' "$(for (( q = 0; q < P_N; q++ )); do printf '%s%s' "${P_NAME[$q]}" "$( [ $q -lt $(( P_N - 1 )) ] && echo ', ')"; done)" || echo 'none yet: agents by project')" ;;
            TOPICS_SCOPE) wrap_print 5 "$D" "project: only the topics of the project of this tab's agent (and those without one)." ;;
            SETUP) wrap_print 5 "$D" "Every step again: change it, or skip what is set." ;;
            GITHUB_BRANCHES) wrap_print 5 "$D" "The branch a topic's agent works on, under the topic and in the search." ;;
            GH) wrap_print 5 "$D" "GitHub Actions for the monitors, through gh and its own login (gh auth login)." ;;
            CIRCLECI_TOKEN) wrap_print 5 "$D" "$(v=$(circleci_token_from) && printf 'From %s. ' "$v")⏎ type one: circleci.com › User settings › Personal API tokens (kept in the bhote config, 0600)." ;;
            DEPLOY_MONITOR) wrap_print 5 "$D" "The last deployments above the agents. Each project's CI: Settings › Projects › <name> › CI." ;;
            TEST_MONITOR) wrap_print 5 "$D" "The last test runs above the agents: CI test jobs, live status files, and local runs (bhote test run -- <command>)." ;;
            ci) [ -n "${MON_MSG:-}" ] && wrap_print 5 "$D" "$MON_MSG" || wrap_print 5 "$D" "$(monitor_describe "$TOPIC_DIR/$SET_PROJ.topic"). ⏎ find it again from the repository." ;;
            SLACK_WATCH) wrap_print 5 "$D" "Pinned Slack channels of waiting topics, read through Claude Code. One machine is enough." ;;
            REMOTE_AGENTS) wrap_print 5 "$D" "Off by default. Asks herdr for the agents of its saved machines." ;;
            JUMP_KEY) wrap_print 5 "$D" "$([ "$KEY_MSG_FOR" = JUMP_KEY ] && [ -n "$KEY_MSG" ] && printf '%s' "$KEY_MSG" || printf '⏎ change. Jumps from the agent to this panel and back.')" ;;
            FIND_KEY) wrap_print 5 "$D" "$([ "$KEY_MSG_FOR" = FIND_KEY ] && [ -n "$KEY_MSG" ] && printf '%s' "$KEY_MSG" || printf '⏎ change. Find a topic or an agent and jump to it.')" ;;
        esac
    done
    printf '\n'; rule
    local k1 k2                                                # the keys of THIS page (the list's keys: settings › Hotkeys)
    case "${SET_PAGE:-main}" in
        projects) k1="↑↓ select · ⏎ open"; k2=", or esc back to Settings" ;;
        project) k1="↑↓ select · space/⏎ pin or unpin an agent"; k2="⏎ rename / delete · , or esc back to Projects" ;;
        connections) k1="↑↓ select · space/⏎ toggle · ←→ change"; k2=", or esc back to Settings" ;;
        *) k1="↑↓ select · space/⏎ toggle · ←→ change"; k2="⏎ open a page (›) · , or esc back" ;;
    esac
    printf ' %s%s%s\n' "$D" "$(clip "$k1" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "$k2" $(( ${COLS:-44} - 3 )))" "$X"
}

# One entry: the title, the description below it, then the elbow line with the meta (who/what, how long ago). The selected one
# gets the highlighted bar over all its lines (no pointer); its first line starts with an invisible \001 so that bhote_view can
# find it for scrolling (and strips it). Done entries are one muted line.
topic_item() {  # topic_item <selected 0|1> <meta colour> <unused> <title colour> <title> <description> <meta> <compact 0|1>
    local w=$(( ${COLS:-44} - 2 )) bg="" mk="" t d m mc=${2:-$D}
    clip_set t "$5" $(( w - 3 )); clip_set d "$6" $(( w - 3 )); clip_set m "$7" $(( w - 5 ))
    [ "$1" = 1 ] && { bg=$SELBG; mk=$'\001'; }
    printf '%s%s  %s%s%s%*s%s\n' "$mk" "$bg" "$4" "$t" "$X$bg" $(( w - 2 - ${#t} )) "" "$X"
    [ -n "$d" ] && printf '%s  %s%s%s%*s%s\n' "$bg" "$D" "$d" "$X$bg" $(( w - 2 - ${#d} )) "" "$X"
    [ -n "$m" ] && printf '%s  %s∟ %s%s%s%*s%s\n' "$bg" "$D" "$mc" "$m" "$X$bg" $(( w - 4 - ${#m} )) "" "$X"
    [ "$8" = 1 ] || printf '\n'
}
agent_state_set() {  # agent_state_set <var> <machine> <pane>: working | idle | blocked | done | gone, from the last agent lists
    local _i _m _id _st _r _x gone=gone
    for (( _i = 0; _i < AG_N; _i++ )); do
        IFS=$US read -r _m _id _st _r _x <<< "${AG_LINES[$_i]}"
        if [ "$_m" = "$2" ] && [ "$_id" = "$3" ]; then gone=${_st:-idle}; break; fi
    done
    printf -v "$1" '%s' "$gone"
}
topics_block() {  # the topics, grouped by status (now, waiting, later, done); done ones are capped at DONE_MAX (default 7)
    local i prev="" st label lc ic icon tc meta age ast desc cp sl ndone=0 hidden=0 max
    num_set max "${U_DONE_MAX:-}" 7
    sel_index
    for (( i = 0; i < T_N; i++ )); do
        st=${T_STATUS[$i]}; desc=${T_DESC[$i]:-}; tc=$L; cp=0
        if [ "$st" = done ]; then                              # beyond the cap only the selected one is shown
            ndone=$(( ndone + 1 ))
            if [ "$ndone" -gt "$max" ] && [ "$i" != "$SEL_IDX" ]; then hidden=$(( hidden + 1 )); continue; fi
        fi
        if [ "$st" != "$prev" ]; then
            case "$st" in now) label=NOW; lc=$ORANGE ;; waiting) label=WAITING; lc=$Y ;; review) label=REVIEW; lc=$BLUE ;; later) label=LATER; lc=$R ;; done) label=DONE; lc=$GREEN ;; esac
            group "$label" "$lc"; prev=$st
        fi
        case "$st" in
            now) ic=$D; icon=""; ago_set meta "${T_UPD[$i]:-$NOW}"
                 if [ -n "${T_AG[$i]}" ]; then      # given to an agent: say what that agent is doing now
                     agent_state_set ast "${T_AM[$i]}" "${T_AP[$i]}"
                     case "$ast" in working) meta="${T_AG[$i]} · working"; ic=$ORANGE ;; testing) meta="${T_AG[$i]} · running tests"; ic=$ORANGE ;; blocked) meta="${T_AG[$i]} · needs you"; ic=$NN ;;
                         idle|done) meta="${T_AG[$i]} · finished"; ic=$GREEN; [ "$i" = "$SEL_IDX" ] && meta="$meta · x = done" ;; *) meta="${T_AG[$i]} · gone" ;; esac
                 fi ;;
            waiting) ic=$D; icon=""; ago_set age "${T_WSINCE[$i]:-$NOW}"; meta="${T_WFOR[$i]:-?} · $age" ;;
            review) ic=$BLUE; icon=""; ago_set age "${T_UPD[$i]:-$NOW}"; meta="${T_AG[$i]:+${T_AG[$i]} · }ready for review · $age" ;;
            later) ic=$D; icon=""; ago_set meta "${T_UPD[$i]:-$NOW}" ;;
            done) ic=$D; icon=""; tc=$D; meta=""; desc=""; cp=1 ;;                  # muted, one line, no gap
        esac
        sl=0; [ "$i" = "$SEL_IDX" ] && sl=1
        topic_item "$sl" "$ic" "$icon" "$tc" "${T_TITLE[$i]:-(untitled)}" "$desc" "$meta" "$cp"
    done
    [ "$hidden" -gt 0 ] && printf '  %s+%d more%s\n' "$D" "$hidden" "$X"
    [ "$T_N" -gt 0 ] || printf '\n  %sno topics yet · n adds one%s\n\n' "$D" "$X"
}
name_color_set() {  # name_color_set <var> <agent name>: the first NAME_COLORS rule (part-of-name=colour) that matches, else plain
    local _r _p _c _col="$L"
    if [ -n "${U_NAME_COLORS:-}" ]; then
        while IFS= read -r _r; do
            _p=${_r%%=*}; _c=${_r#*=}; [ -n "$_p" ] || continue
            shopt -s nocasematch; [[ $2 == *"$_p"* ]] && { shopt -u nocasematch
                case "$_c" in red) _col=$NN ;; teal) _col=$S ;; peach) _col=$C ;; mauve) _col=$R ;; blue) _col=$BLUE ;; green) _col=$GREEN ;; yellow) _col=$Y ;; esac; break; }
            shopt -u nocasematch
        done <<< "${U_NAME_COLORS//,/$'\n'}"
    fi
    printf -v "$1" '%s' "$_col"
}
agent_divider() {  # the handle between topics and agents: a rule with a grip in the middle (drag it with the mouse)
    local w=$(( ${COLS:-44} - 5 )) l r
    l=$(( (w - 5) / 2 )); r=$(( w - 5 - l ))
    printf '  %s%s%s ═══ %s%s%s\n' "$B" "$(hline "$l")" "$X$D" "$X$B" "$(hline "$r")" "$X"
}
agents_block() {  # two columns: the free agents (idle, done) on the left, the busy ones on the right; the colours follow the herdr sidebar
    local i m id st name task ic nc label cw maxr rows shown hidden r left right lpad f=() b=() fw=() bw=() nf=0 nb=0 cell plain
    maxr=$(( ${ROWS:-40} - 21 )); [ "$maxr" -lt 1 ] && maxr=1     # automatic: the head, the keys and four lines of topics always stay
    local want; want=${DRAG_ROWS:-$U_AGENT_ROWS}; [ -n "$want" ] && agent_rows_clamp_set maxr "$want"   # dragged by the divider
    cw=$(( (${COLS:-44} - 4) / 2 ))
    if [ "$AG_N" -gt 0 ]; then
        for (( i = 0; i < AG_N; i++ )); do
            IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
            case "$st" in working) ic="${ORANGE}◐" ;; testing) ic="${ORANGE}◌" ;; blocked) ic="${NN}◉" ;; done) ic="${GREEN}✓" ;; idle) ic="${GREEN}○" ;; *) ic="${D}○" ;; esac
            name_color_set nc "$name"
            label=$name                                         # another machine: its initial in front (not when the name says it)
            [ "$m" = "$HOST" ] || case "$name" in "$m"*) ;; *) label="${m:0:1}·$name" ;; esac
            clip_set label "$label" $(( cw - 2 ))
            cell="$ic$X $nc$label$X"; plain=$(( ${#label} + 2 ))
            case "$st" in
                idle|done) f[$nf]=$cell; fw[$nf]=$plain; nf=$(( nf + 1 )) ;;
                *) b[$nb]=$cell; bw[$nb]=$plain; nb=$(( nb + 1 )) ;;
            esac
        done
        rows=$nf; [ "$nb" -gt "$rows" ] && rows=$nb
        shown=$rows; [ "$shown" -gt "$maxr" ] && shown=$maxr
        agent_divider
        printf '  %s%-*s%s%s%s\n' "$GREEN" $(( cw + 1 )) "FREE" "$X$ORANGE" "BUSY" "$X"
        [ -n "$want" ] && shown=$maxr                           # a dragged height stays, also with fewer agents
        for (( r = 0; r < shown; r++ )); do
            left=${f[$r]:-}; right=${b[$r]:-}; lpad=$(( cw - ${fw[$r]:-0} ))
            printf '  %s%*s %s\n' "$left" "$lpad" "" "$right"
        done
        hidden=0; [ "$nf" -gt "$shown" ] && hidden=$(( nf - shown )); [ "$nb" -gt "$shown" ] && hidden=$(( hidden + nb - shown ))
        [ "$hidden" -gt 0 ] && printf '  %s+%d more agents%s\n' "$D" "$hidden" "$X"
    else agent_divider
    fi
    # saved machines exist but are not asked: say so, and where to change it
    if [ "$U_REMOTE" != on ] && [ "${HAS_MACHINES:-0}" = 1 ]; then
        printf '\n  %sRemote agents off · , settings%s\n' "$D" "$X"
    fi
}
clip_set() {  # clip_set <var> <text> <max columns>: cut with a … when longer (plain text only)
    local _ct=$2
    if [ "$3" -lt 1 ]; then _ct=""; elif [ "${#_ct}" -gt "$3" ]; then _ct="${_ct:0:$(( $3 - 1 ))}…"; fi
    printf -v "$1" '%s' "$_ct"
}
clip() { clip_set _CLIP "$1" "$2"; printf '%s' "$_CLIP"; }
view_head() {  # one line: name and version in colour, the tagline; then a rule (the dog lives on the welcome screen only)
    local name="Bhote v$VERSION" t; clip_set t " - Agent & Work Management" $(( ${COLS:-44} - 5 - ${#name} ))
    printf '\n  %s%s%s%s\n' "${HEAD_GRAD:-$L$name$X}" "$D" "$t" "$X"
    rule
}
view_bottom() {  # the agents, a rule and the keys: pinned to the bottom edge of the panel
    agents_block
    rule
    local sg=""; suggest_build; [ "${#SUG_MAP[@]}" -gt 0 ] && sg=" · a: ${#SUG_MAP[@]} new"
    printf '  %s%s%s' "$D" "$(clip "↑↓ move · , settings$sg" $(( ${COLS:-44} - 4 )))" "$X"
}
count_lines() {  # count_lines <var> <text>  (a read loop: pattern substitution on text full of escapes and UTF-8 is very slow in bash 3.2)
    local _n=0 _l; while IFS= read -r _l; do _n=$(( _n + 1 )); done <<< "$2"; printf -v "$1" '%s' "$_n"
}
bhote_view() {  # head on top, topics below it (scrolling with the selection), agents + rule + keys at the BOTTOM edge
    local head topics bottom hh th bh avail pad=0 i off sel=-1 content tl=() n=0 line
    head=$(view_head); topics=$(topics_block); bottom=$(view_bottom)
    count_lines hh "$head"; count_lines th "$topics"; count_lines bh "$bottom"
    avail=$(( ${ROWS:-40} - hh - bh ))
    printf '%s\n' "$head"
    if [ "$th" -le "$avail" ]; then
        printf '%s\n' "${topics//$'\001'/}"; pad=$(( avail - th ))
    elif [ "$avail" -ge 4 ]; then       # more topics than room: a window that follows the selection, one row for the marker
        content=$(( avail - 1 ))
        while IFS= read -r line; do case "$line" in $'\001'*) sel=$n; line=${line#$'\001'} ;; esac; tl[$n]=$line; n=$(( n + 1 )); done <<< "$topics"
        [ "$sel" = -1 ] && sel=0
        off=$(( sel + 2 - content )); [ "$off" -lt 0 ] && off=0; [ "$off" -gt $(( th - content )) ] && off=$(( th - content ))
        for (( i = off; i < off + content; i++ )); do printf '%s\n' "${tl[$i]}"; done
        printf ' %s↑↓ %d more lines%s\n' "$D" $(( th - content )) "$X"
    else                                # hardly any room: as many topic lines as fit, never more than the pane
        n=0; while IFS= read -r line && [ "$n" -lt "$avail" ]; do printf '%s\n' "${line#$'\001'}"; n=$(( n + 1 )); done <<< "$topics"
    fi
    for (( i = 0; i < pad; i++ )); do printf '\n'; done
    echo $(( ${ROWS:-40} - bh + 1 )) > "$RUN_DIR/divrow" 2>/dev/null     # the divider is the first line of the bottom part
    printf '%s' "$bottom"
}

# Word wrap with a hanging indent: every line of a paragraph starts at the same column and ends before the panel's edge.
wrap_print() {  # wrap_print <indent> <colour> <text>
    local ind=$1 col=$2 width=$(( ${COLS:-44} - 2 - $1 )) line="" word pad
    printf -v pad '%*s' "$ind" ''
    set -f
    for word in $3; do
        [ "${#word}" -gt "$width" ] && clip_set word "$word" "$width"     # a path or URL that cannot break
        if [ -z "$line" ]; then line=$word
        elif [ $(( ${#line} + 1 + ${#word} )) -le "$width" ]; then line="$line $word"
        else printf '%s%s%s%s\n' "$pad" "$col" "$line" "$X"; line=$word; fi
    done
    set +f
    [ -n "$line" ] && printf '%s%s%s%s\n' "$pad" "$col" "$line" "$X"
}
set_row() {  # set_row <selected 0|1> <label> <value, plain> <value, coloured> [extra indent]: label left, value right-aligned
    local sel=$1 label=$2 vp=$3 vc=$4 ind=${5:-0} w=$(( ${COLS:-44} - 2 )) pad
    clip_set label "$label" $(( w - 5 - ind - ${#vp} ))
    pad=$(( w - 4 - ind - ${#label} - ${#vp} )); [ "$pad" -lt 1 ] && pad=1
    if [ "$sel" = 1 ]; then printf '%s   %s%*s%s%s%*s%s%s%s\n' "$SELBG" "$L" "$ind" "" "$label" "$X$SELBG" "$pad" "" "$vc" "$SELBG " "$X"
    else printf '   %*s%s%s%s%*s%s\n' "$ind" "" "$D" "$label" "$X" "$pad" "" "$vc"; fi
}

# ── the settings screen (","). Rows: the remote switch, one row per saved machine, the intervals, the animation.
# ↑/↓ (or k/j) choose, space or enter switches, ←/→ change a number, "," or esc goes back. Every change is saved at once.
SET_ROWS=()
settings_rows() {   # fills SET_ROWS with "kind|key|label"; the machine rows exist only while REMOTE_AGENTS is on
    SET_ROWS=("choice|STORE|Data location" "bool|REMOTE_AGENTS|Load remote agents over SSH")
    if [ "$(cfg_get REMOTE_AGENTS off)" = on ]; then
        local id label host prof enabled
        while IFS=$US read -r id label host prof enabled; do
            label=${label//[[:cntrl:]|]/}; host=${host//[[:cntrl:]]/}
            [ -n "$label" ] && SET_ROWS[${#SET_ROWS[@]}]="machine|$label|$label ($host)"
        done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
        SET_ROWS[${#SET_ROWS[@]}]="num|REMOTE_EVERY|Remote interval (s)"
    fi
    SET_ROWS[${#SET_ROWS[@]}]="num|LOCAL_EVERY|Local interval (s)"
    SET_ROWS[${#SET_ROWS[@]}]="bool|TESTS_BUSY|Running tests = agent busy"
    SET_ROWS[${#SET_ROWS[@]}]="bool|ANIMATION|Animation (blink, pant)"
    SET_ROWS[${#SET_ROWS[@]}]="bool|SPLASH_AUTOCLOSE|Close welcome screen after 15 s"
    SET_ROWS[${#SET_ROWS[@]}]="bool|AUTOSTART|Auto-start with herdr"
    SET_ROWS[${#SET_ROWS[@]}]="link|HOTKEYS|Hotkeys"
}
bhote_settings() {
    local i row kind key label vp vc v def cur=${SET_IDX:-0} sel ind off
    settings_rows
    printf '\n %sSettings%s  %s%s%s\n' "$L" "$X" "$D" "$(clip "${CONFIG_FILE/#$HOME/~}" $(( ${COLS:-44} - 13 )))" "$X"
    rule; printf '\n'
    for (( i = 0; i < ${#SET_ROWS[@]}; i++ )); do
        row=${SET_ROWS[$i]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}; label=${row#*|}; ind=0; sel=0
        [ "$i" = "$cur" ] && sel=1
        case "$kind" in
            bool) def=off; case "$key" in ANIMATION|SPLASH_AUTOCLOSE|AUTOSTART) def=on ;; esac; cfg_var v "$key" $def
                  if [ "$v" = on ]; then vp="[x]"; vc="${GREEN}[x]${X}"; else vp="[ ]"; vc="${D}[ ]${X}"; fi ;;
            choice) cfg_var v STORE local
                  if [ "$v" = remote ]; then cfg_var v STORE_MACHINE '?'; vp="‹ $v ›"; else vp="‹ local ›"; fi; vc="${C}${vp}${X}" ;;
            machine) ind=2; cfg_var off MACHINES_OFF ""
                  case ",$off,"  in *",$key,"*) vp="[ ]"; vc="${D}[ ]${X}" ;; *) vp="[x]"; vc="${GREEN}[x]${X}" ;; esac ;;
            num) case "$key" in REMOTE_EVERY) def=10 ;; *) def=3 ;; esac; cfg_var v "$key" $def; vp=$v; vc="${C}${v}${X}" ;;
            link) vp="›"; vc="${D}›${X}" ;;
        esac
        set_row "$sel" "$label" "$vp" "$vc" "$ind"
        case "$key" in
            STORE) wrap_print 5 "$D" "$(store_summary)" ;;
            REMOTE_AGENTS) wrap_print 5 "$D" "Off by default: bhote opens no connection to another machine until you switch this on." ;;
        esac
    done
    printf '\n'; rule
    printf ' %s%s%s\n' "$D" "$(clip "↑↓ select · space/⏎ toggle" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "←→ change · , or esc back" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "list: ⏎ open · n new · e/d edit · x done" $(( ${COLS:-44} - 3 )))" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "s start · a from agents · q quit" $(( ${COLS:-44} - 3 )))" "$X"
}
bhote_hotkeys() {  # every key, grouped by screen
    local k
    printf '\n %sHotkeys%s\n' "$L" "$X"; rule
    hk_group "LIST"
    hk "↑↓ jk wheel" "move"; hk "→ ⏎" "open the topic menu"; hk "n" "new topic (Title; description @Name)"
    hk "e" "edit the title"; hk "d" "edit the description"
    hk "s" "start on a free agent"; hk "x" "mark done"; hk "a" "suggestions from agents"
    hk "," "settings"; hk "S" "welcome screen"; hk "q" "quit"
    hk_group "MENUS AND PICKERS"
    hk "↑↓" "choose"; hk "→ ⏎" "do it"; hk "← esc" "back"; hk "x" "dismiss a suggestion"
    hk_group "SETTINGS"
    hk "↑↓" "select"; hk "space ⏎" "switch"; hk "←→" "change a value"; hk ", esc" "back"
    hk_group "MOUSE"
    hk "wheel" "move"; hk "drag ═══" "resize the agent area"
    printf '\n'; rule
    printf ' %s← esc back%s\n' "$D" "$X"
}
hk_group() { printf '\n  %s%s%s\n' "$D" "$1" "$X"; }
hk() {  # hk <keys> <what>
    local w=$(( ${COLS:-44} - 18 )) t; clip_set t "$2" "$w"
    printf '   %s%-12s%s %s\n' "$C" "$1" "$X" "$t"
}
store_cycle() {  # step the data location through: local, then every saved machine (→ / space forward, ← back)
    local opts=(local) id label host prof enabled cur i n k=$1 dir=1
    while IFS=$US read -r id label host prof enabled; do label=${label//[[:cntrl:]]/}; [ -n "$label" ] && opts[${#opts[@]}]="$label"; done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
    cur=local; [ "$(cfg_get STORE local)" = remote ] && cur=$(cfg_get STORE_MACHINE '')
    n=${#opts[@]}; [ "$k" = LEFT ] && dir=$(( n - 1 ))
    for (( i = 0; i < n; i++ )); do [ "${opts[$i]}" = "$cur" ] && break; done
    i=$(( (i + dir) % n ))
    if [ "${opts[$i]}" = local ]; then cfg_set STORE local; else cfg_set STORE remote STORE_MACHINE "${opts[$i]}"; fi
    : > "$STORE_DIRTY"
}
settings_key() {  # settings_key <key as read>  (an arrow arrives as ESC [ A/B/C/D)
    local k=$1 n=${#SET_ROWS[@]} row kind key cur v off
    settings_rows; n=${#SET_ROWS[@]}
    case "$k" in
        UP|k) SET_IDX=$(( (${SET_IDX:-0} + n - 1) % n )) ;;
        DOWN|j) SET_IDX=$(( (${SET_IDX:-0} + 1) % n )) ;;
        " "|ENTER|LEFT|RIGHT) row=${SET_ROWS[${SET_IDX:-0}]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}
            if [ "$kind" = choice ]; then store_cycle "$k"; return; fi
            if [ "$kind" = link ]; then [ "$k" = LEFT ] || SETTINGS_GO=hotkeys; return; fi
            [ "$k" = LEFT ] || [ "$k" = RIGHT ] || case "$kind" in
                bool) cur=off; case "$key" in ANIMATION|SPLASH_AUTOCLOSE|AUTOSTART) cur=on ;; esac
                      [ "$(cfg_get "$key" $cur)" = on ] && cfg_set "$key" off || cfg_set "$key" on ;;
                machine) off=$(cfg_get MACHINES_OFF '')
                      case ",$off,"  in
                          *",$key,"*) local x out="" IFS=,; for x in $off; do [ "$x" = "$key" ] || out=${out:+$out,}$x; done; unset IFS
                                      cfg_set MACHINES_OFF "$out" ;;
                          *) cfg_set MACHINES_OFF "${off:+$off,}$key" ;;
                      esac ;;
            esac ;;
        LEFT|RIGHT) row=${SET_ROWS[${SET_IDX:-0}]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}
            if [ "$kind" = num ]; then
                v=$(num_or "$(cfg_get "$key" $([ "$key" = REMOTE_EVERY ] && echo 10 || echo 3))" 3)
                if [ "$k" = RIGHT ]; then v=$(( v + 1 )); else v=$(( v > 1 ? v - 1 : 1 )); fi
                cfg_set "$key" "$v"
            fi ;;
    esac
}

# ── the animation. A background ticker only DECIDES which picture is due (eyes open or closed, tongue out or in) and tells
# the main loop with USR1; the main loop is the only one that writes to the screen, so two writers can never mix their
# escape sequences. It redraws just the dog, at an absolute position, so nothing flickers.
ANIM_FILE="$RUN_DIR/anim"
dog_ticker() {  # dog_ticker <main pid>
    local tick=0 closed tin idx last="" blink bl_last="" _an
    while true; do
        sleep 0.3; tick=$(( tick + 1 ))
        kill -0 "$1" 2>/dev/null || exit 0
        blink=on; [ $(( (tick / 2) % 2 )) -eq 1 ] && blink=off
        closed=0; [ $(( RANDOM % 14 )) -eq 0 ] && closed=1
        tin=0; [ $(( tick % 9 )) -ge 6 ] && tin=1
        idx=$(( closed + 2 * tin ))
        cfg_var _an ANIMATION on; [ "$_an" = on ] || idx=0
        [ "$idx $blink" = "$last" ] && continue
        last="$idx $blink"; echo "$idx $blink" > "$ANIM_FILE"; kill -USR1 "$1" 2>/dev/null || exit 0
    done
}
dog_animate() {  # the main loop's answer to USR1 (only on the splash and the list); draws only what changed
    local idx blink
    [ "$TOO_SMALL" = 1 ] && return 0
    [ "$1" = splash ] && ! splash_fits && return 0
    read -r idx blink < "$ANIM_FILE" 2>/dev/null || { idx=0; blink=on; }
    case "$1" in
        splash) if [ "$idx" != "${DRAWN_IDX:-}" ]; then DOG_IDX=$idx; dog_at big $(( 4 + SG0 )) $(( 2 + (WIDTH - 2 - DOG_W) / 2 )); DRAWN_IDX=$idx; fi
                if [ "$blink" != "${DRAWN_BLINK:-}" ]; then splash_prompt_at "$blink"; DRAWN_BLINK=$blink; fi ;;
        main) ;;                                            # no dog in the list
    esac
}

# Is another byte waiting on the terminal within a few milliseconds? bash 4+ can wait 0.05 s itself; bash 3.2 (macOS) only knows
# whole seconds, so it asks perl. (A lone Esc used to wait a full second for a byte that never came.)
HAVE_PERL=""; command -v perl >/dev/null 2>&1 && HAVE_PERL=1
read_soon() {  # read_soon <var>: one more byte if it arrives within ~50 ms, else empty (rc 1)
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then IFS= read -rsn1 -t 0.05 "$1" 2>/dev/null && return 0
    elif [ -n "$HAVE_PERL" ]; then
        perl -MIO::Select -e 'exit(IO::Select->new(\*STDIN)->can_read(0.05) ? 0 : 1)' </dev/tty 2>/dev/null \
            && IFS= read -rsn1 -t 1 "$1" 2>/dev/null && return 0
    else IFS= read -rsn1 -t 1 "$1" 2>/dev/null && return 0; fi
    printf -v "$1" '%s' ""; return 1
}
ask_drain() {  # throw away input that is still waiting (the rest of a multi-line paste): it must not turn into commands
    local _j
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then while IFS= read -rsn1 -t 0.05 _j </dev/tty 2>/dev/null; do :; done
    elif [ -n "$HAVE_PERL" ]; then
        perl -MIO::Select -e '$s = IO::Select->new(\*STDIN); while ($s->can_read(0.05)) { sysread(STDIN, $b, 4096) or last }' </dev/tty 2>/dev/null
    fi
    return 0
}
# The divider above the agents is a handle like herdr's sidebar split: press on it, drag, release. Its row is written by the frame
# (bhote_view runs in a subshell, so it leaves it in a file); the agent area's height is kept as AGENT_ROWS in the config.
MOUSE_ON=$'\033[?1002h\033[?1006h'; MOUSE_OFF=$'\033[?1002l\033[?1006l'; DRAG=0; DRAG_ROWS=""
mouse_event() {  # mouse_event <b;x;y> <M|m>: sets MOUSE_KEY (UP/DOWN for the wheel, DRAG while the divider moves, else empty)
    local b x y div rest; MOUSE_KEY=""
    b=${1%%;*}; rest=${1#*;}; x=${rest%%;*}; y=${rest#*;}
    case "$b$x$y" in *[!0-9]*) return ;; esac
    case "$b" in
        64) MOUSE_KEY=UP; return ;;
        65) MOUSE_KEY=DOWN; return ;;
    esac
    div=$(cat "$RUN_DIR/divrow" 2>/dev/null); div=$(num_or "$div" 0)
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$y" = "$div" ]; then DRAG=1; return; fi
    if [ "$DRAG" = 1 ] && [ "$2" = M ] && [ "$b" = 32 ]; then       # moving with the button held: the agents start below row y
        DRAG_ROWS=$(( ${ROWS:-40} - y - 4 )); MOUSE_KEY=DRAG; return
    fi
    if [ "$DRAG" = 1 ] && [ "$2" = m ]; then
        DRAG=0; [ -n "$DRAG_ROWS" ] && cfg_set AGENT_ROWS "$(agent_rows_clamp "$DRAG_ROWS")"; DRAG_ROWS=""; MOUSE_KEY=DRAG
    fi
}
agent_rows_clamp_set() {  # agent_rows_clamp_set <var> <n>: at least 1 agent row, and at least 4 lines stay for the topics
    local _n _max=$(( ${ROWS:-40} - 3 - 4 - 4 ))   # head 3, divider/header/rule/keys 4, topics 4
    num_set _n "$2" 1
    [ "$_max" -lt 1 ] && _max=1; [ "$_n" -gt "$_max" ] && _n=$_max; [ "$_n" -lt 1 ] && _n=1
    printf -v "$1" '%s' "$_n"
}
agent_rows_clamp() { agent_rows_clamp_set _ARC "$1"; printf '%s' "$_ARC"; }
# The one-line editor at the bottom. ←→ move, Option+←→ (also Ctrl) jump a word, Shift adds a selection (Shift+Option by words),
# Home/End or Ctrl-A/Ctrl-E (Cmd+←→), Backspace/Delete remove the selection or one character, Option+Backspace a word,
# Ctrl-U/Ctrl-K cut to the start/end. Typing replaces the selection. Enter keeps the text, Esc throws it away.
ED_BUF=""; ED_CUR=0; ED_ANC=-1                               # the text, the cursor (characters before it), the selection anchor (-1: none)
ed_word_left() {  # ED_TO = start of the word left of the cursor
    local i=$ED_CUR
    while [ "$i" -gt 0 ] && [ "${ED_BUF:$(( i - 1 )):1}" = " " ]; do i=$(( i - 1 )); done
    while [ "$i" -gt 0 ] && [ "${ED_BUF:$(( i - 1 )):1}" != " " ]; do i=$(( i - 1 )); done
    ED_TO=$i
}
ed_word_right() {  # ED_TO = end of the word right of the cursor
    local i=$ED_CUR n=${#ED_BUF}
    while [ "$i" -lt "$n" ] && [ "${ED_BUF:$i:1}" = " " ]; do i=$(( i + 1 )); done
    while [ "$i" -lt "$n" ] && [ "${ED_BUF:$i:1}" != " " ]; do i=$(( i + 1 )); done
    ED_TO=$i
}
ed_move() {  # ed_move <to> <select 0|1>
    if [ "$2" = 1 ]; then [ "$ED_ANC" -lt 0 ] && ED_ANC=$ED_CUR; else ED_ANC=-1; fi
    ED_CUR=$1; [ "$ED_CUR" -lt 0 ] && ED_CUR=0; [ "$ED_CUR" -gt "${#ED_BUF}" ] && ED_CUR=${#ED_BUF}
    [ "$ED_ANC" = "$ED_CUR" ] && ED_ANC=-1; return 0
}
ed_cut() {  # ed_cut <from> <to>: remove that range, the cursor goes to its start
    local a=$1 b=$2; [ "$a" -gt "$b" ] && { a=$2; b=$1; }
    ED_BUF="${ED_BUF:0:$a}${ED_BUF:$b}"; ED_CUR=$a; ED_ANC=-1
}
ed_cut_sel() { [ "$ED_ANC" -ge 0 ] || return 1; ed_cut "$ED_ANC" "$ED_CUR"; }
ed_insert() {  # ed_insert <text> <max>
    ed_cut_sel
    local room=$(( $2 - ${#ED_BUF} )) t=$1; [ "$room" -le 0 ] && return 0; t=${t:0:$room}
    ED_BUF="${ED_BUF:0:$ED_CUR}$t${ED_BUF:$ED_CUR}"; ED_CUR=$(( ED_CUR + ${#t} ))
}
ed_key_csi() {  # ed_key_csi <params> <final>: the cursor keys of xterm (1;2 Shift, 1;3 / 1;9 Option, 1;4 / 1;10 Shift+Option, 1;5 Ctrl)
    local p=$1 f=$2 sel=0 word=0
    case "$p" in 1\;2) sel=1 ;; 1\;3|1\;9|1\;5) word=1 ;; 1\;4|1\;10|1\;6) sel=1; word=1 ;; esac
    case "$f" in
        D) if [ "$word" = 1 ]; then ed_word_left; ed_move "$ED_TO" "$sel"
           elif [ "$sel" = 0 ] && [ "$ED_ANC" -ge 0 ]; then local a=$ED_ANC; [ "$a" -gt "$ED_CUR" ] && a=$ED_CUR; ed_move "$a" 0
           else ed_move $(( ED_CUR - 1 )) "$sel"; fi ;;
        C) if [ "$word" = 1 ]; then ed_word_right; ed_move "$ED_TO" "$sel"
           elif [ "$sel" = 0 ] && [ "$ED_ANC" -ge 0 ]; then local a=$ED_ANC; [ "$a" -lt "$ED_CUR" ] && a=$ED_CUR; ed_move "$a" 0
           else ed_move $(( ED_CUR + 1 )) "$sel"; fi ;;
        H) ed_move 0 "$sel" ;;
        F) ed_move "${#ED_BUF}" "$sel" ;;
        "~") case "$p" in 3) ed_cut_sel || ed_cut "$ED_CUR" $(( ED_CUR + 1 )) ;; 1|7) ed_move 0 0 ;; 4|8) ed_move "${#ED_BUF}" 0 ;; esac ;;
    esac
}
ask() {  # ask <label> [text to start with] [max length]: the editor on the last row -> ANSWER. Enter keeps it, Esc throws it away.
    local ch k2 k3 n p cancel=0 max=${3:-500} b
    ED_BUF=${2:-}; ED_BUF=${ED_BUF:0:$max}; ED_CUR=${#ED_BUF}; ED_ANC=-1; ASK_MAX=${3:-}
    trap '' USR1                                           # the animation must not cut the typing short
    printf '%s\033[?25h' "$MOUSE_OFF"                       # no mouse reports in the text; cursor on
    ask_draw "$1"
    while true; do
        IFS= read -rsn1 ch </dev/tty || { cancel=1; break; }   # end of input: treat as cancel
        case "$ch" in
            "") break ;;                                    # Enter
            $'\033')
                read_soon k2
                case "$k2" in
                    "") cancel=1; break ;;                  # a lone Esc: throw the entry away
                    "["|O) p=""; k3=""; n=0
                        while IFS= read -rsn1 -t 1 k3 </dev/tty && [ "$n" -lt 24 ]; do
                            case "$k3" in [0123456789\;\<\=\>\?\ \!\"\#\$\%\&\'\(\)\*\+\,\-\.\/]) p="$p$k3" ;; *) break ;; esac
                            [ "$k2" = O ] && break; n=$(( n + 1 ))
                        done
                        ed_key_csi "$p" "$k3" ;;
                    b) ed_word_left; ed_move "$ED_TO" 0 ;;   # Option+← / Option+→ as Meta (ESC b / ESC f)
                    f) ed_word_right; ed_move "$ED_TO" 0 ;;
                    $'\177'|$'\010') ed_cut_sel || { ed_word_left; ed_cut "$ED_TO" "$ED_CUR"; } ;;   # Option+Backspace: a word
                    l) ed_insert "@" "$max" ;;              # a left Option arrives as Alt: ESC l / ESC 7 are @ and | (German keyboard)
                    7) ed_insert "|" "$max" ;;
                esac ;;
            $'\177'|$'\010') ed_cut_sel || { [ "$ED_CUR" -gt 0 ] && ed_cut $(( ED_CUR - 1 )) "$ED_CUR"; } ;;
            $'\001') ed_move 0 0 ;;                         # Ctrl-A (Cmd+←)
            $'\005') ed_move "${#ED_BUF}" 0 ;;              # Ctrl-E (Cmd+→)
            $'\025') ed_cut 0 "$ED_CUR" ;;                  # Ctrl-U
            $'\013') ed_cut "$ED_CUR" "${#ED_BUF}" ;;       # Ctrl-K
            $'\027') ed_word_left; ed_cut "$ED_TO" "$ED_CUR" ;;   # Ctrl-W
            [[:cntrl:]]) ;;
            *) if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then    # bash 3.2 reads one BYTE: collect the rest of a UTF-8 character
                   LC_ALL=C printf -v b '%d' "'$ch"; n=0
                   [ "$b" -ge 192 ] && n=1; [ "$b" -ge 224 ] && n=2; [ "$b" -ge 240 ] && n=3
                   while [ "$n" -gt 0 ] && IFS= read -rsn1 -t 1 k3 </dev/tty; do ch="$ch$k3"; n=$(( n - 1 )); done
               fi
               ed_insert "$ch" "$max" ;;
        esac
        ask_draw "$1"
    done
    ask_drain                                               # the rest of a multi-line paste must not become commands
    printf '\033[0m\033[?25l%s' "$MOUSE_ON"; trap 'anim=1' USR1; ASK_MAX=""
    if [ "$cancel" = 1 ]; then ANSWER=""; return 1; fi
    ANSWER=${ED_BUF//[[:cntrl:]]/}; ANSWER=${ANSWER#"${ANSWER%%[! ]*}"}; ANSWER=${ANSWER%"${ANSWER##*[! ]}"}
    return 0
}
ask_draw() {  # ask_draw <label>: the prompt row with ED_BUF; the part around the cursor when it is longer than the room
    local rows=${ROWS:-40} w=$(( ${COLS:-44} - 1 )) room cnt="" off a b pre mid post col
    [ -n "${ASK_MAX:-}" ] && cnt="$(( ASK_MAX - ${#ED_BUF} )) left"   # how many characters are left, on the right
    room=$(( w - 3 - ${#1} - 1 - ${#cnt} - 1 )); [ "$room" -lt 4 ] && room=4
    off=0; [ "$ED_CUR" -gt "$room" ] && off=$(( ED_CUR - room ))   # scroll so that the cursor stays visible
    a=$ED_CUR; b=$ED_CUR; [ "$ED_ANC" -ge 0 ] && { a=$ED_ANC; [ "$a" -gt "$b" ] && { a=$ED_CUR; b=$ED_ANC; }; }
    [ "$a" -lt "$off" ] && a=$off; [ "$b" -lt "$off" ] && b=$off
    pre=${ED_BUF:$off:$(( a - off ))}; mid=${ED_BUF:$a:$(( b - a ))}; post=${ED_BUF:$b}
    post=${post:0:$(( room - ${#pre} - ${#mid} ))}
    printf '\033[%d;1H\033[2K%s%*s' "$rows" "$SELBG" "$w" ""
    [ -n "$cnt" ] && printf '\033[%d;%dH%s%s' "$rows" $(( w - ${#cnt} )) "$D" "$cnt"
    printf '\033[%d;1H%s%s▶ %s%s%s%s\033[7m%s\033[27m%s' "$rows" "$SELBG" "$ORANGE" "$L" "$1" "$X$SELBG$L" "$pre" "$mid" "$post"
    col=$(( 4 + ${#1} + ED_CUR - off )); printf '\033[%d;%dH' "$rows" "$col"   # the terminal cursor where the text cursor is
}
menu_line() {  # menu_line <selected: 1 or empty> <text>: a choice; the selected one is a bar over the whole width
    local w=$(( ${COLS:-44} - 2 )) t; clip_set t "$2" $(( w - 4 ))
    if [ -n "$1" ]; then printf '%s   %s%s%*s%s\n' "$SELBG" "$L" "$t" $(( w - 3 - ${#t} )) "" "$X"
    else printf '   %s%s%s\n' "$D" "$t" "$X"; fi
}
MENU_ITEMS=("Start with agent ..." "Waiting for ..." "Park for later" "Mark done" "Rename" "Describe ..." "Delete" "Back")
bhote_menu() {  # the action menu of the selected topic
    local f i title; f=$(sel_file); [ -n "$f" ] || { printf '\n  %sno topic selected%s\n' "$D" "$X"; return; }
    clip_set title "$(topic_get "$f" title '(untitled)')" $(( ${COLS:-44} - 8 ))
    printf '\n %s▸ %s%s\n' "$ORANGE" "$L$title" "$X"
    printf ' %s%s%s\n' "$D" "$(clip "$(topic_get "$f" status now) · $(topic_get "$f" waiting_for -)" $(( ${COLS:-44} - 3 )))" "$X"
    rule; printf '\n'
    for (( i = 0; i < ${#MENU_ITEMS[@]}; i++ )); do
        menu_line "$([ "$i" = "${MENU_IDX:-0}" ] && echo 1)" "${MENU_ITEMS[$i]}"
    done
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ do it · ←/esc back%s\n' "$D" "$X"
}
# ── suggestions: what the running agents work on (the "task" of each agent pane) and is not a topic yet. "a" lists them; adopting one
# makes it a topic that is already assigned to that agent. "x" dismisses one for good (kept in $DATA_DIR/dismissed).
SUG_MAP=(); SUG_IDX=0
eq_ci() { local r=1; shopt -s nocasematch; [[ $1 == "$2" ]] && r=0; shopt -u nocasematch; return $r; }
suggest_build() {  # SUG_MAP = indexes into AG_LINES of agents whose task is neither a topic nor assigned nor dismissed
    local i m id st name task t known line; SUG_MAP=()
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        [ -n "$task" ] || continue
        known=0
        for (( t = 0; t < T_N; t++ )); do
            [ "${T_STATUS[$t]}" = done ] && continue
            if [ "${T_AM[$t]}" = "$m" ] && [ "${T_AP[$t]}" = "$id" ]; then known=1; break; fi
            eq_ci "${T_TITLE[$t]}" "$task" && { known=1; break; }
        done
        [ "$known" = 0 ] && [ -r "$DATA_DIR/dismissed" ] && while IFS= read -r line; do [ "$line" = "$m|$id|$task" ] && { known=1; break; }; done < "$DATA_DIR/dismissed"
        [ "$known" = 0 ] && SUG_MAP[${#SUG_MAP[@]}]=$i
    done
}
bhote_suggest() {
    local i m id st name task sl
    printf '\n %sFrom running agents%s\n %sTheir tasks that are no topic yet%s\n' "$L" "$X" "$D" "$X"
    rule; printf '\n'
    suggest_build
    for (( i = 0; i < ${#SUG_MAP[@]}; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[${SUG_MAP[$i]}]}"
        sl=0; [ "$i" = "$SUG_IDX" ] && sl=1
        topic_item "$sl" "" " " "$L" "$task" "" "$m · $name" 0
    done
    [ "${#SUG_MAP[@]}" -gt 0 ] || printf '   %snothing to suggest%s\n' "$D" "$X"
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ add as topic%s\n %sx dismiss · ←/esc back%s\n' "$D" "$X" "$D" "$X"
}
suggest_do() {  # suggest_do <adopt|dismiss> <index>
    local m id st name task f
    suggest_build; [ -n "${SUG_MAP[$2]:-}" ] || return 0
    IFS=$US read -r m id st name task <<< "${AG_LINES[${SUG_MAP[$2]}]}"
    if [ "$1" = dismiss ]; then printf '%s|%s|%s\n' "$m" "$id" "$task" >> "$DATA_DIR/dismissed"; return 0; fi
    topic_new "$task" "" "" || return 0
    f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"; SEL_ID=$NEW_TOPIC_ID
    topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
}
# ── the picker: "Start" asks which free agent takes the topic. Free = idle or done; entry 0 only marks the topic as started.
PICK_MAP=(); PICK_IDX=0
agent_taken() {  # agent_taken <machine> <pane>: already working on another open topic
    local _t; for (( _t = 0; _t < T_N; _t++ )); do
        [ "${T_STATUS[$_t]}" = now ] && [ "${T_AM[$_t]}" = "$1" ] && [ "${T_AP[$_t]}" = "$2" ] && [ "${T_ID[$_t]}" != "${SEL_ID:-}" ] && return 0
    done; return 1
}
pick_build() {  # PICK_MAP = indexes into AG_LINES of the free agents
    local i m id st name task; PICK_MAP=()
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        case "$st" in idle|done) agent_taken "$m" "$id" || PICK_MAP[${#PICK_MAP[@]}]=$i ;; esac
    done
}
bhote_pick() {
    local f i k m id st name task title n=0 label sl
    f=$(sel_file); [ -n "$f" ] || { printf '\n  %sno topic selected%s\n' "$D" "$X"; return; }
    clip_set title "$(topic_get "$f" title '(untitled)')" $(( ${COLS:-44} - 8 ))
    printf '\n %s▸ %s%s\n %sWho takes it?%s\n' "$ORANGE" "$L$title" "$X" "$D" "$X"
    rule; printf '\n'
    pick_build
    for (( i = 0; i <= ${#PICK_MAP[@]}; i++ )); do
        if [ "$i" = 0 ]; then label="Just mark as started"
        else
            IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( i - 1 ))]}]}"
            label="$m · $name"; [ "$st" = done ] && label="$label ✓"
        fi
        clip_set label "$label" $(( ${COLS:-44} - 8 ))
        sl=""; [ "$i" = "$PICK_IDX" ] && sl=1; menu_line "$sl" "$label"
    done
    [ "${#PICK_MAP[@]}" -gt 0 ] || printf '\n   %sno free agent right now%s\n' "$D" "$X"
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ start · ←/esc back%s\n' "$D" "$X"
}
pick_do() {  # pick_do <index>: hand the topic to that agent (its title as a prompt, Enter included) and mark it started
    local f m id st name task opt=() title desc; f=$(sel_file); [ -n "$f" ] || return 0
    title=$(topic_get "$f" title); desc=$(topic_get "$f" description); [ -n "$desc" ] && title="$title. $desc"
    if [ "$1" -gt 0 ]; then
        pick_build
        IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( $1 - 1 ))]:-0}]}"
        [ -n "${PICK_MAP[$(( $1 - 1 ))]:-}" ] || return 0
        agent_state_set st "$m" "$id"; case "$st" in idle|done) ;; *) return 0 ;; esac     # taken in the meantime: change nothing
        [ "$m" = "$HOST" ] || opt=(--machine "$m")
        # the lists are a few seconds old: right before typing, ask herdr itself that this pane still runs a FREE agent
        # (a pane that is now a plain shell would execute the text)
        st=$(herdr "${opt[@]}" pane list 2>/dev/null | jq -r --arg p "$id" '[.result.panes[] | select(.pane_id == $p)][0] | if . == null then "gone" elif (.agent // "") == "" then "noagent" else (.agent_status // "") end' 2>/dev/null)
        case "$st" in idle|done) ;; *) return 0 ;; esac
    fi
    topic_set "$f" status now; topic_set "$f" waiting_for ""; topic_set "$f" agent ""
    if [ "$1" -gt 0 ]; then
        topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
        ( herdr "${opt[@]}" pane run "$id" -- "$title" >/dev/null 2>&1 ) &
    fi
    : > "$STORE_DIRTY"
}
menu_do() {  # menu_do <index>: run the chosen action on the selected topic; 0 = stay in the menu, 1 = leave it
    local f; f=$(sel_file); [ -n "$f" ] || return 1
    case "$1" in
        0) PICK_IDX=0; view=pick; return 0 ;;     # the picker of free agents (view is bhote_main's variable)
        1) ask "Waiting for: " "$(topic_get "$f" waiting_for)"; [ -n "$ANSWER" ] || return 0
           topic_set "$f" status waiting; topic_set "$f" waiting_for "$ANSWER"; topic_set "$f" waiting_since "$(date +%s)" ;;
        2) topic_set "$f" status later ;;
        3) topic_set "$f" status done ;;
        4) ask "Title: " "$(topic_get "$f" title)" || return 0; [ -n "$ANSWER" ] && topic_set "$f" title "$ANSWER"; [ -n "$ANSWER" ] || return 0 ;;
        5) ask "Description: " "$(topic_get "$f" description)" "$DESC_MAX" || return 0     # Esc keeps the old text; an emptied line removes it
           topic_set "$f" description "$ANSWER" ;;
        6) ask "Delete \"$(topic_get "$f" title)\"? y/N: "; [ "$ANSWER" = y ] || [ "$ANSWER" = Y ] || return 0
           topic_set "$f" deleted 1; SEL_ID="" ;;
        7) ;;
    esac
    return 1
}
prompt_new_topic() {  # "Title", "Title; description", "Title @Name" or "Title > Name" (= waiting for Name); the new topic gets selected
    local title who="" desc=""
    ask "Topic: "
    title=$ANSWER
    case "$title" in *" @"*) who=${title##* @}; title=${title% @*} ;; *" > "*) who=${title##* > }; title=${title% > *} ;; esac   # the name goes last
    case "$title" in *";"*) desc=${title#*;}; title=${title%%;*} ;; esac
    title=${title%"${title##*[! ]}"}; desc=${desc#"${desc%%[! ]*}"}
    topic_new "$title" "$who" "$desc" && SEL_ID=$NEW_TOPIC_ID
}

# ── run. BHOTE_ONCE=1 prints a view once and exits (BHOTE_VIEW=splash|main|settings picks it); otherwise it runs as a panel:
# the start screen first, any key moves on to the topic list (the dog shrinks), "s" shows the start screen again, "," the
# settings, "q" quits. On a short terminal it starts with the list. The window title says "Bhote" so that herdr's
# autostart can tell that it is there.
# The panel works between MIN and MAX columns: wider than MAX it uses only the left MAX columns, narrower than MIN (or shorter
# than MIN_ROWS) it shows a hint instead of a broken picture. The start screen is a fixed picture (WIDTH x SPLASH_ROWS):
# where it does not fit, the list is shown instead.
MIN_COLS=${BHOTE_MIN_COLS:-30}; MAX_COLS=${BHOTE_MAX_COLS:-60}; MIN_ROWS=${BHOTE_MIN_ROWS:-20}; SPLASH_ROWS=39; TOO_SMALL=0
splash_fits() { [ "${REAL_COLS:-44}" -ge "$SPLASH_W" ] && [ "${REAL_ROWS:-40}" -ge "$SPLASH_ROWS" ]; }
# The start screen fills the pane: the frame is as wide and as high as the pane; the extra width centres the content, the extra
# height becomes space between the sections (all of it above the prompt, so the keys stay on the bottom edge).
SG0=1; SG1=1; SG2=1; SG3=1; SG4=1; SPLASH_E=0
splash_geometry() {
    local e q r
    WIDTH=${REAL_COLS:-44}; [ "$WIDTH" -lt "$SPLASH_W" ] && WIDTH=$SPLASH_W; INNER=$(( WIDTH - 2 ))
    e=$(( ${REAL_ROWS:-40} - SPLASH_ROWS )); [ "$e" -lt 0 ] && e=0; SPLASH_E=$e
    # five gaps (under the greeting, the dog, the wordmark, the prompt, the info), each one line plus an equal share of the rest
    q=$(( e / 5 )); r=$(( e % 5 ))
    SG0=$(( 1 + q + (r > 0) )); SG1=$(( 1 + q + (r > 1) )); SG2=$(( 1 + q + (r > 2) )); SG3=$(( 1 + q + (r > 3) )); SG4=$(( 1 + q ))
    SPLASH_PROMPT_ROW=$(( 28 + SG0 + SG1 + SG2 ))
}
term_size() {
    local sz; sz=$(stty size </dev/tty 2>/dev/null); REAL_COLS=${sz#* }; REAL_ROWS=${sz% *}; REAL_COLS=${REAL_COLS:-44}; REAL_ROWS=${REAL_ROWS:-40}
    TOO_SMALL=0; { [ "$REAL_COLS" -lt "$MIN_COLS" ] || [ "$REAL_ROWS" -lt "$MIN_ROWS" ]; } && TOO_SMALL=1
    COLS=$REAL_COLS; [ "$COLS" -gt "$MAX_COLS" ] && COLS=$MAX_COLS; [ "$COLS" -lt "$MIN_COLS" ] && COLS=$MIN_COLS
    ROWS=$REAL_ROWS; splash_geometry
    RULE_LINE=$(hline $(( COLS - 5 )))
}
harden_perms() {  # data, config and their folders: this user only (older versions created them open)
    mkdir -p "$TOPIC_DIR" "$(dirname "$CONFIG_FILE")" 2>/dev/null
    chmod 700 "$DATA_DIR" "$TOPIC_DIR" "$(dirname "$CONFIG_FILE")" 2>/dev/null
    [ -f "$CONFIG_FILE" ] && chmod 600 "$CONFIG_FILE" 2>/dev/null
    return 0
}
bhote_main() {
    local f chk seq tmo _sa _ss view=${BHOTE_VIEW:-splash} key rows m1 m2 last_m="" k2 k3 anim=0 rc MENU_IDX=0 resize=0
    harden_perms; bhote_info
    if [ -n "${BHOTE_ONCE:-}" ] || [ ! -t 0 ]; then
        AGENT_LOCAL=$RUN_DIR/agents.local; AGENT_REMOTE=$RUN_DIR/agents.remote
        collect_local; [ "$(cfg_get REMOTE_AGENTS off)" = on ] && collect_remote
        COLS=${BHOTE_COLS:-44}; ROWS=${BHOTE_ROWS:-40}; REAL_COLS=$COLS; REAL_ROWS=$ROWS; splash_geometry; [ "$COLS" -gt "$MAX_COLS" ] && COLS=$MAX_COLS; RULE_LINE=$(hline $(( COLS - 5 ))); ui_load; bhote_draw "$view"; rm -f "$AGENT_LOCAL" "$AGENT_REMOTE"; return
    fi
    printf '\033]2;Bhote\007'
    dog_init; dog_warm; term_size
    local pids="" stty_saved
    # The terminal must not echo what arrives between two reads: a mouse wheel in the alternate screen sends arrow keys
    # (ESC [ B) all the time, and with echo on they showed up as ^[[B on the screen. Restored on exit.
    # Byte by byte, not line by line (-icanon): only then does a waiting escape sequence count as "input waiting" (read_soon).
    stty_saved=$(stty -g </dev/tty 2>/dev/null); stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    cleanup() {
        trap '' INT TERM HUP QUIT USR1 WINCH                  # once, and not interrupted by the next signal
        kill $pids 2>/dev/null
        [ -n "$stty_saved" ] && stty "$stty_saved" </dev/tty 2>/dev/null
        [ "$(cat "$SHARED_DIR/collector.lock/pid" 2>/dev/null)" = "$$" ] && rm -rf "$SHARED_DIR/collector.lock"
        [ "$(cat "$DATA_DIR/sync.lock/pid" 2>/dev/null)" = "$$" ] && rm -rf "$DATA_DIR/sync.lock"
        rm -rf "$RUN_DIR"
        printf '%s\033[0m\033[?25h\033[?1049l\033]2;\007' "$MOUSE_OFF" 2>/dev/null   # mouse off, colours, cursor, normal screen, title
    }
    trap 'cleanup; exit 0' INT TERM HUP QUIT EXIT
    trap 'redraw=1; resize=1' WINCH
    trap 'anim=1' USR1
    printf '\033[?1049h\033[?25l%s' "$MOUSE_ON"          # alternate screen, hidden cursor, mouse reports (wheel, divider)
    splash_fits || view=main
    collector "$$" & pids="$!"
    echo "0 on" > "$ANIM_FILE"; dog_ticker $$ & pids="$pids $!"
    local back=main
    redraw=1
    while true; do
        if [ "$redraw" = 1 ]; then
            redraw=0; anim=0; [ "$resize" = 1 ] && { resize=0; term_size; }
            [ "$view" = splash ] && ! splash_fits && view=main
            read -r DOG_IDX _ < "$ANIM_FILE" 2>/dev/null || DOG_IDX=0
            DRAWN_IDX=$DOG_IDX; DRAWN_BLINK=on
            bhote_paint "$view"; dog_prev_reset "$view"
        elif [ "$anim" = 1 ]; then anim=0; dog_animate "$view"; fi
        [ "$view" = splash ] && [ -z "${SPLASH_SINCE:-}" ] && SPLASH_SINCE=$SECONDS
        [ "$view" = splash ] || SPLASH_SINCE=""
        tmo=2; [ "$view" = splash ] && tmo=1
        key=""; IFS= read -rsn1 -t "$tmo" key 2>/dev/null; rc=$?
        [ "$rc" = 0 ] && [ -z "$key" ] && key=ENTER      # Enter reads as an empty key; a timeout (rc > 128) stays empty
        if [ "$key" = $'\033' ]; then      # an arrow key (ESC [ A..D, ESC O A..D), a mouse report, another sequence, or a lone Esc
            read_soon k2
            if [ "$k2" = "[" ] || [ "$k2" = O ]; then
                # read up to the final byte (@ .. ~): parameters such as 1;5 (Ctrl+arrow), mouse reports and paste markers
                # must not leak their tail as keys. Only a parameterless A..D is an arrow; the rest is ignored.
                k3=""; seq=""
                while IFS= read -rsn1 -t 1 k3 2>/dev/null; do
                    case "$k3" in [0123456789\;\<\=\>\?\ \!\"\#\$\%\&\'\(\)\*\+\,\-\.\/]) ;; *) [ "$k2" = O ] || [ -z "$seq" ] || k3="x$k3"; break ;; esac   # (no [@-~]: a range follows the locale)
                    [ "$k2" = O ] && break; seq="$seq$k3"; [ "${#seq}" -gt 24 ] && break
                done
                case "$k3" in A) key=UP ;; B) key=DOWN ;; C) key=RIGHT ;; D) key=LEFT ;; *) key="" ;; esac
                case "$seq" in "<"*) mouse_event "${seq#<}" "${k3#x}"; key=$MOUSE_KEY ;; esac      # SGR mouse: < b ; x ; y M|m
            elif [ -z "$k2" ]; then key=ESC
            else key=""; fi                                    # Alt+key: nothing
        fi
        if [ "$view" = settings ]; then
            case "$key" in
                ","|ESC|q|Q) view=$back; redraw=1 ;;
                ""|DRAG) ;;
                *) SETTINGS_GO=""; settings_key "$key"; [ "$SETTINGS_GO" = hotkeys ] && view=hotkeys; redraw=1 ;;
            esac
        elif [ "$view" = hotkeys ]; then
            case "$key" in ESC|LEFT|h|q|Q|","|ENTER) view=settings; redraw=1 ;; esac
        elif [ "$view" = suggest ]; then
            suggest_build
            case "$key" in
                UP|k) SUG_IDX=$(( (SUG_IDX + ${#SUG_MAP[@]} - 1) % (${#SUG_MAP[@]} + (${#SUG_MAP[@]} == 0)) )); redraw=1 ;;
                DOWN|j) SUG_IDX=$(( (SUG_IDX + 1) % (${#SUG_MAP[@]} + (${#SUG_MAP[@]} == 0)) )); redraw=1 ;;
                ENTER|RIGHT) suggest_do adopt "$SUG_IDX"; SUG_IDX=0; view=main; redraw=1 ;;
                x|X) suggest_do dismiss "$SUG_IDX"; SUG_IDX=0; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        elif [ "$view" = pick ]; then
            pick_build
            case "$key" in
                UP|k) PICK_IDX=$(( (PICK_IDX + ${#PICK_MAP[@]}) % (${#PICK_MAP[@]} + 1) )); redraw=1 ;;
                DOWN|j) PICK_IDX=$(( (PICK_IDX + 1) % (${#PICK_MAP[@]} + 1) )); redraw=1 ;;
                ENTER|RIGHT) pick_do "$PICK_IDX"; view=main; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        elif [ "$view" = menu ]; then       # the action menu of the selected topic
            case "$key" in
                UP|k) MENU_IDX=$(( (MENU_IDX + ${#MENU_ITEMS[@]} - 1) % ${#MENU_ITEMS[@]} )); redraw=1 ;;
                DOWN|j) MENU_IDX=$(( (MENU_IDX + 1) % ${#MENU_ITEMS[@]} )); redraw=1 ;;
                ENTER|RIGHT) if menu_do "$MENU_IDX"; then :; else view=main; fi; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        else
            case "$key" in
                "") ;;
                DRAG) [ "$view" = main ] && redraw=1 ;;
                q|Q) exit 0 ;;
                s) if [ "$view" = main ] && [ -n "$(sel_file)" ]; then view=pick; PICK_IDX=0; else view=main; fi; redraw=1 ;;
                S) splash_fits && view=splash; redraw=1 ;;
                a|A) if [ "$view" = main ]; then view=suggest; SUG_IDX=0; redraw=1; fi ;;
                x|X) if [ "$view" = main ]; then f=$(sel_file); [ -n "$f" ] && topic_set "$f" status done; redraw=1; fi ;;   # check it off
                e|E) if [ "$view" = main ]; then f=$(sel_file)                                              # edit the title
                         if [ -n "$f" ] && ask "Title: " "$(topic_get "$f" title)" && [ -n "$ANSWER" ]; then topic_set "$f" title "$ANSWER"; fi; redraw=1; fi ;;
                d|D) if [ "$view" = main ]; then f=$(sel_file)                                              # edit the description
                         if [ -n "$f" ] && ask "Description: " "$(topic_get "$f" description)" "$DESC_MAX"; then topic_set "$f" description "$ANSWER"; fi; redraw=1; fi ;;
                n|N) if [ "$view" = main ]; then prompt_new_topic; redraw=1; else view=main; redraw=1; fi ;;
                ",") back=$view; [ "$back" = splash ] && back=main; view=settings; SET_IDX=0; redraw=1 ;;
                UP|k) if [ "$view" = main ]; then sel_move -1; redraw=1; fi ;;      # on the start screen the wheel does nothing
                DOWN|j) if [ "$view" = main ]; then sel_move +1; redraw=1; fi ;;
                ENTER|RIGHT) if [ "$view" = splash ]; then view=main; elif [ -n "$(sel_file)" ]; then view=menu; MENU_IDX=0; fi; redraw=1 ;;
                *) if [ "$view" = splash ]; then view=main; redraw=1; fi ;;
            esac
        fi
        # the welcome screen closes by itself (setting, default on) when nobody pressed a key for SPLASH_SECONDS
        if [ "$view" = splash ] && [ -z "$key" ]; then
            cfg_var _sa SPLASH_AUTOCLOSE on; cfg_var _ss SPLASH_SECONDS 15
            if [ "$_sa" = on ] && [ $(( SECONDS - ${SPLASH_SINCE:-$SECONDS} )) -ge "$_ss" ]; then view=main; redraw=1; fi
        fi
        # the agent lists changed (the collector writes them every few seconds): redraw the list view
        # the collector rewrites its files every few seconds: only a change of CONTENT repaints the list
        # (only when idle: after a key press the screen is repainted anyway, and a key must not wait for this check)
        # Every 2 seconds, when no key was read: did the agent lists, the topics or the sync state change? (Not tied to a read
        # timeout: the animation wakes the loop all the time, and bash 3.2 returns 1 from a timed-out read, bash 4+ more than 128.)
        if [ -z "$key" ] && [ "$SECONDS" -ge $(( ${chk:-0} + 2 )) ]; then
            chk=$SECONDS
            m1=$( { agents_all; cat "$TOPIC_DIR"/*.topic 2>/dev/null; head -1 "$STORE_STATUS" 2>/dev/null; } | cksum )
            if [ "$m1" != "$last_m" ]; then last_m=$m1; [ "$view" = main ] && redraw=1; fi
        fi
    done
}
bhote_draw() { case "$1" in main) bhote_view ;; hotkeys) bhote_hotkeys ;; suggest) bhote_suggest ;; menu) bhote_menu ;; pick) bhote_pick ;; settings) bhote_settings ;; *) bhote_splash ;; esac; }
# One frame = ONE write: home, every line cleared to its end, then the rest of the screen cleared. No full clear first,
# so nothing flashes; and it is only called when what is on screen would really look different.
bhote_paint() {  # one write per frame; ui_load first (in THIS shell), the frame itself is built in a subshell that only prints
    local frame line out="" first=1
    if [ "$TOO_SMALL" = 1 ]; then     # too small for any picture: one line that cannot wrap
        printf '\033[H\033[J%s' "$(clip "Too small (min ${MIN_COLS}x${MIN_ROWS})" "$(( ${REAL_COLS:-30} - 1 ))")"; return 0
    fi
    ui_load
    frame=$(bhote_draw "$1")
    while IFS= read -r line; do
        [ "$first" = 1 ] || out="${out}"$'\n'; first=0
        out="${out}${line}"$'\033[K'
    done <<< "$frame"
    printf '\033[H%s\033[J' "$out"
}

# ── the command line: the same topics as the panel, for scripts and for chats ("bhote help"). Every change that is made
# here is also merged with the data location at once (best effort: offline it stays local and is merged later).
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')"; }
title_has() { local r=1; shopt -s nocasematch; [[ $1 == *"$2"* ]] && r=0; shopt -u nocasematch; return $r; }   # case-insensitive, multibyte-safe
topic_ref() {  # topic_ref <ref>  ->  prints the file. ref: the number from `bhote list`, an id (prefix), or part of the title.
    local ref=$1 i hits=0 hit="" low
    topics_load
    [ -n "$ref" ] || { echo "bhote: a topic is needed (number, id or part of the title)" >&2; return 1; }
    case "$ref" in *[!0-9]*) ;; *) if [ "${#ref}" -le 3 ]; then      # a number from `bhote list` (decimal, also with leading zeros)
        i=$(( 10#$ref )); if [ "$i" -ge 1 ] && [ "$i" -le "$T_N" ]; then printf '%s' "${T_FILE[$(( i - 1 ))]}"; return 0; fi
        echo "bhote: there is no topic number $ref (bhote list)" >&2; return 1; fi ;; esac
    low=$ref
    for (( i = 0; i < T_N; i++ )); do
        if [ "${T_ID[$i]}" = "$ref" ]; then printf '%s' "${T_FILE[$i]}"; return 0; fi
    done
    for (( i = 0; i < T_N; i++ )); do
        case "${T_ID[$i]}" in "$ref"*) hits=$(( hits + 1 )); hit=${T_FILE[$i]}; continue ;; esac
        title_has "${T_TITLE[$i]}" "$low" && { hits=$(( hits + 1 )); hit=${T_FILE[$i]}; }
    done
    if [ "$hits" = 1 ]; then printf '%s' "$hit"; return 0; fi
    if [ "$hits" = 0 ]; then echo "bhote: no topic matches '$ref'" >&2; return 1; fi
    echo "bhote: '$ref' matches $hits topics, be more specific:" >&2
    for (( i = 0; i < T_N; i++ )); do title_has "${T_TITLE[$i]}" "$low" && echo "  $(( i + 1 ))  ${T_TITLE[$i]}" >&2; done
    return 2
}
cli_done() {  # after a change: merge with the data location (silent when the data is only local)
    [ -n "${BHOTE_NO_SYNC:-}" ] && return 0
    [ "$(cfg_get STORE local)" = remote ] || return 0
    store_sync >/dev/null 2>&1; case $? in
        0) ;;
        2) : > "$STORE_DIRTY" ;;                              # a panel is syncing right now: it takes this change with it
        *) echo "bhote: saved locally; $(cfg_get STORE_MACHINE) is not reachable, it will be merged later" >&2 ;;
    esac
}
# The JSON of one topic: the same object for `list --json`, `show --json` and every changing command with --json (schema:
# docs/schema/topic.schema.json). A value that is not there is null, never an empty string or 0.
json_num() { case "$1" in ''|*[!0-9]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }
json_opt() { if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi; }
topic_n() {  # topic_n <file>: its number in `bhote list --all` (1-based); needs topics_load
    local i; for (( i = 0; i < T_N; i++ )); do [ "${T_FILE[$i]}" = "$1" ] && { printf '%s' $(( i + 1 )); return; }; done; printf 'null'
}
topic_json() {  # topic_json <file>
    local f=$1 st wf ag am ap agent=null
    st=$(topic_get "$f" status now); wf=$(topic_get "$f" waiting_for); ag=$(topic_get "$f" agent); am=$(topic_get "$f" agent_machine); ap=$(topic_get "$f" agent_pane)
    [ "$st" = waiting ] || wf=""
    [ -n "$ag" ] && agent=$(printf '{"name":%s,"machine":%s,"pane":%s}' "$(json_str "$ag")" "$(json_opt "$am")" "$(json_opt "$ap")")
    printf '{"id":%s,"n":%s,"title":%s,"description":%s,"status":%s,"waiting_for":%s,"waiting_since":%s,"agent":%s,"created":%s,"updated":%s}' \
        "$(json_str "$(topic_get "$f" id)")" "$(topic_n "$f")" "$(json_str "$(topic_get "$f" title)")" "$(json_opt "$(topic_get "$f" description)")" \
        "$(json_str "$st")" "$(json_opt "$wf")" "$( [ -n "$wf" ] && json_num "$(topic_get "$f" waiting_since)" || printf 'null')" "$agent" \
        "$(json_num "$(topic_get "$f" created)")" "$(json_num "$(topic_get "$f" updated)")"
}
cli_show() {  # cli_show <file> [--json]
    local f=$1 id title st wf ws desc ag
    if [ "${2:-}" = --json ]; then [ -n "${T_N:-}" ] || topics_load; topic_json "$f"; printf '\n'; return 0; fi
    id=$(topic_get "$f" id); title=$(topic_get "$f" title); st=$(topic_get "$f" status now); wf=$(topic_get "$f" waiting_for)
    ws=$(topic_get "$f" waiting_since 0); desc=$(topic_get "$f" description); ag=$(topic_get "$f" agent)
    printf '%s\n  status: %s\n  id: %s\n' "$title" "$st" "$id"
    if [ -n "$desc" ]; then printf '  description: %s\n' "$desc"; fi
    if [ -n "$ag" ]; then printf '  agent: %s (%s)\n' "$ag" "$(topic_get "$f" agent_machine)"; fi
    if [ "$st" = waiting ] && [ -n "$wf" ]; then printf '  waiting for: %s (%s)\n' "$wf" "$(ago "$ws")"; fi
    return 0
}
bhote_help() {
    cat <<'HELP'
bhote — topics and agents next to herdr.

  bhote                              the panel
  bhote add <title> [options]        new topic   -d <text> description · @Name or -w Name waiting for Name · -s now|later|done
  bhote list [--all] [-s <status>]   the open topics (--all: also done ones), numbered
  bhote show <ref>                   one topic
  bhote now|later|done <ref>         start or resume · park · mark done
  bhote wait <ref> <Name>            waiting for Name (from now)
  bhote rename <ref> <title>         new title
  bhote desc <ref> [<text>]          new description (at most 140 characters; none = remove it)
  bhote rm <ref>                     delete
  bhote sync                         merge with the data location now
  bhote version · bhote help

Every command takes --json: one topic object (list: an array) as described in docs/cli-reference.md.
<ref> is a number from `bhote list --all`, an id (or its start), or part of the title.
Exit codes: 0 ok · 1 error · 2 the ref matches more than one topic. Messages go to stderr.
Settings: ~/.config/bhote/config (or in the panel: ",").
HELP
}
bhote_cli() {
    local cmd=${1:-} a json="" args=(); shift
    harden_perms
    trap 'rm -rf "$RUN_DIR"' EXIT
    for a in "$@"; do if [ "$a" = --json ]; then json=--json; else args[${#args[@]}]=$a; fi; done   # --json anywhere
    set -- ${args[@]+"${args[@]}"}
    case "$cmd" in
        help|-h|--help) bhote_help ;;
        version|--version|-V) if [ -n "$json" ]; then printf '{"version":%s}\n' "$(json_str "$VERSION")"; else echo "bhote $VERSION"; fi ;;
        add)  local title="" who="" st="" desc="" arg
              while [ $# -gt 0 ]; do
                  case "$1" in
                      --waiting|-w) who=${2:-}; shift ;;
                      --status|-s) st=${2:-}; shift ;;
                      --desc|-d) desc=${2:-}; shift ;;
                      @?*) who=${1#@} ;;
                      *) title="${title:+$title }$1" ;;
                  esac; shift
              done
              [ "${#desc}" -gt "$DESC_MAX" ] && echo "bhote: the description is cut to $DESC_MAX characters" >&2
              topic_new "$title" "$who" "$desc" || { echo "bhote: a title is needed (bhote add <title>)" >&2; return 1; }
              f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"
              case "$st" in now|later|done) topic_set "$f" status "$st" ;; esac
              cli_done; topics_load; cli_show "$f" $json ;;
        list|ls) local all="" only="" i first=1
              while [ $# -gt 0 ]; do case "$1" in --all|-a) all=1 ;; --status|-s) only=${2:-}; shift ;; *) echo "bhote: unknown option '$1' for list" >&2; return 1 ;; esac; shift; done
              case "$only" in ''|now|waiting|later|done) ;; *) echo "bhote: --status is one of now, waiting, later, done" >&2; return 1 ;; esac
              NOW=$(date +%s); topics_load
              [ -n "$json" ] && printf '['
              for (( i = 0; i < T_N; i++ )); do
                  [ -n "$only" ] && [ "${T_STATUS[$i]}" != "$only" ] && continue
                  [ -z "$only" ] && [ -z "$all" ] && [ "${T_STATUS[$i]}" = done ] && continue
                  if [ -n "$json" ]; then
                      [ "$first" = 1 ] || printf ','; first=0
                      topic_json "${T_FILE[$i]}"
                  else
                      printf '%3s  %-8s %s' "$(( i + 1 ))" "${T_STATUS[$i]}" "${T_TITLE[$i]}"
                      if [ "${T_STATUS[$i]}" = waiting ]; then printf '  (%s, %s)' "${T_WFOR[$i]}" "$(ago "${T_WSINCE[$i]:-$NOW}")"; fi
                      printf '\n'
                  fi
              done
              if [ -n "$json" ]; then printf ']\n'; fi; return 0 ;;
        show) local f; f=$(topic_ref "${1:-}") || return $?; topics_load; cli_show "$f" $json ;;
        done|now|later|wait|rename|desc|rm)
              local f ref=${1:-}; [ -n "$ref" ] || { echo "bhote: $cmd needs a topic (number, id or part of the title)" >&2; return 1; }
              f=$(topic_ref "$ref") || return $?; shift
              case "$cmd" in
                  done) topic_set "$f" status done ;;
                  now) topic_set "$f" status now; topic_set "$f" waiting_for "" ;;
                  later) topic_set "$f" status later ;;
                  wait) [ -n "${1:-}" ] || { echo "bhote: wait needs a name (bhote wait <ref> <Name>)" >&2; return 1; }
                        topic_set "$f" status waiting; topic_set "$f" waiting_for "$*"; topic_set "$f" waiting_since "$(date +%s)" ;;
                  rename) [ -n "${1:-}" ] || { echo "bhote: rename needs a title" >&2; return 1; }; topic_set "$f" title "$*" ;;
                  rm) local rid; rid=$(topic_get "$f" id); topic_set "$f" deleted 1 ;;
                  desc) local dd="$*"; [ "${#dd}" -gt "$DESC_MAX" ] && echo "bhote: the description is cut to $DESC_MAX characters" >&2
                        topic_set "$f" description "$*" ;;
              esac
              cli_done
              if [ "$cmd" = rm ]; then if [ -n "$json" ]; then printf '{"deleted":%s}\n' "$(json_str "$rid")"; else echo "deleted"; fi
              else topics_load; cli_show "$f" $json; fi ;;
        sync) local m; m=$(cfg_get STORE_MACHINE '')
              sync_out() { if [ -n "$json" ]; then printf '{"sync":%s,"machine":%s}\n' "$(json_str "$1")" "$(json_opt "$m")"; fi; }
              if [ "$(cfg_get STORE local)" != remote ]; then sync_out local; [ -n "$json" ] || echo "data location is local, nothing to merge"
              else store_sync; case $? in
                  0) sync_out ok; [ -n "$json" ] || echo "in sync with $m" ;;
                  2) sync_out busy; echo "bhote: another sync is running right now, try again in a moment" >&2; return 1 ;;
                  *) sync_out offline; echo "bhote: $m is not reachable, changes stay local" >&2; return 1 ;;
              esac; fi ;;
        *) echo "bhote: unknown command '$cmd' (bhote help)" >&2; return 1 ;;
    esac
}

# BHOTE_SOURCE_ONLY=1 loads the functions without starting the panel (the tests do that).
if [ -n "${BHOTE_SOURCE_ONLY:-}" ]; then :
elif [ $# -gt 0 ]; then bhote_cli "$@"
else bhote_main; fi

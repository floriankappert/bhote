}
store_note() {  # store_note ok|offline|again [KEY=value lines]: the state, when it was last in step, and what the transport adds
    # (kharka: its hub, the writes the hub does not have yet, the last complaint). again: kharka changed during the merge.
    local ok_at tf; ok_at=$(awk -F= '$1 == "ok_at" { print $2 }' "$STORE_STATUS" 2>/dev/null)
    [ "$1" = ok ] && ok_at=$(date +%s)
    tf=$(mktemp "$STORE_STATUS.XXXXXX") || return 1
    { printf 'state=%s\nok_at=%s\n' "$1" "${ok_at:-0}"; if [ -n "${2:-}" ]; then printf '%s\n' "$2"; fi; } > "$tf" && mv "$tf" "$STORE_STATUS"

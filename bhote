#!/usr/bin/env bash
# bhote — start screen: a framed welcome like Claude Code's (name and version in the top edge), a compass over a
# gradient wordmark, then a few lines about where it runs. Truecolor; NO_COLOR=1 prints it plain. Bash 3.2 compatible.
# Palette = the Catppuccin values of the herdr sidebar (teal, blue, mauve, pink, peach); the dog has its own.
# UTF-8 is needed (the frame, the dog, ${#var} counting characters). Only when the current locale is not UTF-8, switch to one
# that is installed (forcing a missing one would drop to the C locale and garble every multibyte character).
case "$(locale charmap 2>/dev/null)" in
    UTF-8|utf8|utf-8) ;;
    *) for _l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
           if locale -a 2>/dev/null | grep -qx "$_l"; then export LC_ALL=$_l; break; fi
       done ;;
esac
umask 077                                                             # everything bhote writes is for this user only
RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bhote.XXXXXX") || exit 1         # private (0700) scratch dir: nothing predictable in /tmp
trap 'rm -rf "$RUN_DIR"' EXIT
# What all panels of this machine share (the agent lists, "a change is waiting", which panel collects): a private folder that
# must belong to this user; if it does not (or cannot be made), every panel keeps to its own scratch dir.
SHARED_DIR=${BHOTE_SHARED:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/bhote-$UID}
if [ -L "$SHARED_DIR" ]; then SHARED_DIR=$RUN_DIR                    # a symlink there is not ours: never follow it (not even chmod)
else
    { [ -d "$SHARED_DIR" ] || mkdir -m 700 "$SHARED_DIR"; } 2>/dev/null
    if [ -d "$SHARED_DIR" ] && [ -O "$SHARED_DIR" ] && [ ! -L "$SHARED_DIR" ]; then chmod 700 "$SHARED_DIR" 2>/dev/null; else SHARED_DIR=$RUN_DIR; fi
fi
SPLASH_W=${BHOTE_WIDTH:-42}       # the start screen's least width; it grows with the pane (see splash_geometry)
WIDTH=$SPLASH_W
VERSION=${BHOTE_VERSION:-0.2.0}
NEWS="Steal & Transfer · see GitHub"   # one line for the welcome screen, e.g. "Steal & Transfer · read more on GitHub" (empty: none)

# ── settings: ~/.config/bhote/config, plain KEY=value lines (never sourced). Everything that reaches beyond this machine
# is OFF until the user switches it on in the settings screen (","): bhote must not open SSH connections unasked.
#   REMOTE_AGENTS=on|off   ask the saved herdr machines for their agents, in the background (default off)
#   MACHINES_OFF=a,b       saved machines that stay out even when REMOTE_AGENTS is on
#   REMOTE_EVERY=10        seconds between two remote queries      LOCAL_EVERY=3   seconds between two local ones
#   TESTS_BUSY=on|off      an agent whose workspace is running tests counts as busy, not free (default off)
#   HOST_LABEL=Name        how this machine is called in the agent lists (default: Mac on macOS, else the host name)
#   NAME_COLORS=a=teal,b=mauve   colour agents by a part of their name (case-insensitive); colours: red teal peach mauve blue green yellow
#   ANIMATION=on|off       the dog blinks and pants (default on)
#   SPLASH_AUTOCLOSE=on|off   the welcome screen closes by itself after SPLASH_SECONDS (default on, 15)
#   AUTOSTART=on|off       the herdr plugin opens the panel next to the agents when herdr starts (default on)
CONFIG_FILE=${BHOTE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bhote/config}
cfg_var() {  # cfg_var <var> <key> <default>: no subshell, no awk (the screen asks a dozen times)
    local _cl _cv=""   # odd names: the caller's target variable must never be shadowed
    if [ -r "$CONFIG_FILE" ]; then while IFS= read -r _cl; do [ "${_cl%%=*}" = "$2" ] && _cv=${_cl#*=}; done < "$CONFIG_FILE"; fi
    printf -v "$1" '%s' "${_cv:-$3}"
}
cfg_get() { cfg_var _CFG "$1" "$2"; printf '%s' "$_CFG"; }
# num_or <value> <default>: digits only, without leading zeros ("08" would be octal in $(( ))), at most 18 digits
num_or() { case "$1" in ''|*[!0-9]*) printf '%s' "$2" ;; *) local _v=${1#"${1%%[!0]*}"}; _v=${_v:-0}; [ "${#_v}" -le 18 ] || _v=$2; printf '%s' "$_v" ;; esac; }
num_set() {  # the same into a variable (no subshell)
    case "$2" in ''|*[!0-9]*) printf -v "$1" '%s' "$3" ;; *) local _v=${2#"${2%%[!0]*}"}; _v=${_v:-0}; [ "${#_v}" -le 18 ] || _v=$3; printf -v "$1" '%s' "$_v" ;; esac
}
# Every value that ends up in $(( )) must be plain digits first: bash expands a[$(cmd)] inside arithmetic and would RUN cmd.
cfg_set() {  # cfg_set KEY value [KEY value ...]: one rewrite, one mv (a value never contains a control character: it could add a line)
    local tmp line k keep a i=0 o
    mkdir -p "$(dirname "$CONFIG_FILE")"
    while ! ln -s "$$" "$CONFIG_FILE.lock" 2>/dev/null; do        # one writer at a time (the panel, the CLI, the wizard)
        o=$(readlink "$CONFIG_FILE.lock" 2>/dev/null); [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null && rm -f "$CONFIG_FILE.lock"
        i=$(( i + 1 )); [ "$i" -gt 40 ] && break; sleep 0.05
    done
    tmp=$(mktemp "$CONFIG_FILE.XXXXXX") || { rm -f "$CONFIG_FILE.lock"; return 1; }
    { if [ -r "$CONFIG_FILE" ]; then while IFS= read -r line; do
          k=${line%%=*}; keep=1
          for (( a = 1; a <= $#; a += 2 )); do [ "$k" = "${!a}" ] && keep=0; done
          [ "$keep" = 1 ] && printf '%s\n' "$line"
      done < "$CONFIG_FILE"; fi
      while [ $# -ge 2 ]; do printf '%s=%s\n' "$1" "${2//[[:cntrl:]]/}"; shift 2; done
    } > "$tmp" && mv "$tmp" "$CONFIG_FILE"
    [ "$(readlink "$CONFIG_FILE.lock" 2>/dev/null)" = "$$" ] && rm -f "$CONFIG_FILE.lock"
}
# Every setting: KEY|default|type|description. Types: bool (on/off), int:min:max, enum:a:b, text, list (comma-separated).
# The panel, `bhote config` and docs/configuration.md all follow this table; a value that does not fit is refused.
SETTINGS='SETUP_DONE||text|When the setup wizard ran on this machine (empty: it opens at the next start)
STORE|local|enum:local:remote|Where the topics are kept: local, or a replica on STORE_MACHINE
STORE_MACHINE||text|The saved herdr machine that holds the replica (herdr machine list)
SYNC_VIA|herdr|enum:herdr:ssh|How topics travel: herdr (its saved machine; each side pulls from the other) or plain ssh
PUSH_STATES|on|bool|When an agent here changes its state, tell the other machines at once (through herdr), so that their panels show it within a second (only with REMOTE_AGENTS on)
REMOTE_AGENTS|off|bool|Also list the agents of the saved herdr machines (opens ssh connections)
MACHINES_OFF||list|Saved machines that stay out even with REMOTE_AGENTS=on
PANEL_MIN_WIDTH|36|int:30:200|The narrowest the panel pane may get in herdr (columns); a narrower one is widened again (the agent keeps 40)
PANEL_MAX_WIDTH|60|int:30:300|The widest the panel pane may get in herdr (columns); a wider one is narrowed again
LOCAL_EVERY|3|int:1:3600|Seconds between two queries of the agents of this machine
REMOTE_EVERY|5|int:1:3600|Seconds between two queries of the other machines and the regular merge
TESTS_BUSY|off|bool|An agent whose workspace runs tests counts as busy
AUTO_ASSIGN|off|bool|A running (now) topic without an agent goes to the next free agent by itself, 20 s after its last change
AUTO_ASSIGN_MACHINE|any|text|Whose free agents auto-assign tries first: any (this machine first) or a machine label
AGENT_CAN_CLOSE|on|bool|An agent may close its topic itself (bhote done); off: it can only hand it over for review
NOTIFY|on|bool|herdr notifications: a topic is ready, done, or waits too long
WAIT_REMIND|24|int:0:720|Hours after which a waiting topic is reminded (0 = never)
THEME|terminal|enum:terminal:catppuccin|Colours: terminal (follows the terminal and system theme) or catppuccin (exact colours)
ANIMATION|on|bool|The dog on the welcome screen blinks and pants
SPLASH_AUTOCLOSE|on|bool|The welcome screen closes by itself
SPLASH_SECONDS|15|int:1:600|Seconds until the welcome screen closes itself
AUTOSTART|on|bool|The herdr plugin opens the panel next to the agents when herdr starts
FIND_KEY||text|The herdr key that opens the search popup: find a topic or an agent and jump to it (e.g. ctrl+alt+t; off removes it)
JUMP_KEY||text|The herdr key that jumps between the agent and this panel (e.g. prefix+t; off removes it); written into the herdr config.toml
AGENT_ROWS||int:1:200|Height of the agent area in rows (empty: automatic)
DONE_MAX|7|int:0:999|Done topics shown before +n more
HOST_LABEL||text|How this machine is called in agent lists (default: Mac on macOS, else the host name)
NAME_COLORS||text|Colour agents by part of their name: api=teal,web=mauve
COLOR_TEXT||color|Override: text (#rrggbb)
COLOR_DIM||color|Override: dim text
COLOR_FRAME||color|Override: lines and frames
COLOR_SELECTION||color|Override: the background of the selected row
COLOR_ACCENT||color|Override: accent (teal)
COLOR_NOW||color|Override: running topics, busy agents, the prompt
COLOR_WAITING||color|Override: waiting topics
COLOR_REVIEW||color|Override: topics ready for review
COLOR_LATER||color|Override: parked topics
COLOR_DONE||color|Override: done topics, free agents
COLOR_ERROR||color|Override: blocked agents, errors'
setting_row() {  # setting_row <KEY>: sets S_DEF, S_TYPE, S_DESC; 1 when the key is unknown
    local line; S_DEF=""; S_TYPE=""; S_DESC=""
    while IFS= read -r line; do
        [ "${line%%|*}" = "$1" ] || continue
        line=${line#*|}; S_DEF=${line%%|*}; line=${line#*|}; S_TYPE=${line%%|*}; S_DESC=${line#*|}; return 0
    done <<< "$SETTINGS"
    return 1
}
setting_check() {  # setting_check <KEY> <value>: 0 when the value fits the key's type (an empty value = back to the default)
    local v=$2 t lo hi opts; setting_row "$1" || { echo "bhote: unknown setting '$1' (bhote config list)" >&2; return 1; }
    [ -z "$v" ] && return 0
    case "$v" in *[[:cntrl:]]*) echo "bhote: no control characters in a value" >&2; return 1 ;; esac
    t=$S_TYPE
    case "$t" in
        bool) case "$v" in on|off) return 0 ;; esac; echo "bhote: $1 is on or off" >&2; return 1 ;;
        int:*) lo=${t#int:}; hi=${lo#*:}; lo=${lo%%:*}
               case "$v" in *[!0-9]*) ;; *) [ "${#v}" -le 6 ] && [ "$v" -ge "$lo" ] && [ "$v" -le "$hi" ] && return 0 ;; esac
               echo "bhote: $1 is a whole number from $lo to $hi" >&2; return 1 ;;
        enum:*) opts=":${t#enum:}:"; case "$opts" in *":$v:"*) return 0 ;; esac
                echo "bhote: $1 is one of: $(printf '%s' "${t#enum:}" | tr ':' ' ')" >&2; return 1 ;;
        color) hex_rgb "$v" >/dev/null && return 0; echo "bhote: $1 is a colour like #89b4fa" >&2; return 1 ;;
        *) [ "${#v}" -le 500 ] && return 0; echo "bhote: $1 is at most 500 characters" >&2; return 1 ;;
    esac
}
machine_wanted() {  # machine_wanted <label>: remote queries on, and this machine not switched off
    [ "$(cfg_get REMOTE_AGENTS off)" = on ] || return 1
    case ",$(cfg_get MACHINES_OFF ''),"  in *",$1,"*) return 1 ;; esac
    return 0
}

# ── topics: one small KEY=value file per topic (id, title, status now|waiting|later|done, waiting_for, waiting_since,
# created, updated, deleted). The LOCAL copy is always the working copy: it is read and written, also when the chosen data
# location is a saved machine (STORE=remote, STORE_MACHINE=<label>). That machine holds a replica which is merged in the
# background whenever it can be reached; while it cannot, bhote simply keeps working locally ("offline") and the changes
# wait. Merging is per topic, the newer `updated` wins (a deleted topic stays as a tombstone with deleted=1 so that the
# deletion travels, too). BHOTE_SSH replaces ssh (the tests use a fake one); BHOTE_REMOTE_DIR the folder on the machine.
DATA_DIR=${BHOTE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/bhote}
TOPIC_DIR=$DATA_DIR/topics
REMOTE_TOPIC_DIR=${BHOTE_REMOTE_DIR:-.local/share/bhote/topics}      # relative to the remote home
STORE_STATUS="$DATA_DIR/store.status"                                 # state=ok|offline, ok_at=<epoch>; shared by all panels
STORE_DIRTY="$SHARED_DIR/dirty"                          # touched by every local change: sync at once
store_ssh() { local host=$1; shift; case "$host" in ''|-*|*[!A-Za-z0-9._@:%-]*) return 1 ;; esac   # never an option, never odd characters
    "${BHOTE_SSH:-ssh}" -o BatchMode=yes -o ConnectTimeout=4 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$host" "$@"; }
# The remote LOGIN shell may be zsh or fish: an empty glob aborts a zsh command line. So every remote script goes to
# `sh -c` as one safely quoted word, and does not depend on what the login shell would make of it.
store_sh() { local host=$1 script=$2; store_ssh "$host" "sh -c $(printf '%q' "$script")"; }
store_host() {  # store_host <saved machine label> -> its ssh target
    herdr machine list 2>/dev/null | awk -F'\t' -v l="$1" '$2 == l { print $3; exit }'
}
store_note() {  # store_note ok|offline
    local ok_at; ok_at=$(awk -F= '$1 == "ok_at" { print $2 }' "$STORE_STATUS" 2>/dev/null)
    [ "$1" = ok ] && ok_at=$(date +%s)
    printf 'state=%s\nok_at=%s\n' "$1" "${ok_at:-0}" > "$STORE_STATUS"
}
topic_id() { local _b=${1##*/}; printf '%s' "${_b%.topic}"; }   # the id IS the file name (checked: [A-Za-z0-9_-]); never trust an id= line
topic_get() {  # topic_get <file> <key> [default]
    local line v=""
    [ -f "$1" ] || { printf '%s' "$3"; return; }
    while IFS= read -r line; do [ "${line%%=*}" = "$2" ] && { v=${line#*=}; break; }; done < "$1"
    case "$v" in *[[:cntrl:]]*) v=${v//[[:cntrl:]]/} ;; esac      # a topic may come from another machine: never print its escape codes
    printf '%s' "${v:-$3}"
}
DESC_MAX=140                                                          # a description is a short note, not a document
topic_set() {  # topic_set <file> <key> <value>: also stamps `updated`
    local f=$1 now old v=${3//[[:cntrl:]]/}; now=$(date +%s)      # no control character in a value: a newline would add keys
    [ "$2" = description ] && v=${v:0:$DESC_MAX}
    [ "$2" = title ] && v=${v:0:500}
    old=$(num_or "$(topic_get "$f" updated 0)" 0); [ "$now" -le "$old" ] && now=$(( old + 1 ))   # a change always counts as newer
    local tmp; tmp=$(mktemp "$f.XXXXXX") || return 1           # unique: the collector runs in a subshell with the same $$
    local x='^updated='; [ "$2" = status ] && [ "$v" != now ] && x='^updated=|^transfer_to=|^transfer_to_name=|^transfer_from='
    { grep -v -E -e "^$2=" -e "$x" "$f"; printf '%s=%s\nupdated=%s\n' "$2" "$v" "$now"; } > "$tmp" && mv "$tmp" "$f"
    : > "$STORE_DIRTY"
}
topic_new() {  # topic_new <title> [waiting for] [description]
    mkdir -p "$TOPIC_DIR"
    local now id title status=now since=""; now=$(date +%s); id="$now-$RANDOM"
    title=${1//[[:cntrl:]]/}; title=$(printf '%s' "$title" | sed 's/^ *//; s/ *$//'); set -- "$title" "${2//[[:cntrl:]]/}" "${3//[[:cntrl:]]/}"
    set -- "${1:0:500}" "$2" "${3:0:$DESC_MAX}"
    [ -n "$title" ] || return 1
    [ -n "$2" ] && { status=waiting; since=$now; }
    printf 'id=%s\ntitle=%s\nstatus=%s\nwaiting_for=%s\nwaiting_since=%s\ncreated=%s\nupdated=%s\ndeleted=0\ndescription=%s\n' \
        "$id" "$title" "$status" "$2" "$since" "$now" "$now" "${3:-}" > "$TOPIC_DIR/$id.topic"
    NEW_TOPIC_ID=$id
    : > "$STORE_DIRTY"
}
store_tag() { STORE_TAG_OUT=""; [ "${U_STORE:-}" = remote ] && [ "${U_STORE_STATE:-}" = offline ] && STORE_TAG_OUT=" · offline"; printf '%s' "$STORE_TAG_OUT"; }
# All topics are read ONCE per screen into arrays (pure bash, no subshell per topic: a draw used to start a few awk per topic
# and grew with the square of the count). Order: review, now, next, waiting, later, done; inside a group by file name = by creation.
topics_load() {
    local f line k v id title st wf ws up del desc ag am ap as dl tn seen n=0 a_as a_dl a_tn s i m=0 a_file a_id a_title a_st a_wf a_ws a_up a_desc a_ag a_am a_ap
    for f in "$TOPIC_DIR"/*.topic; do
        [ -f "$f" ] || continue
        title=""; st=now; wf=""; ws=""; up=0; del=0; desc=""; ag=""; am=""; ap=""; as=""; dl=""; tn=""; seen=" "
        while IFS= read -r line; do
            k=${line%%=*}; v=${line#*=}
            case "$seen" in *" $k "*) continue ;; esac; seen="$seen$k "     # the FIRST value counts, everywhere (topic_get does the same)
            case "$k" in title) title=$v ;; status) st=$v ;; waiting_for) wf=$v ;; waiting_since) ws=$v ;; updated) up=$v ;; deleted) del=$v ;; description) desc=$v ;; agent) ag=$v ;; agent_machine) am=$v ;; agent_pane) ap=$v ;; agent_session) as=$v ;; delegated) dl=$v ;; transfer_to_name) tn=$v ;; esac
        done < "$f"
        [ "$del" = 1 ] && continue
        case "$title$wf$desc$ag$am$ap$st" in *[[:cntrl:]]*) title=${title//[[:cntrl:]]/}; wf=${wf//[[:cntrl:]]/}; desc=${desc//[[:cntrl:]]/}; ag=${ag//[[:cntrl:]]/}; am=${am//[[:cntrl:]]/}; ap=${ap//[[:cntrl:]]/}; st=${st//[[:cntrl:]]/} ;; esac
        case "$st" in now|next|waiting|review|later|done) ;; *) st=now ;; esac
        case "$ws" in *[!0-9]*) ws="" ;; esac; case "$up" in ''|*[!0-9]*) up=0 ;; esac
        id=${f##*/}; id=${id%.topic}
        a_file[$n]=$f; a_id[$n]=$id; a_title[$n]=$title; a_st[$n]=$st; a_wf[$n]=$wf; a_ws[$n]=$ws; a_up[$n]=$up; a_desc[$n]=$desc; a_ag[$n]=$ag; a_am[$n]=$am; a_ap[$n]=$ap; a_as[$n]=${as//[!A-Za-z0-9-]/}; a_dl[$n]=${dl//[!0-9]/}; a_tn[$n]=${tn//[[:cntrl:]]/}; n=$(( n + 1 ))
    done
    T_FILE=(); T_ID=(); T_TITLE=(); T_STATUS=(); T_WFOR=(); T_WSINCE=(); T_UPD=(); T_DESC=(); T_AG=(); T_AM=(); T_AP=(); T_AS=(); T_DL=(); T_TN=()
    for s in review now next waiting later done; do             # review first: it waits for you
        for (( i = 0; i < n; i++ )); do
            [ "${a_st[$i]}" = "$s" ] || continue
            T_FILE[$m]=${a_file[$i]}; T_ID[$m]=${a_id[$i]}; T_TITLE[$m]=${a_title[$i]}; T_STATUS[$m]=$s
            T_WFOR[$m]=${a_wf[$i]}; T_WSINCE[$m]=${a_ws[$i]}; T_UPD[$m]=${a_up[$i]}; T_DESC[$m]=${a_desc[$i]}; T_AG[$m]=${a_ag[$i]}; T_AM[$m]=${a_am[$i]}; T_AP[$m]=${a_ap[$i]}; T_AS[$m]=${a_as[$i]}; T_DL[$m]=${a_dl[$i]}; T_TN[$m]=${a_tn[$i]}; m=$(( m + 1 ))
        done
    done
    T_N=$m
}
panel_shows() { case "$1" in now|next|review|waiting) return 0 ;; esac; return 1; }   # the panel lists these; later and done only in search and CLI
sel_index() {  # the index of the selected topic in the arrays (SEL_ID, else the first shown one); needs topics_load first
    local i; SEL_IDX=0
    for (( i = 0; i < T_N; i++ )); do [ "${T_ID[$i]}" = "${SEL_ID:-}" ] && { SEL_IDX=$i; return; }; done
    for (( i = 0; i < T_N; i++ )); do panel_shows "${T_STATUS[$i]}" && { SEL_IDX=$i; return; }; done
}
topics_ordered() { local i; topics_load; for (( i = 0; i < T_N; i++ )); do printf '%s\n' "${T_FILE[$i]}"; done; }
sel_file() { topics_load; sel_index; [ "$T_N" -gt 0 ] && printf '%s' "${T_FILE[$SEL_IDX]}"; }
sel_move() {  # sel_move <+1|-1>: wraps around, like a menu in an old game
    [ -n "${T_N:-}" ] || topics_load; [ "$T_N" -gt 0 ] || return 0   # the arrays of the last frame; ui_load reloads right after
    sel_index; local i=$SEL_IDX k
    for (( k = 0; k < T_N; k++ )); do                          # the next shown one (a parked/done one is skipped)
        i=$(( (i + $1 + T_N) % T_N )); panel_shows "${T_STATUS[$i]}" && break
    done
    panel_shows "${T_STATUS[$i]}" && { SEL_IDX=$i; SEL_ID=${T_ID[$i]}; }
}
topic_files() { topics_ordered; }
topics_count() { topics_load; echo "$T_N"; }
age_set() {  # age_set <var> <epoch>: "now" / "5m" / "3h" / "2d", relative to NOW
    local d t; [ -n "${NOW:-}" ] || NOW=$(date +%s)
    case "$2" in ''|*[!0-9]*) printf -v "$1" '%s' '?'; return ;; esac
    d=$(( NOW - $2 )); [ "$d" -lt 0 ] && d=0
    if [ "$d" -lt 60 ]; then t="now"; elif [ "$d" -lt 3600 ]; then t="$(( d / 60 ))m"; elif [ "$d" -lt 172800 ]; then t="$(( d / 3600 ))h"; else t="$(( d / 86400 ))d"; fi
    printf -v "$1" '%s' "$t"
}
age_text() { age_set _AGE "$1"; printf '%s' "$_AGE"; }
ago_set() { age_set "$1" "$2"; if [ "${!1}" = now ]; then printf -v "$1" '%s' 'just now'; else printf -v "$1" '%s ago' "${!1}"; fi; }   # "3h ago"
ago() { ago_set _AGO "$1"; printf '%s' "$_AGO"; }
store_sync_run() {  # merge the local copy with the replica on the chosen machine. Returns 1 while that machine is unreachable.
    [ "$(cfg_get STORE local)" = remote ] || { rm -f "$STORE_STATUS"; return 0; }
    local label host tmp f l r ok=1 NOW_SYNC via n; NOW_SYNC=$(date +%s)
    label=$(cfg_get STORE_MACHINE ''); host=$(store_host "$label"); cfg_var via SYNC_VIA herdr
    [ -n "$host" ] || { store_note offline; return 1; }        # not a saved herdr machine (both transports need that)
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/bhote.sync.XXXXXX"); mkdir -p "$TOPIC_DIR"
    # 1) everything the machine has: one stream, "@@name" before each file
    # (a newline before every marker: a file without a final newline must not swallow the next one; at most 8 MB are read)
    if [ "$via" = herdr ]; then herdr_dump "$label" 2>/dev/null | head -c 8000001 > "$tmp/dump"
    else store_sh "$host" "umask 077; mkdir -p $REMOTE_TOPIC_DIR && cd $REMOTE_TOPIC_DIR && for f in *.topic; do [ -f \"\$f\" ] && { printf '\\n@@%s\\n' \"\$f\"; cat \"\$f\"; }; done; echo; echo @@END" 2>/dev/null | head -c 8000001 > "$tmp/dump"; fi
    # only a complete dump counts (ssh can die in the middle and still leave a plausible half): it must end with the @@END line
    if [ "$(wc -c < "$tmp/dump")" -gt 8000000 ] || [ "$(tail -n 1 "$tmp/dump")" != "@@END" ]; then
        # through herdr a cut-off dump means: more topics than herdr hands over (64 KB packed); ssh has no such limit
        [ "$via" = herdr ] && [ -s "$tmp/dump" ] && echo "bhote: the topics of $label do not fit through herdr; SYNC_VIA=ssh has no limit" >&2
        rm -rf "$tmp"; store_note offline; return 1
    fi
    # only plain topic names are accepted from the other side: a name like ../../x must never become a path
    mkdir "$tmp/remote"; awk -v d="$tmp/remote" '/^@@/ { if (f != "") close(f); f = ""; if ($0 ~ /^@@[A-Za-z0-9][A-Za-z0-9_-]*\.topic$/) f = d "/" substr($0, 3); next } $0 == "" { next } f != "" { print > f }' "$tmp/dump"
    # a malformed replica file is not taken, and remembered: its local copy must not be pushed over it either (ssh)
    : > "$tmp/rejected"; n=0
    for f in "$tmp/remote"/*.topic; do
        [ -f "$f" ] || continue; n=$(( n + 1 ))
        if [ "$n" -gt 2000 ] || ! topic_valid "$f" "$NOW_SYNC" || [ "$(topic_get "$f" id)" != "$(topic_id "$f")" ]; then
            echo "${f##*/}" >> "$tmp/rejected"; rm -f "$f"
        fi
    done
    [ -s "$tmp/rejected" ] && echo "bhote: $(wc -l < "$tmp/rejected" | tr -d ' ') topic(s) from $label were not taken (malformed, from the future, or too many)" >&2
    # 2) per topic: the newer one wins, in both directions
    { ls "$tmp/remote" 2>/dev/null; ls "$TOPIC_DIR" 2>/dev/null; } | grep -E '^[A-Za-z0-9][A-Za-z0-9_-]*\.topic$' | sort -u > "$tmp/ids"
    while IFS= read -r f; do
        grep -qxF "$f" "$tmp/rejected" 2>/dev/null && continue   # refused from the other side: neither pulled nor pushed
        l=0; r=0
        [ -f "$TOPIC_DIR/$f" ] && l=$(topic_get "$TOPIC_DIR/$f" updated 0)
        [ -f "$tmp/remote/$f" ] && r=$(topic_get "$tmp/remote/$f" updated 0)
        l=$(num_or "$l" 0); r=$(num_or "$r" 0)
        if [ "$r" -gt "$l" ]; then
            local pt; pt=$(mktemp "$TOPIC_DIR/.pull.XXXXXX") || continue
            cp "$tmp/remote/$f" "$pt" || { rm -f "$pt"; continue; }
            # a local change that happened during the dump must not be overwritten
            if [ -f "$TOPIC_DIR/$f" ] && [ "$(num_or "$(topic_get "$TOPIC_DIR/$f" updated 0)" 0)" != "$l" ]; then rm -f "$pt"; continue; fi
            mv "$pt" "$TOPIC_DIR/$f"
        elif [ "$l" -gt "$r" ] && [ "$via" != herdr ]; then     # through herdr the other side pulls by itself: nothing is pushed
            # pushed only when the remote file is still what the dump showed (an edit there in the meantime wins the next round)
            store_sh "$host" "umask 077; f=$REMOTE_TOPIC_DIR/$f; cur=\$(sed -n 's/^updated=//p' \"\$f\" 2>/dev/null | head -1); if [ \"\${cur:-0}\" = $r ]; then cat > \"\$f.tmp\" && mv \"\$f.tmp\" \"\$f\"; else cat >/dev/null; fi" < "$TOPIC_DIR/$f" 2>/dev/null || ok=0
        elif [ "$l" = "$r" ] && [ "$l" != 0 ] && [ -f "$tmp/remote/$f" ] && ! cmp -s "$TOPIC_DIR/$f" "$tmp/remote/$f"; then
            # the same stamp, other contents: both sides decide the same way (the larger checksum wins)
            local cl cr; cl=$(cksum < "$TOPIC_DIR/$f" | cut -d' ' -f1); cr=$(cksum < "$tmp/remote/$f" | cut -d' ' -f1)
            if [ "$cr" -gt "$cl" ]; then cp "$tmp/remote/$f" "$TOPIC_DIR/$f.tmp.$$" && mv "$TOPIC_DIR/$f.tmp.$$" "$TOPIC_DIR/$f"
            elif [ "$via" != herdr ]; then store_sh "$host" "umask 077; cat > $REMOTE_TOPIC_DIR/$f.tmp && mv $REMOTE_TOPIC_DIR/$f.tmp $REMOTE_TOPIC_DIR/$f" < "$TOPIC_DIR/$f" 2>/dev/null || ok=0; fi
        fi
    done < "$tmp/ids"
    rm -rf "$tmp"
    local tomb old=$(( NOW_SYNC - 30 * 86400 ))                 # deletions travel as tombstones; after 30 days both sides have them
    for tomb in $(grep -l '^deleted=1' "$TOPIC_DIR"/*.topic 2>/dev/null); do
        [ "$(num_or "$(topic_get "$tomb" updated 0)" 0)" -lt "$old" ] && rm -f "$tomb"
    done
    if [ "$ok" = 1 ]; then store_note ok; else store_note offline; return 1; fi
}
topics_dump() {  # topics_dump [max bytes]: every topic in one stream, the most recently changed first: "@@name" before each,
    # "@@END" at the end (the merge needs it). With a limit, it stops before that many bytes (only whole topics).
    local max=${1:-0}
    ls "$TOPIC_DIR" 2>/dev/null | grep -E '^[A-Za-z0-9][A-Za-z0-9_-]*\.topic$' | sed "s#^#$TOPIC_DIR/#" > "$RUN_DIR/dumplist" 2>/dev/null
    if [ -s "$RUN_DIR/dumplist" ]; then
        tr '\n' '\0' < "$RUN_DIR/dumplist" | xargs -0 awk -F= '$1 == "updated" && !(FILENAME in u) { u[FILENAME] = $2 + 0 }
            END { for (f in u) print u[f], f } ' 2>/dev/null | sort -rn | cut -d' ' -f2- | tr '\n' '\0' \
            | xargs -0 awk -v max="$max" 'FNR == 1 { if (max > 0 && total > max) exit; n = split(FILENAME, p, "/"); printf "\n@@%s\n", p[n] }
                { print; total += length($0) + 1 }' 2>/dev/null
    fi
    printf '\n@@END\n'
}
# herdr keeps at most 64 KB of an action's output: the dump for herdr travels packed (gzip, base64), about 5 times smaller.
topics_dump_packed() {  # about 10x smaller packed; 400 KB of topics stay well under herdr's 64 KB (the oldest are left out beyond)
    if command -v gzip >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1; then echo "@@GZ"; topics_dump 400000 | gzip -c | base64
    else topics_dump 50000; fi
}
dump_unpack() {  # stdin: a packed or plain dump -> the plain one (a damaged packed dump gives nothing, so the merge sees no @@END)
    local first; IFS= read -r first
    if [ "$first" = "@@GZ" ]; then { base64 -d 2>/dev/null || base64 -D 2>/dev/null; } | gzip -dc 2>/dev/null
    else printf '%s\n' "$first"; cat; fi
}
herdr_dump() {  # herdr_dump <machine label>: the other machine's topics through herdr: its bhote plugin runs `bhote dump`,
    # and herdr keeps the output in that plugin's log, which this machine reads. No ssh of our own.
    # (the newest dump in the log before we ask is the baseline: only a newer one counts. No clocks of two machines compared.)
    local m=$1 i out base q='def lid: (.log_id // "" | tostring | capture("(?<n>[0-9]+)$").n // "0" | tonumber);'
    base=$(herdr --machine "$m" plugin log list --plugin bhote.panel 2>/dev/null | jq -r "$q"' [.result.logs[] | select(.action_id == "dump") | lid] | max // 0' 2>/dev/null)
    base=$(num_or "$base" 0)
    herdr --machine "$m" plugin action invoke dump --plugin bhote.panel >/dev/null 2>&1 || return 1
    for (( i = 0; i < 20; i++ )); do
        out=$(herdr --machine "$m" plugin log list --plugin bhote.panel 2>/dev/null | jq -r --argjson b "$base" "$q"'
            [.result.logs[] | select(.action_id == "dump" and .status == "succeeded" and (lid > $b))] | last | .stdout // empty' 2>/dev/null)
        [ -n "$out" ] && { printf '%s\n' "$out" | dump_unpack; return 0; }
        sleep 0.5
    done
    return 1
}
topic_valid() {  # topic_valid <file> <now>: KEY=value lines only, no key twice, numbers are digits, not from the future, small
    awk -F= -v now="$2" '
        NF < 2 || $1 !~ /^[a-z_]+$/ { bad = 1 }
        seen[$1]++ { bad = 1 }
        ($1 == "updated" || $1 == "created" || $1 == "waiting_since") && $2 !~ /^[0-9]*$/ { bad = 1 }
        ($1 == "updated" || $1 == "created" || $1 == "waiting_since") && $2 != "" && $2 + 0 > now + 300 { bad = 1 }
        length($0) > 4000 || NR > 64 { bad = 1 }
        END { exit bad }' "$1" 2>/dev/null
}
# Locks are symlinks to the pid of their owner: `ln -s` is atomic, so a lock never exists without its owner. A lock whose
# owner is gone is taken over. (Older versions used directories: one of those is removed.)
lock_take() {  # lock_take <path> <pid>: 0 when it is (now) ours
    local o; o=$(readlink "$1" 2>/dev/null)
    [ "$o" = "$2" ] && return 0
    if [ -n "$o" ] && ! kill -0 "$o" 2>/dev/null; then rm -f "$1"; fi
    [ -d "$1" ] && [ ! -L "$1" ] && rm -rf "$1"
    ln -s "$2" "$1" 2>/dev/null
}
lock_drop() { [ "$(readlink "$1" 2>/dev/null)" = "$2" ] && rm -f "$1"; return 0; }   # lock_drop <path> <pid>: only our own
# One sync at a time over all panels of this machine (and the CLI). store_sync returns 2 when another sync is running.
store_sync() {
    local lock=$DATA_DIR/sync.lock rc
    mkdir -p "$DATA_DIR"
    lock_take "$lock" "$$" || return 2
    store_sync_run; rc=$?
    lock_drop "$lock" "$$"
    return $rc
}
store_summary() {  # one line for the settings screen: where the data lives and whether it is in step
    local label st ok_at pending f n=0
    if [ "$(cfg_get STORE local)" != remote ]; then printf 'local only (%s)' "${TOPIC_DIR/#$HOME/~}"; return; fi
    label=$(cfg_get STORE_MACHINE '?')
    st=$(awk -F= '$1 == "state" { print $2 }' "$STORE_STATUS" 2>/dev/null); ok_at=$(num_or "$(awk -F= '$1 == "ok_at" { print $2 }' "$STORE_STATUS" 2>/dev/null)" 0)
    case "$st" in
        ok) printf 'in sync with %s (%s)%s' "$label" "$(ago "$ok_at")" "$([ "$(cfg_get SYNC_VIA herdr)" = herdr ] && printf ' through herdr; %s should pull from here too' "$label")" ;;
        offline) for f in "$TOPIC_DIR"/*.topic; do [ -f "$f" ] && [ "$(num_or "$(topic_get "$f" updated 0)" 0)" -gt "$ok_at" ] && n=$(( n + 1 )); done
                 printf 'OFFLINE: saving locally, %s change(s) wait for %s' "$n" "$label" ;;
        *) printf 'connecting to %s ...' "$label" ;;
    esac
}


topic_set() {  # topic_set <file> <key> <value>: also stamps `updated`
    local f=$1 now old v=${3//[[:cntrl:]]/}; now=$(date +%s)      # no control character in a value: a newline would add keys
    [ "$2" = description ] && v=${v:0:$DESC_MAX}
    [ "$2" = title ] && v=${v:0:500}
    if [ "$2" = status ] && [ "$v" != done ] && [ "$(topic_get "$f" status)" = done ]; then    # taken up again: the description says so (an agent given it knows it existed)
        local dsc pre; dsc=$(topic_get "$f" description); pre="Reopened $(date +%Y-%m-%d)."
        case "$dsc" in "Reopened "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*) dsc=${dsc#Reopened ????-??-??}; dsc=${dsc#.}; dsc=${dsc# } ;; esac
        topic_set "$f" description "$pre${dsc:+ $dsc}"
    fi
    local locked=0; topic_lock "$f" && locked=1                  # (without it after the wait: written anyway, as before)
    old=$(num_or "$(topic_get "$f" updated 0)" 0); [ "$now" -le "$old" ] && now=$(( old + 1 ))   # a change always counts as newer
    local tmp rc=1; tmp=$(mktemp "$f.XXXXXX")                    # unique: the collector runs in a subshell with the same $$
    if [ -n "$tmp" ]; then

store_cycle() {  # step the data location through: local, kharka (when it is installed), then every saved machine (→ / space forward, ← back)
    local opts=(local) id label host prof enabled cur i n k=$1 dir=1
    kharka_found && opts[${#opts[@]}]="kharka"
    while IFS=$US read -r id label host prof enabled; do label=${label//[[:cntrl:]]/}; [ -n "$label" ] && [ "$label" != kharka ] && opts[${#opts[@]}]="$label"; done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
    cur=$(store_place)
    n=${#opts[@]}; [ "$k" = LEFT ] && dir=$(( n - 1 ))
    for (( i = 0; i < n; i++ )); do [ "${opts[$i]}" = "$cur" ] && break; done
    i=$(( (i + dir) % n ))
    case "${opts[$i]}" in local) cfg_set STORE local ;; kharka) cfg_set STORE kharka ;; *) cfg_set STORE remote STORE_MACHINE "${opts[$i]}" ;; esac
    : > "$STORE_DIRTY"
}
settings_key() {  # settings_key <key as read>  (an arrow arrives as ESC [ A/B/C/D)
    local k=$1 n=${#SET_ROWS[@]} row kind key cur v off
    settings_rows; n=${#SET_ROWS[@]}
    case "$k" in
        UP|k) SET_IDX=$(( (${SET_IDX:-0} + n - 1) % n )) ;;
        DOWN|j) SET_IDX=$(( (${SET_IDX:-0} + 1) % n )) ;;
        " "|ENTER|LEFT|RIGHT) row=${SET_ROWS[${SET_IDX:-0}]}; kind=${row%%|*}; row=${row#*|}; key=${row%%|*}
            if [ "$kind" = choice ]; then store_cycle "$k"; return; fi
            if [ "$kind" = num ]; then                               # ← → change it; space and Enter do nothing here
                [ "$k" = LEFT ] || [ "$k" = RIGHT ] || return
                setting_row "$key"; local lo=${S_TYPE#int:}; lo=${lo%%:*}
                v=$(num_or "$(cfg_get "$key" "$S_DEF")" "$S_DEF")
                if [ "$k" = RIGHT ]; then v=$(( v + 1 )); else v=$(( v > lo ? v - 1 : lo )); fi
                setting_check "$key" "$v" 2>/dev/null && cfg_set "$key" "$v"; return
            fi
            if [ "$kind" = key ]; then                               # ⏎ / space: type a new key (herdr's syntax)
                [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                local cur_raw fn=jump_key_apply; focus_key_set FOCUS_KEY; cur_raw=${FOCUS_KEY_RAW:-prefix+t}
                if [ "$key" = FIND_KEY ]; then fn=find_key_apply; cfg_var cur_raw FIND_KEY off; [ "$cur_raw" = off ] && cur_raw=ctrl+alt+t; fi
                if ask "herdr key (prefix+t, ctrl+alt+t, off): " "$cur_raw" 40 && [ -n "$ANSWER" ]; then
                    KEY_MSG_FOR=$key
                    if "$fn" "$ANSWER" 2> "$RUN_DIR/jkerr"; then
                        KEY_MSG="Saved: $([ "$key" = FIND_KEY ] && printf '%s' "${FIND_KEY_SHOW:-off}" || printf '%s' "${FOCUS_KEY:-off}"). herdr has it now."
                    else KEY_MSG=$(head -1 "$RUN_DIR/jkerr"); KEY_MSG=${KEY_MSG#bhote: }; KEY_MSG="Not changed: ${KEY_MSG:-herdr refused it}"; fi
                fi
                return
            fi
            if [ "$kind" = prefer ]; then                            # any, this machine, the saved machines (← → or space)
                local opts=(any "$HOST") lb2 n2 cur3 i2 _id _h _p _e
                while IFS=$US read -r _id lb2 _h _p _e; do lb2=${lb2//[[:cntrl:]]/}; [ -n "$lb2" ] && [ "$lb2" != "$HOST" ] && opts[${#opts[@]}]=$lb2; done <<< "$(herdr machine list 2>/dev/null | tr '\t' '\037')"
                cfg_var cur3 "$key" any; n2=${#opts[@]}
                for (( i2 = 0; i2 < n2; i2++ )); do [ "${opts[$i2]}" = "$cur3" ] && break; done; [ "$i2" -ge "$n2" ] && i2=0
                if [ "$k" = LEFT ]; then i2=$(( (i2 + n2 - 1) % n2 )); else i2=$(( (i2 + 1) % n2 )); fi
                cfg_set "$key" "${opts[$i2]}"; [ "$key" = HERDR_KEYS_MACHINE ] && focus_key_set FOCUS_KEY; return
            fi
            if [ "$kind" = link ]; then [ "$k" = LEFT ] || case "$key" in SETUP) SETTINGS_GO=setup ;; CONNECTIONS) SETTINGS_GO=connections ;; PROJECTS) SETTINGS_GO=projects ;; *) SETTINGS_GO=hotkeys ;; esac; return; fi
            case "$kind" in
                info) return ;;
                secret) [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                      if ask "CircleCI token (empty: remove it from the config): " "" 200; then
                          if setting_check "$key" "$ANSWER" 2>/dev/null; then cfg_set "$key" "${ANSWER//[!A-Za-z0-9_-]/}"; fi
                      fi; return ;;
                text) [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                      local tv; setting_row "$key"; cfg_var tv "$key" "$S_DEF"
                      ask "${row#*|}: " "$tv" 200 && setting_check "$key" "$ANSWER" 2>/dev/null && cfg_set "$key" "$ANSWER"; return ;;
                pci) [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                      MON_MSG="Looking at the repository ..."
                      if monitor_detect_save "$TOPIC_DIR/$SET_PROJ.topic"; then MON_MSG="Found: $(monitor_describe "$TOPIC_DIR/$SET_PROJ.topic")."
                      else MON_MSG="Not found: ${MD_WHY:-no CI}."; fi; return ;;
                ptext) [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                      local pf5="$TOPIC_DIR/$SET_PROJ.topic"
                      ask "${row#*|} (empty: auto): " "$(topic_get "$pf5" "$key")" 300 && { topic_set "$pf5" "$key" "${ANSWER//[[:cntrl:]]/}"; : > "$STORE_DIRTY"; }; return ;;
                mcode) [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                      local mcur; machine_codes_load; machine_code_set mcur "$key"; MC_MSG_FOR=$key
                      if ask "Code of $key (3 letters, empty = from the name): " "$mcur" 3; then
                          if machine_code_save "$key" "$ANSWER" 2> "$RUN_DIR/mcerr"; then machine_codes_load; machine_code_set mcur "$key"; MC_MSG="Saved: $mcur, on every machine (with the topics)."
                          else MC_MSG=$(head -1 "$RUN_DIR/mcerr"); MC_MSG="Not changed: ${MC_MSG#bhote: }"; fi
                      fi; return ;;
                projrow) [ "$k" = LEFT ] || { SET_PROJ=$key; SETTINGS_GO=project; }; return ;;
                projnew) [ "$k" = LEFT ] && return; ask "New project: " || return; [ -n "$ANSWER" ] && project_new "$ANSWER"; return ;;
                pact) [ "$k" = LEFT ] && return; local pf3="$TOPIC_DIR/$SET_PROJ.topic"
                      if [ "$key" = rename ]; then ask "Name: " "$(topic_get "$pf3" title)" && [ -n "$ANSWER" ] && topic_set "$pf3" title "$ANSWER"
                      else ask "Delete \"$(topic_get "$pf3" title)\"? y/N: " && case "$ANSWER" in y|Y) topic_set "$pf3" deleted 1; SETTINGS_GO=projects ;; esac; fi
                      return ;;
                pagent) [ "$k" = LEFT ] || [ "$k" = RIGHT ] && return
                      local pm3=${key%%$US*} pp3=${key#*$US} pf4="$TOPIC_DIR/$SET_PROJ.topic" an3=${row#*|}; an3=${an3%% · *}
                      agent_meta "$pm3" "$pp3"
                      if [ -n "$AM_REPO" ]; then local rl; rl=$(topic_get "$pf4" repos)
                          if list_has "$rl" "$AM_REPO"; then topic_set "$pf4" repos "$(list_del "$rl" "$AM_REPO")"; else topic_set "$pf4" repos "$(list_add "$rl" "$AM_REPO")"; fi
                      else local wl; wl=$(topic_get "$pf4" workspaces)
                          if list_has "$wl" "$an3"; then topic_set "$pf4" workspaces "$(list_del "$wl" "$an3")"; else topic_set "$pf4" workspaces "$(list_add "$wl" "$an3")"; fi
                      fi; return ;;
            esac
            if [ "$kind" = enum ]; then                              # step through the allowed values
                setting_row "$key"; local vals cur2 nxt="" prev="" first="" last="" found=0 x IFS=:
                vals=${S_TYPE#enum:}; cfg_var cur2 "$key" "$S_DEF"
                for x in $vals; do [ -z "$first" ] && first=$x; [ "$found" = 1 ] && [ -z "$nxt" ] && nxt=$x; [ "$x" = "$cur2" ] && { found=1; prev=$last; }; last=$x; done
                unset IFS; [ -z "$nxt" ] && nxt=$first; [ -z "$prev" ] && prev=$last
                if [ "$k" = LEFT ]; then cfg_set "$key" "$prev"; else cfg_set "$key" "$nxt"; fi; : > "$STORE_DIRTY"; return
            fi
            [ "$k" = LEFT ] || [ "$k" = RIGHT ] || case "$kind" in
                bool|sbool) setting_row "$key"; cur=${S_DEF:-off}
                      [ "$(cfg_get "$key" $cur)" = on ] && cfg_set "$key" off || cfg_set "$key" on ;;
                machine) off=$(cfg_get MACHINES_OFF '')
                      case ",$off,"  in
                          *",$key,"*) local x out="" IFS=,; for x in $off; do [ "$x" = "$key" ] || out=${out:+$out,}$x; done; unset IFS
                                      cfg_set MACHINES_OFF "$out" ;;
                          *) cfg_set MACHINES_OFF "${off:+$off,}$key" ;;
                      esac ;;
            esac ;;
    esac
}

# ── the animation. A background ticker only DECIDES which picture is due (eyes open or closed, tongue out or in) and tells
# the main loop with USR1; the main loop is the only one that writes to the screen, so two writers can never mix their
# escape sequences. It redraws just the dog, at an absolute position, so nothing flickers.
ANIM_FILE="$RUN_DIR/anim"
SPIN_FRAMES=("·" "✢" "✳" "✶" "✻" "✽" "✻" "✶" "✳" "✢")       # Claude Code's spinner, there and back
spin_cells() {  # SPIN_CELLS = "row:col ..." of the busy agents' icons in the frame just drawn (from the agent map)
    local div split line r l rr rest st; SPIN_CELLS=""
    { read -r div < "$RUN_DIR/divrow"; } 2>/dev/null; num_set div "${div:-}" 0; [ "$div" -gt 0 ] || return 0
    { IFS= read -r split; split=$(num_or "$split" 0)
      while IFS=$'\036' read -r r l rr; do
          for line in "l:$l" "r:$rr"; do
              rest=${line#?:}; [ -n "$rest" ] || continue; st=${rest##*$US}
              case "$st" in working|testing) ;; *) continue ;; esac
              if [ "${line%%:*}" = l ]; then SPIN_CELLS="$SPIN_CELLS $(( div + 1 + r )):3"; else SPIN_CELLS="$SPIN_CELLS $(( div + 1 + r )):$(( split + 1 ))"; fi
          done
      done; } 2>/dev/null < "$RUN_DIR/agmap"
}
dog_ticker() {  # dog_ticker <main pid>
    local tick=0 closed tin idx last="" blink bl_last=""
    while true; do
        if [ ! -e "$RUN_DIR/anim.want" ]; then sleep 1; kill -0 "$1" 2>/dev/null || exit 0; continue; fi   # nothing to animate (the main loop says when)
        sleep 0.3; tick=$(( tick + 1 ))
        kill -0 "$1" 2>/dev/null || exit 0
        blink=on; [ $(( (tick / 2) % 2 )) -eq 1 ] && blink=off
        closed=0; [ $(( RANDOM % 14 )) -eq 0 ] && closed=1
        tin=0; [ $(( tick % 9 )) -ge 6 ] && tin=1
        idx=$(( closed + 2 * tin ))
        [ "$idx $blink $tick" = "$last" ] && continue           # (the tick: the star of the busy agents dances on every one)
        last="$idx $blink $tick"; echo "$idx $blink $tick" > "$ANIM_FILE"; kill -USR1 "$1" 2>/dev/null || exit 0
    done
}
dog_animate() {  # the main loop's answer to USR1 (only on the splash and the list); draws only what changed
    local idx blink tick c
    [ "$TOO_SMALL" = 1 ] && return 0
    [ "$1" = splash ] && ! splash_fits && return 0
    { read -r idx blink tick < "$ANIM_FILE"; } 2>/dev/null || { idx=0; blink=on; tick=0; }
    case "$1" in
        splash) if [ "$idx" != "${DRAWN_IDX:-}" ]; then DOG_IDX=$idx; dog_at $(( 4 + SG0 )) $(( 2 + (WIDTH - 2 - DOG_W) / 2 )); DRAWN_IDX=$idx; fi
                if [ "$blink" != "${DRAWN_BLINK:-}" ]; then splash_prompt_at "$blink"; DRAWN_BLINK=$blink; fi ;;
        main) [ -n "${SPIN_CELLS:-}" ] || return 0               # the busy agents' star, like Claude's: only its cells are drawn
              num_set tick "$tick" 0; SPIN_CH=${SPIN_FRAMES[$(( tick % ${#SPIN_FRAMES[@]} ))]}
              for c in $SPIN_CELLS; do printf '\033[%d;%dH%s%s%s' "${c%%:*}" "${c#*:}" "$ORANGE" "$SPIN_CH" "$X"; done ;;
    esac
}

# Is another byte waiting on the terminal within a few milliseconds? bash 4+ can wait 0.05 s itself; bash 3.2 (macOS) only knows
# whole seconds, so it asks perl. (A lone Esc used to wait a full second for a byte that never came.)
HAVE_PERL=""; command -v perl >/dev/null 2>&1 && HAVE_PERL=1
# Input comes through INBUF: one wait takes everything that is there at once (a held arrow key, a drag, fast typing), in ONE
# perl call on bash 3.2 (it waits whole seconds only); the keys are then taken from the buffer without starting anything.
INBUF=""
in_fill() {  # in_fill <seconds | wait>: waits for input, then puts all that is there into INBUF; 1 = nothing came in time
    local h c t=$1
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
        if [ "$t" = wait ]; then IFS= read -rsn1 -d '' c </dev/tty || return 1; else IFS= read -rsn1 -d '' -t "$t" c </dev/tty 2>/dev/null || return 1; fi
        INBUF+=$c; while IFS= read -rsn1 -d '' -t 0.005 c </dev/tty 2>/dev/null; do INBUF+=$c; done; return 0
    fi
    if [ -n "$HAVE_PERL" ]; then
        h=$(perl -e 'use IO::Select; my $t = shift; my $s = IO::Select->new(\*STDIN);
            exit 1 unless ($t eq "wait" ? $s->can_read() : $s->can_read($t));
            my $b = ""; while (1) { my $n = sysread(STDIN, my $c, 4096); last unless $n; $b .= $c; last unless $s->can_read(0.003); }
            exit 1 unless length $b; print map { sprintf("\\x%02x", ord) } split //, $b' "$t" </dev/tty 2>/dev/null) || return 1
        printf -v h '%b' "$h"; INBUF="$INBUF$h"; return 0
    fi
    if [ "$t" = wait ]; then IFS= read -rsn1 -d '' c </dev/tty || return 1      # (no perl: whole seconds)
    else t=${t%.*}; [ "${t:-0}" -ge 1 ] 2>/dev/null || t=1; IFS= read -rsn1 -d '' -t "$t" c </dev/tty 2>/dev/null || return 1; fi
    INBUF="$INBUF$c"
}
in_get() {  # in_get <var> [seconds]: the next character (Enter reads as empty, like read); without seconds it waits; 1 = none
    if [ -z "$INBUF" ]; then in_fill "${2:-wait}" || { printf -v "$1" '%s' ""; return 1; }; fi
    local _c=${INBUF:0:1}; INBUF=${INBUF:1}
    case "$_c" in $'\n'|$'\r') _c="" ;; esac
    printf -v "$1" '%s' "$_c"; return 0
}
input_pending() {  # 0 when a key (or a mouse report) is already waiting: then it is handled first and the screen drawn once after
    [ -n "$INBUF" ] && return 0
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then read -t 0 </dev/tty 2>/dev/null
    elif [ -n "$HAVE_PERL" ]; then perl -MIO::Select -e 'exit(IO::Select->new(\*STDIN)->can_read(0) ? 0 : 1)' </dev/tty 2>/dev/null
    else return 1; fi
}
read_soon() {  # read_soon <var>: one more character if it is there within ~50 ms (the rest of an escape sequence), else empty (rc 1)
    in_get "$1" 0.05
}
ask_drain() {  # throw away input that is still waiting (the rest of a multi-line paste): it must not turn into commands
    local _j; INBUF=""
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then while IFS= read -rsn1 -t 0.05 _j </dev/tty 2>/dev/null; do :; done
    elif [ -n "$HAVE_PERL" ]; then
        perl -MIO::Select -e '$s = IO::Select->new(\*STDIN); while ($s->can_read(0.05)) { sysread(STDIN, $b, 4096) or last }' </dev/tty 2>/dev/null
    fi
    return 0
}
# The divider above the agents is a handle like herdr's sidebar split: press on it, drag, release. Its row is written by the frame
# (bhote_view runs in a subshell, so it leaves it in a file); the agent area's height is kept as AGENT_ROWS in the config.
MOUSE_ON=$'\033[?1003h\033[?1006h'; MOUSE_OFF=$'\033[?1003l\033[?1006l'; DRAG=0; DRAG_ROWS=""; HOVER_ID=""   # (1003: also motion without a button, for the hover on the cards)
# Terminals report presses, not double clicks: a second press on the same topic within half a second is one (OPEN: its page).
# Milliseconds from perl (bash 3.2 has no EPOCHREALTIME); without perl only two presses in the same second count.
CLICK_LAST=""; CLICK_AT=0
click_twice() {  # click_twice <topic id>: 0 when this press makes a double click on that topic
    local now=""; [ -n "$HAVE_PERL" ] && now=$(perl -MTime::HiRes=time -e 'printf "%d", time() * 1000' 2>/dev/null)
    num_set now "$now" $(( SECONDS * 1000 ))
    if [ "$1" = "$CLICK_LAST" ] && [ $(( now - CLICK_AT )) -le 500 ]; then CLICK_LAST=""; return 0; fi
    CLICK_LAST=$1; CLICK_AT=$now; return 1
}
mouse_event() {  # mouse_event <b;x;y> <M|m>: sets MOUSE_KEY (DRAG while the divider moves, ITEM/AGENT/TOPIC/OPEN on a click, else empty)
    local b x y div rest; MOUSE_KEY=""
    b=${1%%;*}; rest=${1#*;}; x=${rest%%;*}; y=${rest#*;}
    case "$b$x$y" in *[!0-9]*) return ;; esac
    case "$b" in 64|65|66|67) return ;; esac                 # the wheel does nothing (it must not move the selection)
    if [ "$b" = 35 ]; then                                    # the pointer moves over the panel: the card under it is hovered (HOVER when that changed)
        local hr ht hid="" hd; hd=$(cat "$RUN_DIR/divrow" 2>/dev/null); hd=$(num_or "$hd" 0)
        if [ "$hd" = 0 ] || [ "$y" -lt "$hd" ]; then
            while IFS=$'\036' read -r hr ht; do [ "$hr" = "$y" ] && { hid=${ht%%!*}; break; }; done 2>/dev/null < "$RUN_DIR/tmap"   # (a button row's ref is <id>!<from>!<to>)
        fi
        [ "$hid" = "$HOVER_ID" ] || { HOVER_ID=$hid; MOUSE_KEY=HOVER; }
        return
    fi
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$DRAG" != 1 ]; then  # a row of this frame that bhote_paint noted (an action on the topic's page)?
        local r t; while IFS=$'\036' read -r r t; do [ "$r" = "$y" ] && { CLICK_I=$t; MOUSE_KEY=ITEM; return; }; done 2>/dev/null < "$RUN_DIR/pmap"
    fi
    div=$(cat "$RUN_DIR/divrow" 2>/dev/null); div=$(num_or "$div" 0)
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$DRAG" != 1 ] && [ "$div" -gt 0 ] && [ "$y" -ge $(( div + 1 )) ]; then   # below the divider: an agent?
        local split rel line ag; split=$(head -1 "$RUN_DIR/agmap" 2>/dev/null); split=$(num_or "$split" 0); rel=$(( y - div - 1 ))
        line=$(awk -F'\036' -v r="$rel" 'NR > 1 && $1 == r { print; exit }' "$RUN_DIR/agmap" 2>/dev/null)
        if [ -n "$line" ] && [ "$split" -gt 0 ]; then
            if [ "$x" -le "$split" ]; then ag=$(printf '%s' "$line" | cut -d$'\036' -f2); else ag=$(printf '%s' "$line" | cut -d$'\036' -f3); fi
            [ -n "$ag" ] && { CLICK_M=${ag%%$US*}; CLICK_P=${ag#*$US}; CLICK_P=${CLICK_P%%$US*}; MOUSE_KEY=AGENT; return; }
        fi
    fi
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$DRAG" != 1 ] && { [ "$div" = 0 ] || [ "$y" -lt "$div" ]; }; then   # above it: a topic?
        local r t; while IFS=$'\036' read -r r t; do
            [ "$r" = "$y" ] && [ -n "$t" ] && {
                case "$t" in *"!"*) local rng=${t#*!}; CLICK_T=${t%%!*}; t=$CLICK_T                      # the button of a review card: its columns are in the ref
                    local bn=1 b1 b2; while [ -n "$rng" ]; do b1=${rng%%!*}; rng=${rng#*!}; b2=${rng%%!*}; case "$rng" in *!*) rng=${rng#*!} ;; *) rng="" ;; esac   # from, to, from, to ...
                        [ "$x" -ge "$b1" ] && [ "$x" -le "$b2" ] && { CLICK_N=$bn; MOUSE_KEY=ACT; return; }; bn=$(( bn + 1 )); done ;; *) CLICK_T=$t ;; esac
                MOUSE_KEY=TOPIC; click_twice "$t" && MOUSE_KEY=OPEN; return; }
        done 2>/dev/null < "$RUN_DIR/tmap"
    fi
    if [ "$2" = M ] && [ "$b" = 0 ] && [ "$y" = "$div" ]; then
        DRAG=1; DRAG_Y0=$y; DRAG_R0=$(num_or "$(cat "$RUN_DIR/agrows" 2>/dev/null)" 1); return
    fi
    if [ "$DRAG" = 1 ] && [ "$2" = M ] && [ "$b" = 32 ]; then       # moving with the button held: up = more agent rows
        DRAG_ROWS=$(( DRAG_R0 + DRAG_Y0 - y )); [ "$DRAG_ROWS" -lt 1 ] && DRAG_ROWS=1; MOUSE_KEY=DRAG; return
    fi
    if [ "$DRAG" = 1 ] && [ "$2" = m ]; then
        DRAG=0; [ -n "$DRAG_ROWS" ] && cfg_set AGENT_ROWS "$(agent_rows_clamp "$DRAG_ROWS")"; DRAG_ROWS=""; MOUSE_KEY=DRAG
    fi
}
agent_rows_clamp_set() {  # agent_rows_clamp_set <var> <n>: at least 1 agent row, and at least 4 lines stay for the topics
    local _n _max=$(( ${ROWS:-40} - 3 - 4 - 4 ))   # head 3, divider/header/rule/keys 4, topics 4
    num_set _n "$2" 1
    [ "$_max" -lt 1 ] && _max=1; [ "$_n" -gt "$_max" ] && _n=$_max; [ "$_n" -lt 1 ] && _n=1
    printf -v "$1" '%s' "$_n"
}
agent_rows_clamp() { agent_rows_clamp_set _ARC "$1"; printf '%s' "$_ARC"; }
# The one-line editor at the bottom. ←→ move, Option+←→ (also Ctrl) jump a word, Shift adds a selection (Shift+Option by words),
# Home/End or Ctrl-A/Ctrl-E (Cmd+←→), Backspace/Delete remove the selection or one character, Option+Backspace a word,
# Ctrl-U/Ctrl-K cut to the start/end. Typing replaces the selection. Enter keeps the text, Esc throws it away.
ED_BUF=""; ED_CUR=0; ED_ANC=-1                               # the text, the cursor (characters before it), the selection anchor (-1: none)
ed_word_left() {  # ED_TO = start of the word left of the cursor
    local i=$ED_CUR
    while [ "$i" -gt 0 ] && [ "${ED_BUF:$(( i - 1 )):1}" = " " ]; do i=$(( i - 1 )); done
    while [ "$i" -gt 0 ] && [ "${ED_BUF:$(( i - 1 )):1}" != " " ]; do i=$(( i - 1 )); done
    ED_TO=$i
}
ed_word_right() {  # ED_TO = end of the word right of the cursor
    local i=$ED_CUR n=${#ED_BUF}
    while [ "$i" -lt "$n" ] && [ "${ED_BUF:$i:1}" = " " ]; do i=$(( i + 1 )); done
    while [ "$i" -lt "$n" ] && [ "${ED_BUF:$i:1}" != " " ]; do i=$(( i + 1 )); done
    ED_TO=$i
}
ed_move() {  # ed_move <to> <select 0|1>
    if [ "$2" = 1 ]; then [ "$ED_ANC" -lt 0 ] && ED_ANC=$ED_CUR; else ED_ANC=-1; fi
    ED_CUR=$1; [ "$ED_CUR" -lt 0 ] && ED_CUR=0; [ "$ED_CUR" -gt "${#ED_BUF}" ] && ED_CUR=${#ED_BUF}
    [ "$ED_ANC" = "$ED_CUR" ] && ED_ANC=-1; return 0
}
ed_cut() {  # ed_cut <from> <to>: remove that range, the cursor goes to its start
    local a=$1 b=$2; [ "$a" -gt "$b" ] && { a=$2; b=$1; }
    ED_BUF="${ED_BUF:0:$a}${ED_BUF:$b}"; ED_CUR=$a; ED_ANC=-1
}
ed_cut_sel() { [ "$ED_ANC" -ge 0 ] || return 1; ed_cut "$ED_ANC" "$ED_CUR"; }
ed_insert() {  # ed_insert <text> <max>
    ed_cut_sel
    local room=$(( $2 - ${#ED_BUF} )) t=$1; [ "$room" -le 0 ] && return 0; t=${t:0:$room}
    ED_BUF="${ED_BUF:0:$ED_CUR}$t${ED_BUF:$ED_CUR}"; ED_CUR=$(( ED_CUR + ${#t} ))
}
ed_key_csi() {  # ed_key_csi <params> <final>: the cursor keys of xterm (1;2 Shift, 1;3 / 1;9 Option, 1;4 / 1;10 Shift+Option, 1;5 Ctrl)
    local p=$1 f=$2 sel=0 word=0
    case "$p" in 1\;2) sel=1 ;; 1\;3|1\;9|1\;5) word=1 ;; 1\;4|1\;10|1\;6) sel=1; word=1 ;; esac
    case "$f" in
        D) if [ "$word" = 1 ]; then ed_word_left; ed_move "$ED_TO" "$sel"
           elif [ "$sel" = 0 ] && [ "$ED_ANC" -ge 0 ]; then local a=$ED_ANC; [ "$a" -gt "$ED_CUR" ] && a=$ED_CUR; ed_move "$a" 0
           else ed_move $(( ED_CUR - 1 )) "$sel"; fi ;;
        C) if [ "$word" = 1 ]; then ed_word_right; ed_move "$ED_TO" "$sel"
           elif [ "$sel" = 0 ] && [ "$ED_ANC" -ge 0 ]; then local a=$ED_ANC; [ "$a" -lt "$ED_CUR" ] && a=$ED_CUR; ed_move "$a" 0
           else ed_move $(( ED_CUR + 1 )) "$sel"; fi ;;
        H) ed_move 0 "$sel" ;;
        F) ed_move "${#ED_BUF}" "$sel" ;;
        "~") case "$p" in 3) ed_cut_sel || ed_cut "$ED_CUR" $(( ED_CUR + 1 )) ;; 1|7) ed_move 0 0 ;; 4|8) ed_move "${#ED_BUF}" 0 ;; esac ;;
    esac
}
ask() {  # ask <label> [text to start with] [max length]: the editor on the last row -> ANSWER. Enter keeps it, Esc throws it away.
    local ch k2 k3 n p cancel=0 max=${3:-500} b
    ED_BUF=${2:-}; ED_BUF=${ED_BUF:0:$max}; ED_CUR=${#ED_BUF}; ED_ANC=-1; ASK_MAX=${3:-}
    trap '' USR1                                           # the animation must not cut the typing short
    printf '%s\033[?25h' "$MOUSE_OFF"                       # no mouse reports in the text; cursor on
    ask_draw "$1"
    while true; do
        in_get ch || { cancel=1; break; }                       # end of input: treat as cancel
        case "$ch" in
            "") break ;;                                    # Enter
            $'\033')
                read_soon k2
                case "$k2" in
                    "") cancel=1; break ;;                  # a lone Esc: throw the entry away
                    "["|O) p=""; k3=""; n=0
                        while in_get k3 1 && [ "$n" -lt 24 ]; do
                            case "$k3" in [0123456789\;\<\=\>\?\ \!\"\#\$\%\&\'\(\)\*\+\,\-\.\/]) p="$p$k3" ;; *) break ;; esac
                            [ "$k2" = O ] && break; n=$(( n + 1 ))
                        done
                        ed_key_csi "$p" "$k3" ;;
                    b) ed_word_left; ed_move "$ED_TO" 0 ;;   # Option+← / Option+→ as Meta (ESC b / ESC f)
                    f) ed_word_right; ed_move "$ED_TO" 0 ;;
                    $'\177'|$'\010') ed_cut_sel || { ed_word_left; ed_cut "$ED_TO" "$ED_CUR"; } ;;   # Option+Backspace: a word
                    l) ed_insert "@" "$max" ;;              # a left Option arrives as Alt: ESC l / ESC 7 are @ and | (German keyboard)
                    7) ed_insert "|" "$max" ;;
                esac ;;
            $'\177'|$'\010') ed_cut_sel || { [ "$ED_CUR" -gt 0 ] && ed_cut $(( ED_CUR - 1 )) "$ED_CUR"; } ;;
            $'\001') ed_move 0 0 ;;                         # Ctrl-A (Cmd+←)
            $'\005') ed_move "${#ED_BUF}" 0 ;;              # Ctrl-E (Cmd+→)
            $'\025') ed_cut 0 "$ED_CUR" ;;                  # Ctrl-U
            $'\013') ed_cut "$ED_CUR" "${#ED_BUF}" ;;       # Ctrl-K
            $'\027') ed_word_left; ed_cut "$ED_TO" "$ED_CUR" ;;   # Ctrl-W
            [[:cntrl:]]) ;;
            *) if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then    # bash 3.2 reads one BYTE: collect the rest of a UTF-8 character
                   LC_ALL=C printf -v b '%d' "'$ch"; [ "$b" -lt 0 ] && b=$(( b + 256 )); n=0   # bash 3.2: bytes >= 0x80 come back negative
                   [ "$b" -ge 192 ] && n=1; [ "$b" -ge 224 ] && n=2; [ "$b" -ge 240 ] && n=3
                   while [ "$n" -gt 0 ] && in_get k3 1; do ch="$ch$k3"; n=$(( n - 1 )); done
               fi
               ed_insert "$ch" "$max" ;;
        esac
        ask_draw "$1"
    done
    ask_drain                                               # the rest of a multi-line paste must not become commands
    printf '\033[0m\033[?25l%s' "$MOUSE_ON"; trap 'anim=1' USR1; ASK_MAX=""
    if [ "$cancel" = 1 ]; then ANSWER=""; return 1; fi
    ANSWER=${ED_BUF//[[:cntrl:]]/}; ANSWER=${ANSWER#"${ANSWER%%[! ]*}"}; ANSWER=${ANSWER%"${ANSWER##*[! ]}"}
    return 0
}
ask_draw() {  # ask_draw <label>: the prompt row with ED_BUF; the part around the cursor when it is longer than the room
    local rows=${ASK_ROW:-${ROWS:-40}} w=$(( ${COLS:-44} - 1 )) room cnt="" off a b pre mid post col lab lw
    [ -n "${ASK_MAX:-}" ] && cnt="$(( ASK_MAX - ${#ED_BUF} )) left"   # how many characters are left, on the right
    clip_set lab "$1" $(( w - 3 - ${#cnt} - 2 - 12 )); dw_set lw "$lab"   # a long label (a title in "Delete ...?") leaves room to type
    room=$(( w - 3 - lw - 1 - ${#cnt} - 1 )); [ "$room" -lt 4 ] && room=4
    off=0; [ "$ED_CUR" -gt "$room" ] && off=$(( ED_CUR - room ))   # scroll so that the cursor stays visible
    a=$ED_CUR; b=$ED_CUR; [ "$ED_ANC" -ge 0 ] && { a=$ED_ANC; [ "$a" -gt "$b" ] && { a=$ED_CUR; b=$ED_ANC; }; }
    [ "$a" -lt "$off" ] && a=$off; [ "$b" -lt "$off" ] && b=$off
    pre=${ED_BUF:$off:$(( a - off ))}; mid=${ED_BUF:$a:$(( b - a ))}; post=${ED_BUF:$b}
    post=${post:0:$(( room - ${#pre} - ${#mid} ))}
    printf '\033[%d;1H\033[2K%s%*s' "$rows" "$SELBG" "$w" ""
    [ -n "$cnt" ] && printf '\033[%d;%dH%s%s' "$rows" $(( w - ${#cnt} )) "$D" "$cnt"
    printf '\033[%d;1H%s%s▶ %s%s%s%s\033[7m%s\033[27m%s' "$rows" "$SELBG" "$ORANGE" "$L" "$lab" "$X$SELBG$L" "$pre" "$mid" "$post"
    col=$(( 3 + lw + ED_CUR - off )); printf '\033[%d;%dH' "$rows" "$col"   # "▶ " is 2 columns, the label starts in column 3
}
menu_line() {  # menu_line <selected: 1 or empty> <text>: a choice; the selected one is a bar over the whole width
    local w=$(( ${COLS:-44} - 2 )) t; clip_set t "$2" $(( w - 4 ))
    local tw; dw_set tw "$t"
    if [ -n "$1" ]; then printf '\001%s   %s%s%*s%s\n' "$SELBG" "$LSEL" "$t" $(( w - 3 - tw )) "" "$X"
    else printf '   %s%s%s\n' "$D" "$t" "$X"; fi
}
MENU_ITEMS=()                                                  # "key|label", made for the selected topic (menu_build)
menu_build() {  # menu_build <file>
    local f=$1 st ag; st=$(topic_get "$f" status now); ag=$(topic_get "$f" agent)
    if [ "$st" = done ]; then                                    # a finished topic: take it up again, move it, or tidy it
        [ "${P_N:-0}" -gt 0 ] || projects_load
        MENU_ITEMS=("reopen|Reopen: work on it again" "next|Up next" "later|Park for later")
        [ "$P_N" -gt 0 ] && MENU_ITEMS[${#MENU_ITEMS[@]}]="project|Project: $(project_name "$(topic_get "$f" project)" || echo none) (⏎ next)"
        MENU_ITEMS=("${MENU_ITEMS[@]}" "rename|Rename" "describe|Describe ..." "delete|Delete" "back|Back")
        return
    fi
    MENU_ITEMS=("start|Start with agent ...")
    [ -n "$(topic_get "$f" transfer_to)" ] && MENU_ITEMS=("cancelxfer|Cancel the hand-over to $(topic_get "$f" transfer_to_name)" "${MENU_ITEMS[@]}")
    [ "$st" = waiting ] && [ -n "$ag" ] && [ -n "$(topic_get "$f" agent_pane)" ] && MENU_ITEMS[${#MENU_ITEMS[@]}]="resume|The wait is over: $ag goes on"
    [ -n "$ag" ] && [ -n "$(topic_get "$f" agent_pane)" ] && MENU_ITEMS[${#MENU_ITEMS[@]}]="transfer|Transfer to another agent ..."
    [ "$st" = next ] || MENU_ITEMS[${#MENU_ITEMS[@]}]="next|Up next"
    MENU_ITEMS[${#MENU_ITEMS[@]}]="wait|Waiting for ..."
    [ "${P_N:-0}" -gt 0 ] || projects_load
    [ "$P_N" -gt 0 ] && MENU_ITEMS[${#MENU_ITEMS[@]}]="project|Project: $(project_name "$(topic_get "$f" project)" || echo none) (⏎ next)"
    if [ -n "$(topic_get "$f" slack_channel)" ]; then MENU_ITEMS[${#MENU_ITEMS[@]}]="slack|Slack: unpin $(topic_get "$f" slack_label)"
    else MENU_ITEMS[${#MENU_ITEMS[@]}]="slack|Slack: pin a channel ..."; fi
    [ "$st" = later ] || MENU_ITEMS[${#MENU_ITEMS[@]}]="later|Park for later"
    MENU_ITEMS=("${MENU_ITEMS[@]}" "done|Mark done" "rename|Rename" "describe|Describe ..." "delete|Delete" "back|Back")
}
bhote_menu() {  # the topic's page: title and description in full (wrapped), its status, then the numbered actions
    local f i st sc wf ws ag am age line sl; f=$(sel_file); [ -n "$f" ] || { printf '\n  %sno topic selected%s\n' "$D" "$X"; return; }
    menu_build "$f"
    st=$(topic_get "$f" status now); wf=$(topic_get "$f" waiting_for); ws=$(topic_get "$f" waiting_since); ag=$(topic_get "$f" agent); am=$(topic_get "$f" agent_machine)
    case "$st" in now) sc=$ORANGE ;; next) sc=$S ;; waiting) sc=$Y ;; review) sc=$BLUE ;; later) sc=$R ;; done) sc=$GREEN ;; *) sc=$D ;; esac
    printf '\n  %sTITLE%s\n' "$D" "$X"
    field_block title "$TITLE" "$(topic_get "$f" title '(untitled)')"
    printf '\n  %sDESCRIPTION%s\n' "$D" "$X"
    line=$(topic_get "$f" description); if [ -n "$line" ]; then field_block description "$DESC" "$line"; else field_block description "$D" "– (⏎ adds one)"; fi
    printf '\n  %sSTATUS%s\n' "$D" "$X"
    printf '  %s%s%s' "$sc" "$st" "$X"
    if [ "$st" = waiting ] && [ -n "$wf" ]; then ago_set age "${ws:-$NOW}"; printf ' %s·%s %s%s%s %s· %s%s' "$D" "$X" "$BLUE" "$wf" "$X" "$D" "$age" "$X"; fi
    printf '\n'
    [ -n "$ag" ] && printf '  %sagent%s %s%s%s%s\n' "$D" "$X" "$BLUE" "$(clip "$ag" $(( ${COLS:-44} - 12 )))" "$X" "${am:+ ${D}· $am$X}"
    line=$(topic_get "$f" agent_branch); [ -n "$line" ] && [ -n "$(topic_get "$f" agent_pane)" ] && [ "$(cfg_get GITHUB_BRANCHES on)" = on ] \
        && printf '  %sbranch%s %s⎇ %s%s\n' "$D" "$X" "$S" "$(clip "$line" $(( ${COLS:-44} - 13 )))" "$X"
    line=$(topic_get "$f" project); [ -n "$line" ] && printf '  %sproject%s %s%s%s\n' "$D" "$X" "$L" "$(project_name "$line" || echo "$line")" "$X"
    if [ -n "$(topic_get "$f" slack_channel)" ] || [ -n "$(topic_get "$f" slack_msg)" ]; then   # the pin and the answer that came in
        printf '\n  %sSLACK%s\n' "$D" "$X"
        line=$(topic_get "$f" slack_label); [ -n "$line" ] && printf '  %s%s%s%s\n' "$S" "$line" "$X" "$( [ "$st" = waiting ] && printf ' %s· monitor%s' "$D" "$X")"
        line=$(topic_get "$f" slack_msg); [ -n "$line" ] && slack_msg_print "$line"
    fi
    printf '\n'; rule
    printf '\n  %sACTIONS%s\n' "$D" "$X"
    for (( i = 0; i < ${#MENU_ITEMS[@]}; i++ )); do
        sl=""; [ "$i" = "${MENU_IDX:-0}" ] && sl=1
        printf '\035%s\035' "$i"; menu_num_line "$sl" "$(( i + 1 ))" "${MENU_ITEMS[$i]#*|}"   # (its index: a click runs it)
    done
    printf '\n'; rule
    if [ -n "${FLASH_MSG:-}" ] && [ "$SECONDS" -lt "${FLASH_UNTIL:-0}" ]; then   # what just happened (a Slack pin: asking, pinned, why not)
        case "$FLASH_MSG" in "✓"*) wrap_print 2 "$GREEN" "$FLASH_MSG" ;; "✗"*) wrap_print 2 "$NN" "$FLASH_MSG" ;; *) wrap_print 2 "$S" "$FLASH_MSG" ;; esac
    else printf '  %s%s%s\n' "$D" "$(clip "↑↓ 1-9 choose · ⏎ do it / edit · esc back" $(( ${COLS:-44} - 4 )))" "$X"; fi
}
# Title and description on the topic page are choices, too (MENU_IDX -2 and -1, above the actions): on the bar when chosen,
# and edited in place (EDIT_FIELD): the field is then one line, marked with \002 so that bhote_paint knows its row (EDIT_ROW)
# and the editor opens right there.
field_block() {  # field_block <title|description> <colour> <text>
    local l w=$(( ${COLS:-44} - 2 )) lw mk="" sel="" first=1 rm
    case "$1:${MENU_IDX:-0}" in title:-2|description:-1) sel=1; mk=$'\001' ;; esac
    if [ "$1" = title ]; then rm=$'\035-2\035'; else rm=$'\035-1\035'; fi   # every line: a click edits it (its MENU_IDX)
    if [ "${EDIT_FIELD:-}" = "$1" ]; then printf '%s\002%s%*s%s\n' "$mk" "$SELBG" "$w" "" "$X"; return; fi
    while IFS= read -r l; do
        l=${l//$X/}
        if [ -n "$sel" ]; then dw_set lw "$l"; printf '%s%s%s%s%s%*s%s\n' "$rm" "$mk" "$SELBG" "$LSEL" "$l" $(( w - lw )) "" "$X"; mk=""
        else printf '%s%s%s%s\n' "$rm" "$2" "$l" "$X"; fi
    done <<< "$(wrap_print 2 "" "$3")"
}
slack_msg_print() {  # slack_msg_print <who: text>: the sender, then each line (¶) wrapped; lists hang behind • / 1.; `code` and *bold* as in Slack
    local who=${1%%: *} txt=${1#*: } p rest mk ind blank=1
    [ "$who" = "$1" ] && { who=""; txt=$1; }
    [ -n "$who" ] && printf '\n  %s%s%s\n' "$BLUE" "$(clip "$who" $(( ${COLS:-44} - 4 )))" "$X"
    rest=${txt// ¶ ¶ / ¶ $'\003' ¶ }                          # (an empty line in Slack: a paragraph break, \003 here)
    while [ -n "$rest" ]; do
        p=${rest%% ¶ *}; [ "$p" = "$rest" ] && rest="" || rest=${rest#* ¶ }
        p=${p#"${p%%[! ]*}"}; [ "$p" = $'\003' ] && p=""
        if [ -z "$p" ]; then [ -z "$blank" ] && printf '\n'; blank=1; continue; fi; blank=""   # a paragraph break: one empty line
        mk=""; case "$p" in "• "*|"◦ "*|"- "*) mk="•"; p=${p#* } ;; [0-9]". "*|[0-9][0-9]". "*) mk=${p%%. *}.; p=${p#*. } ;; esac
        if [ -n "$mk" ]; then ind=$(( 3 + ${#mk} )); printf '  %s%s%s ' "$D" "$mk" "$X"; wrap_print "$ind" "" "$p" | sed "1s/^ \{$ind\}//"
        else wrap_print 2 "" "$p"; fi
    done | slack_marks
}
slack_marks() {  # stdin → stdout: `code` in the code colour, *bold* bold, the rest in the terminal's text colour (state carried over lines)
    awk -v base="$([ "$color" = 1 ] && printf '%s[39m' "$esc")" -v code="$C" -v bold="$BOLD" -v off="$X" '
        { out = ""; n = length($0); line = $0
          for (i = 1; i <= n; i++) {
              ch = substr(line, i, 1); prev = (i > 1) ? substr(line, i - 1, 1) : " "; nxt = (i < n) ? substr(line, i + 1, 1) : " "
              if (ch == "`") { incode = !incode; out = out off (incode ? code : (inbold ? bold base : base)); continue }
              if (ch == "*" && !incode && ((!inbold && prev ~ /[ (]/ && nxt !~ /[ ]/) || (inbold && prev !~ /[ ]/))) { inbold = !inbold; out = out off base (inbold ? bold : ""); continue }
              out = out ch
          }
          print base (incode ? code : "") (inbold ? bold : "") out off }'
}
menu_edit_field() {  # menu_edit_field <title|description>: the editor where the field stands; Enter keeps, Esc throws away
    local f fld=$1 cur; f=$(sel_file); [ -n "$f" ] || return 0
    cur=$(topic_get "$f" "$fld")
    EDIT_FIELD=$fld; EDIT_ROW=""; bhote_paint menu
    if [ "$fld" = title ]; then ASK_ROW=$EDIT_ROW ask "" "$cur" && [ -n "$ANSWER" ] && topic_set "$f" title "$ANSWER"
    else ASK_ROW=$EDIT_ROW ask "" "$cur" "$DESC_MAX" && topic_set "$f" description "$ANSWER"; fi
    EDIT_FIELD=""; EDIT_ROW=""
}
menu_num_line() {  # menu_num_line <selected 1|""> <number> <text>: an action with its number key; the selected one on the bar
    local w=$(( ${COLS:-44} - 2 )) t; clip_set t "$3" $(( w - 6 ))
    if [ -n "$1" ]; then printf '%s  %s%-2s%s %s%s%*s%s\n' "$SELBG" "$C" "$2" "$X$SELBG" "$LSEL" "$t" $(( w - 5 - ${#t} )) "" "$X"   # (the number in two columns: 10 and 11 line up)
    else printf '  %s%-2s%s %s%s%s\n' "$C" "$2" "$X" "$L" "$t" "$X"; fi
}
# ── suggestions: what the running agents work on (the "task" of each agent pane) and is not a topic yet. "a" lists them; adopting one
# makes it a topic that is already assigned to that agent. "x" dismisses one for good (kept in $DATA_DIR/dismissed).
SUG_MAP=(); SUG_IDX=0
eq_ci() { local r=1; shopt -s nocasematch; [[ $1 == "$2" ]] && r=0; shopt -u nocasematch; return $r; }
suggest_build() {  # SUG_MAP = indexes into AG_LINES of agents whose task is neither a topic nor assigned nor dismissed
    local i m id st name task t known line; SUG_MAP=()
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        [ -n "$task" ] || continue
        known=0
        for (( t = 0; t < T_N; t++ )); do
            [ "${T_STATUS[$t]}" = done ] && continue
            if [ "${T_AM[$t]}" = "$m" ] && [ "${T_AP[$t]}" = "$id" ]; then known=1; break; fi
            eq_ci "${T_TITLE[$t]}" "$task" && { known=1; break; }
        done
        [ "$known" = 0 ] && [ -r "$DATA_DIR/dismissed" ] && while IFS= read -r line; do [ "$line" = "$m|$id|$task" ] && { known=1; break; }; done < "$DATA_DIR/dismissed"
        [ "$known" = 0 ] && SUG_MAP[${#SUG_MAP[@]}]=$i
    done
}
bhote_suggest() {
    local i m id st name task sl
    printf '\n %sFrom running agents%s\n %sTheir tasks that are no topic yet%s\n' "$L" "$X" "$D" "$X"
    rule; printf '\n'
    suggest_build
    for (( i = 0; i < ${#SUG_MAP[@]}; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[${SUG_MAP[$i]}]}"
        sl=0; [ "$i" = "$SUG_IDX" ] && sl=1
        topic_item "$sl" "$D" "" "$TITLE" "$task" "" "$name" "$m" 0
    done
    [ "${#SUG_MAP[@]}" -gt 0 ] || printf '   %snothing to suggest%s\n' "$D" "$X"
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ add as topic%s\n %sx dismiss · ←/esc back%s\n' "$D" "$X" "$D" "$X"
}
suggest_do() {  # suggest_do <adopt|dismiss> <index>
    local m id st name task f
    suggest_build; [ -n "${SUG_MAP[$2]:-}" ] || return 0
    IFS=$US read -r m id st name task <<< "${AG_LINES[${SUG_MAP[$2]}]}"
    if [ "$1" = dismiss ]; then printf '%s|%s|%s\n' "$m" "$id" "$task" >> "$DATA_DIR/dismissed"; return 0; fi
    topic_new "$task" "" "" || return 0
    f="$TOPIC_DIR/$NEW_TOPIC_ID.topic"; SEL_ID=$NEW_TOPIC_ID
    topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
}
# ── the picker: "Start" asks which free agent takes the topic. Free = idle or done; entry 0 only marks the topic as started.
PICK_MAP=(); PICK_IDX=0
agent_taken() {  # agent_taken <machine> <pane>: already working on another open topic
    local _t; for (( _t = 0; _t < T_N; _t++ )); do
        [ "${T_STATUS[$_t]}" = now ] && [ "${T_AM[$_t]}" = "$1" ] && [ "${T_AP[$_t]}" = "$2" ] && [ "${T_ID[$_t]}" != "${SEL_ID:-}" ] && return 0
    done; return 1
}
PICK_MODE=start
pick_build() {  # PICK_MAP = indexes into AG_LINES of the free agents (for a transfer: not the agent that has the topic now)
    local i m id st name task sm="" sp="" f; PICK_MAP=()
    if [ "$PICK_MODE" = transfer ]; then f=$(sel_file); [ -n "$f" ] && { sm=$(topic_get "$f" agent_machine); sp=$(topic_get "$f" agent_pane); }; fi
    for (( i = 0; i < AG_N; i++ )); do
        IFS=$US read -r m id st name task <<< "${AG_LINES[$i]}"
        [ -n "$sp" ] && [ "$m" = "$sm" ] && [ "$id" = "$sp" ] && continue
        case "$st" in idle|done) agent_taken "$m" "$id" || PICK_MAP[${#PICK_MAP[@]}]=$i ;; esac
    done
}
pick_first() { [ "$PICK_MODE" = transfer ] && echo 1 || echo 0; }   # the first entry: 0 = "just mark as started", 1 = an agent
bhote_pick() {
    local f i k m id st name task title n=0 label sl
    f=$(sel_file); [ -n "$f" ] || { printf '\n  %sno topic selected%s\n' "$D" "$X"; return; }
    clip_set title "$(topic_get "$f" title '(untitled)')" $(( ${COLS:-44} - 8 ))
    printf '\n %s▸ %s%s\n %s%s%s\n' "$ORANGE" "$L$title" "$X" "$D" "$([ "$PICK_MODE" = transfer ] && echo "Transfer to which agent?" || echo "Who takes it?")" "$X"
    rule; printf '\n'
    pick_build
    for (( i = $(pick_first); i <= ${#PICK_MAP[@]}; i++ )); do
        if [ "$i" = 0 ]; then label="Just mark as started"
        else
            IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( i - 1 ))]}]}"
            label="$m · $name"; [ "$st" = done ] && label="$label ✓"
        fi
        clip_set label "$label" $(( ${COLS:-44} - 8 ))
        sl=""; [ "$i" = "$PICK_IDX" ] && sl=1; menu_line "$sl" "$label"
    done
    [ "${#PICK_MAP[@]}" -gt 0 ] || printf '\n   %sno free agent right now%s\n' "$D" "$X"
    printf '\n'; rule
    printf ' %s↑↓ choose · →/⏎ start · ←/esc back%s\n' "$D" "$X"
}

# ── projects. An agent belongs to a project by its git repository (a worktree by its main repository: it inherits) or, outside
# a repository, by its herdr workspace. A project is a record in the topic store (kind=project, file proj-<slug>.topic), so
# it travels with the topics to the other machine. A repository is known by its key: the origin URL (host/owner/name) or,
# without a remote, "dir:<folder name>" of the main checkout.
P_N=0; P_ID=(); P_NAME=(); P_REPOS=(); P_WS=(); P_FILE=()
current_project() {  # CUR_PROJ: the project of this panel: of the agent in its herdr tab (from the collected tokens)
    local m p t a r j c mytab=""; CUR_PROJ=""
    [ -n "${HERDR_PANE_ID:-}" ] && [ -r "$AGENT_META_L" ] || return 0
    while IFS=$US read -r m p t a r j c; do [ "$p" = "$HERDR_PANE_ID" ] && { mytab=$t; break; }; done < "$AGENT_META_L"
    [ -n "$mytab" ] || return 0
    while IFS=$US read -r m p t a r j c; do [ "$t" = "$mytab" ] && [ "$a" = a ] && [ -n "$j" ] && { CUR_PROJ=$j; return 0; }; done < "$AGENT_META_L"
}
topics_projects() {  # T_EPJ: each topic's project: its own, else its agent's
    local i metas rest t a rr jj cc; T_EPJ=(); metas_read metas
    for (( i = 0; i < T_N; i++ )); do
        T_EPJ[$i]=${T_PJ[$i]}
        if [ -z "${T_EPJ[$i]}" ] && [ -n "${T_AP[$i]}" ]; then
            case "$metas" in *$'\n'"${T_AM[$i]}$US${T_AP[$i]}$US"*) rest=${metas#*$'\n'"${T_AM[$i]}$US${T_AP[$i]}$US"}; rest=${rest%%$'\n'*}
                IFS=$US read -r t a rr jj cc <<< "$rest"; T_EPJ[$i]=$jj ;; esac
        fi
    done
}
in_scope() {  # in_scope <topic index>: 0 when the panel lists it (TOPICS_SCOPE=project: its project, or none)
    [ "${U_SCOPE:-all}" = project ] && [ -n "${CUR_PROJ:-}" ] || return 0
    [ -z "${T_EPJ[$1]:-}" ] || [ "${T_EPJ[$1]}" = "$CUR_PROJ" ]
}
projects_load() {  # P_* arrays, by name
    local f line k v id name repos ws del kd n=0 i j t
    P_N=0; P_ID=(); P_NAME=(); P_REPOS=(); P_WS=(); P_FILE=()
    for f in "$TOPIC_DIR"/proj-*.topic; do
        [ -f "$f" ] || continue
        name=""; repos=""; ws=""; del=0; kd=""
        while IFS= read -r line; do k=${line%%=*}; v=${line#*=}
            case "$k" in title) [ -z "$name" ] && name=$v ;; repos) repos=$v ;; workspaces) ws=$v ;; deleted) del=$v ;; kind) kd=$v ;; esac
        done < "$f"
        [ "$kd" = project ] && [ "$del" != 1 ] && [ -n "$name" ] || continue
        id=${f##*/}; id=${id%.topic}
        P_ID[$n]=$id; P_NAME[$n]=${name//[[:cntrl:]]/}; P_REPOS[$n]=$repos; P_WS[$n]=$ws; P_FILE[$n]=$f; n=$(( n + 1 ))
    done
    P_N=$n
    for (( i = 1; i < P_N; i++ )); do                          # by name (insertion sort, a handful of projects)
        for (( j = i; j > 0; j-- )); do
            [[ "${P_NAME[$(( j - 1 ))]}" > "${P_NAME[$j]}" ]] || break
            # shellcheck disable=SC1087  # the array name is a variable: eval builds ${name[j]}
            for t in P_ID P_NAME P_REPOS P_WS P_FILE; do eval "local _a=\${$t[$j]}; $t[$j]=\${$t[$(( j - 1 ))]}; $t[$(( j - 1 ))]=\$_a"; done
        done
    done
}
project_slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//' | cut -c1-40; }
project_name() {  # project_name <id>: its name (empty: none)
    local i; for (( i = 0; i < P_N; i++ )); do [ "${P_ID[$i]}" = "$1" ] && { printf '%s' "${P_NAME[$i]}"; return 0; }; done; return 1
}
project_new() {  # project_new <name>: PROJ_ID; 1 when it exists already
    local name=${1//[[:cntrl:]]/} slug f now; name=${name:0:60}; slug=$(project_slug "$name"); [ -n "$slug" ] || return 1
    PROJ_ID="proj-$slug"; f="$TOPIC_DIR/$PROJ_ID.topic"; now=$(date +%s); mkdir -p "$TOPIC_DIR"
    if [ -f "$f" ]; then [ "$(topic_get "$f" deleted 0)" = 1 ] || return 1      # there; a deleted one comes back
        topic_set "$f" deleted 0; topic_set "$f" title "$name"; return 0; fi
    printf 'id=%s\nkind=project\ntitle=%s\nrepos=\nworkspaces=\ncreated=%s\nupdated=%s\ndeleted=0\n' "$PROJ_ID" "$name" "$now" "$now" > "$f"
    : > "$STORE_DIRTY"
}
# ── machine codes: three capitals per machine (MAC, OMR), in front of its agents' names when the agents of more than one
# machine are listed. Made from the name and unique over all machines bhote knows; one set by hand (settings › Connections,
# the setup) is a record in the topic store (kind=machine, file mach-<slug>.topic), so every machine shows the same code.
MC_KEY="-"; MC_N=0; MC_NAME=(); MC_CODE=(); MC_SET=()
machine_code_ok() { [ "${#1}" = 3 ] && [ -z "${1//[ABCDEFGHIJKLMNOPQRSTUVWXYZ]/}" ]; }   # (no [A-Z]: a range follows the locale)
machine_code_cands() {  # machine_code_cands <name>: the codes it could get, the best first (one per line)
    printf '%s\n' "$1" | LC_ALL=C awk '
        function emit(x) { if (length(x) == 3 && !(x in seen)) { seen[x] = 1; print x } }
        { w = $0; gsub(/[^A-Za-z]+/, " ", w); o = ""
          for (i = 1; i <= length(w); i++) { c = substr(w, i, 1); if (c ~ /[A-Z]/ && substr(w, i - 1, 1) ~ /[a-z]/) o = o " "; o = o c }   # MacBook: Mac Book
          n = split(o, W, " "); L = toupper(o); gsub(/ /, "", L); if (L == "") L = "M"
          while (length(L) < 3) L = L "X"
          f = substr(L, 1, 1); V = "AEIOU"
          if (length(L) == 3) emit(L)                                                                   # Mac: MAC
          if (n >= 3) emit(toupper(substr(W[1], 1, 1) substr(W[2], 1, 1) substr(W[3], 1, 1)))            # Mac Book Pro: MBP
          if (n == 2) { u = toupper(W[2]); c = ""; for (i = 2; i <= length(u); i++) if (index(V, substr(u, i, 1)) == 0) { c = substr(u, i, 1); break }
                        if (c == "") c = substr(u, 2, 1); emit(f substr(u, 1, 1) c) }                    # Mac Studio: MST
          c = ""; for (i = 2; i <= length(L) && length(c) < 2; i++) if (index(V, substr(L, i, 1)) == 0) c = c substr(L, i, 1)
          emit(f c)                                                                                     # Omarchy: OMR
          emit(substr(L, 1, 3))
          for (i = 2; i <= length(L); i++) for (j = i + 1; j <= length(L); j++) emit(f substr(L, i, 1) substr(L, j, 1))
          A = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"; for (i = 1; i <= 26; i++) for (j = 1; j <= 26; j++) emit(f substr(A, i, 1) substr(A, j, 1)) }'
}
machine_codes_load() {  # MC_NAME/MC_CODE (MC_SET: 1 = set by hand): this machine, the listed agents' machines, the records
    # (no forks while the list is drawn: only a changed set of machines or records asks awk for candidates)
    local f line t cd kd del i k c m key="" names=() nn=0 rn=() rc=() nr=0 x
    for f in "$TOPIC_DIR"/mach-*.topic; do
        [ -f "$f" ] || continue; t=""; cd=""; kd=""; del=0
        while IFS= read -r line; do case "$line" in title=*) [ -z "$t" ] && t=${line#title=} ;; code=*) cd=${line#code=} ;; kind=*) kd=${line#kind=} ;; deleted=*) del=${line#deleted=} ;; esac; done < "$f"
        t=${t//[[:cntrl:]]/}; [ "$kd" = machine ] && [ "$del" != 1 ] && [ -n "$t" ] && { rn[$nr]=$t; rc[$nr]=$cd; nr=$(( nr + 1 )); key="$key$t=$cd;"; }
    done
    for m in "$HOST" ${rn[@]+"${rn[@]}"}; do names[$nn]=$m; nn=$(( nn + 1 )); done
    for (( i = 0; i < ${AG_N:-0}; i++ )); do m=${AG_LINES[$i]%%$US*}; m=${m//[[:cntrl:]]/}; [ -n "$m" ] && { names[$nn]=$m; nn=$(( nn + 1 )); }; done
    for (( i = 1; i < nn; i++ )); do for (( k = i; k > 0; k-- )); do         # by name, without doubles (a handful)
        [[ "${names[$(( k - 1 ))]}" > "${names[$k]}" ]] || break; x=${names[$k]}; names[$k]=${names[$(( k - 1 ))]}; names[$(( k - 1 ))]=$x
    done; done
    local un=() u=0; for (( i = 0; i < nn; i++ )); do [ "$i" -gt 0 ] && [ "${names[$i]}" = "${names[$(( i - 1 ))]}" ] && continue; un[$u]=${names[$i]}; u=$(( u + 1 )); key="$key|${names[$i]}"; done
    [ "$key" = "$MC_KEY" ] && return 0
    MC_KEY=$key; MC_N=$u; MC_NAME=(); MC_CODE=(); MC_SET=()
    for (( i = 0; i < MC_N; i++ )); do MC_NAME[$i]=${un[$i]}; MC_CODE[$i]=""; MC_SET[$i]=0; done
    local used=" "
    for (( i = 0; i < MC_N; i++ )); do                          # set by hand first (the first by name keeps a code twice set)
        for (( k = 0; k < nr; k++ )); do
            [ "${rn[$k]}" = "${MC_NAME[$i]}" ] || continue; c=${rc[$k]}
            machine_code_ok "$c" && case "$used" in *" $c "*) ;; *) MC_CODE[$i]=$c; MC_SET[$i]=1; used="$used$c " ;; esac
        done
    done
    for (( i = 0; i < MC_N; i++ )); do                          # the rest, by name: the first free candidate
        [ -n "${MC_CODE[$i]}" ] && continue
        while IFS= read -r c; do case "$used" in *" $c "*) ;; *) MC_CODE[$i]=$c; used="$used$c "; break ;; esac; done < <(machine_code_cands "${MC_NAME[$i]}")
    done
}
machine_code_set() {  # machine_code_set <var> <machine>: its code (empty when it is not known)
    local _i; for (( _i = 0; _i < MC_N; _i++ )); do [ "${MC_NAME[$_i]}" = "$2" ] && { printf -v "$1" '%s' "${MC_CODE[$_i]}"; return 0; }; done
    printf -v "$1" '%s' ""; return 1
}
# ── agent numbers: every agent has a number of its own on its machine (OMR1, MAC4), the same for good, so people can say "that is
# always MAC4". The machine the agent runs on hands them out (the collector, the next free number, never reused) and keeps them in
# a record per agent in the topic store (kind=agentnum, title=machine/name), which every machine reads: the same everywhere.
AN_KEY=(); AN_NUM=(); AN_N=0; AN_AT=-999
agentnum_load() {  # AN_KEY/AN_NUM from the records (looked at again every 5 seconds)
    local f line k n d; [ $(( SECONDS - AN_AT )) -ge 5 ] || return 0; AN_AT=$SECONDS
    AN_KEY=(); AN_NUM=(); AN_N=0
    for f in "$TOPIC_DIR"/an-*.topic; do
        [ -f "$f" ] || continue; k=""; n=""; d=0
        while IFS= read -r line; do case "$line" in title=*) [ -z "$k" ] && k=${line#title=} ;; num=*) n=${line#num=} ;; deleted=*) d=${line#deleted=} ;; esac; done < "$f"
        case "$n" in ''|*[!0-9]*) continue ;; esac; [ "$d" = 1 ] || [ -z "$k" ] && continue
        AN_KEY[$AN_N]=$k; AN_NUM[$AN_N]=$n; AN_N=$(( AN_N + 1 ))
    done
}
agentnum_set() {  # agentnum_set <var> <machine> <agent name>: its number, empty when it has none (yet)
    local _i _k="$2/${3//[[:cntrl:]]/}"; printf -v "$1" '%s' ""
    for (( _i = 0; _i < AN_N; _i++ )); do [ "${AN_KEY[$_i]}" = "$_k" ] && { printf -v "$1" '%s' "${AN_NUM[$_i]}"; return 0; }; done
    return 1
}
agent_code_set() {  # agent_code_set <var> <machine> <agent name>: MAC4 (the machine's code and the agent's number), "" without a code
    local _c _n; [ "${MC_N:-0}" -gt 0 ] || machine_codes_load; agentnum_load
    machine_code_set _c "$2" || _c=""; agentnum_set _n "$2" "$3"; printf -v "$1" '%s' "${_c:+$_c$_n}"
}
agentnum_assign() {  # this machine's agents without a number get the next free one (the collector calls it after collecting)
    local m id st name task max=0 i s1 s2 f now; AN_AT=-999; agentnum_load; now=$(date +%s)
    for (( i = 0; i < AN_N; i++ )); do case "${AN_KEY[$i]}" in "$HOST/"*) [ "${AN_NUM[$i]}" -gt "$max" ] && max=${AN_NUM[$i]} ;; esac; done
    [ -r "$AGENT_LOCAL" ] || return 0
    while IFS=$US read -r m id st name task; do
        [ "$m" = "$HOST" ] && [ -n "$name" ] || continue; name=${name//[[:cntrl:]]/}
        agentnum_set s1 "$m" "$name" && continue
        s1=${m//[^A-Za-z0-9]/_}; s2=${name//[^A-Za-z0-9]/_}; f="$TOPIC_DIR/an-${s1:0:20}-${s2:0:60}.topic"
        [ -e "$f" ] && continue                                 # (another name with the same letters has it: no number rather than a wrong one)
        max=$(( max + 1 ))
        printf 'id=%s\nkind=agentnum\ntitle=%s/%s\nnum=%s\ncreated=%s\nupdated=%s\ndeleted=0\n' "$(basename "$f" .topic)" "$m" "$name" "$max" "$now" "$now" > "$f" && : > "$STORE_DIRTY"
        AN_KEY[$AN_N]="$m/$name"; AN_NUM[$AN_N]=$max; AN_N=$(( AN_N + 1 ))
    done < "$AGENT_LOCAL"
}
machine_code_save() {  # machine_code_save <machine> <code | "">: sets it by hand (empty: made from the name again); 1 = taken or not 3 letters
    local name=${1//[[:cntrl:]]/} c f slug now i
    c=$(printf '%s' "$2" | tr '[:lower:]' '[:upper:]' | tr -d ' ')
    [ -z "$c" ] || machine_code_ok "$c" || { echo "bhote: a machine code is three letters A-Z" >&2; return 1; }
    machine_codes_load
    if [ -n "$c" ]; then for (( i = 0; i < MC_N; i++ )); do
        [ "${MC_CODE[$i]}" = "$c" ] && [ "${MC_NAME[$i]}" != "$name" ] && { echo "bhote: $c is the code of ${MC_NAME[$i]}" >&2; return 1; }
    done; fi
    slug=$(project_slug "$name"); [ -n "$slug" ] || return 1
    f="$TOPIC_DIR/mach-$slug.topic"; now=$(date +%s); mkdir -p "$TOPIC_DIR"
    if [ -f "$f" ]; then topic_set "$f" title "$name"; topic_set "$f" code "$c"; topic_set "$f" deleted 0
    else printf 'id=mach-%s\nkind=machine\ntitle=%s\ncode=%s\ncreated=%s\nupdated=%s\ndeleted=0\n' "$slug" "$name" "$c" "$now" "$now" > "$f"; fi
    MC_KEY="-"; : > "$STORE_DIRTY"
}
project_ref() {  # project_ref <ref>: prints the file; ref = number (bhote project list), id, name or part of it (exit 2: ambiguous)
    local ref=$1 i hits=0 hit="" low; projects_load
    [ -n "$ref" ] || { echo "bhote: a project is needed (bhote project list)" >&2; return 1; }
    case "$ref" in *[!0-9]*) ;; *) i=$(( 10#$ref )); [ "$i" -ge 1 ] && [ "$i" -le "$P_N" ] && { printf '%s' "${P_FILE[$(( i - 1 ))]}"; return 0; } ;; esac
    for (( i = 0; i < P_N; i++ )); do
        { [ "${P_ID[$i]}" = "$ref" ] || [ "${P_ID[$i]}" = "proj-$ref" ] || eq_ci "${P_NAME[$i]}" "$ref"; } && { printf '%s' "${P_FILE[$i]}"; return 0; }
    done
    for (( i = 0; i < P_N; i++ )); do title_has "${P_NAME[$i]}" "$ref" && { hits=$(( hits + 1 )); hit=${P_FILE[$i]}; }; done
    [ "$hits" = 1 ] && { printf '%s' "$hit"; return 0; }
    [ "$hits" = 0 ] && { echo "bhote: no project matches '$ref' (bhote project list)" >&2; return 1; }
    echo "bhote: '$ref' matches $hits projects" >&2; return 2
}
list_has() { case ",$1," in *",$2,"*) return 0 ;; esac; return 1; }   # list_has <a,b,c> <item>
list_add() { if list_has "$1" "$2"; then printf '%s' "$1"; else printf '%s' "${1:+$1,}$2"; fi; }
list_del() { local x out="" IFS=,; for x in $1; do [ "$x" = "$2" ] || out=${out:+$out,}$x; done; printf '%s' "$out"; }
project_for() {  # project_for <repo key> <workspace label>: PROJ_ID of the first project that has the repository (else the workspace)
    local i; PROJ_ID=""
    [ -n "$1" ] && for (( i = 0; i < P_N; i++ )); do list_has "${P_REPOS[$i]}" "$1" && { PROJ_ID=${P_ID[$i]}; return 0; }; done
    [ -n "$2" ] && for (( i = 0; i < P_N; i++ )); do list_has "${P_WS[$i]}" "$2" && { PROJ_ID=${P_ID[$i]}; return 0; }; done
    return 1
}
git_repo_key_set() {  # git_repo_key_set <var> <folder>: the key of the repository there (a worktree: its main one), empty outside one
    local _d=$2 _g="" _c="" _main="" _l _u="" _in=0 _n=0; printf -v "$1" '%s' ""
    while [ -n "$_d" ] && [ "$_n" -lt 40 ]; do
        if [ -d "$_d/.git" ]; then _c="$_d/.git"; _main=$_d; break; fi
        if [ -f "$_d/.git" ]; then IFS= read -r _g < "$_d/.git"; _g=${_g#gitdir: }; case "$_g" in /*) ;; *) _g="$_d/$_g" ;; esac
            case "$_g" in */worktrees/*) _c=${_g%/worktrees/*}; _main=${_c%/.git} ;; *) _c=$_g; _main=$_d ;; esac; break; fi
        [ "$_d" = / ] && break; _d=${_d%/*}; [ -n "$_d" ] || _d=/; _n=$(( _n + 1 ))
    done
    [ -n "$_c" ] || return 1
    [ -r "$_c/config" ] && while IFS= read -r _l; do               # [remote "origin"] url = ...
        case "$_l" in '['*) [ "$_l" = '[remote "origin"]' ] && _in=1 || _in=0 ;; *) [ "$_in" = 1 ] && case "$_l" in *url*=*) _u=${_l#*=}; _u=${_u# }; break ;; esac ;; esac
    done < "$_c/config"
    if [ -n "$_u" ]; then
        _u=${_u#*://}; _u=${_u#*@}; _u=${_u%.git}; _u=${_u%/}
        case "$_u" in *:*) case "${_u#*:}" in [0-9]*/*) _u="${_u%%:*}/${_u#*:*/}" ;; *) _u="${_u%%:*}/${_u#*:}" ;; esac ;; esac   # host:owner/x (scp form) or host:port/owner/x
        printf -v "$1" '%s' "$(printf '%s' "$_u" | tr '[:upper:]' '[:lower:]')"
    else printf -v "$1" 'dir:%s' "${_main##*/}"; fi
}
# ── talking to agents: the live state of one agent pane, and a prompt to it (both through herdr, --machine for other machines)
machine_known() {  # machine_known <label>: this machine, or a machine saved in herdr (a label from another machine's view is not)
    [ -n "$1" ] || return 1; [ "$1" = "$HOST" ] && return 0
    herdr machine list 2>/dev/null | awk -F'\t' -v l="$1" '$2 == l { f = 1 } END { exit !f }'
}
agent_live() {  # agent_live <machine> <pane>: LIVE_ST (idle|done|working|blocked|gone|noagent|unknown), LIVE_SESS, LIVE_CWD
    local opt=() out raw; LIVE_SESS=""; LIVE_CWD=""
    machine_known "$1" || { LIVE_ST=unknown; return 0; }
    [ "$1" = "$HOST" ] || opt=(--machine "$1")
    raw=$(herdr_m ${opt[@]+"${opt[@]}"} pane list) || { LIVE_ST=unknown; return 0; }       # herdr did not answer (or not in time): not "gone"
    [ -n "$raw" ] || { LIVE_ST=unknown; return 0; }
    out=$(printf '%s' "$raw" | jq -r --arg p "$2" '[.result.panes[] | select(.pane_id == $p)][0]
        | if . == null then "gone" elif (.agent // "") == "" then "noagent" else
          [(.agent_status // ""), ((.agent_session.value // "") | tostring | gsub("[^A-Za-z0-9-]"; "")), ((.foreground_cwd // .cwd // "") | tostring | gsub("[\u0001-\u001f]"; ""))] | join("\u001f") end' 2>/dev/null)
    LIVE_ST=${out%%$US*}; LIVE_SESS=""; LIVE_CWD=""
    case "$out" in *"$US"*) out=${out#*$US}; LIVE_SESS=${out%%$US*}; LIVE_CWD=${out#*$US} ;; esac
    [ -n "$LIVE_ST" ] || LIVE_ST=gone
}
AGENT_SEND_SYNC=""                                              # the CLI waits for herdr and reports a failure; the panel does not wait
agent_send() {  # agent_send <machine> <pane> <text>: a prompt to that agent
    local opt=(); machine_known "$1" || return 1; [ "$1" = "$HOST" ] || opt=(--machine "$1")
    case "$2" in ''|*[!A-Za-z0-9:_-]*) return 1 ;; esac
    if [ -n "$AGENT_SEND_SYNC" ]; then
        herdr_m ${opt[@]+"${opt[@]}"} agent prompt "$2" "${3//[[:cntrl:]]/ }" >/dev/null 2>&1 || { echo "bhote: herdr could not send the prompt to $1/$2" >&2; return 1; }
    else ( herdr_m ${opt[@]+"${opt[@]}"} agent prompt "$2" "${3//[[:cntrl:]]/ }" >/dev/null 2>&1 ) & fi
}
how_to_finish() {  # how_to_finish <id>: the sentence every agent gets about reporting back
    local h="when you are finished, run \`bhote review $1\` so that I check it"
    [ "$(cfg_get AGENT_CAN_CLOSE on)" = on ] && h="$h, or \`bhote done $1\` when nothing needs checking"
    printf '%s' "$h"
}

# ── Steal & Transfer: an agent stops, commits its state on its branch with a handover in the commit message, and another
# (free) agent takes over that branch. bhote transfer starts it; the source agent reports with bhote handover; then the
# target agent gets the topic. The topic remembers both ends while it travels (transfer_* keys).
transfer_start() {  # transfer_start <topic file> <from machine> <from pane> <from name> <to machine> <to pane> <to name>
    local f=$1 id title to_ref tpj
    agent_live "$5" "$6"; case "$LIVE_ST" in idle|done) ;; *) echo "bhote: $7 is not free ($LIVE_ST)" >&2; return 1 ;; esac
    # the target must work in the topic's project: another project's agent would not know what to do with it (only on purpose: TRANSFER_FORCE)
    tpj=$(topic_get "$f" project)
    if [ -n "$tpj" ] && [ "${TRANSFER_FORCE:-}" != 1 ]; then agent_meta "$5" "$6"
        [ "$AM_PROJECT" = "$tpj" ] || { echo "bhote: $7 is not an agent of this topic's project ($(project_name "$tpj" || echo "$tpj")); to hand it over anyway: bhote transfer ... --force" >&2; return 3; }
    fi
    local to_cwd=$LIVE_CWD
    agent_live "$2" "$3"; case "$LIVE_ST" in
        gone|noagent) echo "bhote: $4 is no agent any more" >&2; return 1 ;;
        blocked) echo "bhote: $4 is waiting for an answer (permission?): answer it first" >&2; return 1 ;;
        unknown) echo "bhote: $2 is not a machine herdr knows here" >&2; return 1 ;;
    esac
    id=$(topic_id "$f"); title=$(topic_get "$f" title); to_ref="$5/$6"
    local undo; undo=$(mktemp "$RUN_DIR/undo.XXXXXX") && cp "$f" "$undo"
    topic_set "$f" status now; topic_set "$f" waiting_for ""
    topic_set "$f" transfer_to "$to_ref"; topic_set "$f" transfer_to_name "$7"; topic_set "$f" transfer_from "$2/$3"
    topic_set "$f" agent "$4"; topic_set "$f" agent_machine "$2"; topic_set "$f" agent_pane "$3"
    if ! agent_send "$2" "$3" "Steal & Transfer (bhote topic $id: $title): stop here and hand this work over to $7. 1) Commit everything on your current branch (do not create a new branch; only on a detached HEAD create one: git switch -c bhote-$id); put a handover into the commit message body: the goal, what is done, what is open, the next steps, how to test. 2) If the repository has a remote, push the branch. 3) Note the branch and the commit: b=\$(git rev-parse --abbrev-ref HEAD); c=\$(git rev-parse HEAD). 4) If ${to_cwd:-the folder of the other agent} is another worktree of this repository, free the branch with git switch --detach. 5) Run: bhote handover $id --to '$to_ref' --branch \"\$b\" --commit \"\$c\". Then stop."; then
        [ -s "$undo" ] && cp "$undo" "$f" && topic_set "$f" transfer_to ""     # back as it was (newer, so that it wins a merge)
        rm -f "$undo"; return 1
    fi
    rm -f "$undo"; : > "$STORE_DIRTY"
}
transfer_finish() {  # transfer_finish <topic file> <to machine/pane> <branch> <commit>: the target agent takes over
    local f=$1 id title tm tp name from b c
    id=$(topic_id "$f"); title=$(topic_get "$f" title); tm=${2%%/*}; tp=${2#*/}
    name=$(topic_get "$f" transfer_to_name "$tp"); from=$(topic_get "$f" agent "the other agent")
    b=${3//[!A-Za-z0-9._\/-]/}; c=${4//[!A-Za-z0-9]/}
    agent_live "$tm" "$tp"; case "$LIVE_ST" in gone|noagent|unknown) echo "bhote: $name is no agent any more" >&2; return 1 ;; esac
    local get="git switch $b"; case "$b" in ''|HEAD) get="git switch --detach ${c:-<commit>}" ;; esac   # no branch: the commit itself
    # first the prompt: when it does not arrive, the topic stays with the transfer (the handover can be run again)
    agent_send "$tm" "$tp" "Steal & Transfer: take over \"$title\" (bhote topic $id) from $from. The work is on branch ${b:-?} (commit ${c:0:12}): if there is a remote, git fetch; then $get; read the handover with git log -1 ${c:-HEAD}; then continue the work. $(how_to_finish "$id")." || return 1
    topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$tm"; topic_set "$f" agent_pane "$tp"; topic_set "$f" agent_session "$LIVE_SESS"
    topic_set "$f" delegated "$(date +%s)"; topic_set "$f" status now
    topic_set "$f" transfer_to ""; topic_set "$f" transfer_to_name ""; topic_set "$f" transfer_from ""
    topic_set "$f" handover_branch "$b"; topic_set "$f" handover_commit "$c"
    notify "Transferred" "$title → $name" done
    : > "$STORE_DIRTY"
}
delegation_text() {  # delegation_text <file>: the prompt an agent gets: the topic, and how it reports back
    local f=$1 id title desc how
    id=$(topic_id "$f"); title=$(topic_get "$f" title); desc=$(topic_get "$f" description)
    printf '%s%s (bhote topic %s: %s.)' "$title" "${desc:+. $desc}" "$id" "$(how_to_finish "$id")"
}
pick_do() {  # pick_do <index>: hand the topic to that agent (as a prompt through herdr) and mark it started; or transfer it
    local f m id st name task opt=() title desc live sess; f=$(sel_file); [ -n "$f" ] || return 0
    if [ "$PICK_MODE" = transfer ]; then
        [ "$1" -ge 1 ] || return 0                                  # (index -1 would be the LAST agent in bash 4)
        pick_build; [ -n "${PICK_MAP[$(( $1 - 1 ))]:-}" ] || return 0
        IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( $1 - 1 ))]}]}"
        local warn="" tpj; tpj=$(topic_get "$f" project)
        if [ -n "$tpj" ]; then agent_meta "$m" "$id"; [ "$AM_PROJECT" = "$tpj" ] || warn=" (NOT an agent of this topic's project!)"; fi
        ask "Hand \"$(topic_get "$f" title)\" over from $(topic_get "$f" agent agent) to $name$warn? The source agent commits and stops. y/N: " || return 0   # a stray t and ⏎ must not start a hand-over
        [ "$ANSWER" = y ] || [ "$ANSWER" = Y ] || return 0
        [ -n "$warn" ] && TRANSFER_FORCE=1
        transfer_start "$f" "$(topic_get "$f" agent_machine)" "$(topic_get "$f" agent_pane)" "$(topic_get "$f" agent agent)" "$m" "$id" "$name" 2>/dev/null
        TRANSFER_FORCE=""; return 0
    fi
    if [ "$1" -gt 0 ]; then
        pick_build
        [ -n "${PICK_MAP[$(( $1 - 1 ))]:-}" ] || return 0
        IFS=$US read -r m id st name task <<< "${AG_LINES[${PICK_MAP[$(( $1 - 1 ))]}]}"
        agent_state_set st "$m" "$id"; case "$st" in idle|done) ;; *) return 0 ;; esac     # taken in the meantime: change nothing
        [ "$m" = "$HOST" ] || opt=(--machine "$m")
        # the lists are a few seconds old: right before typing, ask herdr itself that this pane still runs a FREE agent
        # (a pane that is now a plain shell would execute the text)
        live=$(herdr_m ${opt[@]+"${opt[@]}"} pane list | jq -r --arg p "$id" '[.result.panes[] | select(.pane_id == $p)][0] | if . == null then "gone" elif (.agent // "") == "" then "noagent" else ((.agent_status // "") + "\u001f" + ((.agent_session.value // "") | tostring | gsub("[^A-Za-z0-9-]"; ""))) end' 2>/dev/null)
        st=${live%%$US*}; sess=""; case "$live" in *"$US"*) sess=${live#*$US} ;; esac
        case "$st" in idle|done) ;; *) return 0 ;; esac
    fi
    topic_set "$f" status now; topic_set "$f" waiting_for ""
    if [ "$1" -gt 0 ]; then
        topic_set "$f" agent "$name"; topic_set "$f" agent_machine "$m"; topic_set "$f" agent_pane "$id"
        topic_set "$f" agent_session "$sess"; topic_set "$f" delegated "$(date +%s)"
        agent_send "$m" "$id" "Your bhote topic: $(delegation_text "$f")"
    else
        local k; for k in agent agent_machine agent_pane agent_session delegated; do topic_set "$f" "$k" ""; done
    fi
    : > "$STORE_DIRTY"
}
menu_do() {  # menu_do <index>: run the chosen action on the selected topic; 0 = stay in the menu, 1 = leave it
    local f k; f=$(sel_file); [ -n "$f" ] || return 1
    menu_build "$f"; k=${MENU_ITEMS[$1]%%|*}
    case "$k" in
        start) PICK_MODE=start; PICK_IDX=0; view=pick; return 0 ;;     # the picker of free agents (view is bhote_main's variable)
        transfer) PICK_MODE=transfer; PICK_IDX=1; view=pick; return 0 ;;
        resume) topic_resume "$f" ;;
        wait) ask "Waiting for: " "$(topic_get "$f" waiting_for)"; [ -n "$ANSWER" ] || return 0
           topic_set "$f" status waiting; topic_set "$f" waiting_for "$ANSWER"; topic_set "$f" waiting_since "$(date +%s)"; slack_rewait "$f" ;;
        project) local cur nx="" i2; cur=$(topic_get "$f" project); projects_load   # none → the first → … → the last → none
           if [ -z "$cur" ]; then nx=${P_ID[0]:-}; else for (( i2 = 0; i2 < P_N; i2++ )); do [ "${P_ID[$i2]}" = "$cur" ] && { nx=${P_ID[$(( i2 + 1 ))]:-}; break; }; done; fi
           topic_set "$f" project "$nx"; return 0 ;;
        slack) if [ -n "$(topic_get "$f" slack_channel)" ]; then slack_pin "$f" off; return 0; fi
           ask "Slack: a link, #channel, @person or a name: " || return 0; [ -n "$ANSWER" ] || return 0
           case "$ANSWER" in http*) ;; *) FLASH_MSG="… asking Claude for $ANSWER (a few seconds)"; FLASH_UNTIL=$(( SECONDS + 120 )); bhote_paint menu ;; esac
           local perr; perr=$(slack_pin "$f" "$ANSWER" 2>&1 >/dev/null)
           if [ -z "$perr" ] || [ -n "$(topic_get "$f" slack_channel)" ]; then
               FLASH_MSG="✓ pinned $(topic_get "$f" slack_label)$( [ "$(topic_get "$f" status)" = waiting ] && echo ': watched while it waits' || echo ': watched once it waits')"
               [ "$(cfg_get SLACK_WATCH off)" = on ] || FLASH_MSG="$FLASH_MSG (Slack monitor is off here: settings › Connections)"
           else FLASH_MSG="✗ ${perr#bhote: }"; fi
           FLASH_UNTIL=$(( SECONDS + 8 )); return 0 ;;
        cancelxfer) topic_set "$f" transfer_to ""; topic_set "$f" transfer_to_name ""; topic_set "$f" transfer_from "" ;;
        reopen) topic_set "$f" status now; topic_set "$f" waiting_for "" ;;
        next) topic_set "$f" status next ;;
        later) topic_set "$f" status later ;;
        done) topic_set "$f" status done ;;
        rename) ask "Title: " "$(topic_get "$f" title)" || return 0; [ -n "$ANSWER" ] && topic_set "$f" title "$ANSWER"; [ -n "$ANSWER" ] || return 0 ;;
        describe) ask "Description: " "$(topic_get "$f" description)" "$DESC_MAX" || return 0     # Esc keeps the old text; an emptied line removes it
           topic_set "$f" description "$ANSWER" ;;
        delete) ask "Delete \"$(topic_get "$f" title)\"? y/N: "; [ "$ANSWER" = y ] || [ "$ANSWER" = Y ] || return 0
           topic_set "$f" deleted 1; SEL_ID="" ;;
        *) ;;
    esac
    return 1
}
review_act() {  # review_act <file> [button 1-3, default 1]: a button of a review card: the agent gets its reply (as if you typed it), the topic goes on now
    local f=$1 n=${2:-1} ask rep am ap ag; [ -f "$f" ] || return 1
    [ "$(topic_get "$f" status)" = review ] || return 1
    ask=$(topic_get "$f" review_ask); rep=$(topic_get "$f" review_reply); [ -n "$ask" ] || return 1
    while [ "$n" -gt 1 ]; do case "$ask" in *¦*) ask=${ask#*¦}; rep=${rep#*¦} ;; *) return 1 ;; esac; n=$(( n - 1 )); done
    rep=${rep%%¦*}
    if [ "$rep" = @jump ]; then                                  # "Review ansehen": show the agent, the topic stays where it is
        [ -n "$(topic_get "$f" agent_pane)" ] && agent_jump "$(topic_get "$f" agent_machine)" "$(topic_get "$f" agent_pane)"; return 0
    fi
    am=$(topic_get "$f" agent_machine); ap=$(topic_get "$f" agent_pane); ag=$(topic_get "$f" agent)
    if [ -n "$ap" ] && [ -n "$rep" ]; then
        agent_live "$am" "$ap"
        case "$LIVE_ST" in gone|noagent) notify "bhote" "${ag:-The agent} is not there any more: nothing sent" request; return 1 ;; esac
        agent_send "$am" "$ap" "$rep" || return 1
    fi
    topic_set "$f" status now; poke
}
topic_file_of() { printf '%s/%s.topic' "$TOPIC_DIR" "${1//[!A-Za-z0-9_-]/}"; }
topic_resume() {  # topic_resume <file>: a waiting topic of an agent: the wait is over, the agent goes on (a prompt through herdr)
    local f=$1 id title wf desc am ap ag
    id=$(topic_id "$f"); title=$(topic_get "$f" title); wf=$(topic_get "$f" waiting_for); desc=$(topic_get "$f" description)
    am=$(topic_get "$f" agent_machine); ap=$(topic_get "$f" agent_pane); ag=$(topic_get "$f" agent)
    topic_set "$f" status now; topic_set "$f" waiting_for ""; topic_set "$f" delegated "$(date +%s)"
    [ -n "$ap" ] || return 0
    agent_live "$am" "$ap"; case "$LIVE_ST" in gone|noagent) echo "bhote: ${ag:-the agent} is not there any more" >&2; return 0 ;; unknown) echo "bhote: could not ask herdr about ${ag:-the agent}; sending the prompt anyway" >&2 ;; esac
    agent_send "$am" "$ap" "The wait is over${wf:+ ($wf)}: $title${desc:+. Go on with: $desc} (bhote topic $id: $(how_to_finish "$id"))."
}
prompt_new_topic() {  # [text to start with] "Title", "Title; description", "Title @Name" or "Title > Name" (= waiting for Name); the new topic gets selected
    ask "Topic: " "${1:-}" || return 1
    new_topic_from "$ANSWER"
}
new_topic_from() {  # new_topic_from <text>: the same syntax as the prompt, without asking; NEW_TOPIC_ID, and it gets selected
    local title=$1 who="" desc=""
    case "$title" in *" @"*) who=${title##* @}; title=${title% @*} ;; *" > "*) who=${title##* > }; title=${title% > *} ;; esac   # the name goes last
    case "$title" in *";"*) desc=${title#*;}; title=${title%%;*} ;; esac
    title=${title%"${title##*[! ]}"}; desc=${desc#"${desc%%[! ]*}"}
    topic_new "$title" "$who" "$desc" && SEL_ID=$NEW_TOPIC_ID || return 1
    [ -n "${CUR_PROJ:-}" ] && topic_set "$TOPIC_DIR/$NEW_TOPIC_ID.topic" project "$CUR_PROJ"   # made in a project's tab: that project
    return 0
}

# ── Slack pins: a waiting topic can carry a Slack channel, DM or thread (slack_channel, slack_thread, slack_label). With
# SLACK_WATCH=on the collector of this machine asks Claude Code every SLACK_EVERY seconds (claude -p, Haiku, only the read-only
# Slack tools of its connector: bhote holds no Slack token) for messages newer than slack_seen; one from someone else sets the
# topic to review (slack_msg: who and what). A topic Slack put under review stays watched: what follows joins its message. BHOTE_CLAUDE replaces the claude command (the tests use a fake).
SLACK_TOOLS="mcp__claude_ai_Slack__slack_read_channel mcp__claude_ai_Slack__slack_read_thread mcp__claude_ai_Slack__slack_read_user_profile mcp__claude_ai_Slack__slack_search_channels mcp__claude_ai_Slack__slack_search_users"
claude_json() {  # claude_json <prompt> [timeout s]: one headless Claude call with the Slack tools; prints the JSON of its answer
    local cl=${BHOTE_CLAUDE:-claude} dir="$DATA_DIR/slack" out p k prof envp=()
    cfg_var prof CLAUDE_CONFIG_DIR ""; prof=${prof/#\~/$HOME}; [ -n "$prof" ] && envp=("CLAUDE_CONFIG_DIR=$prof")   # the profile with the Slack connector
    command -v "$cl" >/dev/null 2>&1 || return 3
    mkdir -p "$dir"; out=$(mktemp "$RUN_DIR/claude.XXXXXX")
    # outside herdr's view (no agent in this pane) and not as a nested session; in a folder of its own (no project files).
    # Slack text is untrusted: no built-in tools, none of the user's allow rules (--setting-sources project), nothing outside --allowedTools
    ( cd "$dir" && exec env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID -u HERDR_SOCKET_PATH -u CLAUDECODE \
        -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_ENTRYPOINT ${envp[@]+"${envp[@]}"} "$cl" -p "$1" --model haiku --tools "" --setting-sources project --permission-mode dontAsk --allowedTools $SLACK_TOOLS \
        --no-session-persistence --output-format json ) > "$out" 2>/dev/null </dev/null & p=$!
    ( trap 'kill "$w" 2>/dev/null; exit 0' TERM; sleep "${2:-120}" & w=$!; wait "$w"; kill "$p" 2>/dev/null ) >/dev/null 2>&1 </dev/null & k=$!
    wait "$p" 2>/dev/null; kill "$k" 2>/dev/null; wait "$k" 2>/dev/null   # (the watchdog takes its sleep along: no output kept open)
    jq -r 'select(.is_error != true) | .result // empty' "$out" 2>/dev/null | sed -e '/^```/d' | jq -c . 2>/dev/null; local rc=$?
    rm -f "$out"; return $rc
}
slack_pin_parse() {  # slack_pin_parse <link | #channel | @person>: SP_CH, SP_TS (a thread), SP_LABEL; SP_NAME when Claude has to look it up
    local a=$1 rest; SP_CH=""; SP_TS=""; SP_LABEL=""; SP_NAME=""
    case "$a" in
        http*://*.slack.com/archives/*)
            rest=${a#*/archives/}; SP_CH=${rest%%[/?#]*}
            case "$rest" in */p[0-9]*) SP_TS=${rest#*/p}; SP_TS=${SP_TS%%[!0-9]*}; [ "${#SP_TS}" -gt 6 ] && SP_TS="${SP_TS:0:${#SP_TS}-6}.${SP_TS:${#SP_TS}-6}" ;; esac
            case "$a" in *thread_ts=*) SP_TS=${a#*thread_ts=}; SP_TS=${SP_TS%%[!0-9.]*} ;; esac   # a reply in a thread: its thread
            case "$SP_CH" in D*) SP_LABEL="DM" ;; *) SP_LABEL="channel" ;; esac; [ -n "$SP_TS" ] && SP_LABEL="thread" ;;
        \#?*|@?*) SP_NAME=$a; SP_LABEL=$a ;;
        *[![:space:]]*) [ "${#a}" -le 80 ] || return 1; SP_NAME=$a; SP_LABEL=$a ;;   # a plain name: a person (their DM) or a channel
        *) return 1 ;;
    esac
    case "$SP_CH" in *[!A-Z0-9]*) return 1 ;; esac; case "$SP_TS" in *[!0-9.]*) return 1 ;; esac
    return 0
}
slack_resolve() {  # slack_resolve <#channel | @person | name>: SP_CH (a channel id, or a user id for the DM), SP_LABEL; SP_ERR why not
    local j what kind name; SP_ERR=""
    case "$1" in
        @*) what="user whose name or display name is '${1#@}' (slack_search_users)" ;;
        \#*) what="channel named '${1#\#}' (slack_search_channels, public and private)" ;;
        *) what="user or channel called '$1': a person's name means the user (slack_search_users), otherwise a channel (slack_search_channels, public and private)" ;;
    esac
    command -v "${BHOTE_CLAUDE:-claude}" >/dev/null 2>&1 || { SP_ERR="no claude command here (Claude Code with its Slack connector)"; return 1; }
    j=$(claude_json "Find the Slack $what. Reply with only JSON: {\"id\":\"<the id>\",\"kind\":\"user\" or \"channel\",\"name\":\"<its name>\"}, or {\"id\":null} when there is no clear match." 90) \
        || { SP_ERR="Claude did not answer (is its Slack connector set up?)"; return 1; }
    SP_CH=$(printf '%s' "$j" | jq -r '.id // empty' 2>/dev/null); kind=$(printf '%s' "$j" | jq -r '.kind // empty' 2>/dev/null)
    name=$(printf '%s' "$j" | jq -r '.name // empty' 2>/dev/null | tr -d '[:cntrl:]' | cut -c1-40)
    case "$SP_CH" in ''|*[!A-Z0-9]*) SP_CH=""; SP_ERR="no clear match for '$1' in Slack"; return 1 ;; esac
    case "$1" in @*|\#*) ;; *) if [ "$kind" = channel ] || [ "${SP_CH#C}" != "$SP_CH" ]; then SP_LABEL="#${name:-$1}"; else SP_LABEL="@${name:-$1}"; fi ;; esac
    return 0
}
slack_rewait() {  # slack_rewait <file>: waits again: no Slack message from before counts (the newer of now and the last seen one)
    local f=$1 seen now; topic_set "$f" slack_msg ""
    [ -n "$(topic_get "$f" slack_channel)" ] || return 0
    seen=$(topic_get "$f" slack_seen 0); now="$(date +%s).000000"
    awk -v a="$now" -v b="$seen" 'BEGIN { exit !(a + 0 > b + 0) }' && topic_set "$f" slack_seen "$now"
    return 0
}
slack_pin() {  # slack_pin <file> <link | #channel | @person | off>: pins (or unpins) a Slack channel, DM or thread on the topic
    local f=$1
    if [ "$2" = off ] || [ "$2" = none ]; then
        for k in slack_channel slack_thread slack_label slack_seen slack_msg; do topic_set "$f" "$k" ""; done; return 0
    fi
    slack_pin_parse "$2" || { echo "bhote: a Slack link (copy link), #channel, @person or a name" >&2; return 1; }
    if [ -n "$SP_NAME" ]; then slack_resolve "$SP_NAME" || { echo "bhote: Slack: ${SP_ERR:-$SP_NAME not found}" >&2; return 1; }; fi
    topic_set "$f" slack_channel "$SP_CH"; topic_set "$f" slack_thread "$SP_TS"; topic_set "$f" slack_label "$SP_LABEL"
    topic_set "$f" slack_seen "$(date +%s).000000"; topic_set "$f" slack_msg ""
}
slack_me() {  # slack_me: the Slack user id of this Claude connector (kept in $DATA_DIR/slack/me); SLACK_NAME = its name
    local j id; SLACK_NAME=""
    j=$(claude_json "Call slack_read_user_profile once (no user_id). Reply with only JSON: {\"id\":\"<user id>\",\"name\":\"<display name>\"}" 60) || return 1
    id=$(printf '%s' "$j" | jq -r '.id // empty' 2>/dev/null); SLACK_NAME=$(printf '%s' "$j" | jq -r '.name // empty' 2>/dev/null | tr -d '[:cntrl:]')
    case "$id" in ''|*[!A-Z0-9]*) return 1 ;; esac
    mkdir -p "$DATA_DIR/slack"; printf '%s\n' "$id" > "$DATA_DIR/slack/me"
}
slack_check() {  # one round of the watch: every waiting topic with a pin, in one Claude call
    local i f pins="" seens="" me j n=0 id st ts maxts who txt
    topics_load
    for (( i = 0; i < T_N; i++ )); do
        f=${T_FILE[$i]}
        case "${T_STATUS[$i]}" in waiting) ;; review) [ -n "$(topic_get "$f" slack_msg)" ] || continue ;; *) continue ;; esac   # (review: Slack put it there, a follow-up joins)
        local ch th seen; ch=$(topic_get "$f" slack_channel); [ -n "$ch" ] || continue
        th=$(topic_get "$f" slack_thread); seen=$(topic_get "$f" slack_seen 0)
        case "$ch" in *[!A-Z0-9]*) continue ;; esac; case "$th" in *[!0-9.]*) continue ;; esac; case "$seen" in ''|*[!0-9.]*) seen=0 ;; esac   # (pins from synced files go into the prompt)
        pins="$pins${pins:+,}$(printf '{"topic":%s,"channel_id":%s,"thread_ts":%s,"oldest":%s}' "$(json_str "${T_ID[$i]}")" "$(json_str "$ch")" "$(json_opt "$th")" "$(json_str "$seen")")"; n=$(( n + 1 ))
        seens="$seens${seens:+,}$(json_str "${T_ID[$i]}"):$(json_str "$seen")"
    done
    [ "$n" -gt 0 ] || return 0
    me=$(cat "$DATA_DIR/slack/me" 2>/dev/null); [ -n "$me" ] || { slack_me && me=$(cat "$DATA_DIR/slack/me" 2>/dev/null); }   # who I am: once
    j=$(claude_json "You check Slack for new messages, read-only. For each pin in this list: when thread_ts is set, call slack_read_thread(channel_id, message_ts=thread_ts, oldest), else slack_read_channel(channel_id, oldest, limit 20). Pins: [$pins]. Reply with only JSON, no prose: {\"pins\":[{\"topic\":\"<topic>\",\"error\":<null or short text>,\"messages\":[{\"ts\":\"<ts>\",\"user\":\"<user id>\",\"name\":\"<display name>\",\"text\":\"<the text exactly as Slack has it (mrkdwn, line breaks as \\n), at most 1500 characters>\"}]}]}. List only messages newer than oldest, the thread parent never." 150)
    if [ -z "$j" ]; then printf 'error %s\n' "$(date +%s)" > "$SHARED_DIR/slack.status"; return 1; fi
    while IFS=$US read -r id maxts who txt; do
        [ -n "$id" ] || continue; f="$TOPIC_DIR/$id.topic"; [ -f "$f" ] || continue
        st=$(topic_get "$f" status); seen=$(topic_get "$f" slack_seen 0)
        case "$maxts" in ''|*[!0-9.]*) continue ;; esac
        awk -v a="$maxts" -v b="$seen" 'BEGIN { exit !(a + 0 > b + 0) }' || continue
        topic_set "$f" slack_seen "$maxts"
        [ -n "$who" ] || continue
        if [ "$st" = waiting ]; then                               # someone else wrote: the topic waits for you now
            topic_set "$f" status review; topic_set "$f" slack_msg "$who: $txt"
            notify "Slack: $(topic_get "$f" title)" "$who: $txt" request
        elif [ "$st" = review ]; then                              # more came in (a sentence often goes on in a second message): it joins
            local old ow ot n; old=$(topic_get "$f" slack_msg); ow=${old%%: *}; ot=${old#*: }; [ "$ow" = "$old" ] && { ow=""; ot=$old; }
            while [ -n "$who" ]; do n=${who%%, *}; [ "$n" = "$who" ] && who="" || who=${who#*, }
                case ", $ow, " in *", $n, "*) ;; *) ow="${ow:+$ow, }$n" ;; esac; done
            ot="$ot ¶ ¶ $txt"; [ "${#ot}" -gt 3000 ] && ot="… ${ot:${#ot}-2990}"   # the newest part counts
            topic_set "$f" slack_msg "$ow: $ot"
            notify "Slack: $(topic_get "$f" title)" "${n:-$ow}: $txt" request
        fi
    done <<< "$(printf '%s' "$j" | jq -r --arg me "$me" --argjson seen "{$seens}" '
        def clean: tostring | gsub("[\u0000-\u001f\u007f]"; " ");
        def plain: gsub("<@[A-Z0-9]+\\|(?<n>[^>]+)>"; "@\(.n)") | gsub("<[!#@][^>|]*\\|(?<n>[^>]+)>"; "\(.n)") | gsub("<(?<u>https?:[^>|]+)\\|(?<t>[^>]+)>"; .t)
            | gsub("<(?<u>https?:[^>]+)>"; .u) | gsub("<@[A-Z0-9]+>"; "@someone") | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&amp;"; "&")
            | gsub("  +"; " ");   # Slack markup out (mentions, links, entities); *bold* and `code` stay for the topic page
        .pins[]? | select(.topic | test("^[A-Za-z0-9_-]+$")) | . as $p
        | ([.messages[]? | select((.ts // "" | tostring | test("^[0-9]+\\.[0-9]+$")) and (.ts != ($p.thread_ts // "")) and ((.ts | tonumber) > ($seen[$p.topic] // "0" | tonumber)))] | sort_by(.ts | tonumber)) as $m
        | (if $me == "" then [] else [$m[] | select(.user != $me)] end) as $o   # all of someone else (who I am unknown: only move on)
        | [$p.topic, ($m | last | .ts // ""),
           ($o | map(.name // .user // "someone" | clean) | reduce .[] as $n ([]; if index([$n]) then . else . + [$n] end) | join(", ")),
           ($o | map(.text // "" | gsub("\\r"; "") | gsub("\\n[ \\t]*\\n\\s*"; " ¶ ¶ ") | gsub("\\n"; " ¶ ") | clean | plain) | join(" ¶ ¶ ") | .[0:1500])] | join("\u001f")' 2>/dev/null)"
    printf 'ok %s\n' "$(date +%s)" > "$SHARED_DIR/slack.status"
    poke
}

# ── the deployment and the test monitor (DEPLOY_MONITOR, TEST_MONITOR): the last deployments and test runs of the projects,
# above the agents. A project carries its CI in its record (synced like the project): ci = github:<owner/repo> or
# circleci:<gh/owner/repo>, deploy_branches (github: main; circleci: develop=Staging,main=Production), deploy_names (github:
# "Backend Deployment=Server,…" workflow=label; circleci: deploy job names; empty: every name with "deploy" in it) and
# test_names (job names; empty: every job with "test" in it, on CircleCI also "build"). monitor_detect finds them from the
# repository on GitHub. The connections: GitHub Actions through gh (its own login), CircleCI through its API v2 with a token.
# The collector of a machine with a monitor on fetches every DEPLOY_EVERY / TEST_EVERY seconds in the background and writes
# $SHARED_DIR/deploys.list and tests.list, newest first: time US project US label US state US done US total US note US url
# (state: running, queued, approval, ok, failed, canceled). Local test runs: `bhote test run -- <command>` (any framework;
# the summary line of Minitest, Vitest, RSpec, pytest and bhote's own tests is read) and live status files (TEST_STATUS_DIR,
# one JSON per suite, see docs/monitors.md).
MON_DIR="$DATA_DIR/testruns"
circleci_token() {  # the CircleCI token: CIRCLECI_TOKEN in the config, else in the environment
    local t; cfg_var t CIRCLECI_TOKEN ""
    [ -n "$t" ] || t=${CIRCLECI_TOKEN:-${CIRCLE_TOKEN:-}}
    printf '%s' "${t//[!A-Za-z0-9_-]/}"
}
circleci_token_from() {  # where the token comes from (for the settings and the setup), or 1
    local t; cfg_var t CIRCLECI_TOKEN ""; [ -n "$t" ] && { echo "bhote config"; return 0; }
    [ -n "${CIRCLECI_TOKEN:-${CIRCLE_TOKEN:-}}" ] && { echo "environment"; return 0; }
    return 1
}
circleci_get() {  # circleci_get <API v2 path>: its JSON; 1 without a token or on an error. The token goes to curl on stdin (never on a command line)
    local t; t=$(circleci_token); [ -n "$t" ] || return 1
    case "$1" in *[!A-Za-z0-9/_.?=\&-]*) return 1 ;; esac
    printf 'header = "Circle-Token: %s"\n' "$t" | curl -sf --max-time 8 -K - "https://circleci.com/api/v2/$1"
}
with_timeout() {  # with_timeout <seconds> <command…>: its output, its status; killed (status 143) when it does not end in time
    local o p k rc d=${TMPDIR:-/tmp}; [ -d "${RUN_DIR:-}" ] && d=$RUN_DIR
    o=$(mktemp "$d/to.XXXXXX") || return 1
    "${@:2}" > "$o" 2>/dev/null </dev/null & p=$!
    ( trap 'kill "$w" 2>/dev/null; exit 0' TERM; sleep "$1" & w=$!; wait "$w"; kill "$p" 2>/dev/null ) >/dev/null 2>&1 </dev/null & k=$!
    wait "$p" 2>/dev/null; rc=$?
    while kill -0 "$p" 2>/dev/null; do wait "$p" 2>/dev/null; rc=$?; done   # (a trapped signal, e.g. a resize, ends a wait early)
    kill "$k" 2>/dev/null; wait "$k" 2>/dev/null
    cat "$o"; rm -f "$o"; return "$rc"
}
gh_t() { with_timeout 25 gh "$@"; }   # a gh call that cannot hang the monitor
gh_ok() {  # 0 when gh is there and logged in (a yes is kept for the life of the process, a no is asked again)
    [ "${GH_OK:-}" = 0 ] && return 0
    if command -v gh >/dev/null 2>&1 && with_timeout 15 gh auth status >/dev/null 2>&1; then GH_OK=0; return 0; fi
    return 1
}
gh_user() { gh api user --jq .login 2>/dev/null; }
mon_label() {  # mon_label <name> <map "a=A,b=B">: the label of a workflow or job (its map entry, else the name without "Deployment"/"deploy-")
    local n=$1 e IFS=,
    for e in $2; do [ "${e%%=*}" = "$n" ] && { [ "${e#*=}" != "$e" ] && printf '%s' "${e#*=}" || printf '%s' "$n"; return 0; }; done
    unset IFS; n=${n% Deployment}; n=${n% deployment}; n=${n#deploy-}; n=${n#Run }; printf '%s' "$n"
}
mon_match() {  # mon_match <name> <map> <default word(s), regex>: 0 when the name is in the map (or, with an empty map, matches the words)
    local e IFS=,
    if [ -n "$2" ]; then for e in $2; do [ "${e%%=*}" = "$1" ] && return 0; done; return 1; fi
    unset IFS; printf '%s' "$1" | grep -qiE "$3"
}
mon_deploy_branches() {  # stdin: a CircleCI config.yml -> branch=Label,… of its deploy jobs (filters: branches: only:)
    awk '
        function ind(l) { match(l, /^ */); return RLENGTH }
        function emit(b,   l, bs, i) { l = tolower(job) ~ /prod/ ? "Production" : (tolower(job) ~ /stag/ ? "Staging" : job)
            n = split(b, bs, ","); for (i = 1; i <= n; i++) if (bs[i] != "" && !(bs[i] in seen)) { seen[bs[i]] = 1; out = out (out ? "," : "") bs[i] "=" l } }
        BEGIN { jind = -1 }
        /^workflows:/ { wf = 1; next }
        wf && /^[^ #]/ { wf = 0 }
        !wf { next }
        {
            i = ind($0)
            if ($0 ~ /^ *- *[A-Za-z0-9_-]+:? *$/ && (jind < 0 || i <= jind)) {   # a job of a workflow (not a list inside one)
                s = $0; sub(/^ *- */, "", s); gsub(/[ :]/, "", s); job = (tolower(s) ~ /deploy/) ? s : ""; jind = i; want = 0; next }
            if (job == "") next
            if (want && $0 ~ /^ *- /) { v = $0; sub(/^ *- */, "", v); gsub(/["\047 ]/, "", v); emit(v); next }
            if ($0 ~ /only:/) { v = $0; sub(/.*only: */, "", v); gsub(/[]["\047 ]/, "", v); if (v == "") { want = 1; next }; want = 0; emit(v); next }
            if ($0 ~ /^ *[A-Za-z_-]+:/) want = 0
        }
        END { print out }'
}
monitor_detect() {  # monitor_detect <project file>: MD_CI, MD_BRANCHES, MD_NAMES, MD_TESTS from its GitHub repository; 1 when there is none
    local pf=$1 repos k slug y def
    MD_CI=""; MD_BRANCHES=""; MD_NAMES=""; MD_TESTS=""; MD_WHY=""
    repos=$(topic_get "$pf" repos); slug=""
    local IFS=,; for k in $repos; do case "$k" in github.com/*/*) slug=${k#github.com/}; break ;; esac; done; unset IFS
    [ -n "$slug" ] || { MD_WHY="no GitHub repository pinned"; return 1; }
    gh_ok || { MD_WHY="gh is not logged in (gh auth login)"; return 1; }
    y=$(gh_t api "repos/$slug/contents/.circleci/config.yml" --jq .content 2>/dev/null | tr -d '\n' | base64 -d 2>/dev/null)
    if [ -n "$y" ]; then                                       # CircleCI: the deploy jobs and the branches they run on
        MD_CI="circleci:gh/$slug"
        MD_BRANCHES=$(printf '%s\n' "$y" | mon_deploy_branches)
        return 0
    fi
    local wfs; wfs=$(gh_t workflow list -R "$slug" --json name --jq '.[].name' 2>/dev/null)
    [ -n "$wfs" ] || { MD_WHY="no CI found (no .circleci/config.yml, no GitHub workflows)"; return 1; }
    MD_CI="github:$slug"                                       # GitHub Actions: the workflows called "…deploy…", on the default branch
    MD_NAMES=$(printf '%s\n' "$wfs" | grep -i deploy | awk '{ l = $0; sub(/ [Dd]eployment$/, "", l); printf "%s%s=%s", (n++ ? "," : ""), $0, l }')
    def=$(gh_t repo view "$slug" --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null)
    MD_BRANCHES=${def:-main}
    return 0
}
monitor_detect_save() {  # monitor_detect_save <project file>: detects and writes the keys; 1 when nothing was found
    monitor_detect "$1" || return 1
    topic_set "$1" ci "$MD_CI"; topic_set "$1" deploy_branches "$MD_BRANCHES"; topic_set "$1" deploy_names "$MD_NAMES"
    : > "$STORE_DIRTY"
}
monitor_describe() {  # monitor_describe <project file>: one line: where its CI is and what is watched
    local ci br nm; ci=$(topic_get "$1" ci); br=$(topic_get "$1" deploy_branches); nm=$(topic_get "$1" deploy_names)
    [ -n "$ci" ] || { printf 'no CI'; return; }
    case "$ci" in
        github:*) if [ -n "$nm" ]; then printf 'GitHub Actions %s · deploys on %s: %s' "${ci#github:}" "${br:-main}" "$(printf '%s' "$nm" | awk -v RS=, -F= 'NF { printf "%s%s", (n++ ? ", " : ""), ($2 != "" ? $2 : $1) }')"
                  else printf 'GitHub Actions %s · no deploy workflow' "${ci#github:}"; fi ;;
        circleci:*) printf 'CircleCI %s · %s' "${ci#circleci:}" "$(printf '%s' "${br:-every branch}" | sed 's/,/, /g; s/=/ → /g')" ;;
    esac
}
mon_iso() { jq -r 'sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601' 2>/dev/null <<< "\"$1\""; }   # ISO time -> Unix seconds
mon_line() {  # mon_line <time> <project> <label> <state> <done> <total> <note> <url>: one entry
    local a out="" i=0; for a in "$@"; do i=$(( i + 1 )); out="$out${a//[[:cntrl:]]/ }"; [ "$i" -lt $# ] && out="$out$US"; done
    printf '%s\n' "$out"
}
deploys_github() {  # deploys_github <project> <owner/repo> <branches> <names>: filtered on the server (the last runs of each workflow, or of each branch)
    local runs="" part e b id wf st cc cr br url title t s d tot got=0 f="databaseId,workflowName,status,conclusion,createdAt,headBranch,displayTitle,url"
    local names=() brs=() IFS=,
    for e in $4; do [ -n "${e%%=*}" ] && names[${#names[@]}]=${e%%=*}; done
    for b in ${3:-main}; do brs[${#brs[@]}]=$b; done
    unset IFS
    if [ ${#names[@]} -gt 0 ]; then
        for e in "${names[@]}"; do for b in "${brs[@]}"; do   # (per workflow AND branch: the last runs of other branches must not push the deploy branch out)
            part=$(gh_t run list -R "$2" --workflow "$e" --branch "$b" --limit 5 --json "$f") && { runs="$runs$part"$'\n'; got=1; }; done; done
    else
        for b in "${brs[@]}"; do part=$(gh_t run list -R "$2" --branch "$b" --limit 50 --json "$f") && { runs="$runs$part"$'\n'; got=1; }; done
    fi
    [ "$got" = 1 ] || return 1
    runs=$(printf '%s' "$runs" | jq -s '(add // []) | unique_by(.databaseId)' 2>/dev/null) || return 1
    while IFS=$US read -r id wf st cc cr br title url; do
        case ",${3:-main}," in *",$br,"*) ;; *) continue ;; esac
        mon_match "$wf" "$4" deploy || continue
        case "$st:$cc" in
            completed:success) s=ok ;; completed:failure|completed:timed_out|completed:startup_failure) s=failed ;; completed:cancelled) s=canceled ;;
            completed:*) continue ;; waiting:*) s=approval ;; in_progress:*) s=running ;; *) s=queued ;;
        esac
        d=""; tot=""
        if [ "$s" = running ]; then read -r d tot < <(gh_t run view "$id" -R "$2" --json jobs --jq '[.jobs[].steps[]] | "\(map(select(.status == "completed")) | length) \(length)"' 2>/dev/null); fi
        case "$title" in *" from "*/*) title=${title##* from }; title=${title#*/} ;; esac
        mon_line "$(mon_iso "$cr")" "$1" "$(mon_label "$wf" "$4")" "$s" "$d" "$tot" "$title" "$url"
    done < <(printf '%s' "$runs" | jq -r '.[] | [.databaseId, .workflowName, .status, .conclusion, .createdAt, .headBranch, .displayTitle, .url] | map(tostring | gsub("[\u0000-\u001f]"; " ")) | join("\u001f")')
}
circleci_state() {  # a workflow's status -> ours (empty: leave it out)
    case "$1" in success) echo ok ;; failed|error|unauthorized) echo failed ;; failing|running) echo running ;; on_hold) echo approval ;; canceled) echo canceled ;; *) ;; esac
}
circleci_workflows() {  # circleci_workflows <slug> [branch] <pipelines>: per pipeline each workflow (the newest of a name): wid US status US created US number US subject US branch US jobs JSON
    local q="project/$1/pipeline" pid num subj br wj
    [ -n "$2" ] && q="$q?branch=$2"
    while IFS=$US read -r pid num subj br; do
        [ -n "$pid" ] || continue
        wj=$(circleci_get "pipeline/$pid/workflow") || continue
        printf '%s' "$wj" | jq -r --arg n "$num" --arg s "$subj" --arg b "$br" '(.items // []) | group_by(.name) | map(max_by(.created_at)) | .[] | [.id, .status, .created_at, $n, $s, $b] | join("\u001f")'
    done < <(circleci_get "$q" | jq -r --argjson k "$3" '.items[:$k][] | [.id, (.number | tostring), ((.vcs.commit.subject // "") | gsub("[\u0000-\u001f]"; " ")), (.vcs.branch // "")] | join("\u001f")' 2>/dev/null)
}
deploys_circleci() {  # deploys_circleci <project> <slug> <branch=Label,…> <job names>
    local e b lab wid st cr num subj br s jobs d tot map=${3:-}
    [ -n "$map" ] || map="="                                   # no branches given: every branch, labelled with the pipeline's own
    while IFS= read -r e; do
        b=${e%%=*}; lab=${e#*=}; [ -n "$e" ] || continue
        while IFS=$US read -r wid st cr num subj br; do
            s=$(circleci_state "$st"); [ -n "$s" ] || continue
            jobs=$(circleci_get "workflow/$wid/job") || continue
            printf '%s' "$jobs" | jq -e --arg m "${4:-}" '[.items[] | select(if $m == "" then (.name | test("deploy|approv"; "i")) else (.name as $n | $m | split(",") | map(split("=")[0]) | index($n)) end)] | length > 0' >/dev/null 2>&1 || continue
            read -r d tot < <(printf '%s' "$jobs" | jq -r '[.items[] | select(.status | test("^(success|failed|canceled|not_run|infrastructure_fail|timedout)$"))] as $f | "\($f | length) \(.items | length)"')
            mon_line "$(mon_iso "$cr")" "$1" "${lab:-$br}" "$s" "$d" "$tot" "${subj:0:60}" "https://app.circleci.com/pipelines/${2}/${num}/workflows/$wid"
        done < <(circleci_workflows "$2" "$b" 2)
    done <<< "$(printf '%s' "$map" | tr ',' '\n')"
}
tests_github() {  # tests_github <project> <owner/repo> <job names>: the test jobs of the last runs (a run's jobs are read once per state)
    local runs id wf st up br url jf j s n f p
    runs=$(gh_t run list -R "$2" --limit 8 --json databaseId,workflowName,status,updatedAt,headBranch,url 2>/dev/null) || return 1
    mkdir -p "$SHARED_DIR/ghjobs" 2>/dev/null
    while IFS=$US read -r id wf st up br url; do
        jf="$SHARED_DIR/ghjobs/$id-${up//[!0-9]/}"
        [ -s "$jf" ] || { gh_t run view "$id" -R "$2" --json jobs > "$jf.tmp" 2>/dev/null && mv "$jf.tmp" "$jf"; rm -f "$jf.tmp"; }
        j=$(jq -r --arg m "${3:-}" '[.jobs[] | select(if $m == "" then (.name | test("test"; "i")) else (.name as $n | $m | split(",") | index($n | sub(" \\([0-9]+/[0-9]+\\)$"; ""))) end)]
            | select(length > 0) | [ (if any(.status != "completed") then "running" elif any(.conclusion == "failure" or .conclusion == "timed_out") then "failed"
                elif all(.conclusion == "success" or .conclusion == "skipped") then "ok" else "canceled" end),
              (map(select(.status == "completed")) | length), length, (.[0].name | sub(" \\([0-9]+/[0-9]+\\)$"; "")), (map(.startedAt) | min) ] | map(tostring) | join("\u001f")' "$jf" 2>/dev/null)
        [ -n "$j" ] || continue
        IFS=$US read -r s f n p st <<< "$j"
        mon_line "$(mon_iso "$st")" "$1" "$p" "$s" "$f" "$n" "$br" "$url"
    done < <(printf '%s' "$runs" | jq -r '.[] | [.databaseId, .workflowName, .status, .updatedAt, .headBranch, .url] | map(tostring) | join("\u001f")')
    find "$SHARED_DIR/ghjobs" -type f -mmin +1440 -delete 2>/dev/null
}
tests_circleci() {  # tests_circleci <project> <slug> <job names>: the test jobs of the last pipelines (any branch)
    local wid st cr num subj br jobs j s d tot nm
    while IFS=$US read -r wid st cr num subj br; do
        jobs=$(circleci_get "workflow/$wid/job") || continue
        j=$(printf '%s' "$jobs" | jq -r --arg m "${3:-}" 'def term: IN("success","failed","canceled","not_run","infrastructure_fail","timedout","unauthorized","terminated-unknown","retried"); [.items[] | select(if $m == "" then (.name | test("test|build"; "i")) else (.name as $n | $m | split(",") | index($n)) end)]
            | select(length > 0) | [ (if any(.status | term | not) then "running" elif any(.status == "failed" or .status == "infrastructure_fail" or .status == "timedout") then "failed"
                elif all(.status == "success") then "ok" else "canceled" end), (map(select(.status | term)) | length), length, .[0].name ] | map(tostring) | join("\u001f")' 2>/dev/null)
        [ -n "$j" ] || continue
        IFS=$US read -r s d tot nm <<< "$j"
        mon_line "$(mon_iso "$cr")" "$1" "$nm" "$s" "$d" "$tot" "$br" "https://app.circleci.com/pipelines/${2}/${num}/workflows/$wid"
    done < <(circleci_workflows "$2" "" 4)
}
tests_local() {  # the local runs (bhote test run) and the live status files (TEST_STATUS_DIR)
    local f dir now line
    now=$(date +%s)
    for f in "$MON_DIR"/*.run; do
        [ -f "$f" ] || continue
        local st="" en="" ex="" pj="" nm="" sm="" tr="" pid=""
        while IFS= read -r line; do case "$line" in started=*) st=${line#*=} ;; ended=*) en=${line#*=} ;; exit=*) ex=${line#*=} ;; project=*) pj=${line#*=} ;; name=*) nm=${line#*=} ;; summary=*) sm=${line#*=} ;; tree=*) tr=${line#*=} ;; pid=*) pid=${line#*=} ;; esac; done < "$f"
        local s=running; if [ -n "$en" ]; then [ "$ex" = 0 ] && s=ok || s=failed; elif [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then s=canceled; fi
        mon_line "$st" "${pj:-$tr}" "$nm" "$s" "" "" "$sm" ""
    done
    dir=$(cfg_get TEST_STATUS_DIR "~/.cache/bhote/test-status"); dir=${dir/#\~/$HOME}
    for f in "$dir"/*.json; do
        [ -f "$f" ] || continue
        jq -r --argjson now "$now" '
            def c: tostring | gsub("[\u0000-\u001f\u007f]"; " ");
            def n: (. // "") | tostring | if test("^[0-9]+$") then . else "" end;
            select(.tree and .suite and .startedAt) | ((.updatedAt // .startedAt) / 1000 | floor) as $up
            | (if .ok == true then "ok" elif .ok == false then "failed" elif ($now - $up) > 30 then "canceled" else "running" end) as $s
            | [(.startedAt / 1000 | floor | tostring), (.tree | c), (.suite | c), $s, (.done | n), (.total | n),
               (((if (.failed // 0) > 0 then "\(.failed) failed · " else "" end) + "\(.passed // 0) passed") | c), ""] | join("\u001f")' "$f" 2>/dev/null
    done
}
monitor_fetch() {  # monitor_fetch deploys|tests: one round of every project with CI (and the local runs); the list, newest first
    local kind=$1 out tmp i ci br nm tn pn
    [ "$kind" = deploys ] || [ "$kind" = tests ] || return 1
    tmp=$(mktemp "$SHARED_DIR/$kind.XXXXXX") || return 1   # (same filesystem as the list: the move is atomic)
    projects_load
    {
        for (( i = 0; i < P_N; i++ )); do
            ci=$(topic_get "${P_FILE[$i]}" ci); [ -n "$ci" ] || continue
            br=$(topic_get "${P_FILE[$i]}" deploy_branches); nm=$(topic_get "${P_FILE[$i]}" deploy_names); tn=$(topic_get "${P_FILE[$i]}" test_names); pn=${P_NAME[$i]}
            case "$kind:$ci" in
                deploys:github:*) [ "$(cfg_get DEPLOY_GITHUB on)" = on ] && gh_ok && deploys_github "$pn" "${ci#github:}" "$br" "$nm" ;;
                deploys:circleci:*) [ "$(cfg_get DEPLOY_CIRCLECI on)" = on ] && deploys_circleci "$pn" "${ci#circleci:}" "$br" "$nm" ;;
                tests:github:*) [ "$(cfg_get TEST_GITHUB on)" = on ] && gh_ok && tests_github "$pn" "${ci#github:}" "$tn" ;;
                tests:circleci:*) [ "$(cfg_get TEST_CIRCLECI on)" = on ] && tests_circleci "$pn" "${ci#circleci:}" "$tn" ;;
            esac
        done
        [ "$kind" = tests ] && [ "$(cfg_get TEST_LOCAL on)" = on ] && tests_local
    } 2>/dev/null | grep -E "^[0-9]+$US" | sort -t "$US" -k1,1nr | head -50 > "$tmp"
    if [ -s "$tmp" ] || [ ! -s "$SHARED_DIR/$kind.list" ]; then mv "$tmp" "$SHARED_DIR/$kind.list"; else rm -f "$tmp"; fi   # (a round that found nothing, e.g. offline, keeps the last list)
    printf '%s\n' "$(date +%s)" > "$SHARED_DIR/$kind.at"
    poke
}
test_summary() {  # test_summary <log>: the result line of the usual frameworks, short (412 passed · 2 failed)
    tail -n 80 "$1" 2>/dev/null | sed "s/$(printf '\033')\[[0-9;]*[A-Za-z]//g" | awk '
        /[0-9]+ runs?, [0-9]+ assertions?/ { if (match($0, /[0-9]+ runs?, /)) { r = substr($0, RSTART); split(r, a, /, */); m = a[1] " · " a[3] " · " a[4] } }   # Minitest
        /^ *Tests +[0-9]/ { v = $0; sub(/^ *Tests +/, "", v); sub(/ *\(.*$/, "", v); gsub(/ *\| */, " · ", v); m = v }                           # Vitest
        /[0-9]+ examples?, [0-9]+ failures?/ { if (match($0, /[0-9]+ examples?, /)) m = substr($0, RSTART) }                                  # RSpec
        /^=+ .*[0-9]+ (passed|failed).* =+$/ { v = $0; gsub(/^=+ | =+$/, "", v); m = v }                                                     # pytest
        /^ok   / { ok++ } /^FAIL / { fl++ }                                                                                                # bhote
        END { if (m == "" && (ok || fl)) m = ok " ok" (fl ? " · " fl " FAIL" : ""); print substr(m, 1, 60) }'
}
cli_test_run() {  # bhote test run [-n <name>] -- <command>: runs it as it is (output, exit code), and the test monitor sees the run
    local name="" id f log rc tree rk
    while [ $# -gt 0 ]; do case "$1" in -n|--name) name=${2:-}; shift ;; --) shift; break ;; *) break ;; esac; shift; done
    [ $# -gt 0 ] || { echo "bhote: test run [-n <name>] -- <command>" >&2; return 1; }
    [ -n "$name" ] || name=$(printf '%s ' "$@" | cut -c1-40 | sed 's/ $//')
    mkdir -p "$MON_DIR"; chmod 700 "$MON_DIR" 2>/dev/null
    id="$(date +%s)-$$"; f="$MON_DIR/$id.run"; log=$(mktemp "$RUN_DIR/test.XXXXXX")
    tree=${PWD##*/}; git_repo_key_set rk "$PWD"; projects_load; project_for "$rk" "" && tree=$(project_name "$PROJ_ID")
    printf 'started=%s\nproject=%s\ntree=%s\nname=%s\npid=%s\n' "$(date +%s)" "${tree//[[:cntrl:]]/}" "${PWD##*/}" "${name//[[:cntrl:]]/}" "$$" > "$f"
    "$@" 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
    printf 'ended=%s\nexit=%s\nsummary=%s\n' "$(date +%s)" "$rc" "$(test_summary "$log")" >> "$f"
    rm -f "$log"; ls -t "$MON_DIR"/*.run 2>/dev/null | tail -n +101 | while IFS= read -r f; do rm -f "$f"; done   # the last 100
    poke; return "$rc"
}
mon_age() {  # mon_age <seconds ago>: 40s, 5m, 3h, 2d
    local a=$1; [ "$a" -lt 0 ] && a=0
    if [ "$a" -lt 60 ]; then printf '%ds' "$a"; elif [ "$a" -lt 3600 ]; then printf '%dm' $(( a / 60 )); elif [ "$a" -lt 86400 ]; then printf '%dh' $(( a / 3600 )); else printf '%dd' $(( a / 86400 )); fi
}
# ── updates: the collector asks GitHub for the newest tag every 6 hours (UPDATE_CHECK); the answer is kept in UPDATE_FILE.
UPDATE_FILE=$DATA_DIR/update; UPDATE_URL=https://github.com/floriankappert/bhote.git
update_fetch() {  # asks for the newest version tag (a vX.Y.Z), writes UPDATE_FILE; 1 when it cannot be told
    local out best tmp
    out=$(with_timeout 25 git ls-remote --tags --refs "$UPDATE_URL") || return 1
    best=$(printf '%s\n' "$out" | sed -n 's|.*refs/tags/v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
    [ -n "$best" ] || return 1
    mkdir -p "$DATA_DIR"; tmp=$(mktemp "$DATA_DIR/update.XXXXXX") || return 1
    printf 'checked=%s\nlatest=%s\n' "$(date +%s)" "$best" > "$tmp" && mv "$tmp" "$UPDATE_FILE"
}
version_gt() {  # version_gt <a> <b>: 0 when a is newer than b (x.y.z)
    local a1 a2 a3 b1 b2 b3; IFS=. read -r a1 a2 a3 <<< "$1"; IFS=. read -r b1 b2 b3 <<< "$2"
    num_set a1 "$a1" 0; num_set a2 "$a2" 0; num_set a3 "$a3" 0; num_set b1 "$b1" 0; num_set b2 "$b2" 0; num_set b3 "$b3" 0
    [ $(( a1 * 1000000 + a2 * 1000 + a3 )) -gt $(( b1 * 1000000 + b2 * 1000 + b3 )) ]
}
update_load() {  # UPD_LATEST = the newer version there is, else empty (no subshell: it runs with every frame)
    local _l _lt=""; UPD_LATEST=""
    [ -r "$UPDATE_FILE" ] || return 0
    while IFS= read -r _l; do case "$_l" in latest=*) _lt=${_l#latest=} ;; esac; done < "$UPDATE_FILE"
    case "$_lt" in ''|*[!0-9.]*) return 0 ;; esac
    version_gt "$_lt" "$VERSION" && UPD_LATEST=$_lt
    return 0
}
update_command() {  # the command that updates bhote the way it was installed here
    local p l d; p=$(command -v bhote 2>/dev/null); [ -n "$p" ] || p=$0
    while [ -L "$p" ]; do l=$(readlink "$p"); case "$l" in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac; done
    case "$p" in
        */Cellar/*|*/homebrew/*|*/linuxbrew/*) echo "brew update && brew upgrade bhote"; return ;;
    esac
    if command -v pacman >/dev/null 2>&1 && pacman -Qo "$p" >/dev/null 2>&1; then echo "makepkg -si in packaging/arch (pacman package bhote)"; return; fi
    d=$(cd "$(dirname "$p")" 2>/dev/null && pwd)
    if [ -n "$d" ] && git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then echo "git -C ${d/#$HOME/~} pull"; return; fi
    echo "install the new version the way you installed bhote (see the README)"
}
dash_caption() {  # dash_caption <text>: ┈┈ Text ┈┈┈┈┈ in grey (Done, Deployments, Tests)
    local rest; rest=$(( ${#RULE_LINE} - 4 - ${#1} )); [ "$rest" -lt 1 ] && rest=1
    printf '  %s┈┈%s %s%s%s %s%s%s\n' "$MUTED" "$X" "$D" "$1" "$X" "$MUTED" "${DASH_LINE:0:$rest}" "$X"
}
mon_bar_set() {  # mon_bar_set <var> <done> <total> <cells>: ■■■■■ as in the Claude status line (MB_FILLED = the cells to colour)
    local _f=$(( ($2 * $4 + $3 / 2) / $3 )) _i _b=""; [ "$_f" -gt "$4" ] && _f=$4; MB_FILLED=$_f
    for (( _i = 0; _i < $4; _i++ )); do _b="$_b■"; done
    printf -v "$1" '%s' "$_b"
}
mon_age_set() {  # mon_age_set <var> <epoch>: the same as mon_age, without a subshell
    local a; num_set a "$2" "$NOW"; a=$(( NOW - a )); [ "$a" -lt 0 ] && a=0
    if [ "$a" -lt 60 ]; then printf -v "$1" '%ds' "$a"; elif [ "$a" -lt 3600 ]; then printf -v "$1" '%dm' $(( a / 60 )); elif [ "$a" -lt 86400 ]; then printf -v "$1" '%dh' $(( a / 3600 )); else printf -v "$1" '%dd' $(( a / 86400 )); fi
}
monitor_block() {  # monitor_block deploys|tests <rows>: a caption and the last entries (nothing when the monitor is off or has none)
    local kind=$1 max=$2 cap t pj lb st d tot note url n=0 more=0 ic tx right rightc bar barc pct lw rw left lbl pad age w=$(( ${COLS:-44} - 4 ))
    case "$kind" in deploys) cap="Deployments" ;; *) cap="Tests" ;; esac
    [ -s "$SHARED_DIR/$kind.list" ] || return 0
    [ -n "${NOW:-}" ] || NOW=$(date +%s)
    dash_caption "$cap"
    while IFS=$US read -r t pj lb st d tot note url; do
        [ "$n" -lt "$max" ] || { more=$(( more + 1 )); continue; }
        bar=""
        case "$st" in
            running) ic="${ORANGE}✶"; tx="running"; case "$d:$tot" in *[!0-9:]*|:*|*:) ;; *) [ "$tot" -gt 0 ] && { pct=$(( d * 100 / tot )); mon_bar_set bar "$d" "$tot" 5; tx="$bar $pct%"; } ;; esac ;;
            queued) ic="${D}◌"; tx="queued" ;; approval) ic="${Y}⏸"; tx="approval" ;; ok) ic="${GREEN}✓"; tx="" ;;
            failed) ic="${NN}✗"; tx="failed" ;; *) ic="${D}⊘"; tx="canceled" ;;
        esac
        [ "$kind" = tests ] && [ -n "$note" ] && [ "$st" != running ] && tx=$note
        [ -z "$tx" ] && [ -n "$note" ] && tx=${note:0:18}           # a deployment that went through: where it came from
        [ -n "$bar" ] || clip_set tx "$tx" $(( w / 2 )); mon_age_set age "$t"
        right="${tx:+$tx · }$age"; dw_set rw "$right"; rightc=$right
        [ -n "$bar" ] && { barc="${ORANGE}${bar:0:MB_FILLED}${MUTED}${bar:MB_FILLED}${D}"; rightc=${right/"$bar"/"$barc"}; }   # (the bar in colour, the width counted without it)
        lbl="$pj · $lb"; [ "$st" = running ] && [ -n "$note" ] && lbl="$lbl ($note)"                 # what is going live, in brackets behind the name
        clip_set left "$lbl" $(( w - rw - 3 )); dw_set lw "$left"
        pad=$(( w - 2 - lw - rw )); [ "$pad" -lt 1 ] && pad=1
        printf '  %s%s %s%s%*s%s%s%s\n' "$ic" "$X" "$L" "$left" "$pad" "" "$D" "$rightc" "$X"
        n=$(( n + 1 ))
    done < "$SHARED_DIR/$kind.list"
    [ "$more" -gt 0 ] && printf '  %s+%d more %s%s\n' "$D" "$more" "$( [ "$kind" = deploys ] && echo deployments || echo tests)" "$X"
    return 0
}
monitors_block() {  # both monitors (when on), above the agents
    local r dm tm; cfg_var r MONITOR_ROWS 4; num_set r "$r" 4; cfg_var dm DEPLOY_MONITOR off; cfg_var tm TEST_MONITOR off
    [ "$dm" = on ] && monitor_block deploys "$r"
    [ "$tm" = on ] && monitor_block tests "$r"
    return 0
}
skill_put() {  # skill_put <source folder> <skill folder>: a link into a checkout (current with every git pull), a copy from a
    # package (brew's share folder is per version: a link would break with the next upgrade). A copy from before becomes a link.
    local s=$1 t=$2
    if [ -e "$(w_self_dir)/.git" ]; then
        if [ -d "$t" ] && [ ! -L "$t" ]; then
            [ "$(ls -A "$t")" = SKILL.md ] || { echo "bhote: ${t/#$HOME/~} holds more than SKILL.md: left as it is" >&2; return 1; }
            rm -f "$t/SKILL.md" && rmdir "$t" || return 1
        fi
        mkdir -p "$(dirname "$t")" && ln -sfn "$s" "$t"
    else
        if [ -L "$t" ]; then rm -f "$t"; fi                                   # a link into a checkout that is no longer used
        mkdir -p "$t" && cp "$s/SKILL.md" "$t/SKILL.md"
    fi
}
cli_skills() {  # bhote skills [install]: the Claude Code skills bhote and bhote-install into every Claude profile (skill_put)
    local sd d n dirs=() seen=" " done_n=0 prof
    sd=$(w_share integrations/claude/skills) || { echo "bhote: the skills are not part of this installation" >&2; return 1; }
    sd=$sd/integrations/claude/skills
    for d in "${CLAUDE_CONFIG_DIR:-}" "$HOME"/.claude "$HOME"/.claude[0-9a-zA-Z_-]*; do
        [ -n "$d" ] && [ -d "$d" ] || continue; case "$seen" in *" $d "*) continue ;; esac; seen="$seen$d "; dirs[${#dirs[@]}]=$d
    done
    [ ${#dirs[@]} -gt 0 ] || { dirs[0]=${CLAUDE_CONFIG_DIR:-$HOME/.claude}; mkdir -p "${dirs[0]}"; }
    for prof in "${dirs[@]}"; do
        for n in bhote bhote-install; do
            [ -f "$sd/$n/SKILL.md" ] || continue
            skill_put "$sd/$n" "$prof/skills/$n" && { printf 'skill %s -> %s\n' "$n" "${prof/#$HOME/~}/skills/$n"; done_n=$(( done_n + 1 )); }
        done
    done
    [ "$done_n" -gt 0 ] || return 1
    printf 'Now open Claude Code and say: /bhote-install  (it sets up the rest: herdr plugin, hooks, machines, monitors).\n'
}
cli_reload() {  # bhote reload: restarts every bhote panel of this machine (after an update). Never types into a panel that still runs:
    # the old panel is ended first (its main process, by group), and only a pane that is a plain shell again gets the command.
    command -v herdr >/dev/null 2>&1 || { echo "bhote: herdr is not here" >&2; return 1; }
    local pane pgid cl n=0 skipped=0 k alive bin; bin=$(command -v bhote 2>/dev/null); [ -n "$bin" ] || bin="$HOME/.local/bin/bhote"
    while IFS= read -r pane; do
        [ -n "$pane" ] || continue
        read -r pgid cl <<< "$(herdr pane process-info --pane "$pane" 2>/dev/null | jq -r '.result.process_info as $i | ($i.foreground_process_group_id // "") as $g | ([$i.foreground_processes[]? | select(.pid == $g) | (.cmdline // "")][0] // "") | "\($g) \(.)"' 2>/dev/null)"
        case "$pgid" in ''|*[!0-9]*) continue ;; esac
        case "$cl" in *bhote) ;; *) continue ;; esac              # the leader of the foreground group must be the bhote script itself
        [ -n "${BHOTE_DRY:-}" ] && { echo "would restart $pane (group $pgid: $cl)"; continue; }
        kill -TERM "$pgid" 2>/dev/null
        for (( k = 0; k < 20; k++ )); do                            # up to 5 s for it to end (it restores the terminal)
            alive=$(herdr pane process-info --pane "$pane" 2>/dev/null | jq -r '[.result.process_info.foreground_processes[]? | select((.cmdline // "") | test("bhote"))] | length' 2>/dev/null)
            [ "${alive:-1}" = 0 ] && break; sleep 0.25
        done
        if [ "${alive:-1}" = 0 ]; then herdr pane run "$pane" "'$bin'" >/dev/null 2>&1 && n=$(( n + 1 ))
        else skipped=$(( skipped + 1 )); echo "bhote: $pane did not end, left alone" >&2; fi
    done <<< "$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | select((.agent // "") == "") | .pane_id' 2>/dev/null)"
    printf 'reloaded %d panel(s)%s\n' "$n" "$( [ "$skipped" -gt 0 ] && echo ", $skipped left alone")"
}
cli_update() {  # bhote update: asks GitHub now; prints whether there is a newer version and the command that updates
    update_fetch || { echo "bhote: could not ask GitHub (offline?)" >&2; return 1; }
    update_load
    if [ -n "$UPD_LATEST" ]; then printf 'Update available: v%s (this is v%s). Run: %s\n' "$UPD_LATEST" "$VERSION" "$(update_command)"
    else printf 'bhote v%s is the newest version.\n' "$VERSION"; fi
}
cli_monitor_list() {  # bhote deploys|tests [--json]: the entries (a round now when the list is older than its interval)
    local kind=$1 at every t pj lb st d tot note url first=1
    cfg_var every "$( [ "$kind" = deploys ] && echo DEPLOY_EVERY || echo TEST_EVERY)" 60; num_set every "$every" 60
    read -r at 2>/dev/null < "$SHARED_DIR/$kind.at"; num_set at "${at:-0}" 0
    [ $(( $(date +%s) - at )) -ge "$every" ] && monitor_fetch "$kind"
    [ -n "$json" ] && printf '['
    while IFS=$US read -r t pj lb st d tot note url; do
        [ -n "$t" ] || continue
        case "$t" in *[!0-9]*) continue ;; esac; case "$d" in ''|*[!0-9]*) d="" ;; esac; case "$tot" in ''|*[!0-9]*) tot="" ;; esac
        if [ -n "$json" ]; then [ "$first" = 1 ] || printf ','; first=0
            printf '{"time":%s,"project":%s,"label":%s,"state":%s,"done":%s,"total":%s,"note":%s,"url":%s}' "$t" "$(json_str "$pj")" "$(json_str "$lb")" "$(json_str "$st")" "${d:-null}" "${tot:-null}" "$(json_opt "$note")" "$(json_opt "$url")"
        else printf '%-9s %-20s %-16s %s %s\n' "$st" "${pj:0:20}" "${lb:0:16}" "$(mon_age $(( $(date +%s) - t )))" "$note"; fi
    done < "$SHARED_DIR/$kind.list" 2>/dev/null
    [ -n "$json" ] && printf ']\n'
    return 0
}
cli_monitor() {  # bhote monitor [detect [<project>] | check]
    local sub=${1:-} pf i
    case "$sub" in
        detect) projects_load
            for (( i = 0; i < P_N; i++ )); do
                [ -n "${2:-}" ] && { pf=$(project_ref "$2") || return $?; [ "$pf" = "${P_FILE[$i]}" ] || continue; }
                if monitor_detect_save "${P_FILE[$i]}"; then printf '%s: %s\n' "${P_NAME[$i]}" "$(monitor_describe "${P_FILE[$i]}")"
                else printf '%s: %s\n' "${P_NAME[$i]}" "${MD_WHY:-nothing found}"; fi
            done ;;
        check|"") monitor_fetch deploys; monitor_fetch tests; cli_monitor_list deploys; cli_monitor_list tests ;;
        *) echo "bhote: monitor detect [<project>] | check" >&2; return 1 ;;
    esac
}

# ── run. BHOTE_ONCE=1 prints a view once and exits (BHOTE_VIEW=splash|main|settings picks it); otherwise it runs as a panel:
# the start screen first, any key moves on to the topic list (the dog shrinks), "s" shows the start screen again, "," the
# settings, "q" quits. On a short terminal it starts with the list. The window title says "Bhote" so that herdr's
# autostart can tell that it is there.
# The panel works between MIN and MAX columns: wider than MAX it uses only the left MAX columns, narrower than MIN (or shorter
# than MIN_ROWS) it shows a hint instead of a broken picture. The start screen is a fixed picture (WIDTH x SPLASH_ROWS):
# where it does not fit, the list is shown instead.
MIN_COLS=${BHOTE_MIN_COLS:-30}; MAX_COLS=${BHOTE_MAX_COLS:-$(num_or "$(cfg_get PANEL_MAX_WIDTH 60)" 60)}; MIN_ROWS=${BHOTE_MIN_ROWS:-20}; SPLASH_ROWS=39; TOO_SMALL=0
splash_fits() { [ "${REAL_COLS:-44}" -ge "$SPLASH_W" ] && [ "${REAL_ROWS:-40}" -ge "$SPLASH_ROWS" ]; }
# The start screen fills the pane: the frame is as wide and as high as the pane; the extra width centres the content, the extra
# height becomes space between the sections (all of it above the prompt, so the keys stay on the bottom edge).
SG0=1; SG1=1; SG2=1; SG3=1; SG4=1; SPLASH_E=0
splash_geometry() {
    local e q r
    WIDTH=${REAL_COLS:-44}; [ "$WIDTH" -lt "$SPLASH_W" ] && WIDTH=$SPLASH_W; INNER=$(( WIDTH - 2 ))
    e=$(( ${REAL_ROWS:-40} - SPLASH_ROWS )); [ "$e" -lt 0 ] && e=0; SPLASH_E=$e
    # five gaps (under the greeting, the dog, the wordmark, the prompt, the info), each one line plus an equal share of the rest
    q=$(( e / 5 )); r=$(( e % 5 ))
    SG0=$(( 1 + q + (r > 0) )); SG1=$(( 1 + q + (r > 1) )); SG2=$(( 1 + q + (r > 2) )); SG3=$(( 1 + q + (r > 3) )); SG4=$(( 1 + q ))
    SPLASH_PROMPT_ROW=$(( 28 + SG0 + SG1 + SG2 ))
}
term_size() {
    local sz; sz=$(stty size </dev/tty 2>/dev/null); REAL_COLS=${sz#* }; REAL_ROWS=${sz% *}; REAL_COLS=${REAL_COLS:-44}; REAL_ROWS=${REAL_ROWS:-40}
    TOO_SMALL=0; { [ "$REAL_COLS" -lt "$MIN_COLS" ] || [ "$REAL_ROWS" -lt "$MIN_ROWS" ]; } && TOO_SMALL=1
    COLS=$REAL_COLS; [ "$COLS" -gt "$MAX_COLS" ] && COLS=$MAX_COLS; [ "$COLS" -lt "$MIN_COLS" ] && COLS=$MIN_COLS
    ROWS=$REAL_ROWS; splash_geometry
    RULE_LINE=$(hline $(( COLS - 5 ))); DASH_LINE=$(dline $(( COLS - 5 )))
}
harden_perms() {  # data, config and their folders: this user only (older versions created them open)
    mkdir -p "$TOPIC_DIR" "$(dirname "$CONFIG_FILE")" 2>/dev/null
    chmod 700 "$DATA_DIR" "$TOPIC_DIR" "$(dirname "$CONFIG_FILE")" 2>/dev/null
    [ -f "$CONFIG_FILE" ] && chmod 600 "$CONFIG_FILE" 2>/dev/null
    return 0
}
# ── the setup wizard. On the first start of every machine it opens by itself (once; one panel only), later from the settings
# ("Setup wizard") or as `bhote setup`. Every step explains itself and asks first; Enter takes the [default], s skips a step,
# q ends the setup. It never asks for a password: when ssh needs one, ssh asks for it itself, and bhote never sees it.
W_STEPS=11; W_QUIT=0
W_LOG="$DATA_DIR/setup.log"                                   # what the wizard did and saw: every check, every command and its output
w_log() { mkdir -p "$DATA_DIR" 2>/dev/null; printf '%s %s\n' "$(date '+%F %T')" "${*//[[:cntrl:]]/}" >> "$W_LOG" 2>/dev/null; }
w_width() { W=$(( ${COLS:-44} - 4 )); [ "$W" -lt 26 ] && W=26; [ "$W" -gt 72 ] && W=72; }
w_screen() {  # w_screen <step> <TITLE>: a clean screen with the progress dots and the step's caption
    local i dots=""; w_width
    for (( i = 1; i <= W_STEPS; i++ )); do
        if [ "$i" -lt "$1" ]; then dots="$dots${GREEN}●${X}"; elif [ "$i" = "$1" ]; then dots="$dots${C}●${X}"; else dots="$dots${D}○${X}"; fi
    done
    printf '\033[H\033[2J\n  %s%s\n  %s\n  %s\n\n  %s%s%s  %sstep %d of %d%s\n\n' "${HEAD_GRAD:-${L}Bhote setup}" "$X" "$B$(hline "$W")$X" "$dots" "$R" "$2" "$X" "$D" "$1" "$W_STEPS" "$X"
    w_log "== step $1: $2"
    if [ "${W_GATE:-0}" = 1 ] && [ "$1" != "$W_STEPS" ]; then W_GATE=0; w_gate || return 1; printf '\n'; fi
    W_GATE=0; return 0
}
w_say() { local col=${2:-$D} COLS=$(( W + 4 )); wrap_print 2 "$col" "$1"; }          # a paragraph, wrapped at the left edge
w_mark() {  # w_mark <colour> <mark> <name> <detail>: aligned check lines (mark, name in 16 columns, detail cut to the edge)
    local n d; clip_set n "$3" 16; pad_set n "$n" 16; clip_set d "${4:-}" $(( W - 19 )); w_log "$2 $3: ${4:-}"
    printf '  %s%s%s %s %s%s%s\n' "$1" "$2" "$X" "$n" "$D" "$d" "$X"
}
w_ok()   { w_mark "$GREEN" "✓" "$@"; }
w_bad()  { w_mark "$NN" "✗" "$@"; }
w_warn() { w_mark "$Y" "!" "$@"; }
w_opt()  { local COLS=$(( W + 4 )); printf '  %s%s%s' "$C" "$1" "$X"; wrap_print 5 "$L" "$2" | sed '1s/^   //'; }   # a numbered choice
w_line() { printf '\n'; }
w_head() {  # w_head <title>: a titled rule: a new topic inside a step
    printf '\n  %s── %s %s%s\n' "$D" "$1" "$(hline $(( ${W:-40} - ${#1} - 4 )))" "$X"
}
w_read() {  # w_read <var> <prompt> [default]: one answer (cooked terminal); q ends the wizard
    local __wr_a __wr_q __wr_w __wr_line="" __wr_first=1 __wr_room=$(( W - 2 ))
    local __wr_ws; read -r -a __wr_ws <<< "$2"                 # split into words (no globbing: a * in the text stays a *)
    printf '\n'
    for __wr_w in ${__wr_ws[@]+"${__wr_ws[@]}"}; do             # word wrap: the first line after "▶ ", the others under the text
        if [ -z "$__wr_line" ]; then __wr_line=$__wr_w
        elif [ $(( ${#__wr_line} + 1 + ${#__wr_w} )) -le "$__wr_room" ]; then __wr_line="$__wr_line $__wr_w"
        else
            if [ "$__wr_first" = 1 ]; then printf '  %s▶%s %s%s%s\n' "$C" "$X" "$L" "$__wr_line" "$X"; __wr_first=0; else printf '    %s%s%s\n' "$L" "$__wr_line" "$X"; fi
            __wr_line=$__wr_w
        fi
    done
    __wr_q="${3:+[$3]}"; [ $(( ${#__wr_line} + 1 + ${#__wr_q} )) -gt "$__wr_room" ] && { if [ "$__wr_first" = 1 ]; then printf '  %s▶%s %s%s%s\n' "$C" "$X" "$L" "$__wr_line" "$X"; else printf '    %s%s%s\n' "$L" "$__wr_line" "$X"; fi; __wr_first=0; __wr_line=""; }
    if [ "$__wr_first" = 1 ]; then printf '  %s▶%s %s%s%s %s%s%s ' "$C" "$X" "$L" "$__wr_line" "$X" "$D" "$__wr_q" "$X"
    else printf '    %s%s%s%s%s%s%s ' "$L" "$__wr_line" "$X" "${__wr_line:+ }" "$D" "$__wr_q" "$X"; fi
    IFS= read -e -r __wr_a </dev/tty || __wr_a=q           # readline: arrows move inside the answer, nothing leaks into it
    __wr_a=${__wr_a//[[:cntrl:]]/}; __wr_a=${__wr_a#"${__wr_a%%[! ]*}"}; __wr_a=${__wr_a%"${__wr_a##*[! ]}"}
    [ "$__wr_a" = q ] && W_QUIT=1
    printf -v "$1" '%s' "${__wr_a:-${3:-}}"
}
w_key() {  # w_key <allowed keys, e.g. "ynsq">: waits for one of them or Enter (-> ENTER); everything else is swallowed
    local k _s _r; _s=$(stty -g </dev/tty 2>/dev/null); stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    while true; do
        IFS= read -rsn1 k </dev/tty || { k=q; break; }
        case "$k" in
            "") k=ENTER; break ;;
            $'\033') local _sq=""; while read_soon _r; do _sq="$_sq$_r"; done   # an arrow: ← → when asked for (< >), else it goes
                case "$_sq:$1" in "[C:"*">"*|"OC:"*">"*) k=RIGHT; break ;; "[D:"*"<"*|"OD:"*"<"*) k=LEFT; break ;; esac; continue ;;
            *) case "$1" in *"$k"*) break ;; esac
               case "$k" in [A-Z]) case "$1" in *"$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]')"*) k=$(printf '%s' "$k" | tr '[:upper:]' '[:lower:]'); break ;; esac ;; esac ;;
        esac
    done
    stty "$_s" </dev/tty 2>/dev/null
    W_KEY=$k
}
w_yn() {  # w_yn <question> <Y|N>: 0 yes, 1 no, 2 skip (s), 3 quit (q); only y, n, Enter, s and q are taken
    local hint="Y/n" __q __w __ws __line="" __first=1 __room=$(( W - 7 )); [ "$2" = N ] && hint="y/N"
    read -r -a __ws <<< "$1"; printf '\n'
    for __w in ${__ws[@]+"${__ws[@]}"}; do
        # shellcheck disable=SC1075  # an if inside the else branch, on one line
        if [ -z "$__line" ]; then __line=$__w
        elif [ $(( ${#__line} + 1 + ${#__w} )) -le "$__room" ]; then __line="$__line $__w"
        else if [ "$__first" = 1 ]; then printf '  %s▶%s %s%s%s\n' "$C" "$X" "$L" "$__line" "$X"; __first=0; else printf '    %s%s%s\n' "$L" "$__line" "$X"; fi; __line=$__w; fi
    done
    if [ "$__first" = 1 ]; then printf '  %s▶%s %s%s%s %s[%s]%s ' "$C" "$X" "$L" "$__line" "$X" "$D" "$hint" "$X"
    else printf '    %s%s%s %s[%s]%s ' "$L" "$__line" "$X" "$D" "$hint" "$X"; fi
    w_key ynsqj
    case "$W_KEY" in
        y|j) printf '%syes%s\n' "$GREEN" "$X"; return 0 ;;
        n) printf '%sno%s\n' "$D" "$X"; return 1 ;;
        ENTER) if [ "$2" = Y ]; then printf '%syes%s\n' "$GREEN" "$X"; return 0; else printf '%sno%s\n' "$D" "$X"; return 1; fi ;;
        s) printf '%sskipped%s\n' "$D" "$X"; return 2 ;;
        q) printf '%send%s\n' "$D" "$X"; W_QUIT=1; return 3 ;;
    esac
}
w_choose() {  # w_choose <var> <prompt> <allowed keys, e.g. 123> <default>: one key from the list (Enter = default, q ends)
    printf '\n  %s▶%s %s%s%s %s[%s]%s ' "$C" "$X" "$L" "$2" "$X" "$D" "$4" "$X"
    w_key "${3}q"
    case "$W_KEY" in ENTER) W_KEY=$4 ;; q) W_QUIT=1; printf '%send%s\n' "$D" "$X"; return 1 ;; esac
    printf '%s%s%s\n' "$GREEN" "$W_KEY" "$X"; printf -v "$1" '%s' "$W_KEY"
}
w_button() { if [ "$color" = 1 ]; then printf '%s\033[7m %s \033[27m%s' "$L" "$1" "$X"; else printf '[ %s ]' "$1"; fi; }   # light on dark, inverted
w_navbar() {  # w_navbar <first button> <skip 0|1> <back 0|1>: ← back · q abort on the left, ⏎ <first> · → skip & next on the right (what is not possible: dim)
    local sk bk pad lw rw; w_width
    if [ "$2" = 1 ]; then sk="${L}→${X} skip & next"; else sk="${MUTED:-$D}→ skip & next${X}"; fi
    if [ "$3" = 1 ]; then bk="${L}←${X} back"; else bk="${MUTED:-$D}← back${X}"; fi
    lw=$(( 6 + 3 + 7 )); rw=$(( ${#1} + 4 + 3 + 13 ))                         # the visible widths: "← back   q abort", " ⏎ change    → skip & next"
    [ "$color" = 1 ] || rw=$(( rw + 2 ))
    pad=$(( W - lw - rw )); [ "$pad" -lt 2 ] && pad=2
    printf '  %s   %s%*s%s   %s' "$bk" "${L}q${X} abort" "$pad" "" "$(w_button "⏎ $1")" "$sk"
}
w_continue() {  # the end of a step: ⏎ next, ← back (this step's start → the step before), q abort
    printf '\n'; w_navbar next 0 "$( [ "${W_IDX:-0}" -gt 0 ] && echo 1 || echo 0)" | sed 's/→ skip \& next/             /'
    printf ' '; w_key "q<"
    case "$W_KEY" in q) W_QUIT=1; W_JUMP=quit ;; LEFT) [ "${W_IDX:-0}" -gt 0 ] && { W_QUIT=1; W_JUMP=back; } ;; esac
    printf '\n'; return 0
}
w_gate() {  # at the start of a step (again): what is set, then ⏎ change · → skip & next · ← back · q abort, pinned to the bottom
    local set=0 rows; [ -n "$(cfg_get SETUP_DONE '')" ] && set=1
    if [ "$set" = 1 ]; then printf '  %sAlready set%s\n' "$D" "$X"; "setup_sum_${W_NAME}" 2>/dev/null
    else printf '  %sNot set up yet.%s\n' "$D" "$X"; fi
    rows=$(stty size </dev/tty 2>/dev/null | awk '{print $1}'); rows=$(num_or "$rows" 0)
    if [ "$rows" -gt 12 ]; then printf '\0337\033[%d;1H\033[2K' $(( rows - 1 )); w_navbar change "$set" "$( [ "$W_IDX" -gt 0 ] && echo 1 || echo 0)"; printf '\0338'
    else printf '\n'; w_navbar change "$set" "$( [ "$W_IDX" -gt 0 ] && echo 1 || echo 0)"; printf '\n'; fi
    while true; do
        w_key "cq<>"
        case "$W_KEY" in
            ENTER|c) [ "$rows" -gt 12 ] && printf '\0337\033[%d;1H\033[2K\0338' $(( rows - 1 )); return 0 ;;   # change: the step's questions
            RIGHT) [ "$set" = 1 ] && { W_JUMP=next; W_QUIT=1; return 1; } ;;
            LEFT) [ "$W_IDX" -gt 0 ] && { W_JUMP=back; W_QUIT=1; return 1; } ;;
            q) W_JUMP=quit; W_QUIT=1; return 1 ;;
        esac
    done
}
setup_sum_checks() { w_ok "jq · herdr" "$(command -v jq >/dev/null && echo ok || echo missing) · $(command -v herdr >/dev/null && echo ok || echo missing)"; w_ok "herdr plugin" "$(herdr plugin list 2>/dev/null | grep -q bhote.panel && echo linked || echo not linked)"; }

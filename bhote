            FI_LABEL[$n]="$m${task:+ · $task}"; FI_TM[$n]=""; case "$st" in off-*) FI_LABEL[$n]="$m reconnecting${task:+ · $task}" ;; esac; lowsrc="$lowsrc$name $m $task agent"$'\n'; n=$(( n + 1 ))

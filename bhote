        [ "$2" = status ] && [ "$v" != review ] && x="$x|^review_note=|^review_ask=|^review_reply="   # (the card under a review topic goes with the review)
        { grep -v -E -e "^$2=" -e "$x" "$f"; printf '%s=%s\nupdated=%s\n' "$2" "$v" "$now"; } > "$tmp" && mv "$tmp" "$f" && rc=0
    fi

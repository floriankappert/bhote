        if [ "$pm" = "-" ]; then pcol=$D; else project_color_set pcol "$pname"; fi
        lines[$n]="  ${MUTED}┈┈${X} ${BOLD}${pcol}${cap}${X} ${MUTED}${DASH_LINE:0:$rest2}${X}"
        lc[$n]=0; lid[$n]=""; rid[$n]=""; n=$(( n + 1 ))
        local cells=() cid=() cwid=() nc2=0 pre pre0 an plen rk rkst pcol tt tj tw

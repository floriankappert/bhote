            0) w_ok "$label → $HOST" "knows this machine" ;;
            1) w_warn "$label → $HOST" "does not know it (step 4)" ;;
            *) w_warn "$label → $HOST" "cannot tell" ;;
        esac
    done 3<<< "$(w_machines)"
    if store_synced; then
        store_sync >/dev/null 2>&1; case $? in 0) w_ok "topics merge" "works" ;; 2) w_warn "topics merge" "busy, it runs again by itself" ;; *) w_bad "topics merge" "$(store_summary)" ;; esac
    fi
    w_line; w_say "Change anything later in the settings (,), or run the setup again: settings › Setup wizard, or bhote setup. A log of this setup: ${W_LOG/#$HOME/~}"
    w_continue
}
step_level() { case "$1" in topics) echo 3 ;; monitors) echo 2 ;; *) echo 1 ;; esac; }   # the feature level that brought the step
bhote_setup() {  # the whole wizard, in a normal (cooked) terminal
    local st old_int; W_QUIT=0; ask_drain                      # keys typed before it opened must not answer its first questions
    old_int=$(trap -p INT); trap 'W_QUIT=1' INT                 # Ctrl-C ends the wizard (and only the wizard)
    COLS=${COLS:-$(stty size </dev/tty 2>/dev/null | awk '{print $2}')}; COLS=${COLS:-44}
    HEAD_GRAD=$(gradient "Bhote setup"); [ "$color" = 1 ] && HEAD_GRAD="${esc}[1m$HEAD_GRAD"
    w_log "==== setup on $HOST (bhote $VERSION)"
    local steps=() all=(checks name machines twoway topics agents projects monitors behaviour panel done) sn from=0 wl; W_IDX=0
    cfg_var wl WIZARD_LEVEL ""; num_set wl "$wl" 1
    [ "${W_NEW_ONLY:-0}" = 1 ] && [ "$wl" -lt "$FEATURE_LEVEL" ] && from=$wl     # from the panel with new features: only the steps added since
    for sn in "${all[@]}"; do [ "$sn" = done ] || [ "$(step_level "$sn")" -gt "$from" ] && steps[${#steps[@]}]=$sn; done
    while [ "$W_IDX" -lt "${#steps[@]}" ]; do               # each step: ⏎ change · → skip & next · ← back · q abort
        W_NAME=${steps[$W_IDX]}; W_QUIT=0; W_JUMP=""; W_GATE=1
        "setup_step_$W_NAME"
        case "$W_JUMP" in
            back) W_IDX=$(( W_IDX > 0 ? W_IDX - 1 : 0 )); continue ;;
            next) W_IDX=$(( W_IDX + 1 )); continue ;;
            quit) break ;;
        esac
        [ "$W_QUIT" = 1 ] && break
        W_IDX=$(( W_IDX + 1 ))
    done
    cfg_set SETUP_DONE "$(date +%Y-%m-%d)" WIZARD_LEVEL "$FEATURE_LEVEL"
    HEAD_GRAD=""                                            # the list makes its own again
    if [ -n "$old_int" ]; then eval "$old_int"; else trap - INT; fi
    printf '\033[H\033[2J'
}
setup_status_json() {  # `bhote setup --json`: what is in place, nothing changes
    printf '{"machine":%s,"jq":%s,"herdr":%s,"plugin":%s,"claude_hook":%s,"machines":[' "$(json_str "$HOST")" \
        "$(command -v jq >/dev/null 2>&1 && echo true || echo false)" "$(command -v herdr >/dev/null 2>&1 && echo true || echo false)" \
        "$(herdr plugin list 2>/dev/null | grep -q bhote.panel && echo true || echo false)" "$(grep -q 'bhote current' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" 2>/dev/null && echo true || echo false)"
    local label host en first=1 known
    while IFS=$US read -r label host en <&3; do
        [ -n "$label" ] || continue
        local reach=false; herdr --machine "$label" pane list >/dev/null 2>&1 && reach=true
        known=null; [ "$reach" = true ] && { w_remote_knows "$label"; case $? in 0) known=true ;; 1) known=false ;; esac; }
        [ "$first" = 1 ] || printf ','; first=0
        printf '{"label":%s,"reachable":%s,"knows_this_machine":%s}' "$(json_str "$label")" "$reach" "$known"
    done 3<<< "$(w_machines)"
    printf '],"setup_done":%s}\n' "$(json_opt "$(cfg_get SETUP_DONE '')")"
}

panel_setup() {  # the wizard from inside the panel: a normal terminal for it, then the panel mode again
    trap '' USR1; printf '%s\033[?25h' "$MOUSE_OFF"; stty "$stty_saved" </dev/tty 2>/dev/null
    W_NEW_ONLY=${1:-0} bhote_setup
    stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null; printf '\033[?25l%s' "$MOUSE_ON"; trap 'anim=1' USR1; term_size
}
bhote_main() {
    local f pf chk seq tmo _sa _ss view=${BHOTE_VIEW:-splash} key rows m1 m2 last_m="" k2 k3 anim=0 rc MENU_IDX=0 resize=0
    harden_perms; bhote_info
    if [ -n "${BHOTE_ONCE:-}" ] || [ ! -t 0 ]; then
        AGENT_LOCAL=$RUN_DIR/agents.local; AGENT_REMOTE=$RUN_DIR/agents.remote
        collect_local; [ "$(cfg_get REMOTE_AGENTS off)" = on ] && collect_remote
        COLS=${BHOTE_COLS:-44}; ROWS=${BHOTE_ROWS:-40}; REAL_COLS=$COLS; REAL_ROWS=$ROWS; splash_geometry; [ "$COLS" -gt "$MAX_COLS" ] && COLS=$MAX_COLS; RULE_LINE=$(hline $(( COLS - 5 ))); DASH_LINE=$(dline $(( COLS - 5 ))); ui_load; bhote_draw "$view" | tr -d '\001'; rm -f "$AGENT_LOCAL" "$AGENT_REMOTE"; return
    fi
    printf '\033]2;Bhote\007'
    dog_init; dog_warm; term_size
    # never set up on this machine: the wizard opens once, in the first panel only (herdr may start several at a time)
    if [ -z "$(cfg_get SETUP_DONE '')" ]; then
        local sl=$SHARED_DIR/setup.lock                       # the panel that shows the wizard holds it
        if lock_take "$sl" "$$"; then
            printf '\033]2;Bhote\007'
            # the welcome screen comes first and says what a key does now; too small for it: straight into the setup
            if splash_fits; then SETUP_PENDING=1; PROMPT_TEXT="PRESS ANY KEY TO START SETUP"; else bhote_setup; lock_drop "$sl" "$$"; fi
        fi
    fi
    local pids="" stty_saved
    # The terminal must not echo what arrives between two reads: a mouse wheel in the alternate screen sends arrow keys
    # (ESC [ B) all the time, and with echo on they showed up as ^[[B on the screen. Restored on exit.
    # Byte by byte, not line by line (-icanon): only then does a waiting escape sequence count as "input waiting" (read_soon).
    stty_saved=$(stty -g </dev/tty 2>/dev/null); stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null
    cleanup() {
        trap '' INT TERM HUP QUIT USR1 WINCH                  # once, and not interrupted by the next signal
        kill $pids 2>/dev/null
        [ -n "$stty_saved" ] && stty "$stty_saved" </dev/tty 2>/dev/null
        lock_drop "$SHARED_DIR/collector.lock" "$$"; lock_drop "$SHARED_DIR/sync.lock" "$$"; lock_drop "$SHARED_DIR/setup.lock" "$$"
        rm -rf "$RUN_DIR"
        printf '%s\033[0m\033[?25h\033[?1049l\033]2;\007' "$MOUSE_OFF" 2>/dev/null   # mouse off, colours, cursor, normal screen, title
    }
    trap 'cleanup; exit 0' INT TERM HUP QUIT EXIT
    trap 'redraw=1; resize=1; CLAMP_AT=$(( SECONDS + 1 ))' WINCH       # (the width is checked once the resizing has settled)
    CLAMP_AT=$(( SECONDS + 2 ))
    trap 'anim=1' USR1
    printf '\033[?1049h\033[?25l%s' "$MOUSE_ON"          # alternate screen, hidden cursor, mouse reports (wheel, divider)
    splash_fits || view=main
    collector "$$" & pids="$!"
    echo "0 on" > "$ANIM_FILE"; : > "$RUN_DIR/anim.want"; dog_ticker $$ & pids="$pids $!"
    local back=main
    redraw=1
    while true; do
        if [ "$redraw" = 1 ] && [ -n "$key" ] && input_pending; then :   # more input waits (key repeat, a drag): handle it first, draw once
        elif [ "$redraw" = 1 ]; then
            redraw=0; anim=0; [ "$resize" = 1 ] && { resize=0; term_size; }
            [ "$view" = splash ] && ! splash_fits && view=main
            { read -r DOG_IDX _ < "$ANIM_FILE"; } 2>/dev/null || DOG_IDX=0
            DRAWN_IDX=$DOG_IDX; DRAWN_BLINK=on
            bhote_paint "$view"; dog_prev_reset "$view"
            if [ "$view" = main ]; then spin_cells; else SPIN_CELLS=""; fi
            if [ "$view" = splash ] || [ -n "$SPIN_CELLS" ]; then [ -e "$RUN_DIR/anim.want" ] || : > "$RUN_DIR/anim.want"; else [ ! -e "$RUN_DIR/anim.want" ] || rm -f "$RUN_DIR/anim.want"; fi
        elif [ "$anim" = 1 ]; then anim=0; dog_animate "$view"; fi
        [ "$view" = splash ] && [ -z "${SPLASH_SINCE:-}" ] && SPLASH_SINCE=$SECONDS
        [ "$view" = splash ] || SPLASH_SINCE=""
        tmo=1                                                  # (the 2 s checks below and the auto-close need a short timeout)
        key=""; rc=0
        [ -n "${SPIN_CELLS:-}" ] && [ "$view" = main ] && tmo=0.3        # the star dances in 0.3 s steps
        in_get key "$tmo" || rc=142
        [ "$rc" = 0 ] && [ -z "$key" ] && key=ENTER      # Enter reads as an empty key; a timeout (rc > 128) stays empty
        if [ "$key" = $'\033' ]; then      # an arrow key (ESC [ A..D, ESC O A..D), a mouse report, another sequence, or a lone Esc
            read_soon k2
            if [ "$k2" = "[" ] || [ "$k2" = O ]; then
                # read up to the final byte (@ .. ~): parameters such as 1;5 (Ctrl+arrow), mouse reports and paste markers
                # must not leak their tail as keys. Only a parameterless A..D is an arrow; the rest is ignored.
                k3=""; seq=""
                while in_get k3 1; do
                    case "$k3" in [0123456789\;\<\=\>\?\ \!\"\#\$\%\&\'\(\)\*\+\,\-\.\/]) ;; *) [ "$k2" = O ] || [ -z "$seq" ] || k3="x$k3"; break ;; esac   # (no [@-~]: a range follows the locale)
                    [ "$k2" = O ] && break; seq="$seq$k3"; [ "${#seq}" -gt 24 ] && break
                done
                if [ "$k2" = "[" ] && [ -z "$seq" ] && [ "$k3" = M ]; then        # X10 mouse: three raw bytes follow
                    in_get k3 1; in_get k3 1; in_get k3 1; k3=M
                fi
                case "$k3" in A) key=UP ;; B) key=DOWN ;; C) key=RIGHT ;; D) key=LEFT ;; *) key="" ;; esac
                case "$seq" in "<"*) mouse_event "${seq#<}" "${k3#x}"; key=$MOUSE_KEY ;; esac      # SGR mouse: < b ; x ; y M|m
            elif [ -z "$k2" ]; then key=ESC
            else key=""; fi                                    # Alt+key: nothing
        fi
        if [ "$key" = HOVER ]; then key=""; [ "$view" = main ] && redraw=1; fi   # the pointer moved onto another card (or off the cards)
        if [ "${SETUP_PENDING:-}" = 1 ]; then
            if [ "$view" != splash ]; then                     # the pane got too small for the welcome screen: next start
                SETUP_PENDING=0; PROMPT_TEXT="PRESS ANY KEY TO START"; lock_drop "$SHARED_DIR/setup.lock" "$$"
            elif [ -n "$key" ] && [ "$key" != DRAG ]; then
                case "$key" in
                    q|Q) exit 0 ;;                               # quit, the setup comes again next time
                    ESC) ;;                                      # not now: the list, the setup comes again next time
                    *) panel_setup ;;
                esac
                SETUP_PENDING=0; PROMPT_TEXT="PRESS ANY KEY TO START"; lock_drop "$SHARED_DIR/setup.lock" "$$"
                view=main; redraw=1; key=""
            fi
        fi
        if [ "$view" = settings ]; then
            case "$key" in
                ","|ESC|q|Q) case "${SET_PAGE:-main}" in connections|projects) SET_PAGE=main; SET_IDX=0 ;; project) SET_PAGE=projects; SET_IDX=0 ;; *) view=$back ;; esac; redraw=1 ;;
                ""|DRAG|AGENT|TOPIC|OPEN|ITEM) ;;
                *) SETTINGS_GO=""; settings_key "$key"; [ "$SETTINGS_GO" = hotkeys ] && view=hotkeys
                   [ "$SETTINGS_GO" = connections ] && { SET_PAGE=connections; SET_IDX=0; }
                   [ "$SETTINGS_GO" = projects ] && { SET_PAGE=projects; SET_IDX=0; }
                   [ "$SETTINGS_GO" = project ] && { SET_PAGE=project; SET_IDX=0; }
                   [ "$SETTINGS_GO" = setup ] && panel_setup
                   redraw=1 ;;
            esac
        elif [ "$view" = hotkeys ]; then
            case "$key" in ESC|LEFT|h|q|Q|","|ENTER) view=settings; redraw=1 ;; esac
        elif [ "$view" = suggest ]; then
            suggest_build
            case "$key" in
                UP|k) SUG_IDX=$(( (SUG_IDX + ${#SUG_MAP[@]} - 1) % (${#SUG_MAP[@]} + (${#SUG_MAP[@]} == 0)) )); redraw=1 ;;
                DOWN|j) SUG_IDX=$(( (SUG_IDX + 1) % (${#SUG_MAP[@]} + (${#SUG_MAP[@]} == 0)) )); redraw=1 ;;
                ENTER|RIGHT) suggest_do adopt "$SUG_IDX"; SUG_IDX=0; view=main; redraw=1 ;;
                x|X) suggest_do dismiss "$SUG_IDX"; SUG_IDX=0; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        elif [ "$view" = pick ]; then
            pick_build
            case "$key" in
                UP|k) pf=$(pick_first); PICK_IDX=$(( PICK_IDX - 1 )); [ "$PICK_IDX" -lt "$pf" ] && PICK_IDX=${#PICK_MAP[@]}; redraw=1 ;;
                DOWN|j) pf=$(pick_first); PICK_IDX=$(( PICK_IDX + 1 )); [ "$PICK_IDX" -gt "${#PICK_MAP[@]}" ] && PICK_IDX=$pf; redraw=1 ;;
                ENTER|RIGHT) pick_do "$PICK_IDX"; view=main; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        elif [ "$view" = menu ]; then       # the action menu of the selected topic
            case "$key" in
                UP|k) f=$(sel_file); [ -n "$f" ] && menu_build "$f"                    # title (-2), description (-1), then the actions
                      MENU_IDX=$(( MENU_IDX - 1 )); [ "$MENU_IDX" -lt -2 ] && MENU_IDX=$(( ${#MENU_ITEMS[@]} - 1 )); redraw=1 ;;
                DOWN|j) f=$(sel_file); [ -n "$f" ] && menu_build "$f"
                      MENU_IDX=$(( MENU_IDX + 1 )); [ "$MENU_IDX" -ge "${#MENU_ITEMS[@]}" ] && MENU_IDX=-2; redraw=1 ;;
                ENTER|RIGHT) case "$MENU_IDX" in
                                 -2) menu_edit_field title ;; -1) menu_edit_field description ;;
                                 *) if menu_do "$MENU_IDX"; then :; else view=main; fi ;;
                             esac; redraw=1 ;;
                ITEM) MENU_IDX=$CLICK_I; case "$MENU_IDX" in                  # a click on an action runs it, on the title or description edits it
                          -2) menu_edit_field title ;; -1) menu_edit_field description ;;
                          *) if menu_do "$MENU_IDX"; then :; else view=main; fi ;;
                      esac; redraw=1 ;;
                [1-9]) f=$(sel_file); [ -n "$f" ] && menu_build "$f"
                       if [ "$key" -le "${#MENU_ITEMS[@]}" ]; then MENU_IDX=$(( key - 1 )); if menu_do "$MENU_IDX"; then :; else view=main; fi; fi; redraw=1 ;;
                ESC|q|Q|$'\177'|h|LEFT) view=main; redraw=1 ;;
            esac
        else
            case "$key" in
                "") ;;
                DRAG) [ "$view" = main ] && redraw=1 ;;
                AGENT) [ "$view" = main ] && { agent_jump "$CLICK_M" "$CLICK_P"; redraw=1; } ;;
                TOPIC) [ "$view" = main ] && { SEL_ID=$CLICK_T; redraw=1; } ;;      # a click on a topic selects it, like the arrows
                ACT) [ "$view" = main ] && { SEL_ID=$CLICK_T; review_act "$(topic_file_of "$CLICK_T")" "${CLICK_N:-1}"; redraw=1; } ;;   # a click on the button of a review card
                y|Y|1|2|3) if [ "$view" = main ]; then f=$(sel_file); k=${key#[yY]}; [ -n "$f" ] && review_act "$f" "${k:-${key/[yY]/1}}"; redraw=1; fi ;;   # (y = the first button)
                OPEN) [ "$view" = main ] && { SEL_ID=$CLICK_T; view=menu; MENU_IDX=0; redraw=1; } ;;   # a double click: the topic's page
                q|Q) exit 0 ;;
                s) if [ "$view" = main ] && [ -n "$(sel_file)" ]; then PICK_MODE=start; view=pick; PICK_IDX=0; else view=main; fi; redraw=1 ;;
                t|T) if [ "$view" = main ] && f=$(sel_file) && [ -n "$f" ] && [ -n "$(topic_get "$f" agent_pane)" ]; then PICK_MODE=transfer; PICK_IDX=1; view=pick; redraw=1; fi ;;
                S) splash_fits && view=splash; redraw=1 ;;
                w|W) if [ "$view" = main ]; then panel_setup "${NEWFEAT:-0}"; redraw=1; fi ;;   # the wizard (new features: only what is new)
                a|A) if [ "$view" = main ]; then view=suggest; SUG_IDX=0; redraw=1; fi ;;
                x|X) if [ "$view" = main ]; then f=$(sel_file); [ -n "$f" ] && topic_set "$f" status done; redraw=1; fi ;;   # check it off
                e|E) if [ "$view" = main ]; then f=$(sel_file)                                              # edit the title
                         if [ -n "$f" ] && ask "Title: " "$(topic_get "$f" title)" && [ -n "$ANSWER" ]; then topic_set "$f" title "$ANSWER"; fi; redraw=1; fi ;;
                d|D) if [ "$view" = main ]; then f=$(sel_file)                                              # edit the description
                         if [ -n "$f" ] && ask "Description: " "$(topic_get "$f" description)" "$DESC_MAX"; then topic_set "$f" description "$ANSWER"; fi; redraw=1; fi ;;
                n|N) if [ "$view" = main ]; then prompt_new_topic; redraw=1; else view=main; redraw=1; fi ;;
                ",") back=$view; [ "$back" = splash ] && back=main; view=settings; SET_PAGE=main; SET_IDX=0; redraw=1 ;;
                UP|k) if [ "$view" = main ]; then sel_move -1; redraw=1; fi ;;      # on the start screen the wheel does nothing
                DOWN|j) if [ "$view" = main ]; then sel_move +1; redraw=1; fi ;;
                ENTER) if [ "$view" = splash ]; then view=main
                       elif [ -n "$(sel_file)" ]; then topic_jump || { view=menu; MENU_IDX=0; }; fi; redraw=1 ;;   # its agent, like a click; else its page
                RIGHT) if [ "$view" = splash ]; then view=main; elif [ -n "$(sel_file)" ]; then view=menu; MENU_IDX=0; fi; redraw=1 ;;
                *) if [ "$view" = splash ]; then view=main; redraw=1; fi ;;
            esac
        fi
        # the welcome screen closes by itself (setting, default on) when nobody pressed a key for SPLASH_SECONDS
        if [ "$view" = splash ] && [ -z "$key" ] && [ "${SETUP_PENDING:-}" != 1 ]; then
            cfg_var _sa SPLASH_AUTOCLOSE on; cfg_var _ss SPLASH_SECONDS 15
            if [ "$_sa" = on ] && [ $(( SECONDS - ${SPLASH_SINCE:-$SECONDS} )) -ge "$_ss" ]; then view=main; redraw=1; fi
        fi
        # the agent lists changed (the collector writes them every few seconds): redraw the list view
        # the collector rewrites its files every few seconds: only a change of CONTENT repaints the list
        # (only when idle: after a key press the screen is repainted anyway, and a key must not wait for this check)
        # Every 2 seconds, when no key was read: did the agent lists, the topics or the sync state change? (Not tied to a read
        # timeout: the animation wakes the loop all the time, and bash 3.2 returns 1 from a timed-out read, bash 4+ more than 128.)
        if [ -n "$FLASH_MSG" ] && [ "$SECONDS" -ge "$FLASH_UNTIL" ]; then FLASH_MSG=""; redraw=1; fi
        if [ -n "${CLAMP_AT:-}" ] && [ "$SECONDS" -ge "$CLAMP_AT" ]; then CLAMP_AT=""; ( panel_width_clamp ) & fi
        if [ -z "$key" ]; then                                 # the agent lists changed (the collector counts a revision up): at once
            local _rev=""; { read -r _rev < "$SHARED_DIR/agents.rev"; } 2>/dev/null
            if [ "$_rev" != "${AG_REV:-}" ]; then AG_REV=$_rev; case "$view" in main) redraw=1 ;; esac; fi
        fi
        if [ -r "$SHARED_DIR/select" ]; then                   # bhote find chose a topic without an agent: select it here
            local _sid _snc _sact; { read -r _sid _snc _sact < "$SHARED_DIR/select"; } 2>/dev/null
            if [ "$_sid $_snc" != "${SEL_SEEN:-}" ]; then        # (show: the topic's page, else the list with it selected)
                [ -n "${SEL_SEEN:-}" ] && case "$_sid" in ''|*[!A-Za-z0-9_-]*) ;; *) [ -f "$TOPIC_DIR/$_sid.topic" ] && {
                    SEL_ID=$_sid; view=main; [ "$_sact" = show ] && { view=menu; MENU_IDX=0; }; redraw=1; } ;; esac
                SEL_SEEN="$_sid $_snc"
            fi
        else SEL_SEEN=${SEL_SEEN:-none}; fi
        if [ -z "$key" ] && [ "$SECONDS" -ge $(( ${chk:-0} + 2 )) ]; then
            chk=$SECONDS
            m1=$( { agents_all; cat "$TOPIC_DIR"/*.topic "$SHARED_DIR/deploys.at" "$SHARED_DIR/tests.at" 2>/dev/null; head -1 "$STORE_STATUS" 2>/dev/null; cat "$CONFIG_FILE" 2>/dev/null; } | cksum )   # also the settings: a new theme shows at once
            if [ "$m1" != "$last_m" ]; then last_m=$m1; case "$view" in main|settings) redraw=1 ;; esac; fi
        fi
    done
}
bhote_draw() { case "$1" in main) bhote_view ;; hotkeys) bhote_hotkeys ;; suggest) bhote_suggest ;; menu) bhote_menu ;; pick) bhote_pick ;; settings) bhote_settings ;; *) bhote_splash ;; esac; }
# One frame = ONE write: home, every line cleared to its end, then the rest of the screen cleared. No full clear first,
# so nothing flashes; and it is only called when what is on screen would really look different.
bhote_paint() {  # one write per frame; ui_load first (in THIS shell), the frame itself is built in a subshell that only prints
    local frame line out="" first=1
    if [ "$TOO_SMALL" = 1 ]; then     # too small for any picture: one line that cannot wrap
        printf '\033[H\033[J%s' "$(clip "Too small (min ${MIN_COLS}x${MIN_ROWS})" "$(( ${REAL_COLS:-30} - 1 ))")"; return 0
    fi
    ui_load
    frame=$(bhote_draw "$1")
    local fl=() fr=() n=0 sel=-1 off=0 rows=${ROWS:-40} i map=""
    while IFS= read -r line; do
        fr[$n]=""; case "$line" in $'\035'*) line=${line#$'\035'}; fr[$n]=${line%%$'\035'*}; line=${line#*$'\035'} ;; esac   # a clickable line (an action)
        case "$line" in $'\001'*) sel=$n; line=${line#$'\001'} ;; esac
        case "$line" in $'\002'*) EDIT_LINE=$n; line=${line#$'\002'} ;; esac   # the field being edited (menu_edit_field)
        fl[$n]=$line; n=$(( n + 1 ))
    done <<< "$frame"
    if [ "$n" -gt "$rows" ] && [ "$sel" -ge 0 ]; then         # taller than the pane (a long menu, settings): follow the selection
        off=$(( sel - rows / 2 )); [ "$off" -gt $(( n - rows )) ] && off=$(( n - rows )); [ "$off" -lt 0 ] && off=0
    fi
    for (( i = off; i < n && i < off + rows; i++ )); do
        [ "$first" = 1 ] || out="${out}"$'\n'; first=0
        out="${out}${fl[$i]}"$'\033[K'
        [ -n "${fr[$i]}" ] && map="$map$(( i - off + 1 ))"$'\036'"${fr[$i]}"$'\n'
    done
    printf '%s' "$map" 2>/dev/null > "$RUN_DIR/pmap"                 # the clickable rows of this frame (row \036 index)
    [ -n "${EDIT_LINE:-}" ] && { EDIT_ROW=$(( EDIT_LINE - off + 1 )); EDIT_LINE=""; }
    printf '\033[H%s\033[J' "$out"
}

# ── the command line: the same topics as the panel, for scripts and for chats ("bhote help"). Every change that is made
# here is also merged with the data location at once (best effort: offline it stays local and is merged later).
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')"; }
title_has() { local r=1; shopt -s nocasematch; [[ $1 == *"$2"* ]] && r=0; shopt -u nocasematch; return $r; }   # case-insensitive, multibyte-safe
topic_ref_sync() {  # topic_ref_sync <ref>: like topic_ref, but when nothing matches and a replica exists, merge once and look again
    local r; topic_ref "$1" && return 0; r=$?
    [ "$r" = 1 ] && [ -z "${BHOTE_NO_SYNC:-}" ] && store_synced || return $r
    store_sync >/dev/null 2>&1; topic_ref "$1" 2>/dev/null
}
topic_ref() {  # topic_ref <ref>  ->  prints the file. ref: the number from `bhote list`, an id (prefix), or part of the title.
    local ref=$1 i hits=0 hit="" low
    topics_load
    [ -n "$ref" ] || { echo "bhote: a topic is needed (number, id or part of the title)" >&2; return 1; }
    case "$ref" in *[!0-9]*) ;; *) if [ "${#ref}" -le 3 ]; then      # a number from `bhote list` (decimal, also with leading zeros)
        i=$(( 10#$ref )); if [ "$i" -ge 1 ] && [ "$i" -le "$T_N" ]; then printf '%s' "${T_FILE[$(( i - 1 ))]}"; return 0; fi
        echo "bhote: there is no topic number $ref (bhote list)" >&2; return 1; fi ;; esac
    low=$ref
    for (( i = 0; i < T_N; i++ )); do
        if [ "${T_ID[$i]}" = "$ref" ]; then printf '%s' "${T_FILE[$i]}"; return 0; fi
    done
    for (( i = 0; i < T_N; i++ )); do
        case "${T_ID[$i]}" in "$ref"*) hits=$(( hits + 1 )); hit=${T_FILE[$i]}; continue ;; esac
        title_has "${T_TITLE[$i]}" "$low" && { hits=$(( hits + 1 )); hit=${T_FILE[$i]}; }
    done
    if [ "$hits" = 1 ]; then printf '%s' "$hit"; return 0; fi
    if [ "$hits" = 0 ]; then echo "bhote: no topic matches '$ref'" >&2; return 1; fi
    echo "bhote: '$ref' matches $hits topics, be more specific:" >&2
    for (( i = 0; i < T_N; i++ )); do
        case "${T_ID[$i]}" in "$ref"*) echo "  $(( i + 1 ))  ${T_TITLE[$i]}  (id ${T_ID[$i]})" >&2; continue ;; esac
        title_has "${T_TITLE[$i]}" "$low" && echo "  $(( i + 1 ))  ${T_TITLE[$i]}" >&2
    done
    return 2
}
notify() {  # notify <title> <body> [sound: done|request|none]: a herdr notification, never blocking, never failing
    [ "$(cfg_get NOTIFY on)" = on ] || return 0

# block, and tools that regenerate the file can keep it (the dotfiles' term-theme does). herdr checks it on reload; a key it
# does not take puts the old file back.
key_ok() {  # key_ok <herdr key>: plain key syntax only (it goes into a TOML string)
    case "$1" in *[!A-Za-z0-9+_\;,.\[\]/=-]*) echo "bhote: odd characters in the key" >&2; return 1 ;; esac

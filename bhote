# ── the topic list: after the start screen the dog shrinks into the header. The topics are SAMPLE DATA for now.
theme_apply; theme_sig THEME_SIG                              # the colours of this run (ui_load re-applies them after a change)
rule() { printf '  %s%s%s\n' "$B" "${RULE_LINE:-───────────────────────────────────────}" "$X"; }   # from the same left edge as the text
group() {  # group <CAPTION> [colour]: a status caption; everything below starts in the same column
    printf '\n  %s%s%s\n' "${2:-$D}" "$1" "$X"
}
# One entry: the title, the description below it, then the elbow line with the meta (who/what, how long ago). The selected one
# gets the highlighted bar over all its lines (no pointer); its first line starts with an invisible \001 so that bhote_view can
# find it for scrolling (and strips it). Done entries are one muted line.
topic_item() {  # topic_item <selected 0|1> <state colour> <time> <title colour> <title> <description> <who> <state> [compact 1]
    # The meta line "∟ who · state · time": who in blue, the state in its own colour, the time grey. The description is italic.
    local w=$(( ${COLS:-44} - 2 )) bg="" mk="" t d tc=$4 dc=$DESC mc=${2:-$D} gc=$D wc=$BLUE who=$7 st=$8 tm=$3 room n
    local tw dw2; clip_set t "$5" $(( w - 3 )); clip_set d "$6" $(( w - 3 )); dw_set tw "$t"; dw_set dw2 "$d"
    if [ "$1" = 1 ]; then                                      # the selection: its own, brighter text colours (contrast on the bar)
        bg=$SELBG; mk=$'\001'; dc=$DESCSEL; gc=$DSEL; [ "$mc" = "$D" ] && mc=$DSEL
        case "$tc" in "$TITLE"|"$L") tc=$TITLESEL ;; *) tc="$([ "$color" = 1 ] && printf '%s[1m' "$esc")$DSEL" ;; esac   # muted (done) titles: readable
    fi
    printf '%s%s  %s%s%s%*s%s\n' "$mk" "$bg" "$tc" "$t" "$X$bg" $(( w - 2 - tw )) "" "$X"
    [ -n "$d" ] && printf '%s  %s%s%s%*s%s\n' "$bg" "$dc" "$d" "$X$bg" $(( w - 2 - dw2 )) "" "$X"
    [ -n "$who$st$tm" ] || { [ "${9:-}" = 1 ] || printf '\n'; return 0; }
    room=$(( w - 4 ))                                          # too long: the time goes first, then the state is cut, then who
    local ww sw; [ -n "$who" ] && clip_set who "$who" "$room"; dw_set ww "$who"; dw_set sw "$st"
    n=$(( ww + sw + ${#tm} + (ww > 0 && sw > 0 ? 3 : 0) + (${#tm} > 0 && ww + sw > 0 ? 3 : 0) ))

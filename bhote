}
w_probe() {  # w_probe <ssh target>: can we get there? W_PROBE = ok | password | unknown | refused | unreachable | other
    local out; out=$("${BHOTE_SSH:-ssh}" -n -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new "$1" true 2>&1); local rc=$?
    if [ $rc = 0 ]; then W_PROBE=ok; return 0; fi
    case "$out" in
        *"ermission denied"*|*"publickey"*) W_PROBE=password ;;
        *"ould not resolve"*|*"not known"*|*"Name or service"*) W_PROBE=unknown ;;
        *"onnection refused"*) W_PROBE=refused ;;
        *"timed out"*|*"o route"*|*"nreachable"*) W_PROBE=unreachable ;;
        *) W_PROBE=other ;;
    esac
    return 1
}
w_probe_say() {  # what the probe means, in one line
    case "$W_PROBE" in
        ok) w_ok "reachable" "ssh works with your key" ;;
        password) w_ok "reachable" "ssh will ask for the password (bhote never sees it)" ;;
        unknown) w_bad "unknown name" "pick it from the list or check the spelling" ;;
        refused) w_bad "no ssh there" "switch on Remote Login (macOS) or sshd (Linux)" ;;
        unreachable) w_bad "not reachable" "is it on and in the same network or tailnet?" ;;
        *) w_bad "ssh failed" "try another address" ;;
    esac
}
w_remote_knows() {  # w_remote_knows <machine label>: does that machine have THIS one saved in herdr? 0 yes, 1 no, 2 cannot tell
    # (herdr does not run `machine list` through --machine; this asks the other side over ssh, read-only, never for a password)
    local host list; host=$(store_host "$1"); case "$host" in ''|-*|*[!A-Za-z0-9._@:%-]*) return 2 ;; esac
    list=$("${BHOTE_SSH:-ssh}" -n -o BatchMode=yes -o ConnectTimeout=6 "$host" "sh -lc $(printf '%q' "${W_RPATH}herdr machine list")" 2>/dev/null) || return 2
    printf '%s\n' "$list" | awk -F'\t' -v h="$HOST" '$2 == h { f = 1 } END { exit !f }' && return 0
